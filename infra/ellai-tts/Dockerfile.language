FROM ghcr.io/astral-sh/uv:0.13.5 AS uv
FROM python:3.12.15-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
WORKDIR /app
COPY --from=uv /uv /uvx /bin/
COPY infra/ellai-tts/pyproject.toml infra/ellai-tts/uv.lock ./
COPY infra/ellai-tts/language_app.py ./
COPY scripts/ellai/provision_native_models.py scripts/ellai/native-models.lock.json ./
RUN addgroup --system swiftaid && adduser --system --ingroup swiftaid swiftaid \
    && uv sync --frozen --no-dev --no-cache && chown -R swiftaid:swiftaid /app
USER swiftaid
EXPOSE 8091
ENTRYPOINT ["/app/.venv/bin/uvicorn", "language_app:app", "--host", "0.0.0.0", "--port", "8091", "--workers", "1", "--no-access-log"]
