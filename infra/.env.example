# Local development only. Copy to .env and replace every value with fresh,
# private credentials. Never reuse these values outside a disposable local DB.
POSTGRES_DB=swiftaid_dev
POSTGRES_USER=swiftaid_dev
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=5432

QDRANT_API_KEY=replace-with-a-long-random-local-api-key

NATS_GATEWAY_USER=swiftaid_gateway
NATS_GATEWAY_PASSWORD=replace-with-a-long-random-local-password
NATS_WORKER_USER=swiftaid_worker
NATS_WORKER_PASSWORD=replace-with-a-different-long-random-local-password
NATS_CLIENT_PORT=4222
NATS_NOTIFICATION_STREAM=SWIFTAID_NOTIFICATIONS
NATS_NOTIFICATION_SUBJECT=swiftaid.notifications.inapp
NATS_BOOTSTRAP_USER=swiftaid_notification_bootstrap
NATS_BOOTSTRAP_PASSWORD=replace-with-a-long-random-bootstrap-password
# Optional explicit NATS option overrides go in the separate
# .nats-overrides.env file using standard .NET keys such as
# Nats__NotificationStreamMaxAgeSeconds. Compose passes that file to Gateway
# and stream bootstrap only when it exists; otherwise appsettings.json remains
# authoritative. Do not put unrelated or secret values in that override file.

# Local MinIO development credentials; MinIO is private and must not use these
# placeholders. Its upstream server repository is archived, so keep it local.
MINIO_ROOT_USER=replace-with-a-local-storage-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-local-storage-password
MINIO_BUCKET=swiftaid-local
MINIO_MAX_OBJECT_SIZE_BYTES=104857600
MINIO_API_PORT=9000
MINIO_ENABLED=false
MINIO_APP_ACCESS_KEY=replace-with-a-local-app-storage-user
MINIO_APP_SECRET_KEY=replace-with-a-long-random-local-app-storage-password

# Local cache only. Redis is not an authoritative store.
REDIS_PASSWORD=replace-with-a-long-random-local-cache-password
REDIS_PORT=6379
REDIS_INSTANCE_NAME=swiftaid:
REDIS_MAXIMUM_TTL_SECONDS=3600

# Tag for the locally built gateway image. Override per developer or CI
# registry; the default preserves the existing local tag.
GATEWAY_IMAGE=vuminkosimatibe/swiftaid-gateway:latest

# Push is disabled unless a project and server-side credential are provisioned.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE_PATH=../secrets/swiftaid-fcm-service-account.json
# Existing deployments may keep the same host file path under
# FCM_CredentialsFilePath; Compose accepts it as a compatibility alias. The
# JSON file is mounted as a read-only Compose secret and never copied here.

# These are public Firebase Web configuration values, not server credentials.
# Web push remains disabled until the SwiftAid Firebase app is configured.
FIREBASE_WEB_ENABLED=false
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=
FIREBASE_WEB_VAPID_KEY=

# ASP.NET Data Protection is disabled unless explicitly provisioned. Keep key
# paths private and inject the certificate password through a secret provider.
CaseCommandProcessing__Enabled=false
CaseCommandProcessing__MaximumTransactionAttempts=3
DataProtection__Enabled=false
DataProtection__ApplicationName=
DataProtection__KeysPath=
DataProtection__CertificatePath=
DataProtection__CertificatePassword=
DataProtection__AllowUnencryptedDevelopmentKeys=false
DataProtection__MaximumPayloadBytes=0

# Server-side federation credentials. Provider callbacks remain unavailable
# until each provider has completed real registration and callback checks.
Federation__Enabled=false
Federation__Google__Enabled=false
Federation__Google__CallbackVerified=false
Federation__Google__CallbackPath=/google/callback
Federation__Google__ClientId=
Federation__Google__ClientSecret=
Federation__Facebook__Enabled=false
Federation__Facebook__CallbackVerified=false
Federation__Facebook__ClientId=
Federation__Facebook__ClientSecret=

# The SwiftAid authorization-code issuer is opt-in and requires configured
# certificates, an operator-allowlisted public client and persistent DB/key storage.
Identity__Enabled=false
Identity__Issuer=
Identity__SigningCertificatePath=
Identity__SigningCertificatePassword=
Identity__EncryptionCertificatePath=
Identity__EncryptionCertificatePassword=

# SMTP delivery for account mail (password reset). Disabled until the operator
# provides relay credentials; the reset endpoints fail closed without them.
Smtp__Enabled=false
Smtp__Host=
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__UserName=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromDisplayName=SwiftAid


Ellai_Enabled=true
# Runtime policy file attached by reference (read-only bind mount into the
# gateway at /etc/swiftaid/policy/ellai-system-instruction.md). Never baked
# into the image. Path is relative to infra/ unless overridden here.
SWIFTAID_POLICY_FILE=../docs/ellai/ellai-system-instruction.md
Ellai__Policy__Version=1.3
Ellai__ApiKey=
Ellai__ApiUrl=
Ellai__ReasoningModel=
Ellai__ReasoningBackend=meta
Ellai__Reasoning__Ollama__Endpoint=http://localhost:11434
Ellai__Reasoning__Ollama__Model=llama3.2:3b
# Serverless/self-hosted lane stays disabled until the Meta default is fully
# tested. Keep Enabled=false even after filling the values below.
Ellai__Reasoning__Serverless__Enabled=false
Ellai__Reasoning__Serverless__Endpoint=
Ellai__Reasoning__Serverless__Model=
Ellai__Reasoning__Serverless__ApiKey=
# Operator-funded budget: $70 for everything (global kill switch + per-session envelope).
Ellai__Pricing__SpendingCap=70.00
# Real Meta plan rates in dollars. Zero (default) means unpriced: dollar caps
# stay inert and the 200k-token session budget remains the active guard.
Ellai__Pricing__InputPer1K=
Ellai__Pricing__OutputPer1K=
Ellai__Pricing__AudioPerMinute=
Ellai__ASR_MODEL=
Ellai__Asr__Language=en
## Live audio: voice agents, dictation, captions
## WebSocket. Authenticate in the handshake frame; the Authorization header is ignored. https://dev.meta.ai/docs/api-reference/voice
Ellai__ASR_WSS=
## A recording you already have
## Multipart upload. Authenticate with the Authorization header. https://dev.meta.ai/docs/api-reference/voice
Ellai__ASR_Transcription__URL=
Ellai__ASRMode=DIARIZATION