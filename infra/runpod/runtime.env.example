# Copy to runtime.env for local Compose. Set these as Runpod Pod environment variables in production.
# Never commit credentials. The Pod generates and persists its internal service passwords.
SWIFTAID_PUBLIC_HOST=localhost
# On Runpod omit SWIFTAID_PUBLIC_HOST to derive <RUNPOD_POD_ID>-8080.proxy.runpod.net.
RUNPOD_CLASSIFICATION_ORGANIZATIONS=
# Required: comma-separated UUIDs of organizations authorized for this classification worker.
# Existing authorization and tenant boundaries remain enforced.
RUNPOD_DOWNLOAD_MODELS=true
# Optional Hugging Face access token if required by your model download policy:
# HF_TOKEN=

Ellai__Enabled=true
Ellai__ReasoningBackend=meta
Ellai__ApiKey=
Ellai__ApiUrl=
Ellai__ReasoningModel=
Ellai__ASR_MODEL=
Ellai__ASR_WSS=
Ellai__ASR_Transcription__URL=
# Use the actual provider HTTPS / WSS endpoints and model identifiers from your existing deployment.
# Hosted Muse is retained for both reasoning and the existing live voice transport.

# Optional existing Gateway integrations; configure their full existing appsettings keys.
# Smtp__Enabled=true
# Identity__Enabled=true
# DemoAccount__Enabled=true
# DemoAccount__Email=demo@example.test
# DemoAccount__Password=<set a strong deployment-specific password>
# DemoAccess__Enabled=false
