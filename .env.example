# Local development only. Copy to .env and replace every value with fresh,
# private credentials. Never reuse these values outside a disposable local DB.
POSTGRES_DB=swiftaid_dev
POSTGRES_USER=swiftaid_dev
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=5432

QDRANT_API_KEY=replace-with-a-long-random-local-api-key

NATS_GATEWAY_USER=swiftaid_gateway
NATS_GATEWAY_PASSWORD=replace-with-a-long-random-local-password
NATS_WORKER_USER=swiftaid_worker
NATS_WORKER_PASSWORD=replace-with-a-different-long-random-local-password
NATS_CLIENT_PORT=4222

# Local MinIO development credentials; MinIO is private and must not use these
# placeholders. Its upstream server repository is archived, so keep it local.
MINIO_ROOT_USER=replace-with-a-local-storage-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-local-storage-password
MINIO_BUCKET=swiftaid-local
MINIO_MAX_OBJECT_SIZE_BYTES=104857600
MINIO_API_PORT=9000
MINIO_ENABLED=false
MINIO_APP_ACCESS_KEY=replace-with-a-local-app-storage-user
MINIO_APP_SECRET_KEY=replace-with-a-long-random-local-app-storage-password

# Local cache only. Redis is not an authoritative store.
REDIS_PASSWORD=replace-with-a-long-random-local-cache-password
REDIS_PORT=6379
REDIS_INSTANCE_NAME=swiftaid:
REDIS_MAXIMUM_TTL_SECONDS=3600

# Push is disabled unless a project and server-side credential are provisioned.
FCM_ENABLED=false
FCM_PROJECT_ID=

# ASP.NET Data Protection is disabled unless explicitly provisioned. Keep key
# paths private and inject the certificate password through a secret provider.
CaseCommandProcessing__Enabled=false
CaseCommandProcessing__MaximumTransactionAttempts=3
DataProtection__Enabled=false
DataProtection__ApplicationName=
DataProtection__KeysPath=
DataProtection__CertificatePath=
DataProtection__CertificatePassword=
DataProtection__AllowUnencryptedDevelopmentKeys=false
DataProtection__MaximumPayloadBytes=0
