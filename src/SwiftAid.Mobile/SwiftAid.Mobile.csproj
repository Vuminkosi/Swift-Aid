<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
    <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->
    <OutputType>Exe</OutputType>
    <RootNamespace>SwiftAid.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>
    <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <!-- Display name -->
    <ApplicationTitle>SwiftAid</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>online.swiftaid.mobile</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
    <WindowsPackageType>None</WindowsPackageType>
    <CodesignEntitlements Condition="'$(TargetFramework)' == 'net10.0-ios' And '$(Configuration)' == 'Debug'">Platforms\iOS\Entitlements.Development.plist</CodesignEntitlements>
    <CodesignEntitlements Condition="'$(TargetFramework)' == 'net10.0-ios' And '$(Configuration)' == 'Release'">Platforms\iOS\Entitlements.Production.plist</CodesignEntitlements>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <EmbedAssembliesIntoApk Condition="'$(TargetFramework)' == 'net10.0-android'">true</EmbedAssembliesIntoApk>
    <AndroidManifestPlaceholders Condition="'$(TargetFramework)' == 'net10.0-android'">usesCleartextTraffic=false</AndroidManifestPlaceholders>
    <AndroidManifestPlaceholders Condition="'$(TargetFramework)' == 'net10.0-android' And '$(Configuration)' == 'Debug'">usesCleartextTraffic=true</AndroidManifestPlaceholders>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <ItemGroup>
      <!-- App Icon -->
  <MauiIcon Include="Resources\AppIcon\appicon.png"
            BaseSize="128,128" />

  <!-- Native static splash screen -->
  <MauiSplashScreen
      Include="Resources\Splash\swiftaid_splash.png"
      Color="#FFFFFF"
      BaseSize="480,480" />

  <!-- Application images -->
  <MauiImage Include="Resources\Images\*" />

  <MauiImage Update="Resources\Images\dotnet_bot.svg"
            BaseSize="168,208" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\SwiftAid.UI\wwwroot\vendor\vad\silero_vad_v5.onnx" LogicalName="SwiftAid.Mobile.silero_vad_v5.onnx" />
    <EmbeddedResource Include="Resources\Raw\appsettings.json" LogicalName="SwiftAid.Mobile.appsettings.json" />
    <EmbeddedResource Include="Resources\Raw\appsettings.Development.json" LogicalName="SwiftAid.Mobile.appsettings.Development.json" />
    <AndroidResource Include="Resources\Raw\relaxing_synth_ping.mp3" Link="Resources\raw\relaxing_synth_ping.mp3" />
    <AndroidResource Include="Resources\Raw\swiftaid_gentle_notification.wav" Link="Resources\raw\swiftaid_gentle_notification.wav" />
    <GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="'$(TargetFramework)' == 'net10.0-android' And Exists('Platforms\Android\google-services.json')" />
    <BundleResource Include="Platforms\iOS\GoogleService-Info.plist" Condition="'$(TargetFramework)' == 'net10.0-ios' And Exists('Platforms\iOS\GoogleService-Info.plist')" />
    <BundleResource Include="Resources\Raw\swiftaid_gentle_notification.wav" Condition="'$(TargetFramework)' == 'net10.0-ios'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Condition="'$(TargetFramework)' == 'net10.0-android'" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Plugin.Firebase.CloudMessaging" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SwiftAid.Client\SwiftAid.Client.csproj" />
    <ProjectReference Include="..\SwiftAid.Contracts\SwiftAid.Contracts.csproj" />
    <ProjectReference Include="..\SwiftAid.UI\SwiftAid.UI.csproj" />
  </ItemGroup>
</Project>
