@page "/sign-in"
@using System.Net.Http.Json
@using SwiftAid.Client.Authentication
@using SwiftAid.Client.Navigation
@using SwiftAid.Mobile.Services.Account
@using SwiftAid.Mobile.Services.Http
@using SwiftAid.Mobile.Services.Authentication
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation

<PageTitle>Sign in | SwiftAid</PageTitle>

<div class="mobile-auth-page">
    <AccountEntrySurface>
    <MudPaper Class="mobile-auth-panel" Elevation="0">
        <SwiftAidPageHeading Eyebrow="Your SwiftAid account"
                             Title="Welcome back"
                             Description="Sign in to your account."
                             HeadingId="sign-in-heading" />
        <MudText Typo="Typo.body2" Class="mobile-auth-privacy-note">
            Signing in does not by itself provide access to an organization’s records.
        </MudText>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert">
                @_error
            </MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(_notice))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">
                @_notice
            </MudAlert>
        }

        @if (_loadingCapabilities)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading sign-in methods" />
        }
        else if (_capabilityError is not null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert">
                @_capabilityError
            </MudAlert>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                       OnClick="LoadCapabilitiesAsync" Disabled="@_busy">
                Try again
            </MudButton>
        }
        else
        {
            @if (_passwordSignInAvailable)
            {
                <EditForm Model="_passwordForm" OnSubmit="HandlePasswordSubmitAsync">
                    <div class="mobile-auth-password" role="group" aria-label="Sign in with email">
                    <MudTextField T="string" Label="Email address" @bind-Value="_passwordForm.Email"
                                  Variant="Variant.Outlined" Required="true" Disabled="@_busy"
                                  InputType="InputType.Email" Immediate="true" autocomplete="email"
                                  aria-label="Email address" />
                    <MudTextField T="string" Label="Password" @bind-Value="_passwordForm.Password"
                                  Variant="Variant.Outlined" Required="true" Disabled="@_busy"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="() => _showPassword = !_showPassword"
                                  Immediate="true" MaxLength="256" autocomplete="current-password"
                                  aria-label="Password" />
                    <MudStack Row="true" Spacing="2" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudSwitch T="bool" @bind-Value="_rememberMe" Color="Color.Primary"
                                   Label="Remember me" Disabled="@(_busy || !CanRememberSignIn)" />
                        <MudLink Href="/forgot-password">Forgot password?</MudLink>
                    </MudStack>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               Disabled="@(!CanSubmit)" Class="auth-cta" StartIcon="@Icons.Material.Filled.Login">
                        @(_busy ? "Signing in…" : "Sign in")
                    </MudButton>
                    </div>
                </EditForm>
            }

            @if (_passwordSignInAvailable && _nativeSignInAvailable)
            {
                <MudText Typo="Typo.body2" Class="mobile-auth-divider-text">Or continue with</MudText>
            }

            @if (_nativeSignInAvailable)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                           OnClick="StartNativeSignInAsync" Disabled="@_busy" Class="auth-cta" StartIcon="@Icons.Material.Filled.Login">
                    @(_busy ? "Opening secure sign-in…" : "More sign-in options")
                </MudButton>
                <MudText Typo="Typo.caption" Align="Align.Center">
                    Available provider and organization options are shown by the Gateway.
                </MudText>
            }

            @if (!_passwordSignInAvailable && !_nativeSignInAvailable)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">
                    Sign-in is unavailable right now. You can continue without an account.
                </MudAlert>
            }

            @if (_passwordSignInAvailable)
            {
                <MudButton Href="@RegisterHref" Variant="Variant.Text" Color="Color.Primary" FullWidth="true">
                    Don't have an account? Sign up
                </MudButton>
            }
        }

        <MudDivider Class="mobile-auth-divider" />

        <MudButton Href="/report" Variant="Variant.Text" Color="Color.Primary" FullWidth="true">
            Continue without an account
        </MudButton>
        <nav aria-label="Legal information">
            <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                <MudLink Href="/privacy">Privacy</MudLink>
                <MudLink Href="/terms">Terms</MudLink>
            </MudStack>
        </nav>
    </MudPaper>
    </AccountEntrySurface>
</div>

@code {
    private readonly PasswordSignInForm _passwordForm = new();
    private bool _rememberMe;
    private bool _showPassword;
    private bool _busy;
    private bool _loadingCapabilities = true;
    private bool _passwordSignInAvailable;
    private bool _nativeSignInAvailable;
    private string? _capabilityError;
    private string? _error;
    private string? _notice;

    private HttpPasswordAuthClient AuthClient =>
        (HttpPasswordAuthClient?)ServiceProvider.GetService(typeof(HttpPasswordAuthClient))
        ?? CreateFallback();

    private NativeSessionHttpOptions? SessionOptions =>
        (NativeSessionHttpOptions?)ServiceProvider.GetService(typeof(NativeSessionHttpOptions));

    private bool CanRememberSignIn => SessionOptions is { } options &&
        GatewayAuthCookieSnapshot.SupportsPersistentSession(options.GatewayBaseAddress);

    private CookieSessionHttpClient GatewayClient =>
        CookieSessionHttpClient.Shared(
            ((NativeSessionHttpOptions?)ServiceProvider.GetService(typeof(NativeSessionHttpOptions)))
            ?.GatewayBaseAddress?.ToString());

    private HttpPasswordAuthClient CreateFallback() => new(GatewayClient);


    private Task RefreshShellAsync()
    {
        // Password sessions live in the gateway cookie jar; notify the shell
        // so the gate and overview refresh without an app restart.
        var session = (IMobileAuthenticationSession?)ServiceProvider.GetService(typeof(IMobileAuthenticationSession));
        return session is null ? Task.CompletedTask : session.RefreshAsync();
    }

    private bool CanSubmit =>
        !_busy &&
        _passwordSignInAvailable &&
        !string.IsNullOrWhiteSpace(_passwordForm.Email) &&
        !string.IsNullOrWhiteSpace(_passwordForm.Password);

    protected override Task OnInitializedAsync()
    {
        _rememberMe = CanRememberSignIn;
        return LoadCapabilitiesAsync();
    }

    private async Task LoadCapabilitiesAsync()
    {
        _loadingCapabilities = true;
        _capabilityError = null;
        try
        {
            using var response = await GatewayClient.GetAsync("/auth/capabilities");
            if (!response.IsSuccessStatusCode)
            {
                throw new HttpRequestException("The gateway did not return sign-in capabilities.");
            }

            var capabilities = await response.Content.ReadFromJsonAsync<IdentityCapabilitiesResponse>();
            if (capabilities is null)
            {
                throw new HttpRequestException("The gateway returned invalid sign-in capabilities.");
            }

            _passwordSignInAvailable = capabilities.PasswordSignInAvailable;
            _nativeSignInAvailable = capabilities.NativeSignInAvailable;
        }
        catch (Exception)
        {
            _passwordSignInAvailable = false;
            _nativeSignInAvailable = false;
            _capabilityError = "We couldn't load sign-in methods. Check your connection and try again.";
        }
        finally
        {
            _loadingCapabilities = false;
        }
    }

    private Task HandlePasswordSubmitAsync(EditContext _) => SignInAsync();

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private string SafeReturnUrl => LocalReturnUrlPolicy.Resolve(ReturnUrl, "/dashboard");
    private string RegisterHref => $"/register?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";

    private async Task SignInAsync()
    {
        if (!CanSubmit)
        {
            return;
        }

        _busy = true;
        _error = null;
        _notice = null;
        try
        {
            var result = await AuthClient.LoginAsync(_passwordForm.Email!.Trim(), _passwordForm.Password!, _rememberMe);
            if (result.Status == PasswordAuthStatus.Succeeded)
            {
                await RefreshShellAsync();
                Navigation.NavigateTo(SafeReturnUrl);
                return;
            }

            _error = result.Message ?? "Sign-in failed. Please try again.";
        }
        catch (Exception)
        {
            _error = "Sign-in is temporarily unavailable.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StartNativeSignInAsync()
    {
        if (_busy || !_nativeSignInAvailable)
        {
            return;
        }

        var session = (IMobileAuthenticationSession?)ServiceProvider.GetService(typeof(IMobileAuthenticationSession));
        if (session is null)
        {
            _error = "Secure sign-in is unavailable right now.";
            return;
        }

        _busy = true;
        _error = null;
        _notice = null;
        try
        {
            if (await session.SignInAsync())
            {
                Navigation.NavigateTo(SafeReturnUrl);
                return;
            }

            _notice = "Sign-in did not complete. You can retry or use email and password.";
        }
        catch (Exception)
        {
            _error = "Secure sign-in is temporarily unavailable. Try again or use email and password.";
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed record IdentityCapabilitiesResponse(
        bool PasswordSignInAvailable,
        bool NativeSignInAvailable);

    private sealed class PasswordSignInForm
    {
        public string? Email { get; set; }

        public string? Password { get; set; }
    }
}
