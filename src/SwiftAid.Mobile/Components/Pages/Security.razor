@page "/security"
@using SwiftAid.Client.Authentication
@using SwiftAid.Client.Presentation
@using SwiftAid.Mobile.Services.Account
@using SwiftAid.Mobile.Services.Http
@using SwiftAid.UI.Components.Surfaces.Account
@inject IServiceProvider ServiceProvider

<PageTitle>Security &amp; sign-in | SwiftAid</PageTitle>

<SwiftAidPageHeading Eyebrow="Account" Title="Security &amp; sign-in"
                     Description="Change your password and review how you sign in."
                     HeadingId="security-heading" />

<ChangePasswordSurface Snapshot="_password" OnRefresh="RefreshAsync" OnSave="ChangePasswordAsync" />

<MudPaper Class="pa-4 mb-4" Elevation="0">
    <MudText Typo="Typo.subtitle1">Device session</MudText>
    @if (_accountLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading device session" />
    }
    else if (_account is null)
    {
        <MudText Typo="Typo.body2" role="status">Your device session could not be loaded.</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="LoadAccountAsync"
                   StartIcon="@Icons.Material.Filled.Refresh">Try again</MudButton>
    }
    else if (!_account.IsSignedIn)
    {
        <MudText Typo="Typo.body2">Sign in to view your device session.</MudText>
    }
    else
    {
        <MudText Typo="Typo.body2">This device is signed in.</MudText>
        <MudText Typo="Typo.caption">
            Linked sign-in methods and remote sessions cannot be managed here yet.
        </MudText>
    }
</MudPaper>

@code {
    private ChangePasswordSnapshot _password = ChangePasswordSnapshot.Loading;
    private AccountPresentationState? _account;
    private bool _accountLoading = true;

    private HttpPasswordAuthClient AuthClient =>
        (HttpPasswordAuthClient?)ServiceProvider.GetService(typeof(HttpPasswordAuthClient))
        ?? CreateAuthFallback();

    private IAccountPresentationClient AccountClient =>
        (IAccountPresentationClient?)ServiceProvider.GetService(typeof(IAccountPresentationClient))
        ?? new UnavailableAccountPresentationClient();

    private IUserProfileClient ProfileClient =>
        (IUserProfileClient?)ServiceProvider.GetService(typeof(IUserProfileClient))
        ?? CreateProfileFallback();

    private HttpPasswordAuthClient CreateAuthFallback()
    {
        var options = (NativeSessionHttpOptions?)ServiceProvider.GetService(typeof(NativeSessionHttpOptions));
        return new HttpPasswordAuthClient(
            CookieSessionHttpClient.Shared(options?.GatewayBaseAddress?.ToString()));
    }

    private IUserProfileClient CreateProfileFallback()
    {
        var options = (NativeSessionHttpOptions?)ServiceProvider.GetService(typeof(NativeSessionHttpOptions));
        return new HttpUserProfileClient(
            CookieSessionHttpClient.Shared(options?.GatewayBaseAddress?.ToString()));
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAccountAsync(), RefreshAsync());
    }

    private async Task LoadAccountAsync()
    {
        if (!_accountLoading) _accountLoading = true;
        _account = null;
        try
        {
            var result = await AccountClient.GetStateAsync();
            _account = result.Succeeded ? result.Value : null;
        }
        catch (Exception)
        {
            _account = null;
        }
        finally
        {
            _accountLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            var profile = await ProfileClient.GetAsync();
            if (profile.Value is null)
            {
                _password = profile.Code == UiCapabilityResultCode.Denied
                    ? ChangePasswordSnapshot.SignedOut
                    : ChangePasswordSnapshot.Unavailable with
                    {
                        StatusMessage = profile.Message ?? ChangePasswordSnapshot.Unavailable.StatusMessage
                    };
                return;
            }

            _password = profile.Value.IsSignedIn
                ? new ChangePasswordSnapshot(ChangePasswordViewState.Ready, false)
                : ChangePasswordSnapshot.SignedOut;
        }
        catch (Exception)
        {
            _password = ChangePasswordSnapshot.Unavailable;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ChangePasswordAsync(ChangePasswordRequest request)
    {
        if (string.IsNullOrWhiteSpace(request.NewPassword))
        {
            _password = new ChangePasswordSnapshot(
                ChangePasswordViewState.Ready, false, "The new passwords do not match.", true);
            return;
        }

        _password = new ChangePasswordSnapshot(ChangePasswordViewState.Ready, true);
        try
        {
            var result = await AuthClient.ChangePasswordAsync(
                request.CurrentPassword ?? string.Empty,
                request.NewPassword);
            _password = result.Status switch
            {
                PasswordAuthStatus.Succeeded => new ChangePasswordSnapshot(
                    ChangePasswordViewState.Ready, false, result.Message ?? "Your password was changed.", false),
                PasswordAuthStatus.SignedOut => ChangePasswordSnapshot.SignedOut,
                _ => new ChangePasswordSnapshot(
                    ChangePasswordViewState.Ready, false,
                    result.Message ?? "The password could not be changed.", true)
            };
        }
        catch (Exception)
        {
            _password = new ChangePasswordSnapshot(
                ChangePasswordViewState.Ready, false,
                "Changing the password is temporarily unavailable.", true);
        }
    }
}
