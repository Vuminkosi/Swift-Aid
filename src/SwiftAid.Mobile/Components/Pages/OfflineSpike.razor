@page "/offline-spike"
@using System.Net
@using CommunityToolkit.Datasync.Client.Offline
@using Microsoft.EntityFrameworkCore
@using SwiftAid.Client.LocalStore
@implements IDisposable
@inject SwiftAidOfflineDbContextFactory ContextFactory

<PageTitle>Save a note | SwiftAid</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="offline-spike-page">
    <SwiftAidPageHeading Eyebrow="On this device"
                         Title="Keep a note on this device"
                         Description="Save this example note, then reopen the app to see whether it stayed here."
                         HeadingId="offline-spike-heading" />

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
        This is an example note. It contains no personal or health details and is not a report.
    </MudAlert>

    <MudPaper Class="offline-spike-panel" Elevation="0">
        <MudText Typo="Typo.h6" HtmlTag="h2">Example note</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Close and reopen the app to check that it is still here.
        </MudText>
        <MudText Typo="Typo.body1">@SampleValue</MudText>

        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="_busy"
                       OnClick="SaveLocalAsync">
                Save example note
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Disabled="_busy || !ContextFactory.HasRemoteEndpoint"
                       OnClick="PullAsync">
                Check shared updates
            </MudButton>
        </MudStack>

        @if (!ContextFactory.HasRemoteEndpoint)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                Updates are unavailable right now. Your saved note remains on this device.
            </MudAlert>
        }
        else if (!_pullAttempted)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
                Shared updates have not been checked yet. Your saved note remains on this device.
            </MudAlert>
        }
    </MudPaper>

    <MudPaper Class="offline-spike-panel" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6" HtmlTag="h2">Saved note</MudText>
            @if (_busy)
            {
                <MudProgressCircular Indeterminate="true"
                                     Size="Size.Small"
                                     Color="Color.Primary"
                                     aria-hidden="true" />
            }
        </MudStack>

        @if (_loadFailed)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" role="alert">
                Your saved note could not be checked. Try again when the app is ready.
            </MudAlert>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="_busy" OnClick="LoadLocalAsync">
                Try again
            </MudButton>
        }
        else if (_localRows.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No note saved yet.</MudText>
        }
        else
        {
            <MudList T="string" Dense="true">
                @foreach (var row in _localRows)
                {
                    <MudListItem T="string">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body1">@row.Value</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">On this device</MudText>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }

        @if (_busy || !string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div role="status" aria-live="polite" aria-atomic="true">
                @if (_busy)
                {
                    <MudText Typo="Typo.body2">@_progressMessage</MudText>
                }
                else if (!string.IsNullOrWhiteSpace(_statusMessage))
                {
                    <MudAlert Severity="_statusSeverity" Variant="Variant.Outlined" Dense="true">
                        @_statusMessage
                    </MudAlert>
                }
            </div>
        }
    </MudPaper>

    <SwiftAidServiceBoundaryNotice />
</MudContainer>

@code {
    private const int MaximumRowsToDisplay = 10;
    private const string SampleId = "offline-spike-sample-v1";
    private const string SampleValue = "Example note — no personal information";
    private readonly CancellationTokenSource _lifetime = new();
    private List<OfflineSpikeRecord> _localRows = [];
    private string? _statusMessage;
    private string? _progressMessage;
    private Severity _statusSeverity = Severity.Info;
    private bool _busy;
    private bool _loadFailed;
    private bool _pullAttempted;

    protected override Task OnInitializedAsync() => LoadLocalAsync();

    private async Task SaveLocalAsync()
    {
        await RunLocalOperationAsync(async cancellationToken =>
        {
            await using var db = await ContextFactory.CreateDbContextAsync(cancellationToken);
            await db.Database.EnsureCreatedAsync(cancellationToken);
            var sample = await db.SpikeRows.FindAsync([SampleId], cancellationToken);
            if (sample is null)
            {
                db.SpikeRows.Add(new OfflineSpikeRecord
                {
                    Id = SampleId,
                    Value = SampleValue,
                    Deleted = false
                });
            }

            await db.SaveChangesAsync(cancellationToken);
            await RefreshRowsAsync(db, cancellationToken);
            SetStatus("Example note saved on this device.", Severity.Success);
        }, "Your note couldn't be saved. Try again when the app is ready.", "Saving note…");
    }

    private async Task LoadLocalAsync()
    {
        await RunLocalOperationAsync(async cancellationToken =>
        {
            await using var db = await ContextFactory.CreateDbContextAsync(cancellationToken);
            await db.Database.EnsureCreatedAsync(cancellationToken);
            await RefreshRowsAsync(db, cancellationToken);
            _loadFailed = false;
            _statusMessage = null;
        },
            "Your saved note couldn't be checked. Try again when the app is ready.",
            "Checking saved note…",
            markLoadFailed: true);
    }

    private async Task PullAsync()
    {
        _pullAttempted = true;
        if (!ContextFactory.HasRemoteEndpoint)
        {
            SetStatus("Updates are unavailable right now. Your saved note remains on this device.", Severity.Info);
            return;
        }

        await RunLocalOperationAsync(async cancellationToken =>
        {
            await using var db = await ContextFactory.CreateDbContextAsync(cancellationToken);
            await db.Database.EnsureCreatedAsync(cancellationToken);
            var result = await db.SpikeRows.PullAsync(cancellationToken);

            if (result.IsSuccessful)
            {
                await RefreshRowsAsync(db, cancellationToken);
                SetStatus("Updates checked. The list is current.", Severity.Success);
                return;
            }

            var responses = result.FailedRequests.Values.ToArray();
            if (responses.Any(response => response.StatusCode == (int)HttpStatusCode.Unauthorized))
            {
                SetStatus("Shared updates aren't available right now. Your saved note remains on this device.", Severity.Warning);
            }
            else if (responses.Any(response => response.StatusCode == (int)HttpStatusCode.Forbidden))
            {
                SetStatus("You don't have access to these updates. Your saved note remains on this device.", Severity.Warning);
            }
            else
            {
                SetStatus("We couldn't check for updates. Your saved note remains on this device; try again.", Severity.Warning);
            }
        },
            "We couldn't check for updates. Your saved note remains on this device; try again.",
            "Checking shared updates…");
    }

    private async Task RunLocalOperationAsync(
        Func<CancellationToken, Task> operation,
        string failureMessage,
        string progressMessage,
        bool markLoadFailed = false)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _progressMessage = progressMessage;
        _loadFailed = false;
        try
        {
            await operation(_lifetime.Token);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            // Component disposal cancels outstanding local I/O without reporting fake success.
        }
        catch (Exception) when (!_lifetime.IsCancellationRequested)
        {
            if (markLoadFailed)
            {
                _loadFailed = true;
                _statusMessage = null;
            }
            else
            {
                SetStatus(failureMessage, Severity.Error);
            }
        }
        finally
        {
            _busy = false;
            _progressMessage = null;
        }
    }

    private async Task RefreshRowsAsync(SwiftAidOfflineDbContext db, CancellationToken cancellationToken)
    {
        _localRows = await db.SpikeRows
            .AsNoTracking()
            .Where(row => !row.Deleted && row.Id == SampleId && row.Value == SampleValue)
            .Take(MaximumRowsToDisplay)
            .ToListAsync(cancellationToken);
    }

    private void SetStatus(string message, Severity severity)
    {
        _statusMessage = message;
        _statusSeverity = severity;
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
