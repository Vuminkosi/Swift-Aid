@page "/monitoring"
@using SwiftAid.Contracts.Cases
@using SwiftAid.UI.Components.Cases
@using SwiftAid.Mobile.Services.Presentation
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject MobileMonitoringQueueClient MonitoringClient

<PageTitle>Monitoring | SwiftAid</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="workspace-page monitoring-page">
    <header class="mb-4">
        <MudText Typo="Typo.overline" Color="Color.Secondary">Workspace</MudText>
        <MudText Typo="Typo.h5" HtmlTag="h1">Monitoring</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Review open work for cases you can access. Overdue work is highlighted.</MudText>
    </header>
    <MudStack Spacing="4">
        <section aria-labelledby="monitoring-assigned-heading">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" id="monitoring-assigned-heading">Assigned to me</MudText>
            <MonitoringQueue Client="MonitoringClient" Scope="MonitoringQueueScope.Assigned" />
        </section>
        <section aria-labelledby="monitoring-open-heading">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" id="monitoring-open-heading">All open work</MudText>
            <MonitoringQueue Client="MonitoringClient" Scope="MonitoringQueueScope.Open" />
        </section>
    </MudStack>
</MudContainer>
