@page "/my-cases"
@using Microsoft.Extensions.DependencyInjection
@using SwiftAid.Client.Presentation
@using SwiftAid.UI.Components.Surfaces.Operations
@inject IServiceProvider ServiceProvider

<PageTitle>Cases | SwiftAid</PageTitle>

<MudContainer Fixed="true" Class="mobile-work-page">
    <OperationsCaseQueue Title="Cases"
                         Description="Cases your account may read."
                         State="_state"
                         Query="_viewQuery"
                         FilterOptions="_filterOptions"
                         Items="_items"
                         TotalCount="_totalCount"
                         StatusMessage="@_statusMessage"
                         OnQueryChanged="ChangeQueryAsync"
                         OnRetry="RefreshAsync" />
</MudContainer>

@code {
    private OperationsSurfaceState _state = OperationsSurfaceState.Loading;
    private OperationsCaseQueue.FilterRequestView _viewQuery = new(1, 25, null, null, null, null, null, null, null, null, null, true);
    private CaseWorkspaceQuery _query = new(new PageRequest(1, 25));
    private OperationsCaseQueue.FilterOptionsView? _filterOptions;
    private IReadOnlyList<OperationsCaseQueue.QueueViewRow> _items = Array.Empty<OperationsCaseQueue.QueueViewRow>();
    private int _totalCount;
    private string? _statusMessage;
    private long _loadGeneration;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ChangeQueryAsync(OperationsCaseQueue.FilterRequestView query)
    {
        _viewQuery = query;
        _query = new CaseWorkspaceQuery(
            new PageRequest(Math.Max(1, query.PageNumber), Math.Clamp(query.PageSize, 1, 100)),
            query.Search,
            query.Sector switch
            {
                OperationsCaseQueue.SectorKind.Human => CaseWorkspaceSector.Human,
                OperationsCaseQueue.SectorKind.Animal => CaseWorkspaceSector.Animal,
                _ => null
            },
            query.WorkflowKey,
            query.CountryCode,
            query.RegionKey,
            query.AssigneeKey,
            query.ReportedCategoryKey,
            query.UpdatedFromUtc,
            query.UpdatedToUtc,
            query.NewestFirst ? CaseWorkspaceSort.UpdatedNewestFirst : CaseWorkspaceSort.UpdatedOldestFirst);
        await LoadAsync();
    }

    private Task RefreshAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var generation = Interlocked.Increment(ref _loadGeneration);
        _state = OperationsSurfaceState.Loading;
        _statusMessage = null;
        StateHasChanged();

        try
        {
            var workspaceClient = ServiceProvider.GetService<ICaseWorkspaceClient>();
            if (workspaceClient is null)
            {
                _items = Array.Empty<OperationsCaseQueue.QueueViewRow>();
                _totalCount = 0;
                _filterOptions = null;
                _state = OperationsSurfaceState.Unavailable;
                _statusMessage = "The case list is not available here.";
                return;
            }

            var result = await workspaceClient.ListAsync(_query);
            if (generation != Volatile.Read(ref _loadGeneration))
            {
                return;
            }

            if (result.Succeeded && result.Value is { } page)
            {
                _items = page.Items.Select(ToViewRow).ToArray();
                _totalCount = page.TotalCount;
                _state = _items.Count == 0 ? OperationsSurfaceState.Empty : OperationsSurfaceState.Populated;
                _statusMessage = result.Message;

                try
                {
                    var options = await workspaceClient.GetFilterOptionsAsync();
                    if (generation == Volatile.Read(ref _loadGeneration))
                    {
                        _filterOptions = options.Succeeded && options.Value is { } availableOptions
                            ? ToViewOptions(availableOptions)
                            : null;
                    }
                }
                catch (Exception)
                {
                    if (generation == Volatile.Read(ref _loadGeneration))
                    {
                        _filterOptions = null;
                    }
                }

                return;
            }

            _items = Array.Empty<OperationsCaseQueue.QueueViewRow>();
            _totalCount = 0;
            _filterOptions = null;
            _state = result.Code switch
            {
                UiCapabilityResultCode.Denied => OperationsSurfaceState.Denied,
                UiCapabilityResultCode.Unavailable => OperationsSurfaceState.Unavailable,
                UiCapabilityResultCode.Retryable => OperationsSurfaceState.Offline,
                _ => OperationsSurfaceState.Error
            };
            _statusMessage = result.Message;
        }
        catch (HttpRequestException)
        {
            if (generation == Volatile.Read(ref _loadGeneration))
            {
                _items = Array.Empty<OperationsCaseQueue.QueueViewRow>();
                _totalCount = 0;
                _filterOptions = null;
                _state = OperationsSurfaceState.Offline;
                _statusMessage = "Check your connection and refresh the case list.";
            }
        }
        catch (Exception)
        {
            if (generation == Volatile.Read(ref _loadGeneration))
            {
                _items = Array.Empty<OperationsCaseQueue.QueueViewRow>();
                _totalCount = 0;
                _filterOptions = null;
                _state = OperationsSurfaceState.Error;
                _statusMessage = "The case list could not be loaded. Refresh to try again.";
            }
        }
    }

    private static OperationsCaseQueue.QueueViewRow ToViewRow(CaseWorkspaceRow row) => new(
        row.CaseId,
        row.PublicReference,
        row.Workflow,
        row.CountryLabel,
        row.Sector switch
        {
            CaseWorkspaceSector.Human => OperationsCaseQueue.SectorKind.Human,
            CaseWorkspaceSector.Animal => OperationsCaseQueue.SectorKind.Animal,
            _ => OperationsCaseQueue.SectorKind.Unknown
        },
        row.RegionLabel,
        row.AssigneeLabel,
        row.ReportedCategoryLabel,
        row.UpdatedAtUtc);

    private static OperationsCaseQueue.FilterOptionsView ToViewOptions(CaseWorkspaceFilterOptions options) => new(
        options.Sectors.Select(ToViewOption).ToArray(),
        options.Workflows.Select(ToViewOption).ToArray(),
        options.Countries.Select(ToViewOption).ToArray(),
        options.Regions.Select(ToViewOption).ToArray(),
        options.Assignees.Select(ToViewOption).ToArray(),
        options.ReportedCategories.Select(ToViewOption).ToArray(),
        options.Capabilities.Search,
        options.Capabilities.Sector,
        options.Capabilities.Workflow,
        options.Capabilities.Country,
        options.Capabilities.Region,
        options.Capabilities.Assignee,
        options.Capabilities.ReportedCategory,
        options.Capabilities.UpdatedDate);

    private static OperationsCaseQueue.FilterOptionView ToViewOption(CaseWorkspaceOption option) => new(option.Key, option.Label);
}
