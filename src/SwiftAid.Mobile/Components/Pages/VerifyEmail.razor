@page "/verify-email"
@implements IDisposable
@using SwiftAid.Client.Authentication
@using SwiftAid.Mobile.Services.Account
@using SwiftAid.Mobile.Services.Http
@using SwiftAid.Mobile.Services.Authentication
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation

<PageTitle>Verify account | SwiftAid</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small">
    <MudPaper Class="pa-4" Elevation="0">
        <MudText Typo="Typo.h5">Verify your account</MudText>
        <MudText Typo="Typo.body2">We sent a verification code to your email address.</MudText>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert">
                @_error
            </MudAlert>
        }
        @if (!string.IsNullOrWhiteSpace(_notice))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">
                @_notice
            </MudAlert>
        }

        <MudTextField T="string" Label="Verification code" @bind-Value="_code"
                      Variant="Variant.Outlined" Required="true" Disabled="@_busy"
                      InputType="InputType.Text" Immediate="true" MaxLength="6"
                      autocomplete="one-time-code" InputMode="InputMode.numeric"
                      aria-label="6-digit verification code" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   OnClick="ConfirmAsync" Disabled="@(!CanConfirm)"
                   Class="auth-cta">
            @(_busy ? "Verifying…" : "Verify")
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true"
                   OnClick="ResendAsync" Disabled="@(!CanResend)">
            @(ResendLabel)
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private string? _code;
    private bool _busy;
    private string? _error;
    private string? _notice;
    private int _resendCountdown;
    private CancellationTokenSource? _countdownLifetime;
    private bool _disposed;

    private HttpPasswordAuthClient AuthClient =>
        (HttpPasswordAuthClient?)ServiceProvider.GetService(typeof(HttpPasswordAuthClient))
        ?? CreateFallback();

    private HttpPasswordAuthClient CreateFallback()
    {
        var options = (NativeSessionHttpOptions?)ServiceProvider.GetService(typeof(NativeSessionHttpOptions));
        return new HttpPasswordAuthClient(
            CookieSessionHttpClient.Shared(options?.GatewayBaseAddress?.ToString()));
    }


    private Task RefreshShellAsync()
    {
        // Password sessions live in the gateway cookie jar; notify the shell
        // so the gate and overview refresh without an app restart.
        var session = (IMobileAuthenticationSession?)ServiceProvider.GetService(typeof(IMobileAuthenticationSession));
        return session is null ? Task.CompletedTask : session.RefreshAsync();
    }

    private bool CanConfirm => !_busy && !string.IsNullOrWhiteSpace(_code);

    private bool CanResend => !_busy && _resendCountdown <= 0;

    private string ResendLabel => _resendCountdown > 0
        ? $"Resend code ({_resendCountdown / 60:00}:{_resendCountdown % 60:00})"
        : "Didn't receive it? Resend code";

    private async Task ResendAsync()
    {
        _busy = true;
        _error = null;
        _notice = null;
        try
        {
            var result = await AuthClient.RequestEmailCodeAsync();
            if (result.Status == PasswordAuthStatus.Succeeded)
            {
                _notice = result.Message ?? "A verification code has been sent.";
                StartResendCountdown(result.RetryAfterSeconds);
            }
            else if (result.Status == PasswordAuthStatus.Throttled)
            {
                _error = result.Message ?? "Requesting a code failed. Please try again.";
                StartResendCountdown(result.RetryAfterSeconds);
            }
            else
            {
                _error = result.Message ?? "Requesting a code failed. Please try again.";
            }
        }
        catch (Exception)
        {
            _error = "Verification codes are temporarily unavailable.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartResendCountdown(int seconds)
    {
        StopResendCountdown();
        if (seconds <= 0 || _disposed)
        {
            return;
        }

        _resendCountdown = seconds;
        var lifetime = new CancellationTokenSource();
        _countdownLifetime = lifetime;
        _ = RunResendCountdownAsync(lifetime.Token);
    }

    private async Task RunResendCountdownAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (_resendCountdown > 0 && await timer.WaitForNextTickAsync(cancellationToken).ConfigureAwait(false))
            {
                _resendCountdown--;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopResendCountdown()
    {
        try
        {
            _countdownLifetime?.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }
        finally
        {
            _countdownLifetime?.Dispose();
            _countdownLifetime = null;
            _resendCountdown = 0;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        StopResendCountdown();
    }

    private async Task ConfirmAsync()
    {
        if (!CanConfirm)
        {
            return;
        }

        _busy = true;
        _error = null;
        _notice = null;
        try
        {
            var result = await AuthClient.ConfirmEmailCodeAsync(_code!.Trim());
            if (result.Status == PasswordAuthStatus.Succeeded)
            {
                await RefreshShellAsync();
                Navigation.NavigateTo("/account");
                return;
            }

            _error = result.Message ?? "The code is invalid or has expired.";
        }
        catch (Exception)
        {
            _error = "Verification is temporarily unavailable.";
        }
        finally
        {
            _busy = false;
        }
    }
}
