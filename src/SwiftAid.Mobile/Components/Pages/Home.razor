@page "/"

<PageTitle>SwiftAid | Community support</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mobile-start">
    <SwiftAidPageHeading Eyebrow="Community health support"
                         Title="Support that follows through."
                         Description="SwiftAid is being prepared for private human and animal concern reporting and accountable follow-through."
                         HeadingId="start-heading" />

    <MudPaper Class="status-card" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Size="Size.Medium" />
            <MudText Typo="Typo.h6" HtmlTag="h2">Current availability</MudText>
        </MudStack>
        <SwiftAidBodyText>
            Public intake and offline capture are not available in this build. This app cannot submit or save a report.
        </SwiftAidBodyText>
    </MudPaper>

    <SwiftAidServiceBoundaryNotice />
</MudContainer>
