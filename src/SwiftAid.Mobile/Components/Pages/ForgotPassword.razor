@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@using SwiftAid.Client.Authentication
@using SwiftAid.Mobile.Services.Account
@using SwiftAid.Mobile.Services.Http
@using SwiftAid.UI.Components.Surfaces.Public
@inject IServiceProvider ServiceProvider

<PageTitle>Forgot password | SwiftAid</PageTitle>

<div class="mobile-auth-page">
    <AccountEntrySurface>
        @if (_requestAccepted)
        {
            <PasswordResetRequestedSurface IsBusy="@_busy"
                                           ErrorMessage="@_error"
                                           OnResend="ResendAsync" />
        }
        else
        {
        <MudPaper Class="mobile-auth-panel" Elevation="0">
            <SwiftAidPageHeading Eyebrow="Your SwiftAid account"
                                 Title="Forgot your password?"
                                 Description="Enter your registered email to request password reset instructions."
                                 HeadingId="mobile-forgot-password-heading" />

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert" aria-atomic="true">
                @_error
            </MudAlert>
        }

            <EditForm Model="_form" OnSubmit="SubmitAsync">
                <DataAnnotationsValidator />
                <div class="mobile-auth-password" role="group" aria-label="Request password reset">
                    <MudTextField T="string" Label="Email address" @bind-Value="_form.Email"
                                  For="@(() => _form.Email)" Variant="Variant.Outlined"
                                  Required="true" Disabled="@_busy" InputType="InputType.Email"
                                  Immediate="true" MaxLength="256" autocomplete="email"
                                  aria-label="Email address" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                               FullWidth="true" Disabled="@(!CanSubmit)" Class="auth-cta"
                               StartIcon="@Icons.Material.Filled.MarkEmailRead">
                        @(_busy ? "Sending…" : "Send reset link")
                    </MudButton>
                </div>
            </EditForm>

            <MudDivider Class="mobile-auth-divider" />
            <nav aria-label="Legal information">
                <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                    <MudLink Href="/privacy">Privacy</MudLink>
                    <MudLink Href="/terms">Terms</MudLink>
                </MudStack>
            </nav>
            <MudButton Href="/sign-in" Variant="Variant.Text" Color="Color.Primary" FullWidth="true">
                Back to sign in
            </MudButton>
        </MudPaper>
        }
    </AccountEntrySurface>
</div>

@code {
    private readonly ResetRequestForm _form = new();
    private bool _busy;
    private bool _requestAccepted;
    private string? _error;

    private HttpPasswordAuthClient AuthClient =>
        (HttpPasswordAuthClient?)ServiceProvider.GetService(typeof(HttpPasswordAuthClient))
        ?? new HttpPasswordAuthClient(CookieSessionHttpClient.Shared(
            ((NativeSessionHttpOptions?)ServiceProvider.GetService(typeof(NativeSessionHttpOptions)))
            ?.GatewayBaseAddress?.ToString()));

    private bool CanSubmit => !_busy && !string.IsNullOrWhiteSpace(_form.Email);

    private Task SubmitAsync(EditContext editContext) => SubmitRequestAsync(editContext);

    private Task ResendAsync() => SubmitRequestAsync(new EditContext(_form));

    private async Task SubmitRequestAsync(EditContext editContext)
    {
        if (!CanSubmit || !editContext.Validate())
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var outcome = await AuthClient.RequestPasswordResetAsync(_form.Email!.Trim());
            if (outcome.Status == PasswordAuthStatus.Succeeded)
            {
                _requestAccepted = true;
            }
            else
            {
                _error = outcome.Message ?? "Password reset is temporarily unavailable. Try again.";
            }
        }
        catch (Exception)
        {
            _error = "Password reset is temporarily unavailable. Check your connection and try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ResetRequestForm
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [StringLength(256)]
        public string? Email { get; set; }
    }
}
