@page "/sessions"
@page "/sessions/calendar"
@using SwiftAid.Client.Presentation
@using SwiftAid.Client.Presentation.PublicWorkflows
@using SwiftAid.Contracts.Sessions
@using SwiftAid.UI.Components.Surfaces.Public
@inject IPublicCommunitySessionClient SessionClient
@inject ISubscriptionClient SubscriptionClient
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Community sessions | SwiftAid</PageTitle>

<PublicSessionsSurface @key="(RequestedSessionId, IsCalendarRoute, InitialRemindersView)" Sessions="_sessions"
                       InitialSessionId="RequestedSessionId"
                       InitialRemindersView="InitialRemindersView"
                       InitialCalendarView="@(IsCalendarRoute && RequestedSessionId is null)"
                       Loading="_loading"
                       ErrorMessage="@_listError"
                       SubscriptionsHref="/notifications"
                       OnRetry="LoadAsync"
                       PublicSessionBasePath="@CalendarBasePath"
                       QuerySessionsAsync="@(RequestedSessionId is null ? QuerySessionsAsync : null)"
                       LoadInvitationTextAsync="LoadInvitationAsync"
                       ShareTextAsync="ShareAsync"
                       LoadSubscriptionStateAsync="LoadSubscriptionStateAsync"
                       ExecuteSubscriptionActionAsync="ExecuteSubscriptionActionAsync"
                       OnRequestSignIn="RequestSignInAsync" />

@code {
    [SupplyParameterFromQuery(Name = "sessionId")]
    private Guid? RequestedSessionId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")]
    private string? RequestedTab { get; set; }
    private bool InitialRemindersView => RequestedSessionId is not null &&
        string.Equals(RequestedTab, "reminders", StringComparison.OrdinalIgnoreCase);
    private bool IsCalendarRoute => string.Equals(Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.TrimEnd('/'),
        "/sessions/calendar", StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<PublicSessionView> _sessions = Array.Empty<PublicSessionView>();
    private bool _loading = true;
    private string? _listError;
    private bool _requestLoaded;
    private Guid? _loadedRequestId;
    private long _listGeneration;
    private string? CalendarBasePath { get; set; }

    protected override void OnInitialized()
    {
        using var client = HttpClientFactory.CreateClient("SwiftAid.NotificationApi");
        CalendarBasePath = client.BaseAddress is { } baseAddress
            ? new Uri(baseAddress, "public/v1/sessions").AbsoluteUri
            : null;
    }

    private async Task<PublicSessionPage?> QuerySessionsAsync(PublicSessionQuery query)
    {
        var result = await SessionClient.QueryPublicAsync(query);
        return result.Succeeded ? result.Value : null;
    }

    protected override Task OnParametersSetAsync()
    {
        if (_requestLoaded && _loadedRequestId == RequestedSessionId)
            return Task.CompletedTask;
        _requestLoaded = true;
        _loadedRequestId = RequestedSessionId;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        var generation = ++_listGeneration;
        _loading = true;
        _listError = null;
        try
        {
            if (RequestedSessionId is { } sessionId)
            {
                var detail = await SessionClient.GetPublicAsync(sessionId);
                if (generation != _listGeneration) return;
                _sessions = detail.Succeeded && detail.Value is { } session ? [session] : [];
                if (!detail.Succeeded)
                    _listError = "This session is temporarily unavailable. Try again.";
                else if (detail.Value is null)
                    _listError = "This session is not available.";
                return;
            }
            var result = await SessionClient.ListPublicAsync();
            if (generation != _listGeneration) return;
            if (result.Succeeded && result.Value is { } sessions)
            {
                _sessions = sessions;
            }
            else
            {
                _sessions = Array.Empty<PublicSessionView>();
                _listError = result.Message ?? result.Metadata.Notice ??
                    "Published sessions are temporarily unavailable. Check your connection and try again.";
            }
        }
        catch (OperationCanceledException)
        {
            if (generation != _listGeneration) return;
            _sessions = Array.Empty<PublicSessionView>();
            _listError = "Loading sessions was cancelled.";
        }
        catch (Exception)
        {
            if (generation != _listGeneration) return;
            _sessions = Array.Empty<PublicSessionView>();
            _listError = "Published sessions are temporarily unavailable. Check your connection and try again.";
        }
        finally
        {
            if (generation == _listGeneration) _loading = false;
        }
    }

    private async Task<string?> LoadInvitationAsync(Guid sessionId)
    {
        try
        {
            var result = await SessionClient.GetInvitationTextAsync(sessionId);
            return result.Succeeded ? result.Value : null;
        }
        catch (Exception)
        {
            return null;
        }
    }

    private async Task<PublicSessionsSurface.SessionSubscriptionPanelState?> LoadSubscriptionStateAsync(Guid sessionId)
    {
        var subscriptionTask = SubscriptionClient.GetAsync(sessionId);
        var optionsTask = SubscriptionClient.GetSubscriptionOptionsAsync(sessionId);
        try
        {
            await Task.WhenAll(subscriptionTask, optionsTask);
            var subscription = await subscriptionTask;
            var options = await optionsTask;
            var status = subscription.Code switch
            {
                UiCapabilityResultCode.Denied => PublicSessionsSurface.SessionSubscriptionStatus.RequiresAuthentication,
                UiCapabilityResultCode.Success when subscription.Value?.Status == SubscriptionStatus.Active => PublicSessionsSurface.SessionSubscriptionStatus.Active,
                UiCapabilityResultCode.Success => PublicSessionsSurface.SessionSubscriptionStatus.Unsubscribed,
                _ => PublicSessionsSurface.SessionSubscriptionStatus.Unavailable
            };

            return new PublicSessionsSurface.SessionSubscriptionPanelState(
                sessionId,
                status,
                subscription.Value?.Version ?? options.Value?.Version ?? 0,
                options.Succeeded && options.Value is { } value ? ToSurfaceOptions(value) : null,
                status == PublicSessionsSurface.SessionSubscriptionStatus.Unavailable
                    ? subscription.Message ?? subscription.Metadata.Notice ?? "Reminder status is unavailable."
                    : options.Succeeded ? subscription.Message : options.Message ?? options.Metadata.Notice,
                IsError: status == PublicSessionsSurface.SessionSubscriptionStatus.Unavailable ||
                    !options.Succeeded && status != PublicSessionsSurface.SessionSubscriptionStatus.RequiresAuthentication);
        }
        catch (OperationCanceledException)
        {
            return ErrorSubscriptionState(sessionId, "Loading reminder status was cancelled.");
        }
        catch (Exception)
        {
            return ErrorSubscriptionState(sessionId, "Reminder status is unavailable. Try again.");
        }
    }

    private async Task<PublicSessionsSurface.SessionSubscriptionPanelState?> ExecuteSubscriptionActionAsync(
        PublicSessionsSurface.SessionSubscriptionAction action)
    {
        try
        {
            UiCapabilityResult<SubscriptionView> result;
            if (action.Kind == PublicSessionsSurface.SessionSubscriptionActionKind.Subscribe)
            {
                var currentOptions = await SubscriptionClient.GetSubscriptionOptionsAsync(action.SessionId);
                if (!currentOptions.Succeeded || currentOptions.Value is not { IsCurrent: true } options ||
                    action.ConsentReference is null || action.Channel is null ||
                    !string.Equals(options.ConsentReference, action.ConsentReference, StringComparison.Ordinal) ||
                    options.Version != action.ExpectedVersion ||
                    !options.Channels.Any(channel => channel == ToClientChannel(action.Channel.Value)))
                {
                    return await LoadSubscriptionStateAsync(action.SessionId) is { } stale
                        ? stale with { IsError = true, Message = "Reminder terms changed. Refresh and review the current options." }
                        : ErrorSubscriptionState(action.SessionId, "Reminder terms changed. Refresh and review the current options.");
                }

                result = await SubscriptionClient.SubscribeAsync(new SubscriptionRequest(
                    action.SessionId,
                    options.ConsentReference,
                    action.ExpectedVersion,
                    ToClientChannel(action.Channel.Value)));
            }
            else
            {
                result = await SubscriptionClient.UnsubscribeAsync(action.SessionId, action.ExpectedVersion);
            }

            var updatedState = await LoadSubscriptionStateAsync(action.SessionId);
            if (updatedState is null) return null;
            return result.Succeeded
                ? updatedState with { Message = result.Message, IsError = false }
                : updatedState with { Message = result.Message ?? result.Metadata.Notice ?? "Reminder preference could not be updated.", IsError = true };
        }
        catch (OperationCanceledException)
        {
            return ErrorSubscriptionState(action.SessionId, "Updating the reminder choice was cancelled.");
        }
        catch (Exception)
        {
            return ErrorSubscriptionState(action.SessionId, "The reminder choice could not be updated. Try again.");
        }
    }

    private Task RequestSignInAsync(Guid sessionId)
    {
        var returnUrl = $"/sessions?sessionId={sessionId:D}&tab=reminders";
        Navigation.NavigateTo($"/sign-in?returnUrl={Uri.EscapeDataString(returnUrl)}");
        return Task.CompletedTask;
    }

    private static PublicSessionsSurface.SessionSubscriptionOptions ToSurfaceOptions(SubscriptionOptions options) => new(
        options.SessionId,
        options.ConsentReference,
        options.Version,
        options.ConsentText,
        options.Channels.Select(ToSurfaceChannel).ToArray(),
        options.IsCurrent);

    private static PublicSessionsSurface.SessionReminderChannel ToSurfaceChannel(SubscriptionChannel channel) => channel switch
    {
        SubscriptionChannel.Email => PublicSessionsSurface.SessionReminderChannel.Email,
        SubscriptionChannel.MobilePush => PublicSessionsSurface.SessionReminderChannel.MobilePush,
        _ => throw new ArgumentOutOfRangeException(nameof(channel))
    };

    private static SubscriptionChannel ToClientChannel(PublicSessionsSurface.SessionReminderChannel channel) => channel switch
    {
        PublicSessionsSurface.SessionReminderChannel.Email => SubscriptionChannel.Email,
        PublicSessionsSurface.SessionReminderChannel.MobilePush => SubscriptionChannel.MobilePush,
        _ => throw new ArgumentOutOfRangeException(nameof(channel))
    };

    private static PublicSessionsSurface.SessionSubscriptionPanelState ErrorSubscriptionState(Guid sessionId, string message) => new(
        sessionId,
        PublicSessionsSurface.SessionSubscriptionStatus.Unavailable,
        0,
        null,
        message,
        IsError: true);

    private static Task ShareAsync(string text) =>
        Share.Default.RequestAsync(new ShareTextRequest(text, "Community session invitation"));
}
