@page "/surveillance"
@using SwiftAid.Client.Presentation
@using SwiftAid.UI.Components.Surfaces.Operations
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IMapAggregateClient MapAggregateClient
@inject ISurveillanceMapDetailsClient MapDetailsClient
@inject SurveillancePlaceLookupClient PlaceLookup

<PageTitle>Surveillance | SwiftAid</PageTitle>
<OperationsMapSurface Title="Regional activity"
                      Eyebrow="Operations"
                      Description="Explore authorized report totals by place and review available signals. Map markers use public place references, not precise case locations."
                      State="_state" Areas="_areas" Details="_details" DetailsLoading="_detailsLoading" Focus="_focus" FocusCountry="@NullIfEmpty(_regionCode)"
                      UpdatedAtUtc="_updatedAtUtc" ContractVersion="_contractVersion"
                      PeriodLabel="@PeriodDescription" StatusMessage="@_message"
                      OnRetry="LoadAsync">
    <FilterContent>
        @if (_placeNotice is not null)
        {
            <MudText Typo="Typo.body2" role="status">@_placeNotice</MudText>
        }
        @if (_details is not null)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">Mapped reports and signals cover the workspace selected in your account.</MudText>
        }
        <MudTextField T="string" Label="Country or region code" Value="@_regionCode"
                      ValueChanged="RegionChangedAsync" Placeholder="All areas" Clearable="true" />
        <MudSelect T="MapAggregatePeriod" Label="Time window" Value="_period"
                   ValueChanged="PeriodChangedAsync" Dense="true">
            <MudSelectItem Value="@ThirtyDays">Last 30 days</MudSelectItem>
            <MudSelectItem Value="@NinetyDays">Last 90 days</MudSelectItem>
        </MudSelect>
    </FilterContent>
</OperationsMapSurface>

@code {
    private static readonly MapAggregatePeriod ThirtyDays = MapAggregatePeriod.Days30;
    private static readonly MapAggregatePeriod NinetyDays = MapAggregatePeriod.Days90;

    private string _regionCode = string.Empty;
    private MapAggregatePeriod _period = MapAggregatePeriod.Days30;
    private IReadOnlyList<OperationsMapSurface.AreaAggregateView> _areas = Array.Empty<OperationsMapSurface.AreaAggregateView>();
    private OperationsSurfaceState _state = OperationsSurfaceState.Loading;
    private DateTimeOffset? _updatedAtUtc;
    private string _contractVersion = "Unknown";
    private string? _message;
    private SwiftAid.Contracts.Surveillance.SurveillanceMapDetails? _details;
    private bool _detailsLoading;
    private long _requestGeneration;
    private long _locationGeneration;
    private OperationsMapSurface.MapFocus? _focus;
    private string? _placeNotice;

    [SupplyParameterFromQuery(Name = "country")] public string? Country { get; set; }
    [SupplyParameterFromQuery(Name = "place")] public string? Place { get; set; }
    [SupplyParameterFromQuery(Name = "region")] public string? Region { get; set; }
    [SupplyParameterFromQuery(Name = "area")] public string? Area { get; set; }
    private string? _loadedLocation;

    private string PeriodDescription => _period == MapAggregatePeriod.Days90 ? "the last 90 days (by record creation)" : "the last 30 days (by record creation)";

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Country}|{Place}|{Region}|{Area}";
        if (key == _loadedLocation) return;
        _loadedLocation = key;
        var generation = ++_locationGeneration;
        _focus = null;
        _placeNotice = null;
        _regionCode = Country is { Length: 2 } && Country.All(char.IsAsciiLetter) ? Country.ToUpperInvariant() : "SZ";
        await LoadAsync();
        if (generation != _locationGeneration || _regionCode.Length == 0 ||
            string.IsNullOrWhiteSpace(Area) && string.IsNullOrWhiteSpace(Region)) return;
        var place = await PlaceLookup.FindAsync(_regionCode, Place, Region, Area);
        if (generation != _locationGeneration) return;
        if (place is { Latitude: { } latitude, Longitude: { } longitude })
        {
            _focus = new(latitude, longitude, place.Name);
            _placeNotice = $"{Region ?? place.CountryName} | {place.Name}. Marker shows the public place reference, not a case location. Totals remain at country level.";
        }
        else
        {
            _placeNotice = "The place reference could not be resolved. Country totals are shown below.";
        }
    }

    private Task RegionChangedAsync(string value)
    {
        _locationGeneration++;
        _focus = null;
        _placeNotice = null;
        _regionCode = value;
        return LoadAsync();
    }

    private Task PeriodChangedAsync(MapAggregatePeriod value)
    {
        _period = value;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        var requestGeneration = ++_requestGeneration;
        _state = OperationsSurfaceState.Loading;
        _areas = Array.Empty<OperationsMapSurface.AreaAggregateView>();
        _updatedAtUtc = null;
        _message = null;
        _details = null;
        _detailsLoading = true;

        try
        {
            var query = new MapAggregateQuery(
                new PageRequest(1, 100),
                NullIfEmpty(_regionCode),
                _period);
            var result = await MapAggregateClient.GetAsync(query);
            if (requestGeneration != _requestGeneration)
            {
                return;
            }

            _contractVersion = result.Metadata.ContractVersion;
            _message = null;

            if (!result.Succeeded)
            {
                _state = result.Code switch
                {
                    UiCapabilityResultCode.Denied => OperationsSurfaceState.Denied,
                    UiCapabilityResultCode.Unavailable => OperationsSurfaceState.Unavailable,
                    UiCapabilityResultCode.Cancelled or UiCapabilityResultCode.Retryable => OperationsSurfaceState.Offline,
                    _ => OperationsSurfaceState.Error
                };
                return;
            }

            if (result.Value is not { IsValid: true } aggregatePage)
            {
                _state = OperationsSurfaceState.Error;
                _message = "Map totals could not be checked. Refresh to try again.";
                return;
            }

            _areas = aggregatePage.Areas.Items.Select(ToView).ToArray();
            _updatedAtUtc = result.Metadata.UpdatedAtUtc;
            _state = _areas.Count == 0 ? OperationsSurfaceState.Empty : OperationsSurfaceState.Populated;
            if (_regionCode is { Length: 2 } && _regionCode.All(char.IsAsciiLetter))
            {
                await InvokeAsync(StateHasChanged);
                try
                {
                    var details = await MapDetailsClient.GetAsync(_regionCode, _period);
                    if (requestGeneration != _requestGeneration) return;
                    if (details.Code == UiCapabilityResultCode.Denied)
                    {
                        _areas = Array.Empty<OperationsMapSurface.AreaAggregateView>();
                        _updatedAtUtc = null;
                        _state = OperationsSurfaceState.Denied;
                    }
                    else
                    {
                        _details = details.Succeeded ? details.Value : null;
                    }
                }
                catch (Exception)
                {
                    if (requestGeneration == _requestGeneration)
                        _details = null;
                }
            }
        }
        catch (Exception)
        {
            if (requestGeneration != _requestGeneration)
            {
                return;
            }

            _areas = Array.Empty<OperationsMapSurface.AreaAggregateView>();
            _state = OperationsSurfaceState.Error;
            _message = "Map totals could not be loaded. Try again when your connection is available.";
        }
        finally
        {
            if (requestGeneration == _requestGeneration)
            {
                _detailsLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private static OperationsMapSurface.AreaAggregateView ToView(MapAreaAggregate area) => new(
        area.AreaCode,
        area.AreaLabel,
        area.Precision switch
        {
            MapAggregateAreaPrecision.Country => OperationsMapSurface.AggregatePrecision.Country,
            MapAggregateAreaPrecision.Region => OperationsMapSurface.AggregatePrecision.Region,
            _ => OperationsMapSurface.AggregatePrecision.Region
        },
        area.HumanCount,
        area.AnimalCount,
        area.Denominator,
        area.IsSuppressed,
        area.SuppressionReason,
        area.AsOfUtc);

    private static string? NullIfEmpty(string value) => string.IsNullOrWhiteSpace(value) ? null : value;
}
