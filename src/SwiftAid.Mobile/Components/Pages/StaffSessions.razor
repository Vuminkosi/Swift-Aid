    private async Task LoadListAsync()
    {
        var generation = ++_listGeneration;
        _loadingList = true;
        ListError = null;
        try
        {
            if (RequestedSessionId is { } sessionId)
            {
                var detail = await PublicSessionClient.GetPublicAsync(sessionId);
                if (generation != _listGeneration) return;
                _sessions = detail.Succeeded && detail.Value is { } session ? [session] : [];
                if (!detail.Succeeded)
                    ListError = "This session is temporarily unavailable. Try again.";
                else if (detail.Value is null)
                    ListError = "This session is not available.";
                return;
            }
            var result = await PublicSessionClient.ListPublicAsync(null);
            if (generation != _listGeneration) return;
            if (result.Code == UiCapabilityResultCode.Success && result.Value is not null)
            {
                _sessions = result.Value;
                return;
            }

            _sessions = Array.Empty<PublicSessionView>();
            ListError = result.Code switch
            {
                UiCapabilityResultCode.Denied => "Published sessions are not available for this request.",
                UiCapabilityResultCode.Cancelled => "Loading sessions was cancelled. Try again when ready.",
                UiCapabilityResultCode.Retryable => "Published sessions are temporarily unavailable. Check your connection and try again.",
                _ => "Published sessions are not connected in this environment."
            };
        }
        catch (Exception)
        {
            if (generation != _listGeneration) return;
            _sessions = Array.Empty<PublicSessionView>();
            ListError = "Published sessions are temporarily unavailable. Check your connection and try again.";
        }
        finally
        {
            if (generation == _listGeneration) _loadingList = false;
        }
    }

