    private void DismissConflictProposal() => _conflictProposal = null;

    private async Task RecoverConflictAsync(SessionUpdateSubmission proposal, string? originalActorId, bool outcomeUnknown = false)
    {
        var identityEpoch = Volatile.Read(ref _identityEpoch);
        if (string.IsNullOrWhiteSpace(originalActorId) || !string.Equals(_actorId, originalActorId, StringComparison.Ordinal))
            return;

        if (outcomeUnknown)
        {
            _deferredProposal = proposal;
            _deferredProposalActor = originalActorId;
            _deferredNotSubmitted = false;
        }

        await LoadStaffSessionAsync(proposal.SessionId);
        if (IsCurrentIdentityEpoch(identityEpoch) && string.Equals(_actorId, originalActorId, StringComparison.Ordinal) &&
            _editingSessionId == proposal.SessionId && (outcomeUnknown || _editingVersion != proposal.ExpectedVersion) &&
            _staffView is not null && _managementCapabilities.CanEdit && CanRenderEditor(_managementCapabilities))
        {
            _conflictProposal = proposal;
            _proposalOutcomeUnknown = outcomeUnknown;
            _proposalNotSubmitted = false;
            if (outcomeUnknown) ClearDeferredProposal();
            _serverError = outcomeUnknown
                ? "The update outcome could not be confirmed. Compare your proposal with the current version below."
                : "The session changed before your update was saved. Compare your proposal with the current version below.";
        }
    }

    private async Task RunCommandAsync(SessionCommand command, SessionUpdateSubmission? proposal = null)
    {
        _commandNotice = null;
        if (command is UpdateSessionCommand && _deferredProposal is not null)
        {
            _serverError = "Check access to the unconfirmed update or discard its temporary copy before submitting another update.";
            return;
        }
        if (command is CreateSessionDraftCommand && _deferredCreate is not null)
        {
            _serverError = "Restore or discard the temporary draft before submitting another session.";
            return;
        }
        var isCreate = command is CreateSessionDraftCommand;
        var originalActorId = _actorId;
        var identityEpoch = Volatile.Read(ref _identityEpoch);
        var accessAvailable = await RefreshStaffAccessAsync(isCreate ? null : command.SessionId,
            isCreate ? null : command.ExpectedVersion);
        if (!IsCurrentIdentityEpoch(identityEpoch) ||
            _actorId is not null && !string.Equals(originalActorId, _actorId, StringComparison.Ordinal)) return;
        if (!accessAvailable || !CanPerformCommand(command))
        {
            if (proposal is not null && !string.IsNullOrWhiteSpace(originalActorId) &&
                (_actorId is null || string.Equals(_actorId, originalActorId, StringComparison.Ordinal)))
            {
                _deferredProposal = proposal;
                _deferredProposalActor = originalActorId;
                _deferredNotSubmitted = true;
            }
            if (command is CreateSessionDraftCommand create && !string.IsNullOrWhiteSpace(originalActorId) &&
                (_actorId is null || string.Equals(_actorId, originalActorId, StringComparison.Ordinal)))
            {
                RetainCreate(create, originalActorId, outcomeUnknown: false);
            }
            ClearEditorState();
            _serverError ??= "Session management is unavailable for this account.";
            return;
        }

        _busy = true;
        _serverError = null;
        var commandAccepted = false;
        if (command is CreateSessionDraftCommand pendingCreate && !string.IsNullOrWhiteSpace(originalActorId))
            RetainCreate(pendingCreate, originalActorId, outcomeUnknown: true);
        if (proposal is not null && !string.IsNullOrWhiteSpace(originalActorId))
        {
            _deferredProposal = proposal;
            _deferredProposalActor = originalActorId;
            _deferredNotSubmitted = false;
        }
        try
        {
            var outcome = await StaffSessionEditor.ExecuteAsync(command);
            if (!IsCurrentIdentityEpoch(identityEpoch) || !string.Equals(originalActorId, _actorId, StringComparison.Ordinal)) return;
            if (outcome.Code == UiCapabilityResultCode.Success && outcome.Metadata.IsAvailable && outcome.Value is { } result)
            {
                if (result.SessionId != command.SessionId || result.Version <= command.ExpectedVersion || string.IsNullOrWhiteSpace(result.Status))
                    throw new InvalidOperationException("The session command result could not be verified.");
                commandAccepted = true;
                if (command is CreateSessionDraftCommand) ClearDeferredCreate();
                if (proposal is not null) ClearDeferredProposal();
                if (_retainedWorkingCopy is { } retained && retained.ActorId == originalActorId &&
                    retained.SessionId == (isCreate ? null : command.SessionId)) DiscardRetainedWorkingCopy();
                _commandNotice = "The session change was saved.";
                _conflictProposal = null;
                await LoadStaffSessionAsync(result.SessionId);
                if (!IsCurrentIdentityEpoch(identityEpoch)) return;
                if (_actorId is not null && !string.Equals(_actorId, originalActorId, StringComparison.Ordinal))
                {
                    _commandNotice = null;
                    return;
                }
                if (_staffView?.SessionId != result.SessionId || _staffView.Version < result.Version)
                    _commandNotice = "The session change was saved, but current details could not be refreshed. Check access and reopen the session.";
                await LoadListAsync();
            }
            else
            {
                if (command is CreateSessionDraftCommand unconfirmedCreate &&
                    (outcome.Code is UiCapabilityResultCode.Success or UiCapabilityResultCode.Unavailable or UiCapabilityResultCode.Retryable or UiCapabilityResultCode.Cancelled or UiCapabilityResultCode.Conflict or UiCapabilityResultCode.Denied) &&
                    !string.IsNullOrWhiteSpace(originalActorId) && string.Equals(_actorId, originalActorId, StringComparison.Ordinal))
                {
                    RetainCreate(unconfirmedCreate, originalActorId, outcomeUnknown: true);
                    ClearEditorState();
                    _serverError = "The session outcome could not be confirmed. Check it before creating another.";
                    return;
                }
                if (outcome.Code == UiCapabilityResultCode.Conflict && proposal is not null)
                {
                    _deferredNotSubmitted = true;
                    await RecoverConflictAsync(proposal, originalActorId);
                    return;
                }
                if (outcome.Code == UiCapabilityResultCode.InvalidRequest)
                {
                    if (command is CreateSessionDraftCommand) ClearDeferredCreate();
                    if (proposal is not null) ClearDeferredProposal();
                }
                _serverError = outcome.Message ?? (outcome.Code == UiCapabilityResultCode.Conflict
                    ? "The session changed. Reload it and try again."
                    : "The change could not be recorded. Please try again.");
                if (outcome.Code is UiCapabilityResultCode.Conflict or UiCapabilityResultCode.Denied or UiCapabilityResultCode.Unavailable)
                {
                    ClearEditorState();
                    _managementCapabilities = SessionManagementPresentation.Unavailable(outcome.Message ?? outcome.Metadata.Notice);
                    _canManageSessions = false;
                    if (outcome.Code == UiCapabilityResultCode.Unavailable && proposal is not null)
                        await RecoverConflictAsync(proposal, originalActorId, outcomeUnknown: true);
                }
            }
        }
        catch (Exception)
        {
            if (!IsCurrentIdentityEpoch(identityEpoch)) return;
            ClearEditorState();
            if (commandAccepted)
            {
                _commandNotice = "The session change was saved, but current details could not be refreshed. Check access and reopen the session.";
                return;
            }
            _managementCapabilities = SessionManagementPresentation.Unavailable(
                "The session change could not be confirmed.");
            _canManageSessions = false;
            _serverError = "The session change could not be confirmed. Reload the session before trying again.";
            if (command is CreateSessionDraftCommand unconfirmedCreate && !string.IsNullOrWhiteSpace(originalActorId) &&
                string.Equals(_actorId, originalActorId, StringComparison.Ordinal))
                RetainCreate(unconfirmedCreate, originalActorId, outcomeUnknown: true);
            if (proposal is not null)
                await RecoverConflictAsync(proposal, originalActorId, outcomeUnknown: true);
        }
        finally
        {
            if (IsCurrentIdentityEpoch(identityEpoch)) _busy = false;
        }
    }

    private bool HasCurrentManagementAccess() =>
        _canManageSessions && !string.IsNullOrWhiteSpace(_actorId) &&
        _managementCapabilities is { IsCurrent: true };

    private bool CanPerformCommand(SessionCommand command) => command switch
    {
        CreateSessionDraftCommand => HasCurrentManagementAccess() &&
            _managementCapabilities is { CanCreate: true, SessionId: null, Version: null },
        UpdateSessionCommand => HasSessionCapability(command, capabilities => capabilities.CanEdit),
        ReviewSessionCommand => HasSessionCapability(command, capabilities => capabilities.CanReview),
        ScheduleSessionCommand => HasSessionCapability(command, capabilities => capabilities.CanSchedule),
        CancelSessionCommand => HasSessionCapability(command, capabilities => capabilities.CanCancel),
        CompleteSessionCommand => HasSessionCapability(command, capabilities => capabilities.CanComplete),
        _ => false
    };

    private bool HasSessionCapability(
        SessionCommand command,
        Func<SessionManagementPresentation, bool> capability)
    {
        var current = _managementCapabilities;
        return HasCurrentManagementAccess() && command.ExpectedVersion > 0 &&
            current is not null && current.SessionId == command.SessionId &&
            current.Version == command.ExpectedVersion && capability(current);
    }

    private Task ShareAsync(string text) => SessionPlatform.ShareAsync(text);
    private Task<bool> OpenCalendarAsync(Guid sessionId) => SessionPlatform.OpenCalendarAsync(sessionId);
}
