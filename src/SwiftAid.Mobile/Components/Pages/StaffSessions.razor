        var epoch = Volatile.Read(ref _identityEpoch);
        await LoadStaffSessionAsync(sessionId);
        if (IsCurrentIdentityEpoch(epoch) && string.Equals(copy.ActorId, _actorId, StringComparison.Ordinal))
            _retainedAccessVerified = _staffView?.SessionId == sessionId && _managementCapabilities.IsAvailable;
    }

    private void OnAuthenticationStateChanged(object? sender, EventArgs args)
    {
        var authEpoch = Interlocked.Increment(ref _identityEpoch);
        Interlocked.Increment(ref _accessGeneration);
        Interlocked.Increment(ref _capabilityRequestGeneration);
        Interlocked.Increment(ref _staffLoadGeneration);
        _ = InvokeAsync(async () =>
        {
            if (!IsCurrentIdentityEpoch(authEpoch)) return;
            CapturePendingWorkingCopy();
            RetainConflictProposal(_actorId);
            _retainedAccessVerified = false;
            _retainedCanRestore = false;
            ClearEditorState();
            _actorId = null;
            _commandNotice = null;
            if (!IsCurrentIdentityEpoch(authEpoch)) return;
            await RefreshStaffAccessAsync(_editingSessionId, _editingSessionId is null ? null : _editingVersion);
            if (!IsCurrentIdentityEpoch(authEpoch)) return;
            if (_canManageSessions && RequestedSessionId is { } id && id != Guid.Empty)
            {
                await LoadStaffSessionAsync(id);
            }
            StateHasChanged();
        });
    }

