    private async Task RetryDeferredCreateAsync()
    {
        if (_busy || !_deferredCreateOutcomeUnknown || _deferredCreateSessionId is not { } id ||
            _deferredCreateActor is not { } actor) return;
        if (HasPendingEditorInput())
        {
            _commandNotice = "Finish or discard your current session edits before checking the unconfirmed session.";
            return;
        }
        var identityEpoch = Volatile.Read(ref _identityEpoch);
        await LoadStaffSessionAsync(id);
        if (!IsCurrentIdentityEpoch(identityEpoch)) return;
        if (_actorId is null)
        {
            _commandNotice = "Access could not be checked. The session outcome is still unconfirmed.";
            return;
        }
        if (!string.Equals(_actorId, actor, StringComparison.Ordinal)) return;
        if (_staffView is { } session && session.SessionId == id &&
            string.Equals(session.CreatedByActorId, actor, StringComparison.Ordinal) && CanRenderEditor(_managementCapabilities))
        {
            if (_retainedWorkingCopy is { SessionId: null } retained && retained.ActorId == actor)
            {
                _confirmedRetainedCreateId = id;
                _retainedAccessVerified = true;
                _retainedCanRestore = false;
            }
            ClearDeferredCreate();
            Interlocked.Increment(ref _staffEditorOpenRequest);
            _commandNotice = $"The session was found. Its reference is {id:D}.";
