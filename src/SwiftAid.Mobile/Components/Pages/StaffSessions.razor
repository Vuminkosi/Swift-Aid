    private async Task HandleCreateAsync(SessionCreateSubmission submission, long generation)
    {
        if (generation != Volatile.Read(ref _editorGeneration)) return;
        if (_busy) return;
        var identityEpoch = Volatile.Read(ref _identityEpoch);
        var actor = _actorId;
        _busy = true;
        try
        {
            var reservation = await DraftReservation.ReserveDraftAsync(submission.Input.OrganizationId);
            if (!IsCurrentIdentityEpoch(identityEpoch) || generation != Volatile.Read(ref _editorGeneration) ||
                !string.Equals(actor, _actorId, StringComparison.Ordinal)) return;
            if (!reservation.Succeeded || reservation.Value is null)
            {
                _serverError = "A session identity could not be reserved. Your entries remain here; try again.";
                return;
            }
            _busy = false;
            await RunCommandAsync(submission.Input.ToCommand(reservation.Value.SessionId, submission.Reason, DateTimeOffset.UtcNow));
        }
        catch (Exception)
        {
            if (IsCurrentIdentityEpoch(identityEpoch))
                _serverError = "A session identity could not be reserved. Your entries remain here; try again.";
        }
        finally
        {
            if (IsCurrentIdentityEpoch(identityEpoch)) _busy = false;
        }
    }

