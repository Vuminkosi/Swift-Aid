    private async Task DownloadEvidenceAsync(string evidenceKey)
    {
        if (_loadedCaseId == Guid.Empty || string.IsNullOrWhiteSpace(evidenceKey) || _evidence is not { State: CaseDetailPanelState.Populated } current ||
            !current.Items.Any(item => string.Equals(item.EvidenceKey, evidenceKey, StringComparison.Ordinal)))
        {
            return;
        }

        var caseId = _loadedCaseId;
        var request = ++_downloadRequest;
        var expectedVersion = current.AggregateVersion;
        _evidence = current with { DownloadingEvidenceKey = evidenceKey, DownloadMessage = null, DownloadFailed = false };
        try
        {
            var contentClient = ServiceProvider.GetService<ICaseEvidenceContentClient>();
            if (contentClient is null)
            {
                _evidence = current with { DownloadingEvidenceKey = null, DownloadMessage = "File downloads are not available here.", DownloadFailed = true };
                return;
            }
            await using var content = new MemoryStream();
            var result = await contentClient.DownloadToAsync(caseId, evidenceKey, content);
            if (request != _downloadRequest || caseId != _loadedCaseId || _evidence is not { State: CaseDetailPanelState.Populated } latest ||
                latest.AggregateVersion != expectedVersion || !latest.Items.Any(item => string.Equals(item.EvidenceKey, evidenceKey, StringComparison.Ordinal)))
            {
                return;
            }

            if (!result.Succeeded || !result.Metadata.IsAvailable || result.Value is not { IsValid: true } download ||
                download.CaseId != caseId || download.AggregateVersion != expectedVersion ||
                !string.Equals(download.EvidenceKey, evidenceKey, StringComparison.Ordinal) || content.Length != download.ByteLength)
            {
                _evidence = latest with { DownloadingEvidenceKey = null, DownloadMessage = "This file could not be downloaded. Try again.", DownloadFailed = true };
                return;
            }

            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SwiftAid.UI/js/swiftaid-download.js");
            var bytes = content.ToArray();
            var sha256 = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(bytes));
            if (!string.Equals(sha256, download.Sha256, StringComparison.OrdinalIgnoreCase))
            {
                _evidence = latest with { DownloadingEvidenceKey = null, DownloadMessage = "The downloaded file could not be verified.", DownloadFailed = true };
                return;
            }
            var handedOff = await module.InvokeAsync<bool>("downloadFile", download.FileName, download.ContentType, bytes);
            if (request == _downloadRequest && caseId == _loadedCaseId && _evidence is { } afterHandoff)
            {
                _evidence = afterHandoff with
                {
                    DownloadingEvidenceKey = null,
                    DownloadMessage = handedOff ? "Download started." : "This file could not be downloaded. Try again.",
                    DownloadFailed = !handedOff
                };
            }
        }
        catch (Exception)
        {
            if (request == _downloadRequest && caseId == _loadedCaseId && _evidence is { } latest)
            {
                _evidence = latest with { DownloadingEvidenceKey = null, DownloadMessage = "This file could not be downloaded. Try again.", DownloadFailed = true };
            }
        }
    }

