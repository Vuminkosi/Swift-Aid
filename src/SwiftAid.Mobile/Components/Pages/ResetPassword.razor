@page "/reset-password"
@using System.ComponentModel.DataAnnotations
@using SwiftAid.Client.Authentication
@using SwiftAid.Mobile.Services.Account
@using SwiftAid.Mobile.Services.Http
@using SwiftAid.UI.Components.Surfaces.Public
@inject IServiceProvider ServiceProvider

<PageTitle>Set a new password | SwiftAid</PageTitle>

<AccountEntrySurface>
    <MudPaper Class="pa-4" Elevation="0">
        <SwiftAidPageHeading Eyebrow="Your SwiftAid account"
                             Title="Set a new password"
                             Description="Choose a new password for your account."
                             HeadingId="mobile-reset-password-heading" />

        @if (!HasLink)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert">
                This reset link is invalid or has expired. Request a new one.
            </MudAlert>
            <MudButton Href="/forgot-password" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Class="auth-cta">
                Request a new link
            </MudButton>
        }
        else if (_completed)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" role="status">
                Your password has been reset. Sign in with your new password.
            </MudAlert>
            <MudButton Href="/sign-in" Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" Class="auth-cta">
                Go to sign in
            </MudButton>
        }
        else
        {
            @if (_loadingPolicy)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading password requirements" />
                <MudText Typo="Typo.body2">Loading password requirements…</MudText>
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert" aria-atomic="true">
                    @_error
                </MudAlert>
            }

            @if (_policy is not null)
            {
                <EditForm Model="_form" OnSubmit="SubmitAsync">
                    <DataAnnotationsValidator />
                    <MudTextField T="string" Label="New password" @bind-Value="_form.Password"
                                  For="@(() => _form.Password)" Variant="Variant.Outlined"
                                  Required="true" Disabled="@_busy"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="() => _showPassword = !_showPassword"
                                  Immediate="true" MaxLength="256" autocomplete="new-password"
                                  aria-label="New password" />
                    <MudTextField T="string" Label="Confirm new password" @bind-Value="_form.ConfirmPassword"
                                  For="@(() => _form.ConfirmPassword)" Variant="Variant.Outlined"
                                  Required="true" Disabled="@_busy" InputType="InputType.Password"
                                  Immediate="true" MaxLength="256" autocomplete="new-password"
                                  aria-label="Confirm new password" />
                    <MudText Typo="Typo.caption">@BuildPolicyHint(_policy)</MudText>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                               FullWidth="true" Disabled="@(!CanSubmit)" Class="auth-cta">
                        @(_busy ? "Saving…" : "Set new password")
                    </MudButton>
                </EditForm>
            }
            else if (!_loadingPolicy)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
                           OnClick="LoadPolicyAsync" Disabled="@_busy">
                    Retry loading password requirements
                </MudButton>
            }
        }
    </MudPaper>
</AccountEntrySurface>

@code {
    private readonly ResetForm _form = new();
    private PasswordPolicyInfo? _policy;
    private bool _loadingPolicy = true;
    private bool _busy;
    private bool _showPassword;
    private bool _completed;
    private string? _error;

    [SupplyParameterFromQuery(Name = "userId")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    private bool HasLink =>
        !string.IsNullOrWhiteSpace(UserId) && UserId.Length <= 128 &&
        !string.IsNullOrWhiteSpace(Code) && Code.Length <= 4096;

    private HttpPasswordAuthClient AuthClient =>
        (HttpPasswordAuthClient?)ServiceProvider.GetService(typeof(HttpPasswordAuthClient))
        ?? new HttpPasswordAuthClient(CookieSessionHttpClient.Shared(
            ((NativeSessionHttpOptions?)ServiceProvider.GetService(typeof(NativeSessionHttpOptions)))
            ?.GatewayBaseAddress?.ToString()));

    private bool CanSubmit => HasLink && _policy is not null && !_loadingPolicy && !_busy
        && !string.IsNullOrWhiteSpace(_form.Password)
        && string.Equals(_form.Password, _form.ConfirmPassword, StringComparison.Ordinal);

    protected override Task OnInitializedAsync() => HasLink ? LoadPolicyAsync() : Task.CompletedTask;

    private async Task LoadPolicyAsync()
    {
        _loadingPolicy = true;
        _error = null;
        try
        {
            _policy = await AuthClient.GetPolicyAsync();
            if (_policy is null)
            {
                _error = "Password requirements could not be loaded. Check your connection and retry.";
            }
        }
        catch (Exception)
        {
            _policy = null;
            _error = "Password requirements could not be loaded. Check your connection and retry.";
        }
        finally
        {
            _loadingPolicy = false;
        }
    }

    private async Task SubmitAsync(EditContext editContext)
    {
        if (!CanSubmit || !editContext.Validate())
        {
            return;
        }

        var policyError = GetPasswordPolicyError(_form.Password!, _policy!);
        if (policyError is not null)
        {
            _error = policyError;
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var outcome = await AuthClient.ConfirmPasswordResetAsync(UserId!, Code!, _form.Password!);
            if (outcome.Status == PasswordAuthStatus.Succeeded)
            {
                _completed = true;
                return;
            }

            _error = outcome.Message ?? "The reset link is invalid or has expired.";
        }
        catch (Exception)
        {
            _error = "Password reset is temporarily unavailable. Check your connection and try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private static string BuildPolicyHint(PasswordPolicyInfo policy)
    {
        var requirements = new List<string> { $"at least {Math.Max(1, policy.MinimumLength)} characters" };
        if (policy.RequireDigit) requirements.Add("a number");
        if (policy.RequireLowercase) requirements.Add("a lowercase letter");
        if (policy.RequireUppercase) requirements.Add("an uppercase letter");
        if (policy.RequireSymbol) requirements.Add("a symbol");
        return $"Use {string.Join(", ", requirements)}.";
    }

    private static string? GetPasswordPolicyError(string password, PasswordPolicyInfo policy)
    {
        if (password.Length < Math.Max(1, policy.MinimumLength))
            return $"Use at least {Math.Max(1, policy.MinimumLength)} characters.";
        if (policy.RequireDigit && !password.Any(char.IsDigit))
            return "Add at least one number.";
        if (policy.RequireLowercase && !password.Any(char.IsLower))
            return "Add at least one lowercase letter.";
        if (policy.RequireUppercase && !password.Any(char.IsUpper))
            return "Add at least one uppercase letter.";
        if (policy.RequireSymbol && !password.Any(character => !char.IsLetterOrDigit(character)))
            return "Add at least one symbol.";
        return null;
    }

    private sealed class ResetForm : IValidatableObject
    {
        [Required(ErrorMessage = "Enter a new password.")]
        [StringLength(256)]
        public string? Password { get; set; }

        [Required(ErrorMessage = "Confirm your new password.")]
        [StringLength(256)]
        public string? ConfirmPassword { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!string.Equals(Password, ConfirmPassword, StringComparison.Ordinal))
            {
                yield return new ValidationResult(
                    "The passwords do not match.",
                    [nameof(ConfirmPassword)]);
            }
        }
    }
}
