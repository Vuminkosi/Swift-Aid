@using MudX
@using SwiftAid.Contracts.Ellai
@implements IDisposable
@inject IEllaiReviewClient ReviewClient

<MudXProvider />
<MudDialog>
    <DialogContent>
        <section class="ellai-conversation" aria-label="Saved conversation" aria-busy="@_loading.ToString().ToLowerInvariant()">
            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" aria-label="Loading conversation" />
            }
            else if (_turns is null)
            {
                <MudAlert Severity="Severity.Warning">This conversation couldn't be loaded.</MudAlert>
                <MudButton OnClick="LoadAsync">Try again</MudButton>
            }
            else if (_turns.Count == 0)
            {
                <MudText>No saved messages in this conversation.</MudText>
            }
            else
            {
                @if (_turns.Count == 100)
                {
                    <MudText Typo="Typo.caption">Showing the most recent 100 turns.</MudText>
                }
                @foreach (var turn in _turns)
                {
                    <div @key="turn.ClientUtteranceId" class="ellai-conversation__turn">
                        <MudXChat ChatPosition="MudX.ChatBubblePosition.End">
                            <MudXChatHeader Name="You" />
                            <MudXChatBubble>@(turn.UserText ?? "Earlier message unavailable.")</MudXChatBubble>
                        </MudXChat>
                        <MudXChat ChatPosition="MudX.ChatBubblePosition.Start">
                            <MudXChatHeader Name="Ellai" />
                            <MudXChatBubble>@ReplyText(turn)</MudXChatBubble>
                        </MudXChat>
                    </div>
                }
            }
        </section>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public string SessionId { get; set; } = string.Empty;
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<EllaiConversationTurnDto>? _turns;
    private bool _loading;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var page = await ReviewClient.PollResponsesAsync(SessionId, 0, _lifetime.Token);
            _turns = page?.Conversation;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _turns = null; }
        finally { _loading = false; }
    }

    private static string ReplyText(EllaiConversationTurnDto turn) => turn.Outcome switch
    {
        "Completed" => turn.AssistantText ?? "Earlier reply unavailable.",
        "Queued" or "Processing" => "Thinking…",
        "RetryableFailure" => "Reconnecting…",
        "Cancelled" => "Request ended.",
        "TerminalFailure" => "This request couldn't be completed.",
        _ => "Earlier reply unavailable.",
    };

    private void Close() => Dialog.Close();
    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }
}
