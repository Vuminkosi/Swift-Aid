@using SwiftAid.Contracts.Ellai

<div class="ellai-fab-host">
    <MudMenu Dense="true" AriaLabel="Ellai assistant menu" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.BottomRight">
        <ActivatorContent>
            <MudFab @ref="_fab" StartIcon="@Icons.Material.Filled.SmartToy" Color="Color.Primary" Size="Size.Large" aria-label="Open Ellai assistant" />
        </ActivatorContent>
        <ChildContent>
            <MudMenuItem OnClick="() => SelectMode(EllaiMode.Ask)" aria-label="Ask Ellai a question">Ask a question</MudMenuItem>
            <MudMenuItem OnClick="() => SelectMode(EllaiMode.ShowMe)" aria-label="Ask Ellai to show you">Show me</MudMenuItem>
            <MudMenuItem OnClick="() => SelectMode(EllaiMode.GuideMe)" aria-label="Start a guided tour">Guide me</MudMenuItem>
            <MudMenuItem OnClick="() => SelectMode(EllaiMode.HelpMeWork)" aria-label="Get help with current work">Help me work</MudMenuItem>
            <MudMenuItem OnClick="() => SelectMode(EllaiMode.ExploreBranch)" aria-label="Explore a branch">Explore a branch</MudMenuItem>
            <MudMenuItem OnClick="() => SelectMode(EllaiMode.ReviewEvidence)" aria-label="Review evidence">Review evidence</MudMenuItem>
            <MudDivider />
            <MudMenuItem OnClick="OnCreateGuide" aria-label="Create a guide">Create a guide…</MudMenuItem>
        </ChildContent>
    </MudMenu>
</div>

@code {
    private MudFab? _fab;

    /// <summary>Returns keyboard focus to the launcher after cancel.</summary>
    public ValueTask FocusLauncherAsync() =>
        _fab is not null ? _fab.FocusAsync() : ValueTask.CompletedTask;

    [Parameter]
    public EventCallback<EllaiMode> OnModeSelected { get; set; }

    [Parameter]
    public EventCallback OnCreateGuide { get; set; }

    private Task SelectMode(EllaiMode mode) => OnModeSelected.InvokeAsync(mode);
}
