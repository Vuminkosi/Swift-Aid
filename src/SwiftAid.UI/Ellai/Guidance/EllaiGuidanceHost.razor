@using Bit.Bonboarding
@using SwiftAid.Contracts.Ellai
@using SwiftAid.UI.Ellai.Components
@inject IBonboardingService Bonboarding
@inject IEllaiGuidanceControl Guidance
@inject EllaiLauncher Launcher
@inject IEllaiReviewClient ReviewClient
@inject MudBlazor.IDialogService Dialogs
@inject EllaiEventPoller EventPoller
@implements IDisposable

<div class="ellai-host">
    <BonboardingRoot />
    @if (IsActive)
    {
        <div class="ellai-host__attached">
            <EllaiCompactComposer Placement="EllaiSurfacePlacement.Attached"
                                  StatusText="@StatusText" Phase="@Phase"
                                  InputText="@InputText" InputTextChanged="OnInputChanged"
                                  Position="@Position" PositionChanged="OnPositionChanged"
                                  CanSend="true" CanUseMicrophone="@CanUseMicrophone"
                                  OnSend="OnSend" OnCancel="OnCancel" OnStartVoice="OnStartVoice" />
        </div>
    }
    else if (ShowComposer)
    {
        <div class="ellai-host__floating">
            <EllaiCompactComposer Placement="EllaiSurfacePlacement.Floating"
                                  StatusText="@StatusText" Phase="@Phase"
                                  InputText="@InputText" InputTextChanged="OnInputChanged"
                                  Position="@Position" PositionChanged="OnPositionChanged"
                                  CanSend="true" CanUseMicrophone="@CanUseMicrophone"
                                  OnSend="OnSend" OnCancel="OnCancel" OnStartVoice="OnStartVoice" />
        </div>
    }
</div>

@code {
    private CancellationTokenSource? _cts;
    private bool ShowComposer;
    private bool IsActive;
    private string? StatusText = "Ellai is ready.";
    private string? Phase = EllaiStatusPhases.Ready;
    private string? InputText;
    private EllaiComposerPosition Position = EllaiComposerPosition.Default;
    private GuidanceSnapshot? _guidance;
    private string? _stopCommandId;

    [Parameter]
    public double ViewportWidth { get; set; } = 1280;

    [Parameter]
    public double ViewportHeight { get; set; } = 800;

    /// <summary>Enables the microphone control once the microphone
    /// permission is granted through the permission flow.</summary>
    [Parameter]
    public bool CanUseMicrophone { get; set; }

    [Parameter]
    public EventCallback<EllaiMode> OnModeSelected { get; set; }

    [Parameter]
    public EventCallback<string?> OnSendText { get; set; }

    [Parameter]
    public EventCallback OnStartVoice { get; set; }

    [Parameter]
    public EventCallback OnCreateGuide { get; set; }

    protected override void OnInitialized()
    {
        Launcher.Requested += OnLauncherRequested;
        EventPoller.ApprovalRequired += OnApprovalRequired;
        EventPoller.SessionCancelled += OnSessionCancelled;
        EventPoller.ActivityUpdated += OnActivityUpdated;
    }

    /// <summary>Binds trusted runtime progress to the composer status line.
    /// Coordinator phases map onto the canonical label set; unknown phases
    /// keep the current label while the template text still updates.</summary>
    internal static string? MapActivityPhase(string phase) => phase switch
    {
        "blocked" => EllaiStatusPhases.Blocked,
        "approval" => EllaiStatusPhases.NeedsInput,
        "done" or "cancelled" => EllaiStatusPhases.Ready,
        "working" or "reading" or "reviewing" or "opening" or "verifying"
            => EllaiStatusPhases.Active,
        _ => null,
    };

    private void OnActivityUpdated(string phase, string text)
    {
        _ = InvokeAsync(() =>
        {
            if (MapActivityPhase(phase) is { } mapped)
            {
                Phase = mapped;
            }

            StatusText = text;
            StateHasChanged();
        });
    }

    private void OnLauncherRequested(EllaiMode mode)
    {
        _ = InvokeAsync(() => SelectModeAsync(mode));
    }

    /// <summary>Attaches live guidance, enabling the attached composer
    /// branch. Called by the hosting page when a journey starts.</summary>
    public async Task AttachGuidanceAsync(
        string journeyId, string journeyVersion, GuidanceMode mode, CancellationToken cancellationToken)
    {
        _guidance = await Guidance.StartAsync(journeyId, journeyVersion, mode, null, cancellationToken);
        IsActive = true;
        ShowComposer = true;
        Phase = EllaiStatusPhases.Active;
        StatusText = "Guidance is showing. The composer follows the active card.";
    }

    private async Task SelectModeAsync(EllaiMode mode)
    {
        CancelPriorSession();
        ShowComposer = true;
        IsActive = false;
        Phase = EllaiStatusPhases.Ready;
        StatusText = "Starting an Ellai session…";
        StateHasChanged();
        try
        {
            var view = await ReviewClient.StartSessionAsync(mode, CancellationToken.None);
            if (view is null)
            {
                StatusText = "Ellai is unavailable right now. Try again in a moment.";
                return;
            }

            TrackSession(view.SessionId);
            StatusText = "Ellai session started. Ask a question or start a guided tour.";
        }
        finally
        {
            await OnModeSelected.InvokeAsync(mode);
        }
    }

    private async Task CreateGuideAsync()
    {
        await OnCreateGuide.InvokeAsync();
    }

    private void OnInputChanged(string? value)
    {
        InputText = value;
    }

    private void OnPositionChanged(EllaiComposerPosition next)
    {
        Position = EllaiComposerPosition.Resolve(next, ViewportWidth, ViewportHeight);
    }

    private async Task OnSend()
    {
        if (string.IsNullOrWhiteSpace(InputText))
        {
            return;
        }

        await OnSendText.InvokeAsync(InputText);
    }

    private async Task OnCancel()
    {
        var token = _cts?.Token ?? CancellationToken.None;
        try
        {
            if (_guidance is not null)
            {
                _stopCommandId ??= $"cancel-{Guid.NewGuid():N}";
                await Guidance.StopAsync(
                    _guidance.Position.GuidanceAttemptId,
                    _guidance.Position.GuidanceVersion,
                    _guidance.Mode,
                    token,
                    _stopCommandId);
            }

            await Bonboarding.StopAllAsync(BonboardingTourEndReason.Cancelled, token);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            CancelPriorSession();
            _guidance = null;
            _stopCommandId = null;
            IsActive = false;
            ShowComposer = false;
            InputText = null;
            Phase = EllaiStatusPhases.Ready;
            StatusText = "Ellai session ended.";
        }
    }

    private void CancelPriorSession()
    {
        try
        {
            _cts?.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }
        finally
        {
            _cts?.Dispose();
            _cts = new CancellationTokenSource();
        }
    }

    private CancellationTokenSource? _pollCts;
    private IDialogReference? _reviewDialog;

    /// <summary>Human edit of the plan under review. Bound by the hosting
    /// page when a reasoning lane can present a revised plan.</summary>
    [Parameter]
    public EventCallback<EllaiReviewDto> OnEditRequested { get; set; }

    /// <summary>Starts tracking one session: polls its event journal and
    /// opens the approval dialog on validated reviews.</summary>
    public void TrackSession(string sessionId)
    {
        EventPoller.TrackSession(sessionId);
        RestartPollLoop();
    }

    private void RestartPollLoop()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = new CancellationTokenSource();
        _ = PollLoopAsync(_pollCts.Token);
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await EventPoller.PollOnceAsync(20, ct).ConfigureAwait(false);
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch
            {
                try
                {
                    await Task.Delay(2000, ct).ConfigureAwait(false);
                }
                catch (OperationCanceledException)
                {
                    break;
                }
            }
        }
    }

    private async void OnApprovalRequired(string requestId)
    {
        try
        {
            await InvokeAsync(() => OpenReviewAsync(requestId)).ConfigureAwait(false);
        }
        catch
        {
        }
    }

    private void OnSessionCancelled()
    {
        _reviewDialog?.Close();
        _reviewDialog = null;
    }

    private async Task OpenReviewAsync(string requestId)
    {
        var sessionId = EventPoller.SessionId;
        if (sessionId is null || _reviewDialog is not null)
        {
            return;
        }

        IDialogReference? dialog = null;
        try
        {
            var review = await ReviewClient.GetActiveReviewAsync(sessionId, CancellationToken.None).ConfigureAwait(false);
            if (review is null || review.RequestId != requestId)
            {
                return;
            }

            var parameters = new DialogParameters
            {
                ["RequestId"] = review.RequestId,
                ["PlanHash"] = review.PlanHash,
                ["PlanVersion"] = review.PlanVersion,
                ["ExpiresAtUtc"] = review.ExpiresAtUtc,
                ["EvidenceText"] = $"Plan {review.PlanHash} version {review.PlanVersion}.",
                ["Actions"] = review.Actions.Select(action =>
                    new EllaiApprovalActionRow(action.ActionId, action.Label, action.Detail, false)).ToList(),
                ["OnApproveSelected"] = EventCallback.Factory.Create<IReadOnlyList<string>>(
                    this, selected => SubmitSelectionAsync(review, selected)),
                ["OnReject"] = EventCallback.Factory.Create(this, () => RejectAsync(review)),
                ["OnEdit"] = EventCallback.Factory.Create(this, () => EditAsync(review)),
                ["OnCancel"] = EventCallback.Factory.Create(this, () => dialog?.Close()),
            };
            dialog = await Dialogs.ShowAsync<EllaiApprovalDialog>(
                "Review proposed actions", parameters).ConfigureAwait(false);
            _reviewDialog = dialog;
            await dialog.Result.ConfigureAwait(false);
        }
        catch
        {
            dialog?.Close();
        }
        finally
        {
            if (ReferenceEquals(_reviewDialog, dialog))
            {
                _reviewDialog = null;
            }
        }
    }

    private async Task SubmitSelectionAsync(EllaiReviewDto review, IReadOnlyList<string> selected)
    {
        try
        {
            await ReviewClient.ApproveSelectedAsync(
                review.SessionId, review.RequestId, selected, CancellationToken.None).ConfigureAwait(false);
        }
        finally
        {
            _reviewDialog?.Close();
            _reviewDialog = null;
        }
    }

    private async Task RejectAsync(EllaiReviewDto review)
    {
        try
        {
            await ReviewClient.RejectReviewAsync(
                review.SessionId, review.RequestId, CancellationToken.None).ConfigureAwait(false);
        }
        finally
        {
            _reviewDialog?.Close();
            _reviewDialog = null;
        }
    }

    private async Task EditAsync(EllaiReviewDto review)
    {
        _reviewDialog?.Close();
        _reviewDialog = null;
        await OnEditRequested.InvokeAsync(review).ConfigureAwait(false);
    }

    public void Dispose()
    {
        Launcher.Requested -= OnLauncherRequested;
        EventPoller.ApprovalRequired -= OnApprovalRequired;
        EventPoller.SessionCancelled -= OnSessionCancelled;
        EventPoller.ActivityUpdated -= OnActivityUpdated;
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        try
        {
            _cts?.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }

        _cts?.Dispose();
    }
}
