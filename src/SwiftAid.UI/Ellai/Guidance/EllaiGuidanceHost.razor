@using Bit.Bonboarding
@using SwiftAid.Contracts.Ellai
@using SwiftAid.UI.Ellai.Components
@using Microsoft.Extensions.DependencyInjection
@using System.Buffers.Binary
@using System.Threading.Channels
@inject IBonboardingService Bonboarding
@inject IEllaiGuidanceControl Guidance
@inject EllaiLauncher Launcher
@inject IEllaiReviewClient ReviewClient
@inject MudBlazor.IDialogService Dialogs
@inject EllaiEventPoller EventPoller
@inject Microsoft.JSInterop.IJSRuntime JS
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@inject IServiceProvider Services
@implements IDisposable

<div class="ellai-host">
    <BonboardingRoot PopoverClass="ellai-guided-popover" ChildContent="@(_generatedTour is null ? null : GuidancePopover)" />
    @if (_guidanceProposalId is not null && _generatedTour is null)
    {
        <MudButton Variant="Variant.Text" Disabled="@_preparingGuidance" OnClick="StartProposedGuidanceAsync" data-ellai-audio-unlock="true">
            @(_preparingGuidance ? "Preparing guidance…" : "Start guidance")
        </MudButton>
        @if (_guidanceNotice is not null)
        {
            <MudText Typo="Typo.caption" role="status">@_guidanceNotice</MudText>
        }
    }
    @if (_generatedTour is not null)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center">
            @if (_generatedTour.Status == BonboardingTourStatus.Paused)
            {
                <MudButton OnClick='@(() => ControlGeneratedTourAsync("resume"))'>Resume guidance</MudButton>
            }
            else
            {
                <MudButton OnClick='@(() => ControlGeneratedTourAsync("pause"))'>Pause guidance</MudButton>
            }
            <MudButton OnClick='@(() => ControlGeneratedTourAsync("cancel"))'>Cancel guidance</MudButton>
            @if (_guidanceReplanRequired)
            {
                <MudButton OnClick="ReplanGeneratedGuidanceAsync">Find another way</MudButton>
            }
            @if (_guidanceNotice is not null)
            {
                <MudText Typo="Typo.caption" role="status">@_guidanceNotice</MudText>
            }
        </MudStack>
    }
    @if (_guidanceNotice is not null && _generatedTour is null && _guidanceProposalId is null)
    {
        <MudText Typo="Typo.caption" role="status">@_guidanceNotice</MudText>
    }
    @if (_showStartFailure)
    {
        <MudAlert Severity="@(_startOutcomeUnknown ? Severity.Warning : Severity.Info)"
                  aria-live="assertive" Class="ellai-host__recovery-status">
            @StatusText
        </MudAlert>
    }
    @if (_generatedTour is null && ShowComposer && (IsActive || !_startOutcomeUnknown))
    {
        <div class="@(IsActive ? "ellai-host__attached" : "ellai-host__floating")">
            @Composer(IsActive ? EllaiSurfacePlacement.Attached : EllaiSurfacePlacement.Floating)
        </div>
    }
</div>

@code {
    private RenderFragment Composer(EllaiSurfacePlacement placement) => @<text>
        <EllaiCompactComposer Placement="placement"
                                  StatusText="@GetComposerStatusText()" Phase="null"
                                  ResponseText="@_latestResponseText" SentMessage="@_latestUserText"
                                  LivePartialTranscript="@_livePartialVoiceTranscript"
                                  InputText="@InputText" InputTextChanged="OnInputChanged"
                                  Position="@Position" PositionChanged="OnPositionChanged"
                                  CanSend="@CanSubmitText" CanCancel="@(!_startOutcomeUnknown)" CanUseMicrophone="@(CanStartVoiceCapture && _microphoneCaptureAvailable)"
                                  CanUseRealtimeMicrophone="@(CanStartVoiceCapture && (_microphoneCaptureAvailable || _nativeVoiceCapture?.IsAvailable == true))"
                                  IsLiveSpeaking="@(_isRecordingAudio && _captureMode == EllaiVoiceCaptureMode.Live)"
                                  IsRecordingAudio="@(_isRecordingAudio && _captureMode == EllaiVoiceCaptureMode.Recorded)"
                                  CanPlayResponse="@CanPlayResponse" IsPlayingResponse="@_isPlayingResponse" IsListeningEnabled="@_readResponsesAloud"
                                  OnToggleResponseAudio="ToggleResponseAudioAsync"
                                  OnSend="OnSend" OnCancel="OnCancel" OnClose="CloseComposerAsync" OnOpenSettings="OpenEllaiSettings"
                                  OnStartVoice="StartRecordedCaptureAsync"
                                  OnStartRealtimeVoice="StartLiveCaptureAsync" OnStopVoice="StopVoiceCaptureAsync" />
    </text>;

    private RenderFragment<BonboardingStepRenderContext> GuidancePopover => context => @<section class="ellai-guided-conversation" aria-label="Ellai walkthrough">
        <header class="ellai-guided-conversation__heading">
            <strong>Ellai guidance</strong>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                           OnClick='@(() => ControlGeneratedTourAsync("cancel"))' aria-label="Cancel guidance" />
        </header>
        @if (_validationGuidanceText is null && _reportInputText is not null)
        {
            <p role="status" class="ellai-guided-conversation__input">@_reportInputText</p>
        }
        @if (_validationGuidanceText is not null)
        {
            <p role="status" class="ellai-guided-conversation__validation">@_validationGuidanceText</p>
        }
        @if (_validationGuidanceText is null && !string.IsNullOrWhiteSpace(context.ValidationMessage))
        {
            <p role="status" class="ellai-guided-conversation__validation">@context.ValidationMessage</p>
        }
        @if (!string.IsNullOrWhiteSpace(_guidanceNotice))
        {
            <p role="status" class="ellai-guided-conversation__validation">@_guidanceNotice</p>
        }
        @if (ShowComposer)
        {
            <div class="ellai-guided-conversation__composer">
                @Composer(EllaiSurfacePlacement.Attached)
            </div>
        }
        <div class="ellai-guided-conversation__navigation">
            <span class="ellai-guided-conversation__progress" role="img" aria-label="@context.ProgressText">
                @for (var index = 0; index < context.Count; index++)
                {
                    <i class="@(index == context.Index ? "is-current" : null)" aria-hidden="true"></i>
                }
            </span>
            @if (!context.IsFirst)
            {
                <MudButton Size="Size.Small" OnClick='@(() => MoveGuidanceStepAsync("back"))'>Back</MudButton>
            }
            <MudButton Size="Size.Small" OnClick="@(async () => await context.SkipAsync())">Skip tour</MudButton>
            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="@(async () => { CancelGuidanceCountdown(); await AdvanceGuidanceStepAsync(_uiObservationLifetime.Token); })">@context.NextLabel @(_guidanceCountdownSeconds is { } seconds ? $"({seconds})" : null)</MudButton>
        </div>
        @if (CurrentGuidanceStep is { SuggestionIds.Count: > 0 } currentStep && _generatedPlan is { } currentPlan)
        {
            <div class="ellai-guided-conversation__suggestions" aria-label="Suggested next steps">
                @foreach (var id in currentStep.SuggestionIds)
                {
                    if (currentPlan.Suggestions.TryGetValue(id, out var suggestion))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   Disabled="@(_selectingGuidanceSuggestion || _submittingUtterance || !string.IsNullOrWhiteSpace(InputText))"
                                   OnClick="@(() => SelectGuidanceSuggestionAsync(id))">@suggestion.Label</MudButton>
                    }
                }
            </div>
        }
    </section>;

    private CancellationTokenSource? _cts;
    private bool ShowComposer;
    private bool IsActive;
    private string? StatusText = "Ready";
    private string? Phase = EllaiStatusPhases.Ready;
    private string? InputText;
    private EllaiComposerPosition? Position;

    private string? GetComposerStatusText()
    {
        if (_liveVoiceReconnectRequired ||
            (_lastDurableTurn?.Outcome == "RetryableFailure" &&
             _lastDurableTurn.ClientUtteranceId == _thinkingUtteranceId))
        {
            return "Reconnecting…";
        }

        if (_startingSession || _startingVoiceCapture)
        {
            return "Connecting…";
        }

        if (!string.IsNullOrWhiteSpace(_toolActivityText)) return _toolActivityText;

        if (_submittingUtterance || _thinkingUtteranceId is not null || _preparingGuidance)
        {
            return "Thinking…";
        }

        return "Ready";
    }
    private EllaiSessionView? _sessionView;
    private string? _pendingUtteranceId;
    private string? _pendingUtteranceText;
    private bool _submittingUtterance;
    private string? _thinkingUtteranceId;
    private string? _settledUtteranceId;
    private CancellationTokenSource? _submissionCts;
    private TaskCompletionSource? _submissionSettled;
    private bool _startingSession;
    private bool _cancelRequestedWhileStarting;
    private bool _startOutcomeUnknown;
    private bool _showStartFailure;
    private bool _sessionVersionConflict;
    private bool _submissionPolicyBlocked;
    private bool _authorizationRequired;
    private bool _submissionCorrectionRequired;
    private bool _cancelOutcomeUnknown;
    private GuidanceSnapshot? _guidance;
    private string? _stopCommandId;
    private long _latestResponseSequence;
    private long _lastReceivedResponseSequence;
    private string? _responseSessionId;
    private string? _responseTextUtteranceId;
    private string? _latestResponseText;
    private string? _latestUserText;
    private string? _latestUserUtteranceId;
    private EllaiConversationTurnDto? _lastDurableTurn;
    private Microsoft.JSInterop.IJSObjectReference? _sessionContinuity;
    private readonly List<long> _latestResponseAudioSequences = [];
    private readonly Queue<long> _pendingResponseAudioSequences = new();
    private int _stopResponsePlaybackRequested;
    private long _activeResponseSequence;
    private string? _activeResponsePlaybackId;
    private bool _isPlayingResponse;
    private Microsoft.JSInterop.IJSObjectReference? _speechModule;
    private CancellationTokenSource? _audioPlaybackCts;
    private Microsoft.JSInterop.IJSObjectReference? _captureModule;
    private Microsoft.JSInterop.IJSObjectReference? _connectivitySubscription;
    private IEllaiNativeVoiceCapture? _nativeVoiceCapture;
    private long _lastNativeGlowTimestamp;
    private double _nativeGlowLevel;
    private IEllaiClientSpeechDetectorFactory? _sileroFactory;
    private EllaiClientBargeInDetector? _otherNativeBargeInDetector;
    private Microsoft.JSInterop.DotNetObjectReference<EllaiGuidanceHost>? _captureDotnetReference;
    private readonly object _capturedPcmGate = new();
    private readonly SemaphoreSlim _liveVoiceReplayGate = new(1, 1);
    private MemoryStream? _capturedPcm;
    private Channel<byte[]>? _liveVoiceChunks;
    private Stream? _liveVoiceStream;
    private Task<EllaiVoiceTranscriptionResult?>? _liveVoiceTranscriptionTask;
    private TaskCompletionSource<EllaiVoiceTranscriptionResult?>? _browserVoiceStreamCompletion;
    private bool _browserLiveVoiceWebSocket;
    private volatile bool _liveVoiceReconnectRequired;
    private volatile bool _liveVoiceCaptureEnding;
    private int _liveVoiceReconnectAttempts;
    private long _liveVoiceReplayBytesSent;
    private CancellationTokenSource? _liveVoiceCts;
    private CancellationTokenSource? _voiceTurnStatusCts;
    private Task? _voiceTurnStatusTask;
    private string? _liveVoiceCaptureId;
    private string? _livePartialVoiceTranscript;
    private long _capturedVoiceBytes;
    private long _lastCompletedVoiceTurnSequence;
    private long _lastVoiceTurnStatusEpoch;
    private string? _voiceTurnCursorSessionId;
    private EllaiVoiceCaptureMode? _captureMode;
    private EllaiLanguagePreferences _speechPreferences = new();
    private bool _microphoneCaptureAvailable;
    private bool _voiceNetworkOnline = true;
    private bool _nativeVoiceCaptureActive;
    private bool _captureEchoCancellationEnabled;
    private EllaiAudioProcessingStatus _audioProcessingStatus = EllaiAudioProcessingStatus.Unknown;
    private bool _voiceCaptureConsentGranted;
    private bool _isRecordingAudio;
    private bool _voiceTranscriptionInProgress;
    private bool _startingVoiceCapture;
    private string? _greetedLiveSessionId;
    private bool _readResponsesAloud;
    private bool _guidanceSpeechAutoEnabled;
    private bool _guidanceSpeechMutedByUser;
    private bool _responseAudioQueueRunning;
    private readonly HashSet<long> _progressAudioSequences = [];
    private string? _toolActivityText;
    private string? _silencedProgressTurnId;
    private Task<bool> _responseStopTask = Task.FromResult(true);
    private int _localBargeInPending;

    private bool CanPlayResponse => _sessionView is not null
        && (_latestResponseSequence > 0 || _progressAudioSequences.Count > 0)
        && (!ReviewClient.UsesGatewayPcmAudioDownload
            || Services.GetService<IEllaiPcmAudioPlayer>()?.IsAvailable == true);

    private bool CanSubmitText => _sessionView is not null
        && string.Equals(EventPoller.SessionId, _sessionView.SessionId, StringComparison.Ordinal)
        && string.Equals(_sessionView.Status, "Active", StringComparison.Ordinal)
        && !_submittingUtterance
        && !_sessionVersionConflict
        && !_submissionPolicyBlocked
        && !_authorizationRequired
        && !_submissionCorrectionRequired
        && !_cancelOutcomeUnknown
        && !_startingSession
        && !_startOutcomeUnknown
        && !string.IsNullOrWhiteSpace(InputText);

    [Parameter]
    public double ViewportWidth { get; set; } = 1280;

    [Parameter]
    public double ViewportHeight { get; set; } = 800;

    [Parameter]
    public EventCallback<EllaiMode> OnModeSelected { get; set; }

    [Parameter]
    public EventCallback OnCreateGuide { get; set; }

    [Parameter]
    public EventCallback RevealNavigation { get; set; }

    private EllaiValidationGuidance? _validationGuidance;

    protected override void OnInitialized()
    {
        _reportVoiceContext = Services.GetService<EllaiPublicReportDraftContext>();
        _reportVoiceContext?.RegisterVoiceController(this, StartReportVoiceCaptureAsync, StopReportVoiceCaptureAsync, TranscribeSavedReportVoiceAsync);
        _validationGuidance = Services.GetService<EllaiValidationGuidance>();
        if (_validationGuidance is not null)
            _validationGuidance.Changed += OnValidationGuidanceChanged;
        _navigationTrail.Record(Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.LocationChanged += TrackNavigation;
        Launcher.Requested += OnLauncherRequested;
        EventPoller.ApprovalRequired += OnApprovalRequired;
        EventPoller.SessionCancelled += OnSessionCancelled;
        EventPoller.ActivityUpdated += OnActivityUpdated;
        EventPoller.ResponseReceived += OnResponseReceived;
        EventPoller.ConversationUpdated += OnConversationUpdated;
        EventPoller.ResponseStreamReset += OnResponseStreamReset;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var speechModule = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                "import", "./_content/SwiftAid.UI/js/ellai-audio-playback.js");
            if (speechModule is not null)
            {
                _speechModule = speechModule;
                await _speechModule.InvokeVoidAsync("initializeAudioUnlock");
            }
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
            _speechModule = null;
        }
        catch (Microsoft.JSInterop.JSException)
        {
            _speechModule = null;
        }

        _sileroFactory = Services.GetService<IEllaiClientSpeechDetectorFactory>();
        if (_sileroFactory is not null) _sileroFactory.SpeechConfirmed += OnNativeSileroSpeech;
        _nativeVoiceCapture = Services.GetService<IEllaiNativeVoiceCapture>();
        if (_nativeVoiceCapture is not null)
        {
            _nativeVoiceCapture.Interrupted += OnNativeVoiceCaptureInterrupted;
            _nativeVoiceCapture.RouteChanged += OnNativeVoiceRouteChanged;
        }

        try
        {
            _captureDotnetReference ??= Microsoft.JSInterop.DotNetObjectReference.Create(this);
            _captureModule = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                "import", "./_content/SwiftAid.UI/js/ellai-voice-capture.js");
            _microphoneCaptureAvailable = await _captureModule.InvokeAsync<bool>("isSupported");
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
            _microphoneCaptureAvailable = false;
        }
        catch (Microsoft.JSInterop.JSException)
        {
            _microphoneCaptureAvailable = false;
        }

        if (_captureModule is not null && _captureDotnetReference is not null)
        {
            try
            {
                _voiceNetworkOnline = await _captureModule.InvokeAsync<bool>("isOnline");
                _connectivitySubscription = await _captureModule.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                    "startConnectivityMonitoring", _captureDotnetReference);
            }
            catch (Microsoft.JSInterop.JSDisconnectedException)
            {
                _voiceNetworkOnline = true;
            }
            catch (Microsoft.JSInterop.JSException)
            {
                _voiceNetworkOnline = true;
            }
        }

        _ = MonitorUiObservationsAsync();
        await RestoreConversationAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RestoreConversationAsync()
    {
        try
        {
            _sessionContinuity = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                "import", "./_content/SwiftAid.UI/js/ellai-session-continuity.js");
            var sessionId = await _sessionContinuity.InvokeAsync<string?>("read");
            if (string.IsNullOrWhiteSpace(sessionId) || _sessionView is not null || _startingSession) return;
            var result = await ReviewClient.ResumeSessionAsync(sessionId, CancellationToken.None);
            if (result.Status == EllaiClientOperationStatus.Accepted && result.Session is { Status: "Active" } session)
            {
                _sessionView = session;
                OfferSavedGuidance(session);
                ShowComposer = true;
                StatusText = "Ready";
                TrackSession(sessionId);
            }
            else if (result.Status is EllaiClientOperationStatus.Unauthorized
                || result.Session is { Status: "Completed" or "Cancelled" })
            {
                await _sessionContinuity.InvokeVoidAsync("write", (string?)null);
            }
        }
        catch (Microsoft.JSInterop.JSException) { }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    private async Task RememberSessionAsync(string? sessionId)
    {
        if (_sessionContinuity is null) return;
        try { await _sessionContinuity.InvokeVoidAsync("write", sessionId); }
        catch (Microsoft.JSInterop.JSException) { }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    private Task StartRecordedCaptureAsync() => StartVoiceCaptureAsync(EllaiVoiceCaptureMode.Recorded);

    private Task StartLiveCaptureAsync() => StartVoiceCaptureAsync(EllaiVoiceCaptureMode.Live);

    private bool CanStartVoiceCapture => _sessionView is { Status: "Active" }
        && !_startingSession && !_startingVoiceCapture && !_voiceTranscriptionInProgress
        && !_isRecordingAudio && !_cancelOutcomeUnknown && !_startOutcomeUnknown;

    private Task StartVoiceCaptureAsync(EllaiVoiceCaptureMode mode, bool reportCapture = false) =>
        StartVoiceCaptureCoreAsync(mode, reportCapture, CancellationToken.None);

    private async Task StartVoiceCaptureCoreAsync(EllaiVoiceCaptureMode mode, bool reportCapture, CancellationToken reportCancellation)
    {
        var session = _sessionView;
        var useNativeLiveCapture = (mode == EllaiVoiceCaptureMode.Live || reportCapture)
            && _nativeVoiceCapture?.IsAvailable == true;
        var useBrowserLiveVoiceWebSocket = mode == EllaiVoiceCaptureMode.Live
            && !useNativeLiveCapture && !ReviewClient.UsesGatewayPcmAudioDownload;
        if (reportCancellation.IsCancellationRequested || (!useNativeLiveCapture && !_microphoneCaptureAvailable)
            || (!useNativeLiveCapture && _captureModule is null)
            || session is null || !string.Equals(session.Status, "Active", StringComparison.Ordinal)
            || _isRecordingAudio || _voiceTranscriptionInProgress || _startingVoiceCapture)
        {
            StatusText = "Microphone capture is unavailable. You can still type to Ellai.";
            Phase = EllaiStatusPhases.NeedsInput;
            return;
        }

        if (!string.IsNullOrWhiteSpace(InputText))
        {
            StatusText = "Send or clear the existing text before starting a voice turn.";
            Phase = EllaiStatusPhases.NeedsInput;
            return;
        }

        _reportVoiceCapture = reportCapture;
        _startingVoiceCapture = true;
        try
        {
            var nativePermission = Services.GetService<IEllaiMicrophonePermission>();
            if (nativePermission is not null
                && !await nativePermission.RequestAsync(CancellationToken.None).ConfigureAwait(false))
            {
                _startingVoiceCapture = false;
                StatusText = "Microphone permission was denied. You can still type to Ellai.";
                Phase = EllaiStatusPhases.NeedsInput;
                return;
            }

            if (!_voiceCaptureConsentGranted)
            {
                if (!await ReviewClient.GrantVoiceCaptureConsentAsync(session.SessionId, CancellationToken.None)
                        .ConfigureAwait(false))
                {
                    _startingVoiceCapture = false;
                    StatusText = "We couldn't confirm your permission to use the microphone. No audio was recorded.";
                    Phase = EllaiStatusPhases.Blocked;
                    return;
                }

                if (_sessionView?.SessionId != session.SessionId || _sessionView.Status != "Active")
                {
                    _startingVoiceCapture = false;
                    return;
                }
                _voiceCaptureConsentGranted = true;
            }
        }
        catch (Exception)
        {
            _startingVoiceCapture = false;
            StatusText = "Microphone access could not be checked. You can still type to Ellai.";
            Phase = EllaiStatusPhases.NeedsInput;
            return;
        }

        if (_sessionView?.SessionId != session.SessionId || _sessionView.Status != "Active")
        {
            _startingVoiceCapture = false;
            return;
        }

        if (reportCancellation.IsCancellationRequested)
        {
            _startingVoiceCapture = false;
            return;
        }
        DiscardCapturedAudio();
        lock (_capturedPcmGate)
        {
            _capturedPcm = new MemoryStream();
            _capturedVoiceBytes = 0;
        }
        _captureMode = mode;
        _liveVoiceCaptureId = Guid.NewGuid().ToString("N");
        if (reportCapture) _reportVoiceContext?.BindVoiceCapture(_liveVoiceCaptureId);
        _captureEchoCancellationEnabled = false;
        _otherNativeBargeInDetector?.Dispose();
        // Preserve existing iOS behaviour; this milestone replaces the detector on web/Android only.
        _otherNativeBargeInDetector = useNativeLiveCapture && _sileroFactory is null ? new EllaiClientBargeInDetector() : null;
        if (!string.Equals(_voiceTurnCursorSessionId, session.SessionId, StringComparison.Ordinal))
        {
            _voiceTurnCursorSessionId = session.SessionId;
            _lastCompletedVoiceTurnSequence = 0;
            _lastVoiceTurnStatusEpoch = 0;
        }
        _captureDotnetReference ??= Microsoft.JSInterop.DotNetObjectReference.Create(this);
        var capturingAlongsidePlayback = mode == EllaiVoiceCaptureMode.Live && _isPlayingResponse;
        try
        {
            await LoadSpeechPreferencesAsync();
            if (mode == EllaiVoiceCaptureMode.Live)
            {
                StatusText = "Hi, What's on your mind!";
                Phase = EllaiStatusPhases.Active;
                await InvokeAsync(StateHasChanged);
                if (!capturingAlongsidePlayback)
                {
                    StopResponseAudio();
                }

            }

            if (reportCancellation.IsCancellationRequested || _sessionView is null
                || !string.Equals(_sessionView.SessionId, session.SessionId, StringComparison.Ordinal)
                || !string.Equals(_sessionView.Status, "Active", StringComparison.Ordinal))
            {
                return;
            }

            _liveVoiceReconnectRequired = false;
            _liveVoiceCaptureEnding = false;
            _liveVoiceReconnectAttempts = 0;
            _liveVoiceReplayBytesSent = 0;
            if (mode == EllaiVoiceCaptureMode.Live && _voiceNetworkOnline)
            {
                if (useBrowserLiveVoiceWebSocket)
                {
                    StartBrowserLiveVoiceStream();
                }
                else
                {
                    StartLiveVoiceStream(session.SessionId);
                }
            }
            else if (mode == EllaiVoiceCaptureMode.Live)
            {
                _liveVoiceReconnectRequired = true;
            }

            _isRecordingAudio = true;
            if (mode == EllaiVoiceCaptureMode.Live) _readResponsesAloud = true;
            if (useNativeLiveCapture)
            {
                try
                {
                    _ = await _nativeVoiceCapture!.StartAsync(
                        QueueNativePcmChunkAsync, _cts?.Token ?? CancellationToken.None);
                    _audioProcessingStatus = _nativeVoiceCapture.AudioProcessingStatus;
                    _captureEchoCancellationEnabled = _audioProcessingStatus.EchoCancellationEnabled == true;
                }
                catch (OperationCanceledException) when (_cts?.IsCancellationRequested == true)
                {
                    throw;
                }
                catch (Exception) when (_microphoneCaptureAvailable && _captureModule is not null)
                {
                    useNativeLiveCapture = false;
                    _ = await _captureModule.InvokeAsync<string>(
                        "startCapture", _captureDotnetReference, mode == EllaiVoiceCaptureMode.Live, session.SessionId);
                }
            }
            else
            {
                _ = await _captureModule!.InvokeAsync<string>(
                    "startCapture", _captureDotnetReference, mode == EllaiVoiceCaptureMode.Live, session.SessionId,
                    useBrowserLiveVoiceWebSocket
                        ? _speechPreferences.ApplyToVoiceUri(_reportVoiceCapture
                            ? ReviewClient.CreateReportVoiceWebSocketUri(new Uri(Navigation.BaseUri), session.SessionId, _liveVoiceCaptureId!)
                            : ReviewClient.CreateLiveVoiceWebSocketUri(new Uri(Navigation.BaseUri), session.SessionId, _liveVoiceCaptureId!)).ToString()
                        : string.Empty);
            }
            _nativeVoiceCaptureActive = useNativeLiveCapture;
            if (mode == EllaiVoiceCaptureMode.Live
                && (_liveVoiceChunks is not null || _browserLiveVoiceWebSocket))
            {
                await StartVoiceTurnStatusPollingAsync(session.SessionId);
            }
            _startingVoiceCapture = false;
            if (mode == EllaiVoiceCaptureMode.Live && !capturingAlongsidePlayback
                && !string.Equals(_greetedLiveSessionId, session.SessionId, StringComparison.Ordinal)
                && await PlayListeningGreetingAsync(session.SessionId))
            {
                _greetedLiveSessionId = session.SessionId;
            }
            if (mode == EllaiVoiceCaptureMode.Live && _liveVoiceReconnectRequired)
            {
                StatusText = "Reconnecting…";
            }
            else
            {
                StatusText = "Ready";
            }
            Phase = EllaiStatusPhases.Active;
            await InvokeAsync(StateHasChanged);
        }
        catch (Microsoft.JSInterop.JSException)
        {
            _isRecordingAudio = false;
            _startingVoiceCapture = false;
            await CancelLiveVoiceStreamAsync();
            DiscardCapturedAudio();
            StatusText = "Microphone access was denied or is unavailable. You can still type to Ellai.";
            Phase = EllaiStatusPhases.NeedsInput;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            _isRecordingAudio = false;
            _startingVoiceCapture = false;
            await CancelLiveVoiceStreamAsync();
            DiscardCapturedAudio();
            StatusText = "Voice capture could not be started. You can still type to Ellai.";
            Phase = EllaiStatusPhases.NeedsInput;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _startingVoiceCapture = false;
        }
    }

    private void StartLiveVoiceStream(string sessionId) =>
        StartLiveVoiceStreamCore(sessionId, isReconnect: false);

    private void StartBrowserLiveVoiceStream()
    {
        _browserLiveVoiceWebSocket = true;
        _liveVoiceCts = CancellationTokenSource.CreateLinkedTokenSource(
            _cts?.Token ?? CancellationToken.None);
        _browserVoiceStreamCompletion = new TaskCompletionSource<EllaiVoiceTranscriptionResult?>(
            TaskCreationOptions.RunContinuationsAsynchronously);
        _liveVoiceTranscriptionTask = _browserVoiceStreamCompletion.Task;
        _liveVoiceCaptureEnding = false;
        _ = ObserveLiveVoiceStreamAsync(_sessionView!.SessionId, _liveVoiceTranscriptionTask);
    }

    private void StartReconnectedLiveVoiceStream(string sessionId) =>
        StartLiveVoiceStreamCore(sessionId, isReconnect: true);

    private void StartLiveVoiceStreamCore(string sessionId, bool isReconnect)
    {
        _browserLiveVoiceWebSocket = false;
        _liveVoiceChunks = Channel.CreateBounded<byte[]>(new BoundedChannelOptions(8)
        {
            FullMode = BoundedChannelFullMode.Wait,
            SingleReader = true,
            SingleWriter = true,
            AllowSynchronousContinuations = false,
        });
        _liveVoiceStream = new PcmChannelReadStream(_liveVoiceChunks.Reader);
        _liveVoiceCts = CancellationTokenSource.CreateLinkedTokenSource(
            _cts?.Token ?? CancellationToken.None);
        _liveVoiceTranscriptionTask = _reportVoiceCapture
            ? ReviewClient.TranscribeReportLiveVoiceStreamAsync(sessionId, _liveVoiceStream, _liveVoiceCts.Token, _liveVoiceCaptureId)
            : ReviewClient.TranscribeLiveVoiceStreamAsync(sessionId, _liveVoiceStream, _liveVoiceCts.Token, _liveVoiceCaptureId);
        if (!isReconnect)
        {
            _liveVoiceReconnectRequired = false;
            _liveVoiceReplayBytesSent = 0;
        }
        _liveVoiceCaptureEnding = false;
        _ = ObserveLiveVoiceStreamAsync(sessionId, _liveVoiceTranscriptionTask);
    }

    private async Task ObserveLiveVoiceStreamAsync(
        string sessionId,
        Task<EllaiVoiceTranscriptionResult?> streamTask)
    {
        try
        {
            await streamTask.ConfigureAwait(false);
        }
        catch (Exception)
        {
            // Keep observing only for completion; the bounded capture copy can recover on stop.
        }

        if (_liveVoiceCaptureEnding || !ReferenceEquals(_liveVoiceTranscriptionTask, streamTask))
        {
            return;
        }

        _liveVoiceReconnectRequired = true;
        if (_voiceNetworkOnline)
        {
            try
            {
                if (await TryReconnectLiveVoiceStreamAsync(sessionId).ConfigureAwait(false))
                {
                    return;
                }
            }
            catch (Exception)
            {
                // Keep the in-memory copy available for the single stop-time upload fallback.
            }
        }
        try
        {
            await InvokeAsync(() =>
            {
                if (_isRecordingAudio && _captureMode == EllaiVoiceCaptureMode.Live
                    && _liveVoiceReconnectRequired
                    && string.Equals(_sessionView?.SessionId, sessionId, StringComparison.Ordinal))
                {
                    SetLiveVoiceRecoveryStatus();
                    StateHasChanged();
                }
            }).ConfigureAwait(false);
        }
        catch (Exception)
        {
            // Component disposal can race an advisory connection status update.
        }
    }

    private void SetLiveVoiceRecoveryStatus()
    {
        StatusText = "Reconnecting…";
        Phase = EllaiStatusPhases.Active;
    }

    private void EnterLiveVoiceRecovery()
    {
        _liveVoiceReconnectRequired = true;
        _liveVoiceChunks?.Writer.TryComplete();
        _ = InvokeAsync(() =>
        {
            if (_isRecordingAudio && _captureMode == EllaiVoiceCaptureMode.Live
                && _liveVoiceReconnectRequired)
            {
                SetLiveVoiceRecoveryStatus();
                StateHasChanged();
            }
        });
    }

    private async Task<bool> TryReconnectLiveVoiceStreamAsync(string sessionId)
    {
        if (!_voiceNetworkOnline || _liveVoiceCaptureEnding || _liveVoiceReconnectAttempts >= 1)
        {
            return false;
        }

        await _liveVoiceReplayGate.WaitAsync().ConfigureAwait(false);
        try
        {
            if (!_voiceNetworkOnline || _liveVoiceCaptureEnding || !_isRecordingAudio
                || _liveVoiceReconnectAttempts >= 1
                || !string.Equals(_sessionView?.SessionId, sessionId, StringComparison.Ordinal))
            {
                return false;
            }

            _liveVoiceReconnectAttempts++;
            _liveVoiceReconnectRequired = true;
            if (_browserLiveVoiceWebSocket)
            {
                _browserVoiceStreamCompletion?.TrySetResult(null);
                if (_liveVoiceTranscriptionTask is not null)
                {
                    await _liveVoiceTranscriptionTask.ConfigureAwait(false);
                }

                _liveVoiceCts?.Dispose();
                _liveVoiceCts = CancellationTokenSource.CreateLinkedTokenSource(
                    _cts?.Token ?? CancellationToken.None);
                _browserVoiceStreamCompletion = new TaskCompletionSource<EllaiVoiceTranscriptionResult?>(
                    TaskCreationOptions.RunContinuationsAsynchronously);
                _liveVoiceTranscriptionTask = _browserVoiceStreamCompletion.Task;
                _liveVoiceCaptureEnding = false;
                _ = ObserveLiveVoiceStreamAsync(sessionId, _liveVoiceTranscriptionTask);

                var replay = SnapshotCapturedAudio();
                try
                {
                    var socketUrl = _speechPreferences.ApplyToVoiceUri(_reportVoiceCapture
                        ? ReviewClient.CreateReportVoiceWebSocketUri(new Uri(Navigation.BaseUri), sessionId, _liveVoiceCaptureId!, 0)
                        : ReviewClient.CreateLiveVoiceWebSocketUri(new Uri(Navigation.BaseUri), sessionId, _liveVoiceCaptureId!, 0)).ToString();
                    var connected = await _captureModule!.InvokeAsync<bool>(
                        "reconnectVoiceStream", socketUrl, replay).ConfigureAwait(false);
                    if (!connected)
                    {
                        return false;
                    }
                    _liveVoiceReplayBytesSent = replay.Length;
                }
                finally
                {
                    Array.Clear(replay);
                }
            }
            else
            {
            await StopLiveVoiceStreamForReconnectAsync().ConfigureAwait(false);
            if (!_voiceNetworkOnline || _liveVoiceCaptureEnding)
            {
                return false;
            }

            StartReconnectedLiveVoiceStream(sessionId);
            var replay = SnapshotCapturedAudio();
            _liveVoiceReplayBytesSent = 0;
            try
            {
                for (var offset = 0; offset < replay.Length;)
                {
                    var count = Math.Min(8_192, replay.Length - offset);
                    var chunk = replay.AsSpan(offset, count).ToArray();
                    if (!await WriteLiveVoiceChunkAsync(chunk, _liveVoiceCts?.Token ?? CancellationToken.None)
                            .ConfigureAwait(false))
                    {
                        Array.Clear(chunk);
                        EnterLiveVoiceRecovery();
                        return false;
                    }

                    offset += count;
                    _liveVoiceReplayBytesSent = offset;
                }
            }
            finally
            {
                Array.Clear(replay);
            }
            }

            if (!_voiceNetworkOnline || _liveVoiceTranscriptionTask?.IsCompleted != false)
            {
                EnterLiveVoiceRecovery();
                return false;
            }

            _liveVoiceReconnectRequired = false;
            StatusText = "Ready";
            Phase = EllaiStatusPhases.Active;
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
            return true;
        }
        catch (Exception)
        {
            EnterLiveVoiceRecovery();
            return false;
        }
        finally
        {
            _liveVoiceReplayGate.Release();
        }
    }

    private async Task StopLiveVoiceStreamForReconnectAsync()
    {
        _liveVoiceCts?.Cancel();
        _liveVoiceChunks?.Writer.TryComplete();
        try
        {
            if (_liveVoiceTranscriptionTask is not null)
            {
                await _liveVoiceTranscriptionTask.ConfigureAwait(false);
            }
        }
        catch
        {
            // A failed stream is replaced by a fresh server epoch below.
        }
        await ReleaseLiveVoiceStreamAsync().ConfigureAwait(false);
    }

    private async Task<bool> WriteLiveVoiceChunkAsync(byte[] chunk, CancellationToken cancellationToken)
    {
        var channel = _liveVoiceChunks;
        if (channel is null || _liveVoiceTranscriptionTask?.IsCompleted != false)
        {
            return false;
        }

        using var enqueueCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
        enqueueCts.CancelAfter(EllaiLiveVoiceChunkEnqueueTimeout);
        try
        {
            await channel.Writer.WriteAsync(chunk, enqueueCts.Token).ConfigureAwait(false);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private (byte[] Audio, long StartSample) GetUncompletedLiveVoiceAudio(
        byte[] capturedAudio, EllaiVoiceTurnStatusDto? status)
    {
        var completedTurns = status?.CompletedTurns?
            .Where(turn => string.Equals(turn.Kind, "TurnCompleted", StringComparison.Ordinal)
                && (turn.SessionId is null
                    || string.Equals(turn.SessionId, _sessionView?.SessionId, StringComparison.Ordinal)))
            .OrderByDescending(turn => turn.Sequence)
            .ToArray() ?? [];

        var captureTurns = completedTurns.Where(turn => string.Equals(
            turn.VoiceCaptureId, _liveVoiceCaptureId, StringComparison.Ordinal)).ToArray();
        if (captureTurns.Length == 0
            && completedTurns.Length > 0
            && completedTurns.All(turn => !string.IsNullOrWhiteSpace(turn.VoiceCaptureId)))
        {
            return (capturedAudio.ToArray(), 0);
        }

        if (captureTurns.Length == 0 && (completedTurns.Length > 0 || _lastCompletedVoiceTurnSequence > 0))
        {
            return ([], 0);
        }

        var latestCompletedTurn = captureTurns.FirstOrDefault();
        if (latestCompletedTurn is null && _lastCompletedVoiceTurnSequence == 0)
        {
            return (capturedAudio.ToArray(), 0);
        }
        if (latestCompletedTurn is null || latestCompletedTurn.AudioEndSample < 0)
        {
            return ([], 0);
        }

        var startByteLong = latestCompletedTurn.AudioEndSample * sizeof(short);
        var startByte = (int)Math.Clamp(startByteLong, 0, capturedAudio.Length);
        return (capturedAudio.AsSpan(startByte).ToArray(), latestCompletedTurn.AudioEndSample);
    }

    private async Task QueueLiveVoiceChunkAsync(byte[] bytes, long offset, CancellationToken cancellationToken)
    {
        await _liveVoiceReplayGate.WaitAsync(cancellationToken).ConfigureAwait(false);
        try
        {
            if (_liveVoiceReconnectRequired || _liveVoiceChunks is null)
            {
                Array.Clear(bytes);
                return;
            }

            var end = offset + bytes.Length;
            if (end <= _liveVoiceReplayBytesSent)
            {
                Array.Clear(bytes);
                return;
            }
            if (offset != _liveVoiceReplayBytesSent
                || !await WriteLiveVoiceChunkAsync(bytes, cancellationToken).ConfigureAwait(false))
            {
                EnterLiveVoiceRecovery();
                Array.Clear(bytes);
                return;
            }

            _liveVoiceReplayBytesSent = end;
        }
        catch (OperationCanceledException)
        {
            EnterLiveVoiceRecovery();
            Array.Clear(bytes);
        }
        finally
        {
            _liveVoiceReplayGate.Release();
        }
    }

    private async Task CancelLiveVoiceStreamAsync()
    {
        if (_browserLiveVoiceWebSocket && _captureModule is not null)
        {
            try
            {
                await _captureModule.InvokeVoidAsync("closeVoiceStream").ConfigureAwait(false);
            }
            catch (Microsoft.JSInterop.JSException)
            {
                // The capture module may already be disposed during navigation.
            }
        }
        _browserVoiceStreamCompletion?.TrySetResult(null);
        _liveVoiceCts?.Cancel();
        if (_nativeVoiceCaptureActive && _nativeVoiceCapture is not null)
        {
            try
            {
                await _nativeVoiceCapture.StopAsync().ConfigureAwait(false);
            }
            catch
            {
                // Cancellation discards the transient turn after a device read failure.
            }
            _nativeVoiceCaptureActive = false;
        }
        _liveVoiceChunks?.Writer.TryComplete();
        try
        {
            _liveVoiceCts?.Cancel();
            if (_liveVoiceTranscriptionTask is not null)
            {
                await _liveVoiceTranscriptionTask.ConfigureAwait(false);
            }
        }
        catch
        {
            // Cancellation and transport failures both discard the partial turn.
        }
        finally
        {
            await ReleaseLiveVoiceStreamAsync();
            _otherNativeBargeInDetector?.Dispose();
            _otherNativeBargeInDetector = null;
            _captureEchoCancellationEnabled = false;
            _nativeGlowLevel = 0;
            if (_captureModule is not null)
            {
                try { await _captureModule.InvokeVoidAsync("setNativeVoiceLevel", 0); }
                catch (Microsoft.JSInterop.JSException) { }
                catch (Microsoft.JSInterop.JSDisconnectedException) { }
            }
        }
    }

    private Task ReleaseLiveVoiceStreamAsync()
    {
        _liveVoiceStream?.Dispose();
        _liveVoiceStream = null;
        _liveVoiceChunks = null;
        _liveVoiceTranscriptionTask = null;
        _browserVoiceStreamCompletion = null;
        _browserLiveVoiceWebSocket = false;
        _liveVoiceCts?.Dispose();
        _liveVoiceCts = null;
        return Task.CompletedTask;
    }

    private async Task StartVoiceTurnStatusPollingAsync(string sessionId)
    {
        await StopVoiceTurnStatusPollingAsync();
        var statusCts = CancellationTokenSource.CreateLinkedTokenSource(
            _cts?.Token ?? CancellationToken.None);
        _voiceTurnStatusCts = statusCts;
        _voiceTurnStatusTask = PollVoiceTurnStatusAsync(sessionId, statusCts);
    }

    private async Task PollVoiceTurnStatusAsync(string sessionId, CancellationTokenSource statusCts)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));
            do
            {
                var status = await ReviewClient.GetVoiceTurnStatusAsync(
                    sessionId, statusCts.Token, Volatile.Read(ref _lastCompletedVoiceTurnSequence))
                    .ConfigureAwait(false);
                if (status is not null && status.Epoch > 0
                    && (status.SessionId is null
                        || string.Equals(status.SessionId, sessionId, StringComparison.Ordinal)))
                {
                    await InvokeAsync(async () =>
                    {
                        if (!_isRecordingAudio || _captureMode != EllaiVoiceCaptureMode.Live
                            || !string.Equals(_sessionView?.SessionId, sessionId, StringComparison.Ordinal))
                        {
                            return;
                        }

                        if (status.Epoch < _lastVoiceTurnStatusEpoch)
                        {
                            return;
                        }
                        _lastVoiceTurnStatusEpoch = Math.Max(_lastVoiceTurnStatusEpoch, status.Epoch);

                        var changed = false;
                        if (!string.Equals(_livePartialVoiceTranscript, status.PartialTranscript,
                                StringComparison.Ordinal))
                        {
                            _livePartialVoiceTranscript = status.PartialTranscript;
                            changed = true;
                        }

                        if (_liveVoiceReconnectRequired)
                        {
                            var recoveryText = "Reconnecting…";
                            if (!string.Equals(StatusText, recoveryText, StringComparison.Ordinal))
                            {
                                StatusText = recoveryText;
                                Phase = EllaiStatusPhases.Active;
                                changed = true;
                            }

                            if (changed)
                            {
                                StateHasChanged();
                            }

                            return;
                        }

                        if (_isPlayingResponse
                            && string.Equals(status.State, "UserSpeaking", StringComparison.Ordinal))
                        {
                            // Native mobile playback cannot receive the browser's local
                            // acoustic barge-in callback. Stop it as soon as the Gateway
                            // confirms speech for this live turn.
                            StopResponseAudio();
                            changed = true;
                        }

                        if (GetVoiceTurnStatusText(status.State) is { } text
                            && !string.Equals(StatusText, text, StringComparison.Ordinal))
                        {
                            StatusText = text;
                            Phase = EllaiStatusPhases.Active;
                            changed = true;
                        }

                        if (changed)
                        {
                            StateHasChanged();
                        }

                        await SubmitConfirmedGatewayVoiceTurnsAsync(status, sessionId);
                    }).ConfigureAwait(false);
                }
            }
            while (await timer.WaitForNextTickAsync(statusCts.Token).ConfigureAwait(false));
        }
        catch (OperationCanceledException) when (statusCts.IsCancellationRequested)
        {
        }
        catch (Exception)
        {
            // Status polling is advisory; capture and final transcription continue.
        }
        finally
        {
            if (ReferenceEquals(_voiceTurnStatusCts, statusCts))
            {
                _voiceTurnStatusCts = null;
                _voiceTurnStatusTask = null;
            }
            statusCts.Dispose();
        }
    }

    private async Task SubmitConfirmedGatewayVoiceTurnsAsync(
        EllaiVoiceTurnStatusDto status,
        string sessionId,
        bool allowClosedCapture = false)
    {
        if ((!_isRecordingAudio && !allowClosedCapture) || _captureMode != EllaiVoiceCaptureMode.Live
            || !string.Equals(_sessionView?.SessionId, sessionId, StringComparison.Ordinal)
            || status.CompletedTurns is null)
        {
            return;
        }

        foreach (var completedTurn in status.CompletedTurns.OrderBy(turn => turn.Sequence))
        {
            if (completedTurn.Sequence <= _lastCompletedVoiceTurnSequence
                || !string.Equals(completedTurn.Kind, "TurnCompleted", StringComparison.Ordinal)
                || (completedTurn.SessionId is not null
                    && !string.Equals(completedTurn.SessionId, sessionId, StringComparison.Ordinal))
                || completedTurn.StreamEpoch > status.Epoch
                || string.IsNullOrWhiteSpace(completedTurn.Transcript))
            {
                continue;
            }

            // A pending server admission must not advance the replay cursor.
            if (completedTurn.ServerSubmission && completedTurn.Admission is null) break;
            _lastCompletedVoiceTurnSequence = completedTurn.Sequence;
            var transcript = completedTurn.Transcript.Trim();
            QueueReportVoiceTurn(sessionId, completedTurn.TurnId ?? completedTurn.ProviderTurnId, completedTurn.VoiceCaptureId, transcript);
            if (_reportVoiceCapture && string.Equals(completedTurn.VoiceCaptureId, _liveVoiceCaptureId, StringComparison.Ordinal))
                continue;
            if (completedTurn.ServerSubmission)
            {
                ReconcileVoiceAdmission(completedTurn.TurnId, transcript, completedTurn.Admission);
                continue;
            }
            InputText = transcript;
            if (Guid.TryParseExact(completedTurn.TurnId, "N", out var turnId)
                || Guid.TryParse(completedTurn.TurnId, out turnId))
            {
                _pendingUtteranceId = turnId.ToString("N");
                _pendingUtteranceText = transcript;
            }
            _submissionCorrectionRequired = false;
            StatusText = "Voice turn confirmed. Ellai is responding…";
            Phase = EllaiStatusPhases.Active;
            StateHasChanged();
            await SendConfirmedVoiceAsync();
        }
    }

    private void ReconcileVoiceAdmission(string? utteranceId, string transcript, EllaiUtteranceSubmitResult? result)
    {
        if (_sessionView is null || string.IsNullOrWhiteSpace(utteranceId)) return;
        if (result?.Session is { } updated
            && string.Equals(updated.SessionId, _sessionView.SessionId, StringComparison.Ordinal))
        {
            if (updated.SessionVersion < _sessionView.SessionVersion && _lastDurableTurn is not null
                && _lastDurableTurn.ClientUtteranceId != utteranceId) return;
            if (updated.SessionVersion >= _sessionView.SessionVersion) _sessionView = updated;
        }
        if (result?.Status == EllaiClientOperationStatus.Accepted)
        {
            ShowLatestUserMessage(utteranceId, transcript);
            if (_settledUtteranceId != utteranceId) _thinkingUtteranceId = utteranceId;
            StatusText = "Ready";
            Phase = EllaiStatusPhases.Active;
        }
        else
        {
            // Keep the stable identity on retry, including an ambiguous commit result.
            // Never overwrite a typed draft while reconciling a voice failure.
            if (string.IsNullOrWhiteSpace(InputText))
            {
                InputText = transcript;
                _pendingUtteranceId = utteranceId;
                _pendingUtteranceText = transcript;
            }
            StatusText = "Couldn't send your voice message. Try again.";
            Phase = EllaiStatusPhases.NeedsInput;
        }
        StateHasChanged();
    }

    private async Task StopVoiceTurnStatusPollingAsync()
    {
        var statusCts = _voiceTurnStatusCts;
        var statusTask = _voiceTurnStatusTask;
        if (statusCts is null)
        {
            return;
        }

        statusCts.Cancel();
        if (statusTask is not null)
        {
            try
            {
                await statusTask.ConfigureAwait(false);
            }
            catch (OperationCanceledException)
            {
            }
        }
    }

    private static string? GetVoiceTurnStatusText(string state) => state switch
    {
        "Listening" or "SpeechCandidate" or "UserSpeaking" or "EndpointCandidate"
            or "Processing" or "AssistantSpeaking" or "Interrupted" => "Ready",
        "Recovering" => "Reconnecting…",
        _ => null,
    };

    private async Task LoadSpeechPreferencesAsync()
    {
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import",
                "./_content/SwiftAid.UI/js/ellai-language-preferences.js");
            var preferences = await module.InvokeAsync<EllaiLanguagePreferences>("load");
            _speechPreferences = preferences is not null && preferences.IsValid() ? preferences : new();
        }
        catch (JSException) { _speechPreferences = new(); }
        ReviewClient.ConfigureSpeechPreferences(_speechPreferences);
    }

    private async Task<bool> PlayListeningGreetingAsync(string sessionId)
    {
        try
        {
            if (ReviewClient.UsesGatewayPcmAudioDownload)
            {
                var audio = await ReviewClient.DownloadListeningGreetingAudioAsync(
                    sessionId, _cts?.Token ?? CancellationToken.None);
                var player = Services.GetService<IEllaiPcmAudioPlayer>();
                if (audio is null || player is null || !player.IsAvailable
                    || audio.Sequence != 0
                    || !string.Equals(audio.VoiceId, "swiftaid-mms-english-v1", StringComparison.Ordinal))
                {
                    return false;
                }

                await player.PlayAsync(audio.Pcm, audio.SampleRate, _cts?.Token ?? CancellationToken.None);
                return true;
            }

            _speechModule ??= await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                "import", "./_content/SwiftAid.UI/js/ellai-audio-playback.js");
            await _speechModule.InvokeVoidAsync("playListeningGreeting", sessionId, _speechPreferences.EnglishVoiceId);
            return true;
        }
        catch (OperationCanceledException) when (_cts?.IsCancellationRequested == true)
        {
            // Session cancellation owns playback and prevents capture from starting.
            return false;
        }
        catch (Exception)
        {
            // Keep the visible greeting and allow the typed composer to remain usable.
            return false;
        }
    }

    [Microsoft.JSInterop.JSInvokable]
    public async Task ReceiveVoicePcmChunk(int[] samples)
    {
        if (!_isRecordingAudio || samples is null || samples.Length > 4096)
        {
            return;
        }

        var bytes = new byte[samples.Length * sizeof(short)];
        for (var index = 0; index < samples.Length; index++)
        {
            var sample = (short)Math.Clamp(samples[index], short.MinValue, short.MaxValue);
            BinaryPrimitives.WriteInt16LittleEndian(bytes.AsSpan(index * sizeof(short), sizeof(short)), sample);
        }
        if (!TryAppendCapturedAudio(bytes, out var offset))
        {
            Array.Clear(bytes);
            _ = InvokeAsync(StopVoiceCaptureAsync);
            return;
        }


        if (_captureMode == EllaiVoiceCaptureMode.Live && _liveVoiceChunks is not null)
        {
            if (_liveVoiceTranscriptionTask?.IsCompleted == true)
            {
                EnterLiveVoiceRecovery();
            }
            await QueueLiveVoiceChunkAsync(bytes, offset, _liveVoiceCts?.Token ?? CancellationToken.None)
                .ConfigureAwait(false);
        }
        else
        {
            Array.Clear(bytes);
        }

    }

    private async ValueTask QueueNativePcmChunkAsync(
        ReadOnlyMemory<byte> pcm,
        CancellationToken cancellationToken)
    {
        if (!_isRecordingAudio || pcm.Length is 0 or > 8_192
            || (pcm.Length & 1) != 0)
        {
            return;
        }

        var bytes = pcm.ToArray();
        if (_captureMode == EllaiVoiceCaptureMode.Recorded)
        {
            if (!TryAppendCapturedAudio(bytes, out _)) _ = InvokeAsync(StopVoiceCaptureAsync);
            Array.Clear(bytes);
            return;
        }
        if (_captureMode != EllaiVoiceCaptureMode.Live)
        {
            Array.Clear(bytes);
            return;
        }
        ObserveOtherNativeBargeIn(bytes);
        await UpdateNativeVoiceGlowAsync(bytes);
        if (!TryAppendCapturedAudio(bytes, out var offset))
        {
            Array.Clear(bytes);
            _ = InvokeAsync(StopVoiceCaptureAsync);
            return;
        }
        if (_liveVoiceChunks is null)
        {
            Array.Clear(bytes);
            return;
        }

        if (_liveVoiceTranscriptionTask?.IsCompleted == true)
        {
            EnterLiveVoiceRecovery();
        }
        await QueueLiveVoiceChunkAsync(bytes, offset, cancellationToken).ConfigureAwait(false);
    }

    [Microsoft.JSInterop.JSInvokable]
    public Task OnVoiceCaptureLimitReached() => InvokeAsync(StopVoiceCaptureAsync);

    [Microsoft.JSInterop.JSInvokable]
    public Task OnVoiceWebSocketClosed(int closeCode, bool wasClean)
    {
        _browserVoiceStreamCompletion?.TrySetResult(null);
        if (_isRecordingAudio && !_liveVoiceCaptureEnding && _browserLiveVoiceWebSocket)
        {
            EnterLiveVoiceRecovery();
        }
        return Task.CompletedTask;
    }

    [Microsoft.JSInterop.JSInvokable]
    public Task OnVoiceAudioProcessingChanged(EllaiAudioProcessingStatus status)
    {
        _audioProcessingStatus = status ?? EllaiAudioProcessingStatus.Unknown;
        _captureEchoCancellationEnabled = _audioProcessingStatus.EchoCancellationEnabled == true;
        return Task.CompletedTask;
    }

    [Microsoft.JSInterop.JSInvokable]
    public Task OnVoiceConnectivityChanged(bool isOnline) => InvokeAsync(async () =>
    {
        if (_voiceNetworkOnline == isOnline)
        {
            return;
        }

        _voiceNetworkOnline = isOnline;
        if (!_isRecordingAudio || _captureMode != EllaiVoiceCaptureMode.Live)
        {
            return;
        }

        if (!isOnline)
        {
            EnterLiveVoiceRecovery();
            return;
        }

        if (_liveVoiceReconnectRequired && _sessionView is not null
            && await TryReconnectLiveVoiceStreamAsync(_sessionView.SessionId))
        {
            return;
        }

        if (_liveVoiceReconnectRequired)
        {
            StatusText = "Ready";
            Phase = EllaiStatusPhases.Active;
            StateHasChanged();
        }
    });

    [Microsoft.JSInterop.JSInvokable]
    public Task OnVoiceCaptureBackpressure() => InvokeAsync(async () =>
    {
        if (_captureMode == EllaiVoiceCaptureMode.Live && _isRecordingAudio)
        {
            EnterLiveVoiceRecovery();
            if (_sessionView is { } session)
            {
                _ = TryReconnectLiveVoiceStreamAsync(session.SessionId);
            }
            return;
        }

        if (_captureModule is not null)
        {
            await _captureModule.InvokeVoidAsync("cancelCapture");
        }
        _isRecordingAudio = false;
        if (_reportVoiceCapture) _reportVoiceContext?.MarkVoiceStopped(failed: true);
        await StopVoiceTurnStatusPollingAsync();
        await CancelLiveVoiceStreamAsync();
        DiscardCapturedAudio();
        StatusText = "Voice capture paused because audio could not be sent reliably. Try again or type your message.";
        Phase = EllaiStatusPhases.NeedsInput;
        await InvokeAsync(StateHasChanged);
    });

    private void OnNativeVoiceCaptureInterrupted(string message)
    {
        _ = InvokeAsync(async () =>
        {
            if (!_nativeVoiceCaptureActive)
            {
                return;
            }

            _isRecordingAudio = false;
            if (_reportVoiceCapture) _reportVoiceContext?.MarkVoiceStopped(failed: true);
            await StopVoiceTurnStatusPollingAsync();
            await CancelLiveVoiceStreamAsync();
            _nativeVoiceCaptureActive = false;
            DiscardCapturedAudio();
            StatusText = message;
            Phase = EllaiStatusPhases.NeedsInput;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void OnNativeVoiceRouteChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (_nativeVoiceCaptureActive)
            {
                _audioProcessingStatus = _nativeVoiceCapture?.AudioProcessingStatus
                    ?? EllaiAudioProcessingStatus.Unknown;
                _captureEchoCancellationEnabled = _audioProcessingStatus.EchoCancellationEnabled == true;
                StatusText = $"Microphone route changed; capture continues. {_audioProcessingStatus.ToStatusText()}";
                StateHasChanged();
            }
        });
    }

    private const int EllaiVoiceTranscriptionMaximumBytes = 32 * 1024 * 1024;
    private static readonly TimeSpan EllaiLiveVoiceChunkEnqueueTimeout = TimeSpan.FromMilliseconds(500);

    private bool TryAppendCapturedAudio(byte[] bytes, out long offset)
    {
        lock (_capturedPcmGate)
        {
            offset = _capturedVoiceBytes;
            if (_capturedPcm is null || bytes.Length == 0
                || _capturedVoiceBytes + bytes.Length > EllaiVoiceTranscriptionMaximumBytes)
            {
                return false;
            }

            _capturedPcm.Write(bytes);
            _capturedVoiceBytes += bytes.Length;
            return true;
        }
    }

    private byte[] SnapshotCapturedAudio()
    {
        lock (_capturedPcmGate)
        {
            return _capturedPcm?.ToArray() ?? [];
        }
    }

    private async Task StopVoiceCaptureAsync()
    {
        if (!_isRecordingAudio || _voiceTranscriptionInProgress)
        {
            return;
        }

        byte[]? capturedAudio = null;
        _voiceTranscriptionInProgress = true;
        _liveVoiceCaptureEnding = true;
        try
        {
            if (_nativeVoiceCaptureActive && _nativeVoiceCapture is not null)
            {
                await _nativeVoiceCapture.StopAsync();
                _nativeVoiceCaptureActive = false;
            }
            else if (_captureModule is not null)
            {
                await _captureModule.InvokeVoidAsync("stopCapture");
            }
            _isRecordingAudio = false;
            await StopVoiceTurnStatusPollingAsync();
            await _liveVoiceReplayGate.WaitAsync().ConfigureAwait(false);
            _liveVoiceReplayGate.Release();
            var session = _sessionView;
            var mode = _captureMode;
            capturedAudio = SnapshotCapturedAudio();
            if (session is null || mode is null || capturedAudio.Length == 0)
            {
                Array.Clear(capturedAudio);
                StatusText = "No audio was captured. You can type to Ellai.";
                Phase = EllaiStatusPhases.NeedsInput;
                return;
            }

            StatusText = "Connecting…";
            Phase = EllaiStatusPhases.Active;
            await InvokeAsync(StateHasChanged);
            EllaiVoiceTranscriptionResult? result;
            var usedLiveVoiceUploadRecovery = false;
            if (mode == EllaiVoiceCaptureMode.Live)
            {
                _liveVoiceChunks?.Writer.TryComplete();
                try
                {
                    result = _liveVoiceTranscriptionTask is null
                        ? null
                        : await _liveVoiceTranscriptionTask.ConfigureAwait(false);
                }
                catch (Exception)
                {
                    result = null;
                }

                var finalStatus = await ReviewClient.GetVoiceTurnStatusAsync(
                    session.SessionId, _cts?.Token ?? CancellationToken.None, afterSequence: 0)
                    .ConfigureAwait(false);
                if (finalStatus is not null)
                {
                    await InvokeAsync(() => SubmitConfirmedGatewayVoiceTurnsAsync(
                        finalStatus, session.SessionId, allowClosedCapture: true));
                }

                {
                    var pendingAudio = GetUncompletedLiveVoiceAudio(capturedAudio, finalStatus);
                    if (pendingAudio.Audio.Length > 0
                        && _liveVoiceReconnectRequired)
                    {
                        usedLiveVoiceUploadRecovery = true;
                        StatusText = "Reconnecting…";
                        await InvokeAsync(StateHasChanged);
                        try
                        {
                            _ = _reportVoiceCapture
                                ? await ReviewClient.TranscribeReportVoiceAsync(
                                    session.SessionId, pendingAudio.Audio, EllaiVoiceCaptureMode.Live,
                                    _cts?.Token ?? CancellationToken.None, _liveVoiceCaptureId, pendingAudio.StartSample).ConfigureAwait(false)
                                : await ReviewClient.TranscribeVoiceAsync(
                                session.SessionId,
                                pendingAudio.Audio,
                                EllaiVoiceCaptureMode.Live,
                                _cts?.Token ?? CancellationToken.None,
                                _liveVoiceCaptureId,
                                pendingAudio.StartSample).ConfigureAwait(false);
                        }
                        finally
                        {
                            Array.Clear(pendingAudio.Audio);
                        }

                        finalStatus = await ReviewClient.GetVoiceTurnStatusAsync(
                            session.SessionId, _cts?.Token ?? CancellationToken.None, afterSequence: 0)
                            .ConfigureAwait(false);
                        if (finalStatus is not null)
                        {
                            await InvokeAsync(() => SubmitConfirmedGatewayVoiceTurnsAsync(
                                finalStatus, session.SessionId, allowClosedCapture: true));
                        }
                    }
                }

                Array.Clear(capturedAudio);
                await ReleaseLiveVoiceStreamAsync();
                result = null;

                if (finalStatus is not null && _lastCompletedVoiceTurnSequence == 0 && !_submittingUtterance
                    && !_isPlayingResponse)
                {
                    StatusText = usedLiveVoiceUploadRecovery
                        ? "Couldn't send your voice message. Try again or type your message."
                        : "No completed voice turn came through. Try again or type your message.";
                    Phase = EllaiStatusPhases.NeedsInput;
                }
                return;
            }
            else
            {
                var payload = CreateWavePayload(capturedAudio);
                Array.Clear(capturedAudio);
                try
                {
                    result = _reportVoiceCapture
                        ? await ReviewClient.TranscribeReportVoiceAsync(session.SessionId, payload, mode.Value, CancellationToken.None, _liveVoiceCaptureId).ConfigureAwait(false)
                        : await ReviewClient.TranscribeVoiceAsync(session.SessionId, payload, mode.Value, CancellationToken.None, _liveVoiceCaptureId).ConfigureAwait(false);
                }
                finally
                {
                    Array.Clear(payload);
                }
            }

            if (result is null || string.IsNullOrWhiteSpace(result.Transcript))
            {
                if (usedLiveVoiceUploadRecovery)
                {
                    StatusText = "Couldn't send your voice message. Try again or type your message.";
                    Phase = EllaiStatusPhases.NeedsInput;
                    return;
                }

                var failedTurnStatus = mode == EllaiVoiceCaptureMode.Live
                    ? await ReviewClient.GetVoiceTurnStatusAsync(
                        session.SessionId, _cts?.Token ?? CancellationToken.None).ConfigureAwait(false)
                    : null;
                StatusText = failedTurnStatus is not null
                    ? GetVoiceTurnStatusText(failedTurnStatus.State)
                        ?? "That voice turn didn't come through. Please try again or type your message."
                    : "That voice turn didn't come through. Please try again or type your message.";
                Phase = EllaiStatusPhases.NeedsInput;
                return;
            }

            var transcript = result.Transcript.Trim();
            QueueReportVoiceTurn(session.SessionId, result.ClientUtteranceId ?? _liveVoiceCaptureId ?? Guid.NewGuid().ToString("N"), _liveVoiceCaptureId, transcript);
            if (_reportVoiceCapture) return;
            if (result.ServerSubmission)
            {
                await InvokeAsync(() => ReconcileVoiceAdmission(result.ClientUtteranceId, transcript, result.Admission));
                return;
            }
            var canAutoSubmitVoiceTurn = string.IsNullOrWhiteSpace(InputText);
            InputText = string.IsNullOrWhiteSpace(InputText)
                ? transcript
                : $"{InputText.TrimEnd()}\n{transcript}";
            _submissionCorrectionRequired = false;
            if (canAutoSubmitVoiceTurn)
            {
                StatusText = mode == EllaiVoiceCaptureMode.Live
                    ? "Voice turn transcribed. Ellai is responding…"
                    : "Recording transcribed. Ellai is responding…";
                Phase = EllaiStatusPhases.Active;
                await InvokeAsync(StateHasChanged);
                await InvokeAsync(SendConfirmedVoiceAsync);
            }
            else if (mode == EllaiVoiceCaptureMode.Live)
            {
                StatusText = "Voice turn transcribed. Review the words and existing draft before selecting Send.";
                Phase = EllaiStatusPhases.NeedsInput;
            }
            else
            {
                StatusText = "Transcript added to the composer. Review it before selecting Send.";
                Phase = EllaiStatusPhases.NeedsInput;
            }
        }
        catch (Microsoft.JSInterop.JSException)
        {
            StatusText = "Microphone capture could not be completed. You can still type to Ellai.";
            Phase = EllaiStatusPhases.NeedsInput;
        }
        catch (OperationCanceledException)
        {
            StatusText = "Voice transcription was canceled. You can still type to Ellai.";
            Phase = EllaiStatusPhases.NeedsInput;
        }
        catch (Exception)
        {
            StatusText = "Voice transcription could not be completed. You can still type to Ellai.";
            Phase = EllaiStatusPhases.NeedsInput;
        }
        finally
        {
            if (capturedAudio is not null)
            {
                Array.Clear(capturedAudio);
            }
            _isRecordingAudio = false;
            _voiceTranscriptionInProgress = false;
            _captureMode = null;
            if (_reportVoiceCapture) _reportVoiceContext?.MarkVoiceStopped();
            _liveVoiceCaptureEnding = true;
            if (_liveVoiceChunks is not null || _browserLiveVoiceWebSocket)
            {
                await CancelLiveVoiceStreamAsync();
            }
            DiscardCapturedAudio();
            await InvokeAsync(StateHasChanged);
        }
    }

    private static byte[] CreateWavePayload(byte[] pcm)
    {
        var wav = new byte[44 + pcm.Length];
        "RIFF"u8.CopyTo(wav);
        BinaryPrimitives.WriteInt32LittleEndian(wav.AsSpan(4, 4), wav.Length - 8);
        "WAVEfmt "u8.CopyTo(wav.AsSpan(8, 8));
        BinaryPrimitives.WriteInt32LittleEndian(wav.AsSpan(16, 4), 16);
        BinaryPrimitives.WriteInt16LittleEndian(wav.AsSpan(20, 2), 1);
        BinaryPrimitives.WriteInt16LittleEndian(wav.AsSpan(22, 2), 1);
        BinaryPrimitives.WriteInt32LittleEndian(wav.AsSpan(24, 4), 24000);
        BinaryPrimitives.WriteInt32LittleEndian(wav.AsSpan(28, 4), 48000);
        BinaryPrimitives.WriteInt16LittleEndian(wav.AsSpan(32, 2), 2);
        BinaryPrimitives.WriteInt16LittleEndian(wav.AsSpan(34, 2), 16);
        "data"u8.CopyTo(wav.AsSpan(36, 4));
        BinaryPrimitives.WriteInt32LittleEndian(wav.AsSpan(40, 4), pcm.Length);
        pcm.CopyTo(wav, 44);
        return wav;
    }

    private void DiscardCapturedAudio()
    {
        _livePartialVoiceTranscript = null;
        lock (_capturedPcmGate)
        {
            if (_capturedPcm is not null)
            {
                if (_capturedPcm.TryGetBuffer(out var buffer))
                {
                    Array.Clear(buffer.Array!, buffer.Offset, buffer.Count);
                }
                _capturedPcm.Dispose();
                _capturedPcm = null;
            }
            _capturedVoiceBytes = 0;
        }
    }

    /// <summary>Binds trusted runtime progress to the composer status line.
    /// Coordinator phases map onto the canonical label set; unknown phases
    /// keep the current label while the template text still updates.</summary>
    internal static string? MapActivityPhase(string phase) => phase switch
    {
        "blocked" => EllaiStatusPhases.Blocked,
        "approval" => EllaiStatusPhases.NeedsInput,
        "done" or "cancelled" => EllaiStatusPhases.Ready,
        "working" or "reading" or "reviewing" or "opening" or "verifying"
            => EllaiStatusPhases.Active,
        _ => null,
    };

    private void OnActivityUpdated(string phase, string text)
    {
        _ = InvokeAsync(() =>
        {
            if (MapActivityPhase(phase) is { } mapped)
            {
                Phase = mapped;
            }

            StatusText = text;
            StateHasChanged();
        });
    }

    private static string? OutcomeText(string? outcome, string? text) => outcome switch
    {
        "Completed" => text,
        "TerminalFailure" => "I couldn't complete that request. Please try again.",
        "Cancelled" => "Request cancelled.",
        "RetryableFailure" => null,
        "LegacyUnknown" => "This earlier response is unavailable.",
        _ => null,
    };

    private void OnResponseStreamReset()
    {
        _ = InvokeAsync(() =>
        {
            StopResponseAudio();
            _lastReceivedResponseSequence = 0;
            _latestResponseSequence = 0;
            _latestResponseAudioSequences.Clear();
            _pendingResponseAudioSequences.Clear();
        });
    }

    private void SettleThinking(string? utteranceId)
    {
        if (utteranceId is null) return;
        _settledUtteranceId = utteranceId;
        if (_thinkingUtteranceId == utteranceId) _thinkingUtteranceId = null;
        _toolActivityText = null;
        PreemptProgressAudio();
    }

    private void ShowLatestUserMessage(string utteranceId, string? text)
    {
        if (_latestUserUtteranceId != utteranceId) _toolActivityText = null;
        if (_latestUserUtteranceId != utteranceId && _responseTextUtteranceId != utteranceId)
        {
            StopResponseAudio();
            _latestResponseText = null;
            _latestResponseSequence = 0;
            _latestResponseAudioSequences.Clear();
        }
        _latestUserUtteranceId = utteranceId;
        _latestUserText = text;
    }

    private void OnConversationUpdated(IReadOnlyList<EllaiConversationTurnDto> conversation)
    {
        _ = InvokeAsync(() =>
        {
            var latest = conversation.LastOrDefault();
            if (latest is null) return;
            // HTTP deserialization creates a fresh proposal collection every poll.
            // Compare its stable identities, otherwise an unchanged durable answer
            // replaces the active step's narration on every history refresh.
            if (_lastDurableTurn is { } previous && latest with { UiProposals = previous.UiProposals } == previous &&
                latest.UiProposals.Select(item => item.ProposalId).SequenceEqual(previous.UiProposals.Select(item => item.ProposalId))) return;
            if (_lastDurableTurn is not null && latest.Sequence < _lastDurableTurn.Sequence) return;
            if (_thinkingUtteranceId is not null && latest.ClientUtteranceId != _thinkingUtteranceId
                && !conversation.Any(turn => turn.ClientUtteranceId == _thinkingUtteranceId
                    && turn.Sequence < latest.Sequence)) return;
            var wasAwaitingThisTurn = _thinkingUtteranceId == latest.ClientUtteranceId;
            _lastDurableTurn = latest;
            ObserveGuidanceProposal(latest, wasAwaitingThisTurn);
            ShowLatestUserMessage(latest.ClientUtteranceId, latest.UserText);
            if (latest.Outcome is "Queued" or "Processing" or "RetryableFailure")
            {
                if (latest.ClientUtteranceId != _settledUtteranceId)
                    _thinkingUtteranceId = latest.ClientUtteranceId;
                StateHasChanged();
            }
            else
            {
                SettleThinking(latest.ClientUtteranceId);
            }
            if (latest.Outcome is "Queued" or "Processing") return;
            _responseTextUtteranceId = latest.ClientUtteranceId;
            _latestResponseText = OutcomeText(latest.Outcome, latest.AssistantText);
            if (latest.Outcome != "Completed")
            {
                StopResponseAudio();
                _latestResponseSequence = 0;
                _latestResponseAudioSequences.Clear();
                _pendingResponseAudioSequences.Clear();
            }
            StatusText = latest.Outcome == "RetryableFailure" ? "Reconnecting.." : "Ready";
            Phase = EllaiStatusPhases.Ready;
            StateHasChanged();
        });
    }

    private void OnResponseReceived(EllaiSessionResponseDto response)
    {
        _ = InvokeAsync(() =>
        {
            if (_sessionView is null
                || !string.Equals(response.SessionId, _sessionView.SessionId, StringComparison.Ordinal)
                || (string.IsNullOrWhiteSpace(response.Text) && !response.IsFinal && response.Progress is null))
            {
                return;
            }

            if (!string.Equals(_responseSessionId, response.SessionId, StringComparison.Ordinal))
            {
                _responseSessionId = response.SessionId;
                _lastReceivedResponseSequence = 0;
                _latestResponseSequence = 0;
                _responseTextUtteranceId = null;
                _latestResponseText = null;
                _latestResponseAudioSequences.Clear();
                _pendingResponseAudioSequences.Clear();
            }

            // The poller may observe a guidance event while a failed request has
            // temporarily cleared its identity. A retry returns that same retained
            // event; allow it once only while it is still the current tour narration.
            var recoveredGuidance = response.Progress is { State: "Guidance" } guidance &&
                guidance.EventId == _guidanceNarrationEventId && _generatedTour is not null &&
                response.Sequence == _lastReceivedResponseSequence && response.Sequence > _latestResponseSequence;
            if (response.Sequence <= _lastReceivedResponseSequence && !recoveredGuidance)
            {
                return;
            }

            _lastReceivedResponseSequence = Math.Max(_lastReceivedResponseSequence, response.Sequence);
            if (_latestUserUtteranceId is not null && response.ClientUtteranceId is not null
                && response.ClientUtteranceId != _latestUserUtteranceId) return;
            if (response.Progress is { } progress)
            {
                if (progress.State == "Guidance")
                {
                    if ((progress.EventId != _guidanceNarrationEventId && progress.EventId != _validationNarrationEventId) || _generatedTour is null ||
                        progress.ExpiresAtUtc <= DateTimeOffset.UtcNow) return;
                    _latestResponseText = response.Text;
                    _latestResponseSequence = response.Sequence;
                    _latestResponseAudioSequences.Clear();
                    _latestResponseAudioSequences.Add(response.Sequence);
                    if (_readResponsesAloud)
                    {
                        _progressAudioSequences.Add(response.Sequence);
                        _pendingResponseAudioSequences.Enqueue(response.Sequence);
                        Interlocked.Exchange(ref _stopResponsePlaybackRequested, 0);
                        if (!_responseAudioQueueRunning) _ = PlayQueuedResponseAudioAsync();
                    }
                    else if (progress.EventId == _guidanceNarrationEventId) BeginGuidanceCountdown(response.Sequence);
                    StateHasChanged();
                    return;
                }
                if (progress.State == "Interrupted") _silencedProgressTurnId = response.ClientUtteranceId;
                if (progress.State is "Completed" or "Failed" or "Cancelled" or "Interrupted" or "Retrying")
                {
                    _toolActivityText = null;
                    PreemptProgressAudio();
                }
                else if (_settledUtteranceId != response.ClientUtteranceId
                    && _silencedProgressTurnId != response.ClientUtteranceId)
                {
                    _toolActivityText = progress.Operation;
                    if (progress.Speak && _readResponsesAloud && progress.ExpiresAtUtc > DateTimeOffset.UtcNow)
                    {
                        _progressAudioSequences.Add(response.Sequence);
                        _pendingResponseAudioSequences.Enqueue(response.Sequence);
                        Interlocked.Exchange(ref _stopResponsePlaybackRequested, 0);
                        if (!_responseAudioQueueRunning) _ = PlayQueuedResponseAudioAsync();
                    }
                }
                StateHasChanged();
                return;
            }
            _toolActivityText = null;
            PreemptProgressAudio();
            if (response.IsFinal || response.IsReconciliation)
                SettleThinking(response.ClientUtteranceId);
            if (response.IsReconciliation)
            {
                var hadChunks = _responseTextUtteranceId == response.ClientUtteranceId
                    && _latestResponseAudioSequences.Count > 0;
                _responseTextUtteranceId = response.ClientUtteranceId;
                _latestResponseText = OutcomeText(response.Outcome, response.Text);
                if (response.Outcome != "Completed")
                {
                    StopResponseAudio();
                    _latestResponseSequence = 0;
                    _latestResponseAudioSequences.Clear();
                    _pendingResponseAudioSequences.Clear();
                }
                else if (!hadChunks)
                {
                    _latestResponseSequence = response.Sequence;
                    _latestResponseAudioSequences.Clear();
                    _latestResponseAudioSequences.Add(response.Sequence);
                    if (_readResponsesAloud && CanPlayResponse)
                    {
                        _pendingResponseAudioSequences.Enqueue(response.Sequence);
                        if (!_isPlayingResponse) _ = PlayQueuedResponseAudioAsync();
                    }
                }
                Phase = EllaiStatusPhases.Ready;
                StatusText = "Ready";
                StateHasChanged();
                return;
            }
            var startsNewResponse = !string.IsNullOrWhiteSpace(response.Text)
                && (response.ClientUtteranceId is null
                    || !string.Equals(_responseTextUtteranceId, response.ClientUtteranceId, StringComparison.Ordinal));
            var hasDurableAnswer = _lastDurableTurn?.ClientUtteranceId == response.ClientUtteranceId
                && _lastDurableTurn?.Outcome == "Completed";
            if (startsNewResponse)
            {
                _responseTextUtteranceId = response.ClientUtteranceId;
                if (!hasDurableAnswer) _latestResponseText = response.Text;
                _latestResponseAudioSequences.Clear();
                _pendingResponseAudioSequences.Clear();
            }
            else if (!hasDurableAnswer && !string.IsNullOrWhiteSpace(response.Text))
            {
                _latestResponseText = string.Concat(_latestResponseText, " ", response.Text);
            }
            StatusText = response.IsFinal ? "Ready" : "Connecting..";
            _latestResponseSequence = response.Sequence;
            if (!string.IsNullOrWhiteSpace(response.Text))
            {
                _latestResponseAudioSequences.Add(response.Sequence);
            }
            Phase = response.IsFinal ? EllaiStatusPhases.Ready : EllaiStatusPhases.Active;
            if (!string.IsNullOrWhiteSpace(response.Text)
                && _readResponsesAloud && CanPlayResponse)
            {
                _pendingResponseAudioSequences.Enqueue(response.Sequence);
                if (!_isPlayingResponse)
                {
                    _ = PlayQueuedResponseAudioAsync();
                }
            }
            StateHasChanged();
        });
    }

    private async Task ToggleResponseAudioAsync()
    {
        if (_sessionView is null)
        {
            return;
        }

        if (_readResponsesAloud)
        {
            _readResponsesAloud = false;
            _guidanceSpeechAutoEnabled = false;
            _guidanceSpeechMutedByUser = true;
            StopResponseAudio();
            StatusText = "Speech playback stopped.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        _readResponsesAloud = true;
        _guidanceSpeechAutoEnabled = false;
        _guidanceSpeechMutedByUser = false;
        await InvokeAsync(StateHasChanged);
        await PlayResponseAudioAsync();
    }

    private void DisableResponseAudio()
    {
        _readResponsesAloud = false;
        _guidanceSpeechAutoEnabled = false;
        _guidanceSpeechMutedByUser = true;
        StopResponseAudio();
        StatusText = "Speech playback stopped.";
    }

    private void BeginGuidanceSpeech()
    {
        if (_readResponsesAloud || _guidanceSpeechMutedByUser) return;
        _guidanceSpeechAutoEnabled = true;
        _readResponsesAloud = true;
    }

    private void EndGuidanceSpeech()
    {
        if (!_guidanceSpeechAutoEnabled) return;
        _guidanceSpeechAutoEnabled = false;
        _readResponsesAloud = false;
        StopResponseAudio();
    }

    private async Task PlayResponseAudioAsync()
    {
        if (_sessionView is null || _latestResponseSequence < 1 || _isPlayingResponse)
        {
            return;
        }

        Interlocked.Exchange(ref _stopResponsePlaybackRequested, 0);

        var sequences = _latestResponseAudioSequences.Count == 0
            ? [_latestResponseSequence]
            : _latestResponseAudioSequences.ToArray();
        foreach (var sequence in sequences)
        {
            if (!_pendingResponseAudioSequences.Contains(sequence))
                _pendingResponseAudioSequences.Enqueue(sequence);
        }
        await PlayQueuedResponseAudioAsync();
    }

    private async Task PlayQueuedResponseAudioAsync()
    {
        if (_responseAudioQueueRunning) return;
        _responseAudioQueueRunning = true;
        try
        {
            Interlocked.Exchange(ref _stopResponsePlaybackRequested, 0);
            while (_pendingResponseAudioSequences.TryDequeue(out var sequence))
            {
                if (Interlocked.CompareExchange(ref _stopResponsePlaybackRequested, 0, 0) != 0
                    || !_readResponsesAloud || !CanPlayResponse)
                {
                    _pendingResponseAudioSequences.Clear();
                    return;
                }
                // Await local stop acknowledgement before a replacement starts.
                if (!await _responseStopTask)
                {
                    _pendingResponseAudioSequences.Clear();
                    _progressAudioSequences.Clear();
                    return;
                }
                if (Interlocked.CompareExchange(ref _stopResponsePlaybackRequested, 0, 0) != 0
                    || !_readResponsesAloud) break;
                await PlayResponseAudioSequenceAsync(sequence);
                _progressAudioSequences.Remove(sequence);
            }
        }
        finally { _responseAudioQueueRunning = false; }
    }

    private async Task PlayResponseAudioSequenceAsync(long sequence)
    {
        if (_sessionView is null || sequence < 1 || _isPlayingResponse)
        {
            return;
        }

        var sessionId = _sessionView.SessionId;
        var playbackId = Guid.NewGuid().ToString("N");
        var playbackCts = new CancellationTokenSource();
        CancelGuidanceCountdown();
        var playbackCompleted = false;
        var narrationEventId = _guidanceNarrationEventId;
        _audioPlaybackCts = playbackCts;
        _activeResponseSequence = sequence;
        _activeResponsePlaybackId = playbackId;
        _isPlayingResponse = true;
        Interlocked.Exchange(ref _localBargeInPending, 0);
        StatusText = "Preparing Ellai speech…";
        await InvokeAsync(StateHasChanged);
        try
        {
            if (ReviewClient.UsesGatewayPcmAudioDownload)
            {
                await using var audio = await ReviewClient.DownloadResponseAudioStreamAsync(
                    sessionId, sequence, playbackId, playbackCts.Token);
                var player = Services.GetService<IEllaiPcmAudioPlayer>();
                if (audio is null || player is null || !player.IsAvailable
                    || audio.Sequence != sequence
                    || !string.Equals(audio.VoiceId, "swiftaid-mms-english-v1", StringComparison.Ordinal))
                {
                    throw new InvalidOperationException("Gateway PCM playback is unavailable.");
                }

                await player.PlayAsync(audio.Pcm, audio.SampleRate, playbackCts.Token);
            }
            else
            {
                _speechModule ??= await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                    "import", "./_content/SwiftAid.UI/js/ellai-audio-playback.js");
                await _speechModule.InvokeVoidAsync(
                    "playResponse", sessionId, sequence, playbackId);
            }

            StatusText = "Ellai speech playback finished.";
            playbackCompleted = !playbackCts.IsCancellationRequested;
        }
        catch (OperationCanceledException) when (playbackCts.IsCancellationRequested)
        {
            StatusText = _isRecordingAudio && _captureMode == EllaiVoiceCaptureMode.Live
                ? "You interrupted Ellai. Keep speaking; completed turns are sent automatically."
                : "Speech playback stopped.";
        }
        catch (Exception)
        {
            StatusText = "Ellai couldn't play the spoken reply. You can still read it above.";
        }
        finally
        {
            if (ReferenceEquals(_audioPlaybackCts, playbackCts))
            {
                _audioPlaybackCts = null;
                _isPlayingResponse = false;
                _activeResponseSequence = 0;
                _activeResponsePlaybackId = null;
            }

            playbackCts.Dispose();
            await InvokeAsync(StateHasChanged);
        }
        if (playbackCompleted && narrationEventId is not null && narrationEventId == _guidanceNarrationEventId)
            BeginGuidanceCountdown(sequence);
    }

