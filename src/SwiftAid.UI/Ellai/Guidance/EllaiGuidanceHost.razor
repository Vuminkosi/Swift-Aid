    /// <summary>Attaches live guidance, enabling the attached composer
    /// branch. Called by the hosting page when a journey starts.</summary>
    public async Task AttachGuidanceAsync(
        string journeyId, string journeyVersion, GuidanceMode mode, CancellationToken cancellationToken)
    {
        _guidance = await Guidance.StartAsync(journeyId, journeyVersion, mode, null, cancellationToken);
        IsActive = true;
        ShowComposer = true;
        Phase = EllaiStatusPhases.Active;
        StatusText = "Guidance is showing. The composer follows the active card.";
    }

    private async Task SelectModeAsync(EllaiMode mode)
    {
        if (_guidance is not null && IsActive)
        {
            ShowComposer = true;
            StatusText = "Guidance is showing. The composer follows the active card.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (_sessionView is { } existingSession)
        {
            if (string.Equals(existingSession.Status, "Active", StringComparison.Ordinal)
                && string.Equals(EventPoller.SessionId, existingSession.SessionId, StringComparison.Ordinal))
            {
                ShowComposer = true;
                StatusText = "Ellai session is active. Continue where you left off.";
                Phase = EllaiStatusPhases.Active;
                await InvokeAsync(StateHasChanged);
                return;
            }

            StatusText = "End or reconcile the current Ellai session before starting another.";
            return;
        }

        if (_startingSession || _startOutcomeUnknown)
        {
            StatusText = "End or reconcile the current Ellai session before starting another.";
            return;
        }

        CancelPriorSession();
        StopResponseAudio();
        _sessionView = null;
        _pendingUtteranceId = null;
        _pendingUtteranceText = null;
        _sessionVersionConflict = false;
        _submissionPolicyBlocked = false;
        _voiceCaptureConsentGranted = false;
        _authorizationRequired = false;
        _submissionCorrectionRequired = false;
        _cancelOutcomeUnknown = false;
        EventPoller.ForgetSession();
        _pollCts?.Cancel();
        ShowComposer = true;
        IsActive = false;
        Phase = EllaiStatusPhases.Ready;
        _startingSession = true;
        _cancelRequestedWhileStarting = false;
        _showStartFailure = false;
        StatusText = "Starting an Ellai session…";
        StateHasChanged();
        try
        {
            var startResult = await ReviewClient.StartSessionAsync(mode, CancellationToken.None);
            if (startResult.Status != EllaiClientOperationStatus.Accepted
                || startResult.Session is not { } view
                || string.IsNullOrWhiteSpace(view.SessionId))
            {
                _sessionView = null;
                ShowComposer = false;
                _startOutcomeUnknown = startResult.Status == EllaiClientOperationStatus.OutcomeUnknown
                    || startResult.Status == EllaiClientOperationStatus.Accepted;
                _showStartFailure = true;
                StatusText = startResult.Status switch
                {
                    EllaiClientOperationStatus.Unauthorized => "Sign in to start an Ellai session. No session was created.",
                    EllaiClientOperationStatus.PolicyBlocked => "Ellai is unavailable for this account or workspace. No session was created.",
                    EllaiClientOperationStatus.InvalidRequest => "This Ellai request could not be validated. No session was created.",
                    EllaiClientOperationStatus.Unavailable => "Ellai is temporarily unavailable. No session was created. Try again shortly.",
                    _ => "The session start outcome is unknown. The server did not provide a session ID, and this page has no lookup to reconcile it. Do not start another session; contact support to reconcile the remote state."
                };
                Phase = EllaiStatusPhases.Blocked;
                return;
            }

            if (_cancelRequestedWhileStarting)
            {
                _sessionView = view;
                var ended = await CancelRemoteSessionAsync(view);
                if (ended)
                {
                    CompleteLocalCancel("Ellai session ended.");
                }
                else
                {
                    _sessionView = view;
                    TrackSession(view.SessionId);
                    ShowComposer = true;
                    StatusText = "A session was created while you were canceling, and remote cancellation is unconfirmed. Retry Cancel to reconcile it.";
                    Phase = EllaiStatusPhases.Blocked;
                }

                return;
            }

            _sessionView = view;
            TrackSession(view.SessionId);
            StatusText = "Ellai session started. Enter a question to continue.";
        }
        catch (Exception)
        {
            _startOutcomeUnknown = true;
            _showStartFailure = true;
            ShowComposer = false;
            StatusText = "The session start outcome is unknown and no session ID or lookup is available to reconcile it. Do not start another session; contact support to reconcile the remote state.";
            Phase = EllaiStatusPhases.Blocked;
        }
        finally
        {
            _startingSession = false;
            await OnModeSelected.InvokeAsync(mode);
            await InvokeAsync(StateHasChanged);
        }
    }

