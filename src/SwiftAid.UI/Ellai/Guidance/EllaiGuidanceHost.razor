    private async Task OnSend()
    {
        if (!CanSubmitText)
        {
            StatusText = _authorizationRequired
                ? "Sign in is required before this message can be sent. Your transcript is still here."
                : _submissionPolicyBlocked
                    ? "This message cannot be sent under the current policy. Your transcript is still here."
                    : _sessionVersionConflict
                        ? "The session changed before this message could be sent. Review the transcript and try again."
                        : _sessionView is null || !string.Equals(_sessionView.Status, "Active", StringComparison.Ordinal)
                            ? "This Ellai session is no longer active. Start a new session to continue."
                            : "Ellai cannot submit this message right now. Your transcript is still here; try again shortly.";
            Phase = _authorizationRequired || _submissionPolicyBlocked
                ? EllaiStatusPhases.Blocked
                : EllaiStatusPhases.NeedsInput;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var session = _sessionView;
        var text = InputText!.Trim();
        if (_pendingUtteranceId is null
            || !string.Equals(_pendingUtteranceText, text, StringComparison.Ordinal))
        {
            _pendingUtteranceId = Guid.NewGuid().ToString("N");
            _pendingUtteranceText = text;
        }

        var request = new SubmitUtteranceRequest(
            _pendingUtteranceId!,
            session!.SessionId,
            session.SessionVersion,
            text,
            TranscriptRef: null,
            InputSource: "typed",
            ClientEpoch: session.SessionVersion);

        _submissionCts?.Dispose();
        _submissionCts = CancellationTokenSource.CreateLinkedTokenSource(_cts?.Token ?? CancellationToken.None);
        var cancellationToken = _submissionCts.Token;
        _submissionSettled = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        _submittingUtterance = true;
        StatusText = "Sending your message to Ellai…";
        Phase = EllaiStatusPhases.Active;
        try
        {
            var result = await ReviewClient.SubmitUtteranceAsync(request, cancellationToken);
            switch (result.Status)
            {
                case EllaiClientOperationStatus.Accepted
                    when result.Session is { } updated
                        && string.Equals(updated.SessionId, session.SessionId, StringComparison.Ordinal):
                    _sessionView = updated;
                    _pendingUtteranceId = null;
                    _pendingUtteranceText = null;
                    if (string.Equals(InputText, text, StringComparison.Ordinal))
                    {
                        InputText = null;
                    }

                    StatusText = "Your message was accepted. Ellai is processing it.";
                    Phase = EllaiStatusPhases.Active;
                    break;

                case EllaiClientOperationStatus.Unavailable:
                    StatusText = "Ellai could not confirm this message. Retry safely with the same text, or cancel the session.";
                    Phase = EllaiStatusPhases.Blocked;
                    break;

                case EllaiClientOperationStatus.Conflict:
                    _sessionVersionConflict = true;
                    _pendingUtteranceId = null;
                    _pendingUtteranceText = null;
                    if (result.Session is { } current
                        && string.Equals(current.SessionId, session.SessionId, StringComparison.Ordinal))
                    {
                        _sessionView = current;
                        if (string.Equals(current.Status, "Active", StringComparison.Ordinal))
                        {
                            _sessionVersionConflict = false;
                            StatusText = "The session changed. Your message was not sent. Review it, then send again.";
                        }
                        else
                        {
                            _sessionView = null;
                            EventPoller.ForgetSession();
                            _sessionVersionConflict = false;
                            StatusText = "The session ended. Your message was not sent. Start a new session to continue.";
                        }
                    }
                    else
                    {
                        StatusText = "The session changed. Your message was not sent. Its remote state may still be active, and this view cannot refresh it.";
                    }

                    Phase = EllaiStatusPhases.Blocked;
                    break;

                case EllaiClientOperationStatus.Unauthorized:
                    _authorizationRequired = true;
                    _pendingUtteranceId = null;
                    _pendingUtteranceText = null;
                    StatusText = "Sign in again to continue. Ellai did not accept this message.";
                    Phase = EllaiStatusPhases.Blocked;
                    break;

                case EllaiClientOperationStatus.InvalidRequest:
                    _submissionCorrectionRequired = true;
                    _pendingUtteranceId = null;
                    _pendingUtteranceText = null;
                    StatusText = "Ellai did not accept this message. Check the text and try again.";
                    Phase = EllaiStatusPhases.Blocked;
                    break;

                case EllaiClientOperationStatus.PolicyBlocked:
                    _submissionPolicyBlocked = false;
                    StatusText = "This request was blocked by the current session policy. Your text is still here; check your permissions and try again.";
                    Phase = EllaiStatusPhases.Blocked;
                    break;

                case EllaiClientOperationStatus.Accepted:
                    StatusText = "Ellai could not confirm this message. Retry safely with the same text, or cancel the session.";
                    Phase = EllaiStatusPhases.Blocked;
                    break;

                default:
                    StatusText = "Ellai could not confirm this message. Retry safely with the same text, or cancel the session.";
                    Phase = EllaiStatusPhases.Blocked;
                    break;
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            StatusText = "Ellai could not confirm this message. Retry safely with the same text, or cancel the session.";
            Phase = EllaiStatusPhases.Blocked;
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception)
        {
            StatusText = "Ellai could not confirm this message. Retry safely with the same text, or cancel the session.";
            Phase = EllaiStatusPhases.Blocked;
        }
        finally
        {
            _submittingUtterance = false;
            _submissionSettled?.TrySetResult();
        }
    }

    private async Task OnCancel()
    {
        await StopAndDiscardVoiceCaptureAsync().ConfigureAwait(false);
        if (_startOutcomeUnknown)
        {
            StatusText = "The remote start outcome is unresolved and this page has no session lookup. Contact support before starting another session.";
            Phase = EllaiStatusPhases.Blocked;
            return;
        }

        if (_startingSession)
        {
            _cancelRequestedWhileStarting = true;
            StatusText = "Cancel requested. Waiting for the start result so any created session can be ended.";
            Phase = EllaiStatusPhases.Active;
            return;
        }

        if (_submittingUtterance)
        {
            StatusText = "Canceling the message request, then checking the session with the server…";
            Phase = EllaiStatusPhases.Active;
            _submissionCts?.Cancel();
            if (_submissionSettled is { } settled)
            {
                await settled.Task;
            }
        }

        var token = _cts?.Token ?? CancellationToken.None;
        if (_sessionView is { } session)
        {
            var ended = await CancelRemoteSessionAsync(session);
            if (!ended)
            {
                return;
            }
        }


        try
        {
            if (_guidance is not null)
            {
                _stopCommandId ??= $"cancel-{Guid.NewGuid():N}";
                await Guidance.StopAsync(
                    _guidance.Position.GuidanceAttemptId,
                    _guidance.Position.GuidanceVersion,
                    _guidance.Mode,
                    token,
                    _stopCommandId);
            }

            await Bonboarding.StopAllAsync(BonboardingTourEndReason.Cancelled, token);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            CompleteLocalCancel("Ellai session ended.");
        }
    }

    private async Task<bool> CancelRemoteSessionAsync(EllaiSessionView session)
    {
        try
        {
            var refreshedActiveSession = false;
            var result = await ReviewClient.CancelSessionAsync(
                session.SessionId, session.SessionVersion, CancellationToken.None);
            if (result.Status == EllaiClientOperationStatus.Cancelled)
            {
                return true;
            }

            if (result.Status == EllaiClientOperationStatus.Conflict
                && result.Session is { } current
                && string.Equals(current.SessionId, session.SessionId, StringComparison.Ordinal))
            {
                if (!string.Equals(current.Status, "Active", StringComparison.Ordinal))
                {
                    return true;
                }

                _sessionView = current;
                refreshedActiveSession = true;
            }

            _cancelOutcomeUnknown = !(result.Status == EllaiClientOperationStatus.Conflict && refreshedActiveSession);
            _sessionVersionConflict = result.Status == EllaiClientOperationStatus.Conflict;
            _authorizationRequired = result.Status == EllaiClientOperationStatus.Unauthorized;
            StatusText = result.Status switch
            {
                EllaiClientOperationStatus.Unauthorized => "Your sign-in is no longer valid. The remote session may still be active.",
                EllaiClientOperationStatus.PolicyBlocked => "Policy prevented cancellation. The remote session may still be active.",
                EllaiClientOperationStatus.InvalidRequest => "Cancellation could not be validated. The remote session may still be active.",
                EllaiClientOperationStatus.Conflict when refreshedActiveSession => "The session changed. Its current version is loaded, but cancellation was not confirmed. Press Cancel again to retry.",
                EllaiClientOperationStatus.Conflict => "The session changed and its current state could not be refreshed. Reconcile the session before retrying.",
                _ => "Cancellation could not be confirmed. Press Cancel again to retry safely."
            };
            Phase = EllaiStatusPhases.Blocked;
            return false;
        }
        catch (Exception)
        {
            _cancelOutcomeUnknown = true;
            StatusText = "Cancellation could not be confirmed. The remote session may still be active; press Cancel again to retry safely.";
            Phase = EllaiStatusPhases.Blocked;
            return false;
        }
    }

    private void CompleteLocalCancel(string status)
    {
        _ = StopAndDiscardVoiceCaptureAsync();
        StopResponseAudio();
        CancelPriorSession();
        EventPoller.ForgetSession();
        _pollCts?.Cancel();
        _guidance = null;
        _guidancePaused = false;
        _stopCommandId = null;
        _sessionView = null;
        _voiceCaptureConsentGranted = false;
        _pendingUtteranceId = null;
        _pendingUtteranceText = null;
        _cancelOutcomeUnknown = false;
        _startOutcomeUnknown = false;
        _showStartFailure = false;
        _sessionVersionConflict = false;
        _submissionPolicyBlocked = false;
        _authorizationRequired = false;
        _submissionCorrectionRequired = false;
        _rejectInProgress = false;
        _approvalSubmissionInProgress = false;
        IsActive = false;
        ShowComposer = false;
        InputText = null;
        Phase = EllaiStatusPhases.Ready;
        StatusText = status;
    }

    private void ObserveLocalBargeIn(ReadOnlySpan<byte> pcm)
    {
        if (!_isRecordingAudio || _captureMode != EllaiVoiceCaptureMode.Live
            || !_isPlayingResponse || !_captureEchoCancellationEnabled
            || _clientBargeInDetector is null
            || !_clientBargeInDetector.ObservePcm24Khz(pcm)
            || Interlocked.CompareExchange(ref _localBargeInPending, 1, 0) != 0)
        {
            return;
        }

        var interruptionTurnId = Guid.NewGuid().ToString("N");
        var streamEpoch = _lastVoiceTurnStatusEpoch;
        _ = InvokeAsync(() =>
        {
            if (!_isRecordingAudio || _captureMode != EllaiVoiceCaptureMode.Live || !_isPlayingResponse)
            {
                Interlocked.Exchange(ref _localBargeInPending, 0);
                return;
            }

            StopResponseAudio(interruptionTurnId, streamEpoch);
            StatusText = "You interrupted Ellai. Keep speaking; I’m listening to the rest of your turn.";
            Phase = EllaiStatusPhases.Active;
            StateHasChanged();
        });
    }

    private void StopResponseAudio(string? interruptionTurnId = null, long streamEpoch = 0)
    {
        var sessionId = _sessionView?.SessionId;
        var sequence = _activeResponseSequence;
        var playbackId = _activeResponsePlaybackId;
        _audioPlaybackCts?.Cancel();
        if (sessionId is not null && sequence > 0 && playbackId is not null)
        {
            _ = ReviewClient.InterruptResponseAudioAsync(
                sessionId,
                sequence,
                playbackId,
                CancellationToken.None,
                interruptionTurnId,
                streamEpoch);
        }


        if (ReviewClient.UsesGatewayPcmAudioDownload)
        {
            var player = Services.GetService<IEllaiPcmAudioPlayer>();
            if (player is not null)
            {
                _ = player.StopAsync();
            }
        }

        if (_speechModule is not null && !string.IsNullOrWhiteSpace(sessionId))
        {
            _ = _speechModule.InvokeVoidAsync("stopResponse", sessionId);
        }

        _latestResponseSequence = 0;
        _isPlayingResponse = false;
        _activeResponseSequence = 0;
        _activeResponsePlaybackId = null;
    }

    private void CancelPriorSession()
    {
        try
        {
            _cts?.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }
        finally
        {
            _cts?.Dispose();
            _cts = new CancellationTokenSource();
        }
    }

    private CancellationTokenSource? _pollCts;
    private IDialogReference? _reviewDialog;

    /// <summary>Human edit of the plan under review. Bound by the hosting
    /// page when a reasoning lane can present a revised plan.</summary>
    [Parameter]
    public EventCallback<EllaiReviewDto> OnEditRequested { get; set; }

    /// <summary>Starts tracking one session: polls its event journal and
    /// opens the approval dialog on validated reviews.</summary>
    public void TrackSession(string sessionId)
    {
        EventPoller.TrackSession(sessionId);
        RestartPollLoop();
    }

    private void RestartPollLoop()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = new CancellationTokenSource();
        _ = PollLoopAsync(_pollCts.Token);
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await EventPoller.PollOnceAsync(20, ct).ConfigureAwait(false);
                await Task.Delay(TimeSpan.FromSeconds(2), ct).ConfigureAwait(false);
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch
            {
                try
                {
                    await Task.Delay(2000, ct).ConfigureAwait(false);
                }
                catch (OperationCanceledException)
                {
                    break;
                }
            }
        }
    }

    private async void OnApprovalRequired(string requestId)
    {
        try
        {
            await InvokeAsync(() => OpenReviewAsync(requestId)).ConfigureAwait(false);
        }
        catch
        {
        }
    }

    private void OnSessionCancelled()
    {
        _reviewDialog?.Close();
        _reviewDialog = null;
        CompleteLocalCancel("Ellai session ended.");
        StateHasChanged();
    }

    private async Task OpenReviewAsync(string requestId)
    {
        var sessionId = EventPoller.SessionId;
        if (sessionId is null || _reviewDialog is not null)
        {
            return;
        }

        IDialogReference? dialog = null;
        try
        {
            var review = await ReviewClient.GetActiveReviewAsync(sessionId, CancellationToken.None).ConfigureAwait(false);
            if (review is null || review.RequestId != requestId)
            {
                return;
            }

            Phase = EllaiStatusPhases.NeedsInput;
            StatusText = "Waiting for your approval…";
            StateHasChanged();
            await PauseGuidanceForReviewAsync().ConfigureAwait(false);

            var parameters = new DialogParameters
            {
                ["RequestId"] = review.RequestId,
                ["PlanHash"] = review.PlanHash,
                ["PlanVersion"] = review.PlanVersion,
                ["ExpiresAtUtc"] = review.ExpiresAtUtc,
                ["EvidenceText"] = $"Plan {review.PlanHash} version {review.PlanVersion}.",
                ["Actions"] = review.Actions.Select(action =>
                    new EllaiApprovalActionRow(action.ActionId, action.Label, action.Detail, false)).ToList(),
                ["OnApproveSelected"] = EventCallback.Factory.Create<IReadOnlyList<string>>(
                    this, selected => SubmitSelectionAsync(review, selected)),
                ["OnReject"] = EventCallback.Factory.Create(this, () => RejectAsync(review)),
                ["OnEdit"] = EventCallback.Factory.Create(this, () => EditAsync(review)),
                ["OnCancel"] = EventCallback.Factory.Create(this, DismissReview),
            };
            dialog = await Dialogs.ShowAsync<EllaiApprovalDialog>(
                "Review proposed actions", parameters).ConfigureAwait(false);
            _reviewDialog = dialog;
            await dialog.Result.ConfigureAwait(false);
        }
        catch
        {
            dialog?.Close();
        }
        finally
        {
            if (ReferenceEquals(_reviewDialog, dialog))
            {
                _reviewDialog = null;
            }

            await ResumeGuidanceAfterReviewAsync().ConfigureAwait(false);
        }
    }

    /// <summary>Yields focus to the approval dialog: an active guidance
    /// attempt pauses and resumes when the dialog closes. Pause/Resume go
    /// through the ordinary guidance control seam with the current fence.</summary>
    private bool _guidancePaused;

    private async Task PauseGuidanceForReviewAsync()
    {
        if (_guidance is null || _guidancePaused)
        {
            return;
        }

        try
        {
            var snapshot = await Guidance.DispatchAsync(
                _guidance.Position.GuidanceAttemptId,
                _guidance.Position.GuidanceVersion,
                GuidanceCommandKind.Pause,
                _guidance.Mode, null, null, CancellationToken.None).ConfigureAwait(false);
            if (snapshot is not null)
            {
                _guidance = snapshot;
                _guidancePaused = true;
            }
        }
        catch
        {
        }
    }

    private async Task ResumeGuidanceAfterReviewAsync()
    {
        if (!_guidancePaused)
        {
            return;
        }

        _guidancePaused = false;
        if (_guidance is null)
        {
            return;
        }

        try
        {
            var snapshot = await Guidance.DispatchAsync(
                _guidance.Position.GuidanceAttemptId,
                _guidance.Position.GuidanceVersion,
                GuidanceCommandKind.Resume,
                _guidance.Mode, null, null, CancellationToken.None).ConfigureAwait(false);
            if (snapshot is not null)
            {
                _guidance = snapshot;
            }
        }
        catch
        {
        }
    }

    private void DismissReview()
    {
        _reviewDialog?.Close();
        _reviewDialog = null;
        StatusText = "Review dismissed.";
        StateHasChanged();
    }

    private bool _approvalSubmissionInProgress;

    private async Task SubmitSelectionAsync(EllaiReviewDto review, IReadOnlyList<string> selected)
    {
        if (_approvalSubmissionInProgress)
        {
            return;
        }

        var actionIds = selected.ToArray();
        _approvalSubmissionInProgress = true;
        StatusText = "Approval outcome pending — checking the authoritative receipts…";
        StateHasChanged();
        try
        {
            try
            {
                await ReviewClient.ApproveSelectedAsync(
                    review.SessionId, review.RequestId, actionIds, CancellationToken.None);
            }
            catch
            {
                // The server may have committed before the response failed.
            }

            IReadOnlyList<EllaiApprovedReceiptDto>? listed = null;
            try
            {
                listed = await ReviewClient.ListReceiptsAsync(
                    review.SessionId, CancellationToken.None);
            }
            catch
            {
                // Keep the outcome unknown; never infer that no action occurred.
            }

            if (EllaiReceiptVerifier.IsReconciled(actionIds, listed))
            {
                StatusText = $"Verified — {actionIds.Length} approval(s) recorded.";
                _reviewDialog?.Close();
                _reviewDialog = null;
            }
            else
            {
                StatusText = "Approval outcome unknown. Receipt confirmation is unavailable or incomplete; do not submit this approval again.";
                Phase = EllaiStatusPhases.Blocked;
            }

            StateHasChanged();
        }
        finally
        {
            _approvalSubmissionInProgress = false;
        }
    }

    private bool _rejectInProgress;

    private async Task RejectAsync(EllaiReviewDto review)
    {
        if (_rejectInProgress)
        {
            return;
        }

        _rejectInProgress = true;
        StatusText = "Checking whether the review was rejected…";
        Phase = EllaiStatusPhases.Active;
        StateHasChanged();
        try
        {
            var rejected = await ReviewClient.RejectReviewAsync(
                review.SessionId, review.RequestId, CancellationToken.None);
            if (rejected)
            {
                _reviewDialog?.Close();
                _reviewDialog = null;
                StatusText = "Review rejected.";
                Phase = EllaiStatusPhases.Ready;
                _rejectInProgress = false;
                return;
            }
        }
        catch
        {
            // Rejection may have completed before the response was lost.
        }

        EllaiReviewDto? activeReview = null;
        try
        {
            activeReview = await ReviewClient.GetActiveReviewAsync(
                review.SessionId, CancellationToken.None);
        }
        catch
        {
            // A failed read does not prove rejection or that it did not occur.
        }

        var stillActive = activeReview is not null
            && string.Equals(activeReview.RequestId, review.RequestId, StringComparison.Ordinal);
        StatusText = !stillActive
            ? "Rejection outcome unknown. The review is no longer available to verify; do not repeat the rejection."
            : "Rejection outcome unknown. The review is still available; do not repeat the rejection. Cancel or close this review and reconcile with staff.";
        Phase = EllaiStatusPhases.Blocked;
        StateHasChanged();
        _rejectInProgress = false;
    }

    private async Task EditAsync(EllaiReviewDto review)
    {
        _reviewDialog?.Close();
        _reviewDialog = null;
        StatusText = "Editing the plan…";
        StateHasChanged();
        await OnEditRequested.InvokeAsync(review).ConfigureAwait(false);
    }

    public void Dispose()
    {
        if (_nativeVoiceCapture is not null)
        {
            _nativeVoiceCapture.Interrupted -= OnNativeVoiceCaptureInterrupted;
            _nativeVoiceCapture.RouteChanged -= OnNativeVoiceRouteChanged;
        }
        Launcher.Requested -= OnLauncherRequested;
        EventPoller.ApprovalRequired -= OnApprovalRequired;
        EventPoller.SessionCancelled -= OnSessionCancelled;
        EventPoller.ActivityUpdated -= OnActivityUpdated;
        EventPoller.ResponseReceived -= OnResponseReceived;
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        try
        {
            _cts?.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }

        _cts?.Dispose();
        _submissionCts?.Cancel();
        _submissionCts?.Dispose();
        _ = DisposeConnectivityMonitoringAsync();
        _captureDotnetReference?.Dispose();
        _isRecordingAudio = false;
        _voiceTurnStatusCts?.Cancel();
        if (_captureModule is not null)
        {
            _ = _captureModule.InvokeVoidAsync("cancelCapture");
            _ = _captureModule.DisposeAsync();
        }
        _ = CancelLiveVoiceStreamAsync();
        DiscardCapturedAudio();
        StopResponseAudio();
        if (_speechModule is not null)
        {
            _ = _speechModule.InvokeVoidAsync("disposeAudioPlayback");
            _ = _speechModule.DisposeAsync();
        }
    }

    private async Task StopAndDiscardVoiceCaptureAsync()
    {
        _isRecordingAudio = false;
        _voiceCaptureConsentGranted = false;
        await StopVoiceTurnStatusPollingAsync();
        try
        {
            if (_captureModule is not null)
            {
                await _captureModule.InvokeVoidAsync("cancelCapture");
            }
        }
        catch (Microsoft.JSInterop.JSException)
        {
        }
        await CancelLiveVoiceStreamAsync();
        DiscardCapturedAudio();
    }

    private async Task DisposeConnectivityMonitoringAsync()
    {
        var subscription = _connectivitySubscription;
        _connectivitySubscription = null;
        if (subscription is null)
        {
            return;
        }

        try
        {
            await subscription.InvokeVoidAsync("dispose");
        }
        catch (Microsoft.JSInterop.JSException)
        {
            // The browser context may already be unavailable during component disposal.
        }

        try
        {
            await subscription.DisposeAsync();
        }
        catch (Microsoft.JSInterop.JSException)
        {
        }
    }
}
