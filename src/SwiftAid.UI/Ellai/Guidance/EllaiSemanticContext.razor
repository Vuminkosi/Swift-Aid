@using SwiftAid.Contracts.Ellai
@implements IAsyncDisposable
@inject IJSRuntime JS

@code {
    [Parameter, EditorRequired]
    public IEllaiUiContextProvider Provider { get; set; } = default!;

    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    private readonly SemaphoreSlim _lifecycle = new(1, 1);
    private IJSObjectReference? _module;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await _lifecycle.WaitAsync();
        try
        {
            if (_disposed) return;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import",
                "./_content/SwiftAid.UI/js/ellai-ui-observations.js");
            var state = Provider.GetState();
            var manifest = Provider.Describe();
            if (state.ComponentId != Provider.ComponentId || manifest.ComponentId != Provider.ComponentId ||
                state.Controls.Any(control => !manifest.Controls.Any(descriptor => descriptor.ControlId == control.ControlId)))
                throw new InvalidOperationException("Semantic state must belong to its component manifest.");
            await _module.InvokeAsync<bool>("updateComponent", _instanceId, state);
        }
        catch (JSDisconnectedException) { }
        finally { _lifecycle.Release(); }
    }

    public async ValueTask DisposeAsync()
    {
        await _lifecycle.WaitAsync();
        try
        {
            if (_disposed) return;
            _disposed = true;
            if (_module is not null)
            {
                try { await _module.InvokeVoidAsync("removeComponent", _instanceId); }
                catch (JSDisconnectedException) { }
                finally { await _module.DisposeAsync(); }
            }
        }
        catch (JSDisconnectedException) { }
        finally { _lifecycle.Release(); }
    }
}
