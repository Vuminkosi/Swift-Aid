@using SwiftAid.Contracts.Ellai
@page "/ellai/about"

<MudContainer MaxWidth="MaxWidth.Medium" Class="ellai-settings">
    <MudText Typo="Typo.h5" HtmlTag="h1">About Ellai</MudText>
    <MudText Typo="Typo.body2">
        Ellai is SwiftAid's permission-aware application assistant. It answers product
        questions, demonstrates features, and proposes bounded administrative work
        that a person reviews and the application verifies.
    </MudText>
    <MudTabs Class="mt-4" aria-label="Ellai information">
        <MudTabPanel Text="About">
    <MudDivider Class="my-4" />
    <MudText Typo="Typo.subtitle1" HtmlTag="h2">Defaults</MudText>
    <MudText Typo="Typo.body2">
        Text input and typed output unless you choose voice. Memory is session-scoped;
        nothing is retained across sessions without your explicit memory permission.
    </MudText>
    <MudDivider Class="my-4" />
    <MudText Typo="Typo.subtitle1" HtmlTag="h2">Voice</MudText>
    <MudText Typo="Typo.body2">
        Voice input uses on-device capture with server transcription only after you
        grant the microphone permission. Spoken answers are short summaries; the full
        answer stays on screen. This preview plays no audio until permissions exist:
    </MudText>
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">
        Voice preview is unavailable until the microphone permission is granted.
    </MudAlert>
    <MudDivider Class="my-4" />
    <MudText Typo="Typo.subtitle1" HtmlTag="h2">Interaction</MudText>
    <MudText Typo="Typo.body2">
        One compact composer with its status beneath it. It floats where you place it
        and attaches beneath the active guidance card during demonstrations. Cancel
        ends the session and removes the composer.
    </MudText>
    <MudDivider Class="my-4" />
    <MudText Typo="Typo.subtitle1" HtmlTag="h2">Guidance</MudText>
    <MudText Typo="Typo.body2">
        Demonstrations narrate each step and wait for you. Skipping, pausing, and
        stopping never lose completed work; receipts record what was verified.
    </MudText>
    <MudDivider Class="my-4" />
    <MudText Typo="Typo.subtitle1" HtmlTag="h2">Capabilities</MudText>
    @if (Capabilities is null || Capabilities.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">
            Capability status is loading.
        </MudAlert>
    }
    else
    {
        <MudList T="VoiceCapability" Dense="true" aria-label="Ellai capabilities">
            @foreach (var capability in Capabilities)
            {
                <MudListItem T="VoiceCapability" Text="@($"{capability.Modality} · {capability.Language} · {capability.Availability}")" />
            }
        </MudList>
    }
    <MudDivider Class="my-4" />
    <MudText Typo="Typo.subtitle1" HtmlTag="h2">Privacy</MudText>
    <MudText Typo="Typo.body2">
        Microphone access, transcription, reasoning, memory, and each business action
        are separate permissions. Opening Ellai does not grant them. Sensitive case
        content is never sent to the default reasoning route.
    </MudText>
        </MudTabPanel>
        <MudTabPanel Text="History" aria-label="Previous Ellai sessions">
            @if (PastSessions is null || PastSessions.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status" Class="mt-4">
                    No previous sessions yet. Past conversations appear here when memory permission is granted.
                </MudAlert>
            }
            else
            {
                @foreach (var session in PastSessions.OrderByDescending(s => s.StartedAt))
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-4">
                        @session.Mode · @session.Status · started @session.StartedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                    </MudText>
                    <EllaiActivityDisclosure Entries="@session.Entries" />
                    <MudDivider Class="my-4" />
                }
            }
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    [Parameter]
    public IReadOnlyList<VoiceCapability>? Capabilities { get; set; }

    [Parameter]
    public IReadOnlyList<EllaiPastSession>? PastSessions { get; set; }

    public sealed record EllaiPastSession(
        string SessionId,
        string Mode,
        string Status,
        DateTimeOffset StartedAt,
        IReadOnlyList<EllaiActivityDisclosure.EllaiTimelineEntry> Entries);
}
