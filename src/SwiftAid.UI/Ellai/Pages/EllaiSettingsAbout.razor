@using SwiftAid.UI.Ellai.Components
@using SwiftAid.Contracts.Ellai
@page "/ellai/about"
@implements IDisposable
@inject IEllaiReviewClient ReviewClient

<MudContainer MaxWidth="MaxWidth.Medium" Class="ellai-settings">
    <section class="ellai-settings__hero" aria-labelledby="ellai-settings-title">
        <MudText Typo="Typo.overline" Class="ellai-settings__eyebrow">YOUR SWIFTAID GUIDE</MudText>
        <MudText Typo="Typo.h3" HtmlTag="h1" id="ellai-settings-title" Class="ellai-settings__title">
            Meet Ellai
        </MudText>
        <MudText Typo="Typo.body1" Class="ellai-settings__intro">
            A helpful voice for finding your way around SwiftAid, understanding its features,
            and taking the next step. You stay in control of what you share and what happens next.
        </MudText>
    </section>

    <MudTabs Class="ellai-settings__tabs" aria-label="Ellai information and settings">
        <MudTabPanel Text="About & settings">
            <div class="ellai-settings__content">
                <MudPaper Outlined="true" Class="ellai-settings__card">
                    <MudText Typo="Typo.h6" HtmlTag="h2">A little help, when you need it</MudText>
                    <MudText Typo="Typo.body2">
                        Ask Ellai a question, explore SwiftAid, or get guidance through a supported task.
                        Ellai explains what is happening and leaves important choices with you.
                    </MudText>
                </MudPaper>

                <MudPaper Outlined="true" Class="ellai-settings__card">
                    <MudText Typo="Typo.h6" HtmlTag="h2">Choose how to connect</MudText>
                    <MudText Typo="Typo.body2">
                        Type a message or use the microphone to speak. You can keep typing when voice is unavailable.
                    </MudText>
                </MudPaper>

                <MudPaper Outlined="true" Class="ellai-settings__card">
                    <MudText Typo="Typo.h6" HtmlTag="h2">Voice controls and defaults</MudText>
                    <dl class="ellai-settings__defaults">
                        <dt>Read replies aloud</dt><dd>Off for typed conversations. Select Listen to Ellai to read this and new replies aloud.</dd>
                        <dt>Live Speak replies</dt><dd>Voice turns on when you start Live Speak. You can turn it off beside the status.</dd>
                        <dt>Microphone</dt><dd>Off until you select Record or Live Speak. Live Speak stays ready between turns until you stop it.</dd>
                        <dt>Voice speed</dt><dd>Normal</dd>
                    </dl>
                    <MudText Typo="Typo.caption">Your listening choice lasts for the open conversation. A new conversation or reload uses these defaults.</MudText>
                </MudPaper>

                <MudPaper Outlined="true" Class="ellai-settings__card">
                    <MudText Typo="Typo.h6" HtmlTag="h2">Your choices stay yours</MudText>
                    <MudText Typo="Typo.body2">
                        Ellai can help prepare a next step, but you review and approve actions that change
                        information. Starting the microphone is always your choice.
                    </MudText>
                </MudPaper>

                <MudPaper Outlined="true" Class="ellai-settings__card">
                    <MudText Typo="Typo.h6" HtmlTag="h2">Your privacy</MudText>
                    <MudText Typo="Typo.body2">
                        For privacy, avoid sharing names, contact details, or other details that could identify someone.
                    </MudText>
                </MudPaper>

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="ellai-settings__boundary">
                    Ellai helps with SwiftAid and its workflows. It does not provide medical or veterinary
                    advice, diagnosis, or emergency response.
                </MudAlert>
            </div>
        </MudTabPanel>

        <MudTabPanel Text="Session history" aria-label="Previous Ellai sessions">
            <div class="ellai-settings__history">
                <MudButton Variant="Variant.Text" OnClick="RefreshAsync" Disabled="@_loading">Refresh sessions</MudButton>
                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" aria-label="Loading sessions" />
                }
                @if (_loadFailed)
                {
                    <MudAlert Severity="Severity.Warning" role="status">Your sessions couldn't be loaded. Please try Refresh sessions.</MudAlert>
                }
                else if (!_loading && _sessions.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">
                        No conversations yet for your current account or guest session.
                    </MudAlert>
                }
                else
                {
                    @foreach (var session in _sessions)
                    {
                        <MudPaper @key="session.SessionId" Outlined="true" Class="ellai-settings__session">
                            <div class="ellai-settings__session-heading">
                                <MudText Typo="Typo.subtitle1" HtmlTag="h2">@DisplayMode(session.Mode)</MudText>
                                <MudText Typo="Typo.caption">@session.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Class="ellai-settings__session-status">@DisplayStatus(session.Status)</MudText>
                            <MudButton Variant="Variant.Text" OnClick="@(() => OpenConversationAsync(session.SessionId))">View conversation</MudButton>
                            @if (_selectedSessionId == session.SessionId)
                            {
                                @if (_loadingConversation)
                                {
                                    <MudProgressLinear Indeterminate="true" aria-label="Loading conversation" />
                                }
                                else if (_conversation is null)
                                {
                                    <MudText Typo="Typo.caption" role="status">This conversation couldn't be loaded. Select View conversation to try again.</MudText>
                                }
                                else if (_conversation.Count == 0)
                                {
                                    <MudText Typo="Typo.caption">No saved messages in this conversation.</MudText>
                                }
                                else
                                {
                                    @if (_conversation.Count == 100)
                                    {
                                        <MudText Typo="Typo.caption">Showing the most recent 100 turns.</MudText>
                                    }
                                    @foreach (var turn in _conversation)
                                    {
                                        <div class="ellai-settings__turn" @key="turn.ClientUtteranceId">
                                            <MudText Typo="Typo.caption"><strong>You</strong></MudText>
                                            <MudText Typo="Typo.caption" Class="ellai-settings__message">@(turn.UserText ?? "Earlier message unavailable.")</MudText>
                                            <MudText Typo="Typo.caption"><strong>Ellai</strong></MudText>
                                            <MudText Typo="Typo.caption" Class="ellai-settings__message">@ReplyText(turn)</MudText>
                                        </div>
                                    }
                                }
                            }
                        </MudPaper>
                    }
                }
                @if (_nextOffset is not null)
                {
                    <MudButton Variant="Variant.Text" Disabled="@_loading" OnClick="LoadMoreAsync">Load older sessions</MudButton>
                }
            </div>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private readonly List<EllaiSessionHistoryItemDto> _sessions = [];
    private IReadOnlyList<EllaiConversationTurnDto>? _conversation;
    private string? _selectedSessionId;
    private int? _nextOffset;
    private bool _loading;
    private bool _loadFailed;
    private bool _loadingConversation;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        _sessions.Clear();
        _selectedSessionId = null;
        _conversation = null;
        _nextOffset = null;
        await LoadAsync(0);
    }

    private Task LoadMoreAsync() => LoadAsync(_nextOffset ?? 0);

    private async Task LoadAsync(int offset)
    {
        _loading = true;
        _loadFailed = false;
        try
        {
            var page = await ReviewClient.ListSessionHistoryAsync(offset, _lifetime.Token);
            if (page is null) { _loadFailed = true; return; }
            foreach (var session in page.Sessions)
                if (!_sessions.Any(existing => existing.SessionId == session.SessionId)) _sessions.Add(session);
            _nextOffset = page.NextOffset;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _loadFailed = true; }
        finally { _loading = false; }
    }

    private async Task OpenConversationAsync(string sessionId)
    {
        _selectedSessionId = sessionId;
        _conversation = null;
        _loadingConversation = true;
        try
        {
            var page = await ReviewClient.PollResponsesAsync(sessionId, 0, _lifetime.Token);
            if (_selectedSessionId == sessionId) _conversation = page?.Conversation;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { /* A failed load stays distinct from an empty conversation. */ }
        finally { if (_selectedSessionId == sessionId) _loadingConversation = false; }
    }

    private static string ReplyText(EllaiConversationTurnDto turn) => turn.Outcome switch
    {
        "Completed" => turn.AssistantText ?? "Earlier reply unavailable.",
        "Queued" or "Processing" => "Thinking…",
        "RetryableFailure" => "Reconnecting…",
        "Cancelled" => "Request ended.",
        "TerminalFailure" => "This request couldn't be completed.",
        _ => "Earlier reply unavailable.",
    };

    public void Dispose() { _lifetime.Cancel(); _lifetime.Dispose(); }

    private static string DisplayMode(string mode) => mode switch
    {
        "Ask" => "Asked Ellai",
        "Guide" or "GuideMe" => "Guided session",
        "HelpMeWork" => "Task assistance",
        _ => "Ellai session",
    };

    private static string DisplayStatus(string status) => status switch
    {
        "Active" or "Open" => "In progress",
        "Completed" or "Closed" => "Completed",
        "Canceled" or "Cancelled" => "Ended",
        _ => "Saved session",
    };
}
