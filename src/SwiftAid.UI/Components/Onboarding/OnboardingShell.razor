@* Responsive onboarding/auth shell. Single centered column on narrow screens,
   split illustration + form composition on wide screens. SSR-safe: no JS interop. *@
<div class="onboarding-shell">
    <div class="onboarding-shell__illustration" aria-hidden="true">
        @Illustration
    </div>
    <main class="onboarding-shell__main" aria-labelledby="@HeadingId">
        <div class="onboarding-shell__card">
            @if (ShowBack)
            {
                <MudButton Href="@BackHref"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           aria-label="Back">
                    Back
                </MudButton>
            }
            <OnboardingBrandHeader />
            <SwiftAidPageHeading Eyebrow="@Eyebrow"
                                 Title="@Title"
                                 Description="@Description"
                                 HeadingId="@HeadingId" />
            @if (ShowStepper)
            {
                <OnboardingStepper CurrentStep="CurrentStep" TotalSteps="TotalSteps" />
            }
            @ChildContent
            <nav class="onboarding-shell__legal" aria-label="Legal information">
                <MudLink Href="/privacy">Privacy</MudLink>
                <MudLink Href="/terms">Terms</MudLink>
            </nav>
        </div>
    </main>
</div>

@code {
    [Parameter]
    public string HeadingId { get; set; } = "onboarding-heading";

    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public bool ShowBack { get; set; }

    [Parameter]
    public string BackHref { get; set; } = "/";

    [Parameter]
    public bool ShowStepper { get; set; }

    [Parameter]
    public int CurrentStep { get; set; } = 1;

    [Parameter]
    public int TotalSteps { get; set; } = 4;

    [Parameter]
    public RenderFragment? Illustration { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
