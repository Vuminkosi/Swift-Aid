@* Progress dots for the onboarding carousel. CurrentStep is 1-based. *@
<nav class="onboarding-stepper" aria-label="Onboarding progress">
    <ol>
        @for (var step = 1; step <= TotalSteps; step++)
        {
            var current = step == CurrentStep;
            <li>
                <span class="onboarding-stepper__dot @(current ? "is-current" : step < CurrentStep ? "is-complete" : null)"
                      aria-current="@(current ? "step" : null)"
                      aria-label="@($"Step {step} of {TotalSteps}{(current ? ", current step" : step < CurrentStep ? ", completed" : string.Empty)}")"></span>
            </li>
        }
    </ol>
</nav>

@code {
    [Parameter]
    public int CurrentStep { get; set; } = 1;

    [Parameter]
    public int TotalSteps { get; set; } = 4;

    protected override void OnParametersSet()
    {
        TotalSteps = Math.Max(1, TotalSteps);
        CurrentStep = Math.Clamp(CurrentStep, 1, TotalSteps);
    }
}
