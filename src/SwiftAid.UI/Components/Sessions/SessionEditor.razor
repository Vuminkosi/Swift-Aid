@using SwiftAid.Contracts.Sessions
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation

<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" ConfirmExternalNavigation="@(HasPendingInput && !SuppressNavigationPrompt)" />

<section class="session-editor" aria-label="Community session editor">
    @if (_confirmingLeave)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0" role="alertdialog" aria-modal="true" aria-label="Unsaved session changes">
            <MudText Typo="Typo.subtitle1">Leave without saving your session changes?</MudText>
            <MudText Typo="Typo.body2">Your unsaved entries will be lost.</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="StayOnEditor">Stay on this page</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="LeaveEditor">Leave without saving</MudButton>
        </MudPaper>
    }
    <MudText Typo="Typo.h6" HtmlTag="h2">@(IsNew ? "Plan a new community session" : $"Edit community session")</MudText>

    @if (!IsNew)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Status: @(Status ?? "unknown") · version @ExpectedVersion
        </MudText>
    }

    @if (!IsNew)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary">Country, region, sector and time zone are fixed after creation.</MudText>
    }

    @if (IsScheduled)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status" Class="mt-2">
            You can change the start time and reminder timing. Changes to published content require a reviewed revision, which is not yet available here.
        </MudAlert>
    }

    @if (_storedTimeZoneUnavailable)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert" Class="mt-2">
            This device cannot resolve the saved time zone. The local start time cannot be displayed or edited here.
        </MudAlert>
    }

    @if (HasUnsavedChanges)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status" Class="mt-2">
            You have unsaved changes.@if (!IsNew) { <span> Save them before recording a review or publishing the schedule.</span> }
        </MudAlert>
    }

    @if (ServerError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert" Class="mt-2">@ServerError</MudAlert>
    }

    <fieldset class="session-editor__fields" disabled="@(!CanEditFields || Busy)">
        <legend>Session details</legend>
    <MudGrid Class="mt-2">
        @if (IsNew)
        {
            <MudItem xs="12">
                <MudSelect T="string" Label="Organization" @bind-Value="_organizationId" Required="true" Clearable="true"
                           HelperText="Choose an organization you own. Owners can review materials and publish its sessions."
                           Error='@HasError("OrganizationId")' ErrorText='@FieldError("OrganizationId")'>
                    @foreach (var organizationId in OwnerOrganizationIds)
                    {
                        <MudSelectItem Value="@organizationId">@organizationId</MudSelectItem>
                    }
                </MudSelect>
                @if (OwnerOrganizationIds.Count == 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">No active organization ownership is available for this account.</MudText>
                }
            </MudItem>
        }
        <MudItem xs="12" md="6">
            <MudTextField T="string" Immediate="true" Label="Title" @bind-Value="_title" Disabled="@IsScheduled" Required="true"
                         Error='@HasError("Title")' ErrorText='@FieldError("Title")' />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField T="string" Immediate="true" Label="Presenter" @bind-Value="_presenter" Disabled="@IsScheduled" Required="true"
                         Error='@HasError("Presenter")' ErrorText='@FieldError("Presenter")' />
        </MudItem>
        <MudItem xs="12">
            <MudTextField T="string" Immediate="true" Label="Public summary" Lines="3" @bind-Value="_summary" Disabled="@IsScheduled" Required="true"
                         HelperText="Shown to the public. Logistics only: what the session covers, never patient details."
                         Error='@HasError("Summary")' ErrorText='@FieldError("Summary")' />
        </MudItem>
        <MudItem xs="12">
            <MudTextField T="string" Immediate="true" Label="Who should attend" @bind-Value="_audience" Disabled="@IsScheduled" Required="true"
                         HelperText="Describe the audience in general terms, for example livestock keepers near the showgrounds."
                         Error='@HasError("Audience")' ErrorText='@FieldError("Audience")' />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" Immediate="true" Label="Country code" @bind-Value="_country" Disabled="@(!IsNew)" Required="true"
                         Error='@HasError("Country")' ErrorText='@FieldError("Country")' />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" Immediate="true" Label="Region" @bind-Value="_region" Disabled="@(!IsNew)" Required="true"
                         Error='@HasError("Region")' ErrorText='@FieldError("Region")' />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" Immediate="true" Label="Sector" @bind-Value="_sector" Disabled="@(!IsNew)" Required="true"
                         Error='@HasError("Sector")' ErrorText='@FieldError("Sector")' />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField T="string" Immediate="true" Label="Language" @bind-Value="_language" Disabled="@IsScheduled" Required="true"
                         Error='@HasError("Language")' ErrorText='@FieldError("Language")' />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField T="string" Immediate="true" Label="Topic tags (comma separated)" @bind-Value="_topicTagsText" Disabled="@IsScheduled"
                         Error='@HasError("Tags")' ErrorText='@FieldError("Tags")' />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField T="string" Immediate="true" Label="Time zone" @bind-Value="_timeZone" Disabled="@(!IsNew)" @bind-Value:after="ClearAmbiguousOffset" Required="true"
                         HelperText="An IANA time zone, for example Africa/Harare."
                         Error='@HasError("TimeZone")' ErrorText='@FieldError("TimeZone")' />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField T="DateTime?" Immediate="true" Format="s" InputType="InputType.DateTimeLocal" Label="Start date and time"
                         @bind-Value="_startLocal" @bind-Value:after="ClearAmbiguousOffset" Disabled="@_storedTimeZoneUnavailable" Required="true"
                         HelperText="Wall-clock time in the time zone above."
                         Error='@HasError("Start")' ErrorText='@FieldError("Start")' />
        </MudItem>
        @if (AmbiguousOffsets.Count > 0)
        {
            <MudItem xs="12">
                <MudSelect T="int?" Label="Which occurrence?" @bind-Value="_ambiguousOffsetMinutes"
                           HelperText="This local time occurs twice when clocks change. Choose its UTC offset."
                           Error='@HasError("StartOffset")' ErrorText='@FieldError("StartOffset")'>
                    @foreach (var offset in AmbiguousOffsets)
                    {
                        <MudSelectItem T="int?" Value="@((int?)offset)">UTC@FormatOffset(offset)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }
        <MudItem xs="6" md="3">
            <MudTextField T="string" Immediate="true" Label="Duration (minutes)" @bind-Value="_durationText" Disabled="@IsScheduled" Required="true" InputType="InputType.Number"
                         Error='@HasError("Duration")' ErrorText='@FieldError("Duration")' />
        </MudItem>
        <MudItem xs="6" md="3">
            <MudTextField T="string" Immediate="true" Label="Capacity (optional)" @bind-Value="_capacityText" Disabled="@IsScheduled" InputType="InputType.Number"
                         Error='@HasError("Capacity")' ErrorText='@FieldError("Capacity")' />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="string" Label="Visibility" @bind-Value="_visibility" Disabled="@IsScheduled">
                <MudSelectItem Value="@("Public")">Public (appears in the public list)</MudSelectItem>
                <MudSelectItem Value="@("Internal")">Internal (never appears in the public list)</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="string" Label="Channel" @bind-Value="_channelType" Disabled="@IsScheduled">
                <MudSelectItem Value="@("None")">No online channel</MudSelectItem>
                <MudSelectItem Value="@("FacebookPage")">Facebook page</MudSelectItem>
                <MudSelectItem Value="@("WhatsAppGroup")">WhatsApp group</MudSelectItem>
                <MudSelectItem Value="@("Other")">Other channel</MudSelectItem>
            </MudSelect>
        </MudItem>
        @if (!string.Equals(_channelType, "None", StringComparison.Ordinal))
        {
            <MudItem xs="12">
                <MudTextField T="string" Immediate="true" Label="Channel link" @bind-Value="_channelLink" Disabled="@IsScheduled" Required="true"
                             HelperText="Paste the destination link from the channel you already manage. SwiftAid never posts on your behalf."
                             Error='@HasError("ChannelLink")' ErrorText='@FieldError("ChannelLink")' />
            </MudItem>
        }
        <MudItem xs="12">
            <MudTextField T="string" Immediate="true" Label="Reminder lead hours (comma separated, optional)" @bind-Value="_reminderLeadsText"
                         HelperText="Whole hours between 1 and 168, no repeats. Example: 24, 1."
                         Error='@HasError("ReminderLeads")' ErrorText='@FieldError("ReminderLeads")' />
        </MudItem>
        <MudItem xs="12">
            <MudText Typo="Typo.subtitle2">Source materials</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                At least one human-authored, source-linked material is required. New or unreviewed content cannot be published.
            </MudText>
            @for (var materialIndex = 0; materialIndex < _materials.Count; materialIndex++)
            {
                var row = _materials[materialIndex];
                var removeMaterialLabel = $"Remove material {materialIndex + 1}";
                <div class="session-editor__material-row" @key="row.Key">
                    <MudTextField T="string" Immediate="true" Label="Material" @bind-Value="row.MaterialId" Disabled="@IsScheduled" />
                    <MudTextField T="string" Immediate="true" Label="Source version" @bind-Value="row.SourceVersion" Disabled="@IsScheduled" />
                    <MudTextField T="string" Immediate="true" Label="Source and reuse-rights evidence" @bind-Value="row.RightsEvidence" Disabled="@IsScheduled"
                                  HelperText="Required before an organization owner can approve this material." />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                   OnClick="() => RemoveMaterial(row)" aria-label="@removeMaterialLabel" Disabled="@(!CanEditFields || Busy || IsScheduled)" />
                </div>
            }
            @if (!string.IsNullOrEmpty(FieldError("Materials")))
            {
                <MudText Typo="Typo.caption" Color="Color.Error">@FieldError("Materials")</MudText>
            }
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddMaterial" Disabled="@(!CanEditFields || Busy || IsScheduled)">Add material</MudButton>
        </MudItem>
    </MudGrid>
    </fieldset>

    @if (CanProvideReason)
    {
        <MudTextField T="string" Immediate="true" Label="Reason for this change" @bind-Value="_reason" Required="true"
                     HelperText="Recorded with the change for review."
                     Error='@HasError("Reason")' ErrorText='@FieldError("Reason")' />
    }

    <div class="session-editor__actions">
        @if (IsNew)
        {
            @if (CanCreate)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="SubmitCreateAsync" Disabled="Busy" StartIcon="@Icons.Material.Filled.Save">Save draft</MudButton>
            }
        }
        else
        {
            @if (CanUpdate)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="SubmitUpdateAsync" Disabled="Busy" StartIcon="@Icons.Material.Filled.Save">Save changes</MudButton>
            }
            @if (CanReview && IsDraft)
            {
                @if (IsSelfReview)
                {
                    <MudCheckBox T="bool" @bind-Value="_acknowledgeSelfReview" Color="Color.Primary">
                        I planned this draft and I have reviewed it for publication.
                    </MudCheckBox>
                    @if (!string.IsNullOrEmpty(FieldError("SelfReview")))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@FieldError("SelfReview")</MudText>
                    }
                }
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="SubmitReviewAsync" Disabled="@(Busy || HasUnsavedChanges)" StartIcon="@Icons.Material.Filled.RateReview">Approve materials and record review</MudButton>
            }
            @if (CanSchedule)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="SubmitScheduleAsync" Disabled="@(Busy || HasUnsavedChanges)" StartIcon="@Icons.Material.Filled.Publish">Publish schedule</MudButton>
            }
            @if (CanComplete)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="SubmitCompleteAsync" Disabled="Busy" StartIcon="@Icons.Material.Filled.TaskAlt">Mark complete</MudButton>
            }
            @if (CanCancel)
            {
                @if (!_confirmingCancel)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => _confirmingCancel = true" Disabled="Busy" StartIcon="@Icons.Material.Filled.Cancel">Cancel session…</MudButton>
                }
                else
                {
                    @if (HasUnsavedChanges)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="status">
                            Cancellation applies to the saved session. Your unsaved changes will not be saved.
                        </MudAlert>
                    }
                    <MudTextField T="string" Immediate="true" Label="Cancellation reason" @bind-Value="_cancellationReason" Required="true"
                                 Error='@HasError("CancellationReason")' ErrorText='@FieldError("CancellationReason")' />
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="SubmitCancelAsync" Disabled="Busy" StartIcon="@Icons.Material.Filled.Cancel">Yes, cancel this session</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="() => _confirmingCancel = false" Disabled="Busy" StartIcon="@Icons.Material.Filled.ArrowBack">Keep session</MudButton>
                }
            }
        }
    </div>
</section>

@code {
    [Parameter] public Guid? SessionId { get; set; }

    [Parameter] public long ExpectedVersion { get; set; }

    [Parameter] public string? Status { get; set; }

    [Parameter] public string? CreatedByActorId { get; set; }

    [Parameter] public string? CurrentActorId { get; set; }

    [Parameter] public CommunitySessionView? InitialSession { get; set; }

    [Parameter] public SessionCreateSubmission? InitialDraft { get; set; }
    [Parameter] public SessionEditorWorkingCopy? InitialWorkingCopy { get; set; }

    [Parameter] public SessionManagementPresentation? ManagementCapabilities { get; set; }

    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool SuppressNavigationPrompt { get; set; }

    [Parameter] public string? ServerError { get; set; }

    [Parameter] public EventCallback<SessionCreateSubmission> OnCreate { get; set; }

    [Parameter] public EventCallback<SessionUpdateSubmission> OnUpdate { get; set; }

    [Parameter] public EventCallback<SessionReviewSubmission> OnReview { get; set; }

    [Parameter] public EventCallback<string> OnSchedule { get; set; }

    [Parameter] public EventCallback<SessionCancelSubmission> OnCancel { get; set; }

    [Parameter] public EventCallback<string> OnComplete { get; set; }

    private string _title = string.Empty;
    private string? _organizationId;
    private IReadOnlyList<string> OwnerOrganizationIds => ManagementCapabilities?.OwnerOrganizationIds ?? [];
    private string _summary = string.Empty;
    private string _audience = string.Empty;
    private string _country = string.Empty;
    private string _region = string.Empty;
    private string _sector = string.Empty;
    private string _presenter = string.Empty;
    private string _language = string.Empty;
    private string _topicTagsText = string.Empty;
    private string _timeZone = "Africa/Harare";
    private DateTime? _startLocal;
    private int? _ambiguousOffsetMinutes;
    private string _durationText = "60";
    private string _capacityText = string.Empty;
    private string _visibility = "Public";
    private string _channelType = "None";
    private string? _channelLink;
    private string _reminderLeadsText = "24, 1";
    private readonly List<MaterialRow> _materials = new();
    private string _reason = string.Empty;
    private string? _cancellationReason;
    private bool _acknowledgeSelfReview;
    private bool _confirmingCancel;
    private Guid? _loadedForSessionId;
    private string?[]? _savedFields;
    private bool _draftRestored;
    private bool _workingCopyRestored;
    private bool _storedTimeZoneUnavailable;
    private bool _confirmingLeave;
    private string? _approvedLocation;
    private string? _pendingLocation;
    private readonly Dictionary<string, string> _errors = new(StringComparer.Ordinal);

    private bool IsNew => SessionId is null;
    private bool IsScheduled => string.Equals(Status, "Scheduled", StringComparison.OrdinalIgnoreCase);
    private bool IsDraft => string.Equals(Status, "Draft", StringComparison.OrdinalIgnoreCase);
    private bool HasUnsavedChanges => _savedFields is not null && !CaptureFields().SequenceEqual(_savedFields);
    public bool HasPendingInput => HasUnsavedChanges || !string.IsNullOrWhiteSpace(_reason) ||
        !string.IsNullOrWhiteSpace(_cancellationReason) || _acknowledgeSelfReview;
    private bool HasCurrentCapabilities => ManagementCapabilities is { } capabilities &&
        capabilities.Matches(SessionId, IsNew ? null : ExpectedVersion, Status);
    private bool CanCreate => IsNew && HasCurrentCapabilities && ManagementCapabilities!.CanCreate;
    private bool CanUpdate => !IsNew && HasCurrentCapabilities && ManagementCapabilities!.CanEdit;
    private bool CanReview => !IsNew && HasCurrentCapabilities && ManagementCapabilities!.CanReview;
    private bool CanSchedule => !IsNew && HasCurrentCapabilities && ManagementCapabilities!.CanSchedule;
    private bool CanCancel => !IsNew && HasCurrentCapabilities && ManagementCapabilities!.CanCancel;
    private bool CanComplete => !IsNew && HasCurrentCapabilities && ManagementCapabilities!.CanComplete;
    private bool CanEditFields => IsNew ? CanCreate : CanUpdate;
    private bool CanProvideReason => CanCreate || CanUpdate || CanReview || CanSchedule || CanCancel || CanComplete;
    private bool IsSelfReview =>
        CurrentActorId is not null &&
        string.Equals(CurrentActorId, CreatedByActorId, StringComparison.Ordinal);

    protected override void OnParametersSet()
    {
        if (InitialSession is not null && _loadedForSessionId != InitialSession.SessionId)
        {
            _loadedForSessionId = InitialSession.SessionId;
            Prefill(InitialSession);
        }
        else if (InitialSession is null && _loadedForSessionId is not null)
        {
            _loadedForSessionId = null;
        }
        else if (InitialSession is null && _savedFields is null)
        {
            _savedFields = CaptureFields();
        }
        if (IsNew && InitialSession is null && InitialDraft is { } draft && !_draftRestored)
        {
            _draftRestored = true;
            var input = draft.Input;
            _title = input.Title;
            _organizationId = input.OrganizationId;
            _summary = input.Summary;
            _audience = input.AudienceDescription;
            _country = input.CountryCode;
            _region = input.RegionId;
            _sector = input.Sector;
            _presenter = input.Presenter;
            _language = input.Language;
            _topicTagsText = string.Join(", ", input.TopicTags);
            _timeZone = input.TimeZoneId;
            _startLocal = ToWallClock(input.StartUtc, input.TimeZoneId);
            _storedTimeZoneUnavailable = _startLocal is null;
            _ambiguousOffsetMinutes = GetStoredAmbiguousOffset(input.StartUtc, input.TimeZoneId);
            _durationText = input.DurationMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _capacityText = input.Capacity?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
            _visibility = input.Visibility.ToString();
            _channelType = input.ChannelType.ToString();
            _channelLink = input.ChannelLink;
            _reminderLeadsText = string.Join(", ", input.ReminderLeadHours);
            _materials.Clear();
            foreach (var material in input.Materials)
                _materials.Add(new MaterialRow { MaterialId = material.MaterialId, SourceVersion = material.SourceVersion, RightsEvidence = material.RightsEvidence ?? string.Empty });
            _reason = draft.Reason;
        }
        if (InitialWorkingCopy is { } workingCopy && !_workingCopyRestored &&
            !string.IsNullOrWhiteSpace(CurrentActorId) && string.Equals(workingCopy.ActorId, CurrentActorId, StringComparison.Ordinal) &&
            workingCopy.SessionId == SessionId && workingCopy.ExpectedVersion == ExpectedVersion)
        {
            _workingCopyRestored = true;
            RestoreWorkingCopy(workingCopy);
        }
    }

    /// <summary>Captures incomplete entries without validating or submitting them.</summary>
    public SessionEditorWorkingCopy CaptureWorkingCopy() => new(
        CurrentActorId, SessionId, ExpectedVersion, _title, _organizationId, _summary, _audience, _country, _region, _sector, _presenter, _language,
        _topicTagsText, _timeZone, _startLocal, _ambiguousOffsetMinutes, _durationText, _capacityText,
        _visibility, _channelType, _channelLink, _reminderLeadsText,
        _materials.Select(item => new SessionMaterialInput(item.MaterialId, item.SourceVersion, item.RightsEvidence)).ToArray(),
        _reason, _cancellationReason, _acknowledgeSelfReview, _storedTimeZoneUnavailable, _savedFields?.ToArray());

    private void RestoreWorkingCopy(SessionEditorWorkingCopy copy)
    {
        _title = copy.Title;
        _organizationId = copy.OrganizationId;
        _summary = copy.Summary;
        _audience = copy.Audience;
        _country = copy.Country;
        _region = copy.Region;
        _sector = copy.Sector;
        _presenter = copy.Presenter;
        _language = copy.Language;
        _topicTagsText = copy.TopicTags;
        _timeZone = copy.TimeZone;
        _startLocal = copy.StartLocal;
        _ambiguousOffsetMinutes = copy.AmbiguousOffsetMinutes;
        _durationText = copy.Duration;
        _capacityText = copy.Capacity;
        _visibility = copy.Visibility;
        _channelType = copy.ChannelType;
        _channelLink = copy.ChannelLink;
        _reminderLeadsText = copy.ReminderLeads;
        _reason = copy.Reason;
        _cancellationReason = copy.CancellationReason;
        _acknowledgeSelfReview = copy.AcknowledgeSelfReview;
        _storedTimeZoneUnavailable = copy.StoredTimeZoneUnavailable;
        _savedFields = copy.SavedFields?.ToArray();
        _materials.Clear();
        foreach (var material in copy.Materials)
        {
            _materials.Add(new MaterialRow
            {
                MaterialId = material.MaterialId,
                SourceVersion = material.SourceVersion,
                RightsEvidence = material.RightsEvidence ?? string.Empty
            });
        }
    }

    private void ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (SuppressNavigationPrompt) return;
        if (_approvedLocation is { } approved)
        {
            _approvedLocation = null;
            if (string.Equals(approved, context.TargetLocation, StringComparison.Ordinal)) return;
        }
        if (!HasPendingInput) return;
        context.PreventNavigation();
        _pendingLocation = context.TargetLocation;
        _confirmingLeave = true;
    }

    private void StayOnEditor()
    {
        _confirmingLeave = false;
        _pendingLocation = null;
    }

    private void LeaveEditor()
    {
        if (_pendingLocation is not { } target) return;
        _confirmingLeave = false;
        _pendingLocation = null;
        _approvedLocation = target;
        Navigation.NavigateTo(target);
    }

    private void Prefill(CommunitySessionView view)
    {
        _title = view.Title;
        _organizationId = view.OrganizationId;
        _summary = view.Summary;
        _audience = view.AudienceDescription;
        _country = view.CountryCode;
        _region = view.RegionId;
        _sector = view.Sector;
        _presenter = view.Presenter;
        _language = view.Language;
        _topicTagsText = string.Join(", ", view.TopicTags);
        _timeZone = view.TimeZoneId;
        _startLocal = ToWallClock(view.StartUtc, view.TimeZoneId);
        _storedTimeZoneUnavailable = _startLocal is null;
        _ambiguousOffsetMinutes = GetStoredAmbiguousOffset(view.StartUtc, view.TimeZoneId);
        _durationText = view.DurationMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _capacityText = view.Capacity?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
        _visibility = view.Visibility.ToString();
        _channelType = view.ChannelType.ToString();
        _channelLink = view.ChannelLink;
        _reminderLeadsText = string.Join(", ", view.ReminderLeadHours);
        _materials.Clear();
        foreach (var material in view.Materials)
        {
            _materials.Add(new MaterialRow { MaterialId = material.MaterialId, SourceVersion = material.SourceVersion, RightsEvidence = material.RightsEvidence ?? string.Empty });
        }

        _errors.Clear();
        _confirmingCancel = false;
        _savedFields = CaptureFields();
    }

    private string?[] CaptureFields()
    {
        var fields = new List<string?>
        {
            _title, _summary, _audience, _country, _region, _sector, _presenter, _language,
            _topicTagsText, _timeZone, _startLocal?.ToString("O", System.Globalization.CultureInfo.InvariantCulture),
            _ambiguousOffsetMinutes?.ToString(System.Globalization.CultureInfo.InvariantCulture), _durationText,
            _organizationId, _capacityText, _visibility, _channelType, _channelLink, _reminderLeadsText
        };
        foreach (var material in _materials)
        {
            fields.Add(material.MaterialId);
            fields.Add(material.SourceVersion);
            fields.Add(material.RightsEvidence);
        }
        return fields.ToArray();
    }

    private static DateTime? ToWallClock(DateTimeOffset startUtc, string timeZoneId)
    {
        try
        {
            var zone = TimeZoneInfo.FindSystemTimeZoneById(timeZoneId);
            return TimeZoneInfo.ConvertTime(startUtc, zone).DateTime;
        }
        catch (Exception ex) when (ex is TimeZoneNotFoundException or InvalidTimeZoneException or ArgumentException)
        {
            return null;
        }
    }

    private string? FieldError(string key) => _errors.TryGetValue(key, out var message) ? message : null;

    private bool HasError(string key) => _errors.ContainsKey(key);

    private void AddMaterial() => _materials.Add(new MaterialRow());

    private void RemoveMaterial(MaterialRow row) => _materials.Remove(row);

    private async Task SubmitCreateAsync()
    {
        if (!CanCreate || !ValidateForm(requireReason: true, forSchedule: false))
        {
            return;
        }

        await OnCreate.InvokeAsync(new SessionCreateSubmission(BuildCreateInput(), _reason.Trim()));
    }

    private async Task SubmitUpdateAsync()
    {
        if (!CanUpdate || !ValidateForm(requireReason: true, forSchedule: false))
        {
            return;
        }

        await OnUpdate.InvokeAsync(new SessionUpdateSubmission(
            SessionId!.Value, ExpectedVersion, BuildUpdateInput(), _reason.Trim()));
    }

    private async Task SubmitReviewAsync()
    {
        if (!CanReview || !IsDraft || HasUnsavedChanges || !ValidateForm(requireReason: true, forSchedule: false))
        {
            return;
        }

        if (IsSelfReview && !_acknowledgeSelfReview)
        {
            _errors["SelfReview"] = "A creator publishing their own draft must explicitly acknowledge the self-review.";
            return;
        }

        await OnReview.InvokeAsync(new SessionReviewSubmission(_acknowledgeSelfReview, _reason.Trim()));
    }

    private async Task SubmitScheduleAsync()
    {
        if (!CanSchedule || HasUnsavedChanges || !ValidateForm(requireReason: true, forSchedule: true))
        {
            return;
        }

        await OnSchedule.InvokeAsync(_reason.Trim());
    }

    private async Task SubmitCancelAsync()
    {
        if (!CanCancel || Busy)
        {
            return;
        }

        _errors.Clear();
        if (string.IsNullOrWhiteSpace(_reason))
        {
            _errors["Reason"] = "A reason for this change is required.";
        }
        if (string.IsNullOrWhiteSpace(_cancellationReason))
        {
            _errors["CancellationReason"] = "A cancellation reason is required.";
        }
        if (_errors.Count != 0)
        {
            return;
        }

        await OnCancel.InvokeAsync(new SessionCancelSubmission(_cancellationReason!.Trim(), _reason.Trim()));
    }

    private async Task SubmitCompleteAsync()
    {
        if (!CanComplete || !ValidateForm(requireReason: true, forSchedule: false))
        {
            return;
        }

        await OnComplete.InvokeAsync(_reason.Trim());
    }

    private CreateSessionInput BuildCreateInput() => new(
        _title.Trim(),
        _summary.Trim(),
        _audience.Trim(),
        ParseTags(),
        _country.Trim(),
        _region.Trim(),
        _sector.Trim(),
        _presenter.Trim(),
        _language.Trim(),
        ToStartUtc(),
        _timeZone.Trim(),
        int.Parse(_durationText.Trim(), System.Globalization.CultureInfo.InvariantCulture),
        ParseCapacity(),
        _materials.Select(m => new SessionMaterialInput(m.MaterialId.Trim(), m.SourceVersion.Trim(), m.RightsEvidence.Trim())).ToArray(),
        Enum.Parse<SessionVisibility>(_visibility, ignoreCase: true),
        Enum.Parse<SessionChannelType>(_channelType, ignoreCase: true),
        string.IsNullOrWhiteSpace(_channelLink) ? null : _channelLink.Trim(),
        ParseReminderLeads()) { OrganizationId = _organizationId?.Trim() ?? string.Empty };

    private UpdateSessionInput BuildUpdateInput()
    {
        if (IsScheduled)
        {
            if (InitialSession is not { } published || published.SessionId != SessionId || published.Version != ExpectedVersion)
                throw new InvalidOperationException("The current published session must be loaded before rescheduling.");

            return new UpdateSessionInput(published.Title, published.Summary, published.AudienceDescription,
                published.TopicTags, published.Presenter, published.Language, ToStartUtc(), published.DurationMinutes,
                published.Capacity, published.Materials.Select(item => new SessionMaterialInput(item.MaterialId, item.SourceVersion, item.RightsEvidence)).ToArray(),
                published.Visibility, published.ChannelType, published.ChannelLink, ParseReminderLeads());
        }

        var create = BuildCreateInput();
        return new UpdateSessionInput(
            create.Title,
            create.Summary,
            create.AudienceDescription,
            create.TopicTags,
            create.Presenter,
            create.Language,
            create.StartUtc,
            create.DurationMinutes,
            create.Capacity,
            create.Materials,
            create.Visibility,
            create.ChannelType,
            create.ChannelLink,
            create.ReminderLeadHours);
    }

    private bool ValidateForm(bool requireReason, bool forSchedule)
    {
        _errors.Clear();

        if (IsNew && !OwnerOrganizationIds.Contains(_organizationId ?? string.Empty, StringComparer.Ordinal))
            _errors["OrganizationId"] = "Choose an active organization you own.";
        Require(_title, "Title", "A title is required.");
        Require(_summary, "Summary", "A public summary is required.");
        Require(_audience, "Audience", "Describe who should attend.");
        Require(_country, "Country", "A country code is required.");
        Require(_region, "Region", "A region is required.");
        Require(_sector, "Sector", "A sector is required.");
        Require(_presenter, "Presenter", "A presenter is required.");
        Require(_language, "Language", "A language is required.");
        Require(_timeZone, "TimeZone", "A time zone is required.");

        TimeZoneInfo? zone = null;
        if (!string.IsNullOrWhiteSpace(_timeZone))
        {
            try
            {
                zone = TimeZoneInfo.FindSystemTimeZoneById(_timeZone.Trim());
            }
            catch (Exception ex) when (ex is TimeZoneNotFoundException or InvalidTimeZoneException or ArgumentException)
            {
                _errors["TimeZone"] = "The time zone is unknown on this host.";
            }
        }

        DateTimeOffset? startUtc = null;
        if (_startLocal is null)
        {
            _errors["Start"] = "A session start is required.";
        }
        else if (zone is not null)
        {
            try
            {
                var local = DateTime.SpecifyKind(_startLocal.Value, DateTimeKind.Unspecified);
                if (zone.IsAmbiguousTime(local) &&
                    (!_ambiguousOffsetMinutes.HasValue || !zone.GetAmbiguousTimeOffsets(local).Contains(TimeSpan.FromMinutes(_ambiguousOffsetMinutes.Value))))
                {
                    _errors["StartOffset"] = "Choose which UTC offset applies to this local time.";
                }
                else
                {
                    startUtc = ToStartUtc();
                }
            }
            catch (ArgumentException)
            {
                _errors["Start"] = "That local time does not exist in the selected time zone.";
            }
        }

        if (forSchedule && startUtc is not null && startUtc.Value <= DateTimeOffset.UtcNow)
        {
            _errors["Start"] = "A session can only be scheduled for a future start.";
        }

        if (!int.TryParse(_durationText?.Trim(), System.Globalization.NumberStyles.Integer,
                System.Globalization.CultureInfo.InvariantCulture, out var duration) ||
            duration < 1 || duration > 1440)
        {
            _errors["Duration"] = "Duration must be between 1 and 1440 minutes.";
        }

        if (!string.IsNullOrWhiteSpace(_capacityText))
        {
            if (!int.TryParse(_capacityText.Trim(), System.Globalization.NumberStyles.Integer,
                    System.Globalization.CultureInfo.InvariantCulture, out var capacity) ||
                capacity < 1)
            {
                _errors["Capacity"] = "Capacity must be positive when set.";
            }
        }

        if (!string.IsNullOrWhiteSpace(_topicTagsText))
        {
            var tags = _topicTagsText.Split(',').Select(t => t.Trim()).ToArray();
            if (tags.Any(string.IsNullOrWhiteSpace))
            {
                _errors["Tags"] = "Topic tags must not be blank.";
            }
        }

        if (_materials.Count == 0)
        {
            _errors["Materials"] = "At least one source-linked material is required.";
        }
        else if (_materials.Any(m => string.IsNullOrWhiteSpace(m.MaterialId) || string.IsNullOrWhiteSpace(m.SourceVersion) || (IsDraft && string.IsNullOrWhiteSpace(m.RightsEvidence))))
        {
            _errors["Materials"] = "Each material needs an identifier, source version, and source/reuse-rights evidence.";
        }

        if (string.Equals(_channelType, "None", StringComparison.Ordinal))
        {
            if (!string.IsNullOrWhiteSpace(_channelLink))
            {
                _errors["ChannelLink"] = "A channel link requires a channel type.";
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_channelLink))
            {
                _errors["ChannelLink"] = "A channel link is required for the selected channel type.";
            }
            else if (!Uri.TryCreate(_channelLink.Trim(), UriKind.Absolute, out var uri) ||
                (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
            {
                _errors["ChannelLink"] = "A channel link must be an absolute http(s) URL.";
            }
        }

        if (!string.IsNullOrWhiteSpace(_reminderLeadsText))
        {
            var parts = _reminderLeadsText.Split(',').Select(p => p.Trim()).ToArray();
            var parsed = new List<int>(parts.Length);
            var valid = true;
            foreach (var part in parts)
            {
                if (!int.TryParse(part, System.Globalization.NumberStyles.Integer,
                        System.Globalization.CultureInfo.InvariantCulture, out var lead) ||
                    lead < 1 || lead > 168)
                {
                    valid = false;
                    break;
                }

                parsed.Add(lead);
            }

            if (!valid)
            {
                _errors["ReminderLeads"] = "Reminder lead hours must be whole hours between 1 and 168.";
            }
            else if (parsed.Distinct().Count() != parsed.Count)
            {
                _errors["ReminderLeads"] = "Reminder lead hours must be distinct.";
            }
        }

        if (requireReason && string.IsNullOrWhiteSpace(_reason))
        {
            _errors["Reason"] = "A reason for this change is required.";
        }

        return _errors.Count == 0;

        void Require(string? value, string key, string message)
        {
            if (!_errors.ContainsKey(key) && string.IsNullOrWhiteSpace(value))
            {
                _errors[key] = message;
            }
        }
    }

    private IReadOnlyList<string> ParseTags() =>
        string.IsNullOrWhiteSpace(_topicTagsText)
            ? Array.Empty<string>()
            : _topicTagsText.Split(',').Select(t => t.Trim()).Where(t => t.Length > 0).ToArray();

    private int? ParseCapacity() =>
        string.IsNullOrWhiteSpace(_capacityText)
            ? null
            : int.Parse(_capacityText.Trim(), System.Globalization.CultureInfo.InvariantCulture);

    private IReadOnlyList<int> ParseReminderLeads() =>
        string.IsNullOrWhiteSpace(_reminderLeadsText)
            ? Array.Empty<int>()
            : _reminderLeadsText.Split(',').Select(p => int.Parse(p.Trim(), System.Globalization.CultureInfo.InvariantCulture)).ToArray();

    private DateTimeOffset ToStartUtc()
    {
        var zone = TimeZoneInfo.FindSystemTimeZoneById(_timeZone.Trim());
        var local = DateTime.SpecifyKind(_startLocal!.Value, DateTimeKind.Unspecified);
        if (zone.IsAmbiguousTime(local))
        {
            if (!_ambiguousOffsetMinutes.HasValue ||
                !zone.GetAmbiguousTimeOffsets(local).Contains(TimeSpan.FromMinutes(_ambiguousOffsetMinutes.Value)))
            {
                throw new InvalidOperationException("An offset must be selected for an ambiguous local time.");
            }

            return new DateTimeOffset(local, TimeSpan.FromMinutes(_ambiguousOffsetMinutes.Value)).ToUniversalTime();
        }

        return new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(local, zone));
    }

    private IReadOnlyList<int> AmbiguousOffsets
    {
        get
        {
            if (_startLocal is null || string.IsNullOrWhiteSpace(_timeZone))
                return Array.Empty<int>();

            try
            {
                var zone = TimeZoneInfo.FindSystemTimeZoneById(_timeZone.Trim());
                var local = DateTime.SpecifyKind(_startLocal.Value, DateTimeKind.Unspecified);
                return zone.IsAmbiguousTime(local)
                    ? zone.GetAmbiguousTimeOffsets(local).Select(offset => (int)offset.TotalMinutes).OrderDescending().ToArray()
                    : Array.Empty<int>();
            }
            catch (Exception ex) when (ex is TimeZoneNotFoundException or InvalidTimeZoneException or ArgumentException)
            {
                return Array.Empty<int>();
            }
        }
    }

    private static int? GetStoredAmbiguousOffset(DateTimeOffset startUtc, string timeZoneId)
    {
        try
        {
            var zone = TimeZoneInfo.FindSystemTimeZoneById(timeZoneId);
            var local = TimeZoneInfo.ConvertTime(startUtc, zone);
            return zone.IsAmbiguousTime(local.DateTime) ? (int)local.Offset.TotalMinutes : null;
        }
        catch (Exception ex) when (ex is TimeZoneNotFoundException or InvalidTimeZoneException or ArgumentException)
        {
            return null;
        }
    }

    private void ClearAmbiguousOffset() => _ambiguousOffsetMinutes = null;

    private static string FormatOffset(int minutes)
    {
        var absolute = Math.Abs(minutes);
        return $"{(minutes < 0 ? "-" : "+")}{absolute / 60:00}:{absolute % 60:00}";
    }

    private sealed class MaterialRow
    {
        public Guid Key { get; } = Guid.NewGuid();
        public string MaterialId { get; set; } = string.Empty;
        public string SourceVersion { get; set; } = string.Empty;
        public string RightsEvidence { get; set; } = string.Empty;
    }
}
