@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<MudText Typo="Typo.subtitle2" id="appearance-heading">Appearance</MudText>
<MudRadioGroup T="string" Value="_theme" ValueChanged="SetAsync" aria-labelledby="appearance-heading">
    <MudRadio Value="@("system")" Color="Color.Primary">System</MudRadio>
    <MudRadio Value="@("light")" Color="Color.Primary">Light</MudRadio>
    <MudRadio Value="@("dark")" Color="Color.Primary">Dark</MudRadio>
</MudRadioGroup>
<MudText Typo="Typo.caption">
    @if (_theme == "system" && !string.IsNullOrWhiteSpace(_effectiveTheme))
    {
        @($"Following your device setting ({_effectiveTheme}). Changes apply automatically.")
    }
    else
    {
        @("Changes apply automatically.")
    }
</MudText>

<MudPaper Class="pa-3 mt-2 theme-preview" Elevation="0" aria-hidden="true">
    <MudText Typo="Typo.subtitle2">SwiftAid</MudText>
    <MudText Typo="Typo.body2">Example card and button</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="true">
        Preview action
    </MudButton>
</MudPaper>

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<ThemePreferenceControl>? _self;
    private string _theme = "system";
    private string? _effectiveTheme;
    private bool _disposed;

    [JSInvokable]
    public Task OnSystemThemeChanged(string theme)
    {
        if (_disposed || (theme != "light" && theme != "dark"))
        {
            return Task.CompletedTask;
        }

        _effectiveTheme = theme;
        return InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/SwiftAid.UI/js/theme-preference.js");
            _theme = await _module.InvokeAsync<string>("getTheme");
            if (_theme != "light" && _theme != "dark" && _theme != "system")
            {
                _theme = "system";
            }

            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("watchSystemTheme", _self);
            StateHasChanged();
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task SetAsync(string value)
    {
        _theme = value is "light" or "dark" or "system" ? value : "system";
        if (_module is not null)
        {
            try
            {
                _effectiveTheme = await _module.InvokeAsync<string>("setTheme", _theme);
            }
            catch (JSException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        GC.SuppressFinalize(this);
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }
    }
}
