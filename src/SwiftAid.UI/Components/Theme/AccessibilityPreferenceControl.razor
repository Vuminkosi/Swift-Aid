@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<MudText Typo="Typo.subtitle2" id="accessibility-heading">Accessibility</MudText>
<MudSwitch T="bool" Value="_reduceMotion" ValueChanged="SetAsync"
           Color="Color.Primary" Label="Reduce motion"
           aria-describedby="accessibility-motion-hint" />
<MudText Typo="Typo.caption" id="accessibility-motion-hint">
    @(EffectiveText())
</MudText>
<MudText Typo="Typo.subtitle2" id="text-scale-heading">Text size</MudText>
<MudRadioGroup T="string" Value="_textScale" ValueChanged="SetTextScaleAsync" aria-labelledby="text-scale-heading">
    <MudRadio Value="@("system")" Color="Color.Primary">System</MudRadio>
    <MudRadio Value="@("standard")" Color="Color.Primary">Standard</MudRadio>
    <MudRadio Value="@("large")" Color="Color.Primary">Large</MudRadio>
    <MudRadio Value="@("extra-large")" Color="Color.Primary">Extra-large</MudRadio>
</MudRadioGroup>
<MudText Typo="Typo.caption">@(TextScaleHint())</MudText>

@code {
    private IJSObjectReference? _module;
    private IJSObjectReference? _textScaleModule;
    private DotNetObjectReference<AccessibilityPreferenceControl>? _self;
    private bool _reduceMotion;
    private bool _followsSystem = true;
    private string _textScale = "system";
    private bool _disposed;

    [JSInvokable]
    public Task OnSystemMotionChanged(bool systemReduced)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        if (_followsSystem)
        {
            _reduceMotion = systemReduced;
            return InvokeAsync(StateHasChanged);
        }

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/SwiftAid.UI/js/motion-preference.js");
            var preference = await _module.InvokeAsync<string>("getMotion");
            _followsSystem = preference != "reduced";
            _reduceMotion = await _module.InvokeAsync<bool>("setMotion", preference);

            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("watchMotion", _self);
            _textScaleModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/SwiftAid.UI/js/text-scale-preference.js");
            _textScale = await _textScaleModule.InvokeAsync<string>("getTextScale");
            if (_textScale != "system" && _textScale != "standard" && _textScale != "large" && _textScale != "extra-large")
            {
                _textScale = "system";
            }

            StateHasChanged();
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task SetAsync(bool value)
    {
        // Off always means "follow the device setting", never "force motion on".
        _followsSystem = !value;
        if (_module is not null)
        {
            try
            {
                _reduceMotion = await _module.InvokeAsync<bool>(
                    "setMotion", value ? "reduced" : "system");
                return;
            }
            catch (JSException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }

        _reduceMotion = value;
    }

    private string EffectiveText() =>
        _reduceMotion
            ? "Motion is reduced in this app."
            : "Motion follows your device setting.";

    private async Task SetTextScaleAsync(string value)
    {
        _textScale = value is "standard" or "large" or "extra-large" or "system" ? value : "system";
        if (_textScaleModule is not null)
        {
            try
            {
                _textScale = await _textScaleModule.InvokeAsync<string>("setTextScale", _textScale);
                return;
            }
            catch (JSException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }
    }

    private string TextScaleHint() =>
        _textScale switch
        {
            "large" => "Large text. Applies across the app immediately.",
            "extra-large" => "Extra-large text. Applies across the app immediately.",
            "standard" => "Standard text size.",
            _ => "Text size follows your device setting.",
        };

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        GC.SuppressFinalize(this);
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }

        if (_textScaleModule is not null)
        {
            try
            {
                await _textScaleModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }
    }
}
