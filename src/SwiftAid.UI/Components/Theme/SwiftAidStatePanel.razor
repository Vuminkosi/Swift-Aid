@using SwiftAid.UI.Components.Theme

<div class="swiftaid-state-panel__announcer" aria-live="polite" aria-atomic="true">@_announcementText</div>

@if (State != SwiftAidViewState.Populated)
{
    <MudPaper Class="@PanelClass" Elevation="0" role="@(State == SwiftAidViewState.Loading ? "status" : "region")" aria-labelledby="@HeadingId" aria-live="@(State is SwiftAidViewState.Loading or SwiftAidViewState.Error or SwiftAidViewState.Offline or SwiftAidViewState.Denied ? "polite" : null)">
        <div class="swiftaid-status-panel__content">
            @if (State == SwiftAidViewState.Loading)
            {
                <MudProgressCircular Class="swiftaid-status-panel__icon" Indeterminate="true" Size="Size.Small" aria-hidden="true" />
            }
            else
            {
                <MudIcon Class="swiftaid-status-panel__icon" Icon="@Icon" aria-hidden="true" />
            }

            <div class="swiftaid-status-panel__copy">
                <MudText id="@HeadingId" Typo="Typo.subtitle1" HtmlTag="h2">@Heading</MudText>
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <MudText Typo="Typo.body2" Class="swiftaid-status-panel__description">@Description</MudText>
                }

                @if (Actions is not null || OnRetry.HasDelegate)
                {
                    <div class="swiftaid-status-panel__actions">
                        @Actions
                        @if (OnRetry.HasDelegate)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="OnRetry" aria-label="Try loading this section again" StartIcon="@Icons.Material.Filled.Refresh">
                                Try again
                            </MudButton>
                        }
                    </div>
                }
            </div>
        </div>
    </MudPaper>
}
else
{
    @ChildContent
}

@code {
    private string _announcementText = string.Empty;

    [Parameter]
    public SwiftAidViewState State { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private string PanelClass => string.Join(" ", new[]
    {
        "swiftaid-status-panel",
        $"swiftaid-status-panel--{State.ToString().ToLowerInvariant()}",
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string HeadingId { get; } = $"swiftaid-state-{Guid.NewGuid():N}";

    protected override void OnParametersSet()
    {
        var nextAnnouncement = State is SwiftAidViewState.Empty or SwiftAidViewState.Information
            ? string.IsNullOrWhiteSpace(Description) ? Heading : $"{Heading}. {Description}"
            : string.Empty;

        if (!string.Equals(_announcementText, nextAnnouncement, StringComparison.Ordinal))
        {
            _announcementText = nextAnnouncement;
        }
    }

    private string Heading => !string.IsNullOrWhiteSpace(Title)
        ? Title
        : State switch
        {
            SwiftAidViewState.Loading => "Loading",
            SwiftAidViewState.Empty => "Nothing to show yet",
            SwiftAidViewState.Offline => "You are offline",
            SwiftAidViewState.Error => "We couldn't load this information",
            SwiftAidViewState.Denied => "You can't view this right now",
            SwiftAidViewState.Information => "Information",
            _ => string.Empty
        };

    private string Icon => State switch
    {
        SwiftAidViewState.Empty => Icons.Material.Filled.Inbox,
        SwiftAidViewState.Offline => Icons.Material.Outlined.CloudOff,
        SwiftAidViewState.Error => Icons.Material.Outlined.ErrorOutline,
        SwiftAidViewState.Denied => Icons.Material.Outlined.Lock,
        _ => Icons.Material.Outlined.Info
    };
}
