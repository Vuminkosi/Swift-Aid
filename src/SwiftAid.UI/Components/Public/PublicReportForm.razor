@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using SwiftAid.Contracts.Geography
@using SwiftAid.Contracts.Intake
@using SwiftAid.UI.Components.Public
@implements IDisposable

<section class="public-report" aria-labelledby="public-report-title">
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
        You can report without an account. Reports are private and are not checked when first received.
        Sending a report does not mean a service is available or that help is on the way.
    </MudAlert>

    <MudText id="public-report-title" Typo="Typo.h5" HtmlTag="h2">Report details</MudText>

    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
        @if (HasPendingAttachments)
        {
            <span>Remove the locally selected files to save or send the report. The file contents are not included.</span>
        }
        else if (CanSaveDraft)
        {
            <span>Your draft can be saved on this device. It has not been sent to SwiftAid.</span>
        }
        else
        {
            <span>This form is not saved on this device. Leaving this page will discard these entries. Nothing has been sent to SwiftAid.</span>
        }
    </MudAlert>

    <EditForm EditContext="@_editContext" OnSubmit="HandleFormSubmit">
        <DataAnnotationsValidator />
        <div class="public-report__sections">
            <section class="public-report__section" aria-labelledby="public-report-subject">
                <div>
                    <MudText id="public-report-subject" Typo="Typo.h6" HtmlTag="h3">Who or what is this concern about?</MudText>
                    <MudText Typo="Typo.body2" Class="public-report__hint">Choose the closest description. You can leave unknown details blank.</MudText>
                </div>

                <fieldset class="public-report__subject-fieldset" aria-describedby="public-subject-error">
                    <legend class="public-report__label">Concern type</legend>
                    <InputRadioGroup TValue="IntakeSubjectScope?" id="public-subject" class="public-report__subject-options" @bind-Value="_draft.SubjectScope">
                        <label class="public-report__subject-card">
                            <InputRadio TValue="IntakeSubjectScope?" Value="@((IntakeSubjectScope?)IntakeSubjectScope.Human)" />
                            <MudIcon Icon="@Icons.Material.Filled.Person" aria-hidden="true" />
                            <span class="public-report__subject-copy">
                                <span class="public-report__subject-title">A person</span>
                                <span class="public-report__subject-description">One person or a group of people</span>
                            </span>
                        </label>
                        <label class="public-report__subject-card">
                            <InputRadio TValue="IntakeSubjectScope?" Value="@((IntakeSubjectScope?)IntakeSubjectScope.Individual)" />
                            <MudIcon Icon="@Icons.Material.Filled.Pets" aria-hidden="true" />
                            <span class="public-report__subject-copy">
                                <span class="public-report__subject-title">An individual animal</span>
                                <span class="public-report__subject-description">A concern about one animal</span>
                            </span>
                        </label>
                        <label class="public-report__subject-card">
                            <InputRadio TValue="IntakeSubjectScope?" Value="@((IntakeSubjectScope?)IntakeSubjectScope.Herd)" />
                            <MudIcon Icon="@Icons.Material.Filled.Groups" aria-hidden="true" />
                            <span class="public-report__subject-copy">
                                <span class="public-report__subject-title">A herd of animals</span>
                                <span class="public-report__subject-description">A group of larger animals</span>
                            </span>
                        </label>
                        <label class="public-report__subject-card">
                            <InputRadio TValue="IntakeSubjectScope?" Value="@((IntakeSubjectScope?)IntakeSubjectScope.Flock)" />
                            <MudIcon Icon="@Icons.Material.Filled.Pets" aria-hidden="true" />
                            <span class="public-report__subject-copy">
                                <span class="public-report__subject-title">A flock of animals</span>
                                <span class="public-report__subject-description">A group of birds or similar animals</span>
                            </span>
                        </label>
                        <label class="public-report__subject-card">
                            <InputRadio TValue="IntakeSubjectScope?" Value="@((IntakeSubjectScope?)IntakeSubjectScope.OtherGroup)" />
                            <MudIcon Icon="@Icons.Material.Filled.MoreHoriz" aria-hidden="true" />
                            <span class="public-report__subject-copy">
                                <span class="public-report__subject-title">Another animal group</span>
                                <span class="public-report__subject-description">A group not listed above</span>
                            </span>
                        </label>
                    </InputRadioGroup>
                </fieldset>
                <div id="public-subject-error" class="public-report__error"><ValidationMessage For="@(() => _draft.SubjectScope)" /></div>

                <label class="public-report__label" for="public-narrative">What happened?</label>
                <InputTextArea id="public-narrative" class="public-report__control public-report__narrative" rows="5"
                               maxlength="6000" aria-describedby="public-narrative-help public-narrative-error"
                               @bind-Value="_draft.Narrative" />
                <span id="public-narrative-help" class="public-report__hint">Describe what you saw in your own words. Do not include names, phone numbers, or diagnoses.</span>
                <div id="public-narrative-error" class="public-report__error"><ValidationMessage For="@(() => _draft.Narrative)" /></div>

                <label class="public-report__label" for="public-observations">Other observations <span>(optional, one per line)</span></label>
                <InputTextArea id="public-observations" class="public-report__control" rows="5" maxlength="20000"
                               aria-describedby="public-observations-help" @bind-Value="_draft.ObservationsText" />
                <span id="public-observations-help" class="public-report__hint">Keep separate details on separate lines. Unknown details can be left blank.</span>
            </section>

            <section class="public-report__section" aria-labelledby="public-report-time">
                <div>
                    <MudText id="public-report-time" Typo="Typo.h6" HtmlTag="h3">When and where did it happen?</MudText>
                    <MudText Typo="Typo.body2" Class="public-report__hint">This is the event location and time, not where or when the report is sent.</MudText>
                </div>

                <div class="public-report__capture-time">
                    <span class="public-report__label">Report started</span>
                    @if (_draft.CapturedAt is { } capturedAt)
                    {
                        <time datetime="@capturedAt.ToString("O")">@capturedAt.ToLocalTime().ToString("g")</time>
                    }
                    else
                    {
                        <span>Unknown</span>
                    }
                    <span class="public-report__hint">Shown from this device clock. It is not the time the event happened.</span>
                </div>

                <div class="public-report__grid">
                    <div>
                        <label class="public-report__label" for="public-time-precision">Time known?</label>
                        <InputSelect TValue="ReportedTimePrecision" id="public-time-precision" class="public-report__control" @bind-Value="_draft.OccurrencePrecision">
                            <option value="@ReportedTimePrecision.Unknown">I do not know</option>
                            <option value="@ReportedTimePrecision.DateOnly">Date only</option>
                            <option value="@ReportedTimePrecision.Approximate">Approximate date or time</option>
                            <option value="@ReportedTimePrecision.Exact">Exact date and time</option>
                        </InputSelect>
                    </div>
                    @if (_draft.OccurrencePrecision != ReportedTimePrecision.Unknown)
                    {
                        <div>
                            <label class="public-report__label" for="public-occurrence-date">Reported date</label>
                            <InputDate TValue="DateTime?" id="public-occurrence-date" class="public-report__control" @bind-Value="_draft.OccurrenceDate" />
                        </div>
                    }
                </div>
                @if (_draft.OccurrencePrecision is ReportedTimePrecision.Approximate or ReportedTimePrecision.Exact)
                {
                    <span class="public-report__hint">Enter only details you know. Do not guess the timezone.</span>
                    @if (_draft.OccurrencePrecision == ReportedTimePrecision.Exact)
                    {
                        <label class="public-report__label" for="public-occurrence-time">Reported local time</label>
                        <InputText id="public-occurrence-time" type="time" class="public-report__control" @bind-Value="_draft.OccurrenceTime" />
                        <label class="public-report__label" for="public-occurrence-offset">Time difference from UTC <span>(required for an exact time; for example, +02:00)</span></label>
                        <InputText id="public-occurrence-offset" class="public-report__control" maxlength="9" @bind-Value="_draft.OccurrenceOffset" />
                    }
                    <label class="public-report__label" for="public-time-note">Time zone, if known <span>(optional)</span></label>
                    <InputText id="public-time-note" class="public-report__control" maxlength="160" @bind-Value="_draft.TimeNote" />
                }

                <div class="public-report__grid">
                    <div>
                        <label class="public-report__label" for="public-onset-precision">When did symptoms or signs start?</label>
                        <InputSelect TValue="ReportedTimePrecision" id="public-onset-precision" class="public-report__control" @bind-Value="_draft.OnsetPrecision">
                            <option value="@ReportedTimePrecision.Unknown">I do not know</option>
                            <option value="@ReportedTimePrecision.DateOnly">Date only</option>
                            <option value="@ReportedTimePrecision.Approximate">Approximate date</option>
                            <option value="@ReportedTimePrecision.Exact">Exact date and time</option>
                        </InputSelect>
                    </div>
                    @if (_draft.OnsetPrecision != ReportedTimePrecision.Unknown)
                    {
                        <div>
                            <label class="public-report__label" for="public-onset-date">Reported onset date</label>
                            <InputDate TValue="DateTime?" id="public-onset-date" class="public-report__control" @bind-Value="_draft.OnsetDate" />
                        </div>
                    }
                </div>
                @if (_draft.OnsetPrecision == ReportedTimePrecision.Exact)
                {
                    <span class="public-report__hint">Enter only onset details you know. Do not guess the time difference from UTC.</span>
                    <label class="public-report__label" for="public-onset-time">Reported local onset time</label>
                    <InputText id="public-onset-time" type="time" class="public-report__control" @bind-Value="_draft.OnsetTime" />
                    <label class="public-report__label" for="public-onset-offset">Onset time difference from UTC <span>(required for an exact time; for example, +02:00)</span></label>
                    <InputText id="public-onset-offset" class="public-report__control" maxlength="9" @bind-Value="_draft.OnsetOffset" />
                }

                <label class="public-report__unknown">
                    <InputCheckbox @bind-Value="_draft.LocationUnknown" @bind-Value:after="HandleLocationUnknownChanged" />
                    <span>The event location is unknown</span>
                </label>
                @if (!_draft.LocationUnknown)
                {
                    <div>
                        <label class="public-report__label" for="public-country">Country where the event happened</label>
                        @if (HasCountryCatalogue)
                        {
                            <InputSelect id="public-country" class="public-report__control" @bind-Value="_draft.CountryCode" @bind-Value:after="ResetCountryConfirmation">
                                <option value="">Choose a country</option>
                                @foreach (var country in Countries)
                                {
                                    <option value="@country.Code">@country.Name</option>
                                }
                            </InputSelect>
                            <span class="public-report__hint">Choose the closest country or area. Some places may not appear on SwiftAid’s list.</span>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                Country selection is temporarily unavailable. You can continue with the location marked unknown.
                            </MudAlert>
                        }
                    </div>
                    <div class="public-report__grid">
                        <PublicReportPlaceField Label="Region" Presence="@_draft.RegionPresence" PresenceChanged="@(value => _draft.RegionPresence = value)"
                                                Value="@_draft.Region" ValueChanged="@(value => _draft.Region = value)" />
                        <PublicReportPlaceField Label="Area" Presence="@_draft.AreaPresence" PresenceChanged="@(value => _draft.AreaPresence = value)"
                                                Value="@_draft.Area" ValueChanged="@(value => _draft.Area = value)" />
                        <PublicReportPlaceField Label="Town, village, or locality" Presence="@_draft.LocalityPresence" PresenceChanged="@(value => _draft.LocalityPresence = value)"
                                                Value="@_draft.Locality" ValueChanged="@(value => _draft.Locality = value)" />
                    </div>
                }
            </section>

            <section class="public-report__section" aria-labelledby="public-report-evidence">
                <div>
                    <MudText id="public-report-evidence" Typo="Typo.h6" HtmlTag="h3">Optional recording</MudText>
                    <MudText Typo="Typo.body2" Class="public-report__hint">An original recording may help explain what happened. It is not required.</MudText>
                </div>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    You cannot add a recording here yet. Do not send private recordings another way.
                </MudAlert>
            </section>

            <section class="public-report__section" aria-labelledby="public-report-fact-review">
                <div>
                    <MudText id="public-report-fact-review" Typo="Typo.h6" HtmlTag="h3">Review the facts you reported</MudText>
                    <MudText Typo="Typo.body2" Class="public-report__hint">
                        These details come from what you entered. Nothing has been added or diagnosed for you. Correct a detail above, or leave it unknown.
                    </MudText>
                </div>

                <dl class="public-report__fact-summary">
                    <div>
                        <dt>Subject</dt>
                        <dd>@SubjectSummary</dd>
                        <dd class="public-report__fact-source">You selected this</dd>
                    </div>
                    <div>
                        <dt>Original statement</dt>
                        <dd>@UnknownIfEmpty(_draft.Narrative)</dd>
                        <dd class="public-report__fact-source">Your words, shown as entered</dd>
                    </div>
                    <div>
                        <dt>Separate observations</dt>
                        <dd>@ObservationSummary</dd>
                        <dd class="public-report__fact-source">You entered these details. No others were added.</dd>
                    </div>
                    <div>
                        <dt>Reported time</dt>
                        <dd>@TimeSummary</dd>
                        <dd class="public-report__fact-source">@TimeProvenance</dd>
                    </div>
                    <div>
                        <dt>Reported symptom or sign onset</dt>
                        <dd>@OnsetSummary</dd>
                        <dd class="public-report__fact-source">@(_draft.OnsetPrecision == ReportedTimePrecision.Unknown ? "Not provided; remains unknown" : "From the onset details you entered")</dd>
                    </div>
                    <div>
                        <dt>Reported place</dt>
                        <dd>@LocationSummary</dd>
                        <dd class="public-report__fact-source">@LocationProvenance</dd>
                    </div>
                    <div>
                        <dt>Species or group detail</dt>
                        <dd>Unknown</dd>
                        <dd class="public-report__fact-source">This form does not collect a species or subgroup field.</dd>
                    </div>
                    <div>
                        <dt>Affected, deceased, and at-risk counts</dt>
                        <dd>Unknown</dd>
                        <dd class="public-report__fact-source">No counts have been entered or inferred.</dd>
                    </div>
                </dl>
                <MudText Typo="Typo.caption" Class="public-report__hint">
                    Your review confirms only that you checked these details. It does not verify them or provide a diagnosis.
                </MudText>
            </section>

            <section class="public-report__section" aria-labelledby="public-report-confirmations">
                <div>
                    <MudText id="public-report-confirmations" Typo="Typo.h6" HtmlTag="h3">Before sending</MudText>
                    <MudText Typo="Typo.body2" Class="public-report__hint">Your report stays private. If received, its receipt shows whether it is being reviewed and whether local service coverage is available.</MudText>
                </div>

                <label class="public-report__unknown">
                    <InputCheckbox @bind-Value="_draft.ReportReviewConfirmed" />
                    <span>I reviewed the original statement and the known or unknown details above.</span>
                </label>
                <MudText Typo="Typo.body2" Class="public-report__hint">Reports are not checked when first received. A receipt does not mean someone has been assigned or that help is on the way.</MudText>
                <div class="public-report__confirmation @(CanConfirmCountry ? string.Empty : "public-report__confirmation--unavailable")">
                    <InputCheckbox id="public-country-confirm" @bind-Value="_draft.CountryConfirmed"
                                   disabled="@(!CanConfirmCountry || string.IsNullOrWhiteSpace(_draft.CountryCode))"
                                   aria-describedby="public-country-confirm-help" />
                    <label for="public-country-confirm">I confirm the event country shown above.</label>
                    <span id="public-country-confirm-help" class="public-report__hint">
                        @(CanConfirmCountry ? "Choose a country before confirming it." : "The country list is unavailable. You can still save your draft.")
                    </span>
                </div>
                @if (HasPrivacyNotice)
                {
                    <MudLink Href="@PrivacyNoticeReference" Target="_blank" rel="noopener noreferrer">
                        Read SwiftAid’s privacy notice
                    </MudLink>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="public-report__hint">SwiftAid’s privacy notice is temporarily unavailable. You can still save a draft.</MudText>
                }
                <div class="public-report__confirmation">
                    <InputCheckbox id="public-policy-confirm" @bind-Value="_draft.ProcessingConfirmed"
                                   disabled="@(!HasPrivacyNotice)"
                                   aria-describedby="public-policy-confirm-help" />
                    <label for="public-policy-confirm">I have read how SwiftAid uses the details I share.</label>
                    <span id="public-policy-confirm-help" class="public-report__hint">
                        @(HasPrivacyNotice ? "Read the privacy notice before confirming." : "You can confirm after the current privacy notice is available.")
                    </span>
                </div>
                @if (AttachmentSelectionCount > 0)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        Remove the selected files before saving or sending. They are not part of this report and cannot be sent here.
                    </MudAlert>
                }
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                    You can send your report after choosing and confirming a country, completing the checks above, and when a local service is available.
                </MudAlert>
            </section>
        </div>

        <div class="public-report__actions">
            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Text" Color="Color.Primary"
                       OnClick="ReviewEntries" StartIcon="@Icons.Material.Filled.FactCheck">
                Review entries
            </MudButton>
            @if (CanSaveDraft)
            {
                <MudButton ButtonType="ButtonType.Button" Variant="Variant.Text" Color="Color.Primary"
                           OnClick="SaveDraftAsync" StartIcon="@Icons.Material.Filled.Save">
                    @DraftSaveButtonLabel
                </MudButton>
            }
            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Text" Color="Color.Primary" Disabled="@(!CanSubmit || _sending)"
                       aria-describedby="public-submit-unavailable" StartIcon="@Icons.Material.Filled.Send" OnClick="SendReportAsync">
                @(_sending ? SubmitProgressLabel : SubmitButtonLabel)
            </MudButton>
        </div>
        @if (AttachmentSelectionCount == 0 && !CanSubmit && !CanSaveDraft)
        {
        <MudText id="public-submit-unavailable" Typo="Typo.body2" Class="public-report__hint">
            <span>This form cannot save or send reports right now. Your entries have not been saved or sent.</span>
        </MudText>
        }
        @if (_draftSaved || _saveError is not null || _sendError is not null)
        {
            <div role="status" aria-live="polite" class="public-report__feedback">
                @if (_draftSaved)
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                        @DraftSavedMessage
                    </MudAlert>
                }
                else if (_sendError is not null)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        @_sendError
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        @_saveError
                    </MudAlert>
                }
            </div>
        }
        @if (_reviewAttempted)
        {
            <div role="status" aria-live="polite" class="public-report__feedback">
                <MudAlert Severity="@(_reviewPassed ? Severity.Info : Severity.Warning)" Variant="Variant.Outlined" Dense="true">
                    @(_reviewPassed
                        ? "Required fields are filled. This does not verify the facts. Your entries have not been saved or sent."
                        : "Please review the highlighted entries.")
                </MudAlert>
            </div>
        }
    </EditForm>
</section>

@code {
    private PublicReportDraft _draft = new() { CapturedAt = DateTimeOffset.Now };
    private EditContext _editContext = default!;
    private IntakeSubmission? _loadedSubmission;
    private bool _parametersInitialized;
    private bool _reviewAttempted;
    private bool _reviewPassed;
    private bool _draftSaved;
    private string? _saveError;
    private bool _sending;
    private string? _sendError;

    [Parameter] public IReadOnlyList<PublicCountryOption> Countries { get; set; } = [];
    [Parameter] public PublicReportDraft? Draft { get; set; }
    [Parameter] public string? CountryCatalogueVersion { get; set; }
    [Parameter] public bool CountryCatalogueIsCurrent { get; set; }
    [Parameter] public string? PrivacyNoticeReference { get; set; }
    [Parameter] public string? ProcessingPolicyReference { get; set; }
    [Parameter] public string? ProcessingPolicyVersion { get; set; }
    [Parameter] public bool DraftSavingAvailable { get; set; }
    [Parameter] public Guid? CurrentDraftId { get; set; }
    [Parameter] public IntakeSubmission? InitialSubmission { get; set; }
    [Parameter] public EventCallback<PublicReportSaveRequest> OnSaveDraft { get; set; }
    [Parameter] public bool SubmitAvailable { get; set; }
    [Parameter] public EventCallback<IntakeSubmission> OnSendReport { get; set; }
    [Parameter] public string SubmitButtonLabel { get; set; } = "Send report";
    [Parameter] public string SubmitProgressLabel { get; set; } = "Sending report…";
    [Parameter] public string DraftSaveButtonLabel { get; set; } = "Save draft on this device";
    [Parameter] public string DraftSavedMessage { get; set; } = "Your report draft is saved on this device. It has not been sent.";
    [Parameter] public int AttachmentSelectionCount { get; set; }

    private bool HasCountryCatalogue => Countries.Count > 0 && !string.IsNullOrWhiteSpace(CountryCatalogueVersion);
    private bool CanConfirmCountry => HasCountryCatalogue && CountryCatalogueIsCurrent;
    private bool HasPrivacyNotice => !string.IsNullOrWhiteSpace(PrivacyNoticeReference) &&
                                     !string.IsNullOrWhiteSpace(ProcessingPolicyVersion);

    protected override void OnParametersSet()
    {
        if (Draft is not null)
        {
            if (_parametersInitialized && ReferenceEquals(_draft, Draft))
                return;

            _parametersInitialized = true;
            _loadedSubmission = InitialSubmission;
            _draft = Draft;

            if (_editContext is not null)
                _editContext.OnFieldChanged -= HandleFieldChanged;

            _editContext = new EditContext(_draft);
            _editContext.OnFieldChanged += HandleFieldChanged;
            _draftSaved = false;
            _saveError = null;
            _reviewAttempted = false;
            _reviewPassed = false;
            return;
        }

        if (_parametersInitialized && ReferenceEquals(_loadedSubmission, InitialSubmission))
            return;

        _parametersInitialized = true;

        if (_editContext is not null)
            _editContext.OnFieldChanged -= HandleFieldChanged;

        _loadedSubmission = InitialSubmission;
        _draft = InitialSubmission is null
            ? new PublicReportDraft { CapturedAt = DateTimeOffset.Now }
            : PublicReportDraft.FromSubmission(InitialSubmission);
        _editContext = new EditContext(_draft);
        _editContext.OnFieldChanged += HandleFieldChanged;
        _draftSaved = InitialSubmission is not null;
        _saveError = null;
        _reviewAttempted = false;
        _reviewPassed = false;
    }

    private bool HasPendingAttachments => AttachmentSelectionCount > 0;
    private bool CanSaveDraft => DraftSavingAvailable && OnSaveDraft.HasDelegate && !HasPendingAttachments;
    private bool CanSubmit => SubmitAvailable && OnSendReport.HasDelegate && !HasPendingAttachments;

    private string SubjectSummary => _draft.SubjectScope switch
    {
        IntakeSubjectScope.Human => "Person or people",
        IntakeSubjectScope.Individual => "Individual animal",
        IntakeSubjectScope.Herd => "Herd",
        IntakeSubjectScope.Flock => "Flock",
        IntakeSubjectScope.OtherGroup => "Other animal group",
        _ => "Unknown"
    };

    private string ObservationSummary
    {
        get
        {
            var values = _draft.GetObservations();
            return values.Count == 0 ? "Unknown" : string.Join("; ", values);
        }
    }

    private string TimeSummary => _draft.OccurrencePrecision switch
    {
        ReportedTimePrecision.Unknown => "Unknown",
        ReportedTimePrecision.Exact => $"{_draft.OccurrenceDate?.ToString("d") ?? "Unknown date"} {_draft.OccurrenceTime ?? "Unknown time"} {_draft.OccurrenceOffset ?? "Unknown offset"}",
        ReportedTimePrecision.DateOnly => _draft.OccurrenceDate?.ToString("d") ?? "Date unknown",
        _ => _draft.OccurrenceDate is { } date ? $"Approximately {date:d}" : "Approximately; date unknown"
    };

    private string TimeProvenance => _draft.OccurrencePrecision == ReportedTimePrecision.Unknown
        ? "Not provided; remains unknown"
        : "From the time you entered, not when you sent the report";

    private string OnsetSummary => _draft.OnsetPrecision switch
    {
        ReportedTimePrecision.Unknown => "Unknown",
        ReportedTimePrecision.Exact => $"{_draft.OnsetDate?.ToString("d") ?? "Unknown date"} {_draft.OnsetTime ?? "Unknown time"} {_draft.OnsetOffset ?? "Unknown offset"}",
        ReportedTimePrecision.DateOnly => _draft.OnsetDate?.ToString("d") ?? "Date unknown",
        _ => _draft.OnsetDate is { } date ? $"Approximately {date:d}" : "Approximately; date unknown"
    };

    private string LocationSummary
    {
        get
        {
            var countryName = Countries.FirstOrDefault(country => string.Equals(
                country.Code,
                _draft.CountryCode,
                StringComparison.OrdinalIgnoreCase))?.Name;
            var places = new[] { _draft.Locality, _draft.Area, _draft.Region, countryName }
                .Where(value => !string.IsNullOrWhiteSpace(value));
            return string.Join(", ", places) is { Length: > 0 } location ? location : "Unknown";
        }
    }

    private string LocationProvenance => LocationSummary == "Unknown"
        ? "Not provided; remains unknown"
        : "From the place names and country you entered";

    private static string UnknownIfEmpty(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Unknown" : value.Trim();

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs args)
    {
        _reviewAttempted = false;
        _reviewPassed = false;
        _draftSaved = false;
        _saveError = null;
        _sendError = null;
    }

    private void HandleLocationUnknownChanged()
    {
        if (!_draft.LocationUnknown)
            return;

        _draft.CountryCode = null;
        _draft.CountryConfirmed = false;
        _draft.RegionPresence = PresenceState.Unknown;
        _draft.Region = null;
        _draft.AreaPresence = PresenceState.Unknown;
        _draft.Area = null;
        _draft.LocalityPresence = PresenceState.Unknown;
        _draft.Locality = null;
    }

    private void ResetCountryConfirmation() => _draft.CountryConfirmed = false;

    private void ReviewEntries()
    {
        _reviewAttempted = true;
        _reviewPassed = _editContext.Validate();
    }

    private Task HandleFormSubmit(EditContext _)
    {
        ReviewEntries();
        return Task.CompletedTask;
    }

    private async Task SaveDraftAsync()
    {
        if (!CanSaveDraft)
        {
            return;
        }

        try
        {
            var submission = _draft.ToSubmission(
                CountryCatalogueVersion,
                ProcessingPolicyReference,
                ProcessingPolicyVersion,
                Countries,
                CountryCatalogueIsCurrent);
            await OnSaveDraft.InvokeAsync(new PublicReportSaveRequest(CurrentDraftId, submission));
            _draftSaved = true;
            _saveError = null;
        }
        catch (InvalidOperationException exception)
        {
            _draftSaved = false;
            _saveError = exception.Message;
        }
        catch
        {
            _draftSaved = false;
            _saveError = "Your report draft could not be saved. Your entries remain on this screen only.";
        }
    }

    private async Task SendReportAsync()
    {
        if (!CanSubmit || _sending)
        {
            return;
        }

        _sending = true;
        try
        {
            _reviewAttempted = true;
            _reviewPassed = _editContext.Validate();
            if (!_reviewPassed)
            {
                return;
            }

            var submission = _draft.ToSubmission(
                CountryCatalogueVersion,
                ProcessingPolicyReference,
                ProcessingPolicyVersion,
                Countries,
                CountryCatalogueIsCurrent);
            await OnSendReport.InvokeAsync(submission);
            _sendError = null;
        }
        catch (InvalidOperationException exception)
        {
            _sendError = exception.Message;
        }
        catch
        {
            _sendError = "Your report could not be sent. Your entries remain on this screen.";
        }
        finally
        {
            _sending = false;
        }
    }

    public void Dispose() => _editContext.OnFieldChanged -= HandleFieldChanged;

}
