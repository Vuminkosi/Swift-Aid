    private string LocationSummary
    {
        get
        {
            if (Draft.LocationUnknown &&
                string.IsNullOrWhiteSpace(Draft.CountryCode) &&
                Draft.RegionPresence != PresenceState.Known &&
                Draft.AreaPresence != PresenceState.Known &&
                Draft.LocalityPresence != PresenceState.Known)
            {
                return "Unknown";
            }

            var place = string.Join(", ", new[]
            {
                Draft.LocalityPresence == PresenceState.Known ? Draft.Locality : null,
                Draft.AreaPresence == PresenceState.Known ? Draft.Area : null,
                Draft.RegionPresence == PresenceState.Known ? Draft.Region : null
            }
                .Where(value => !string.IsNullOrWhiteSpace(value)));
            return string.IsNullOrWhiteSpace(place) ? "Unknown" : place;
        }
    }

