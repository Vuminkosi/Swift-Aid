    private void ClearStepValidation()
    {
        _followValidation = false;
        _validationField = null;
        _validationMessage = null;
        PublishValidation();
        _messageStore.Clear();
        _stepError = null;
        _editContext.NotifyValidationStateChanged();
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs args)
    {
        _dismissedServerValidationRevision = ServerValidationRevision;
        _messageStore.Clear(args.FieldIdentifier);
        _stepError = null;
        _observationChoiceMessage = null;
        _submitError = null;
        _saveState = DraftSaveState.Unsaved;
        // Acknowledging the country or processing terms does not change report evidence.
        // Preserve review in any checkbox order; actual report edits still invalidate it.
        if (args.FieldIdentifier.FieldName is not (nameof(PublicReportDraft.ReportReviewConfirmed)
            or nameof(PublicReportDraft.CountryConfirmed) or nameof(PublicReportDraft.ProcessingConfirmed)))
        {
            Draft.ReportReviewConfirmed = false;
            _messageStore.Clear(new FieldIdentifier(Draft, nameof(PublicReportDraft.ReportReviewConfirmed)));
        }

        if (_step == 1 && _detailsValidationAttempted)
        {
            _messageStore.Clear();
            ValidateDetails();
        }
        else
        {
            _editContext.NotifyValidationStateChanged();
        }
    }

    private bool IsObservationSelected(string observation) =>
        (Draft.ObservationsText ?? string.Empty)
            .Split(["\r\n", "\r", "\n"], StringSplitOptions.None)
            .Any(line => string.Equals(line, observation, StringComparison.Ordinal));

    private Task ToggleObservationAsync(string observation)
    {
        var currentText = Draft.ObservationsText ?? string.Empty;
        var isSelected = IsObservationSelected(observation);

        if (isSelected)
        {
            Draft.ObservationsText = RemoveExactObservationLines(currentText, observation);
        }
        else
        {
            var existingObservations = Draft.GetObservations();
            var separator = currentText.Length == 0 || currentText.EndsWith('\n') || currentText.EndsWith('\r')
                ? string.Empty
                : Environment.NewLine;
            var updatedText = string.Concat(currentText, separator, observation);

            if (existingObservations.Count >= MaximumObservations || updatedText.Length > 20000)
            {
                _observationChoiceMessage = existingObservations.Count >= MaximumObservations
                    ? $"You can add up to {MaximumObservations} separate observations. Remove one before adding another."
                    : "There is not enough space for another observation. Shorten or remove one first.";
                return Task.CompletedTask;
            }

            Draft.ObservationsText = updatedText;
        }

        _observationChoiceMessage = null;
        _editContext.NotifyFieldChanged(new FieldIdentifier(Draft, nameof(Draft.ObservationsText)));
        return Task.CompletedTask;
    }

    private static string RemoveExactObservationLines(string text, string observation)
    {
        var removalRanges = new List<(int Start, int End)>();
        var lineStart = 0;

        for (var index = 0; index < text.Length; index++)
        {
            if (text[index] is not ('\r' or '\n'))
            {
                continue;
            }

            var delimiterLength = text[index] == '\r' &&
                index + 1 < text.Length &&
                text[index + 1] == '\n'
                ? 2
                : 1;
            var line = text.Substring(lineStart, index - lineStart);
            if (string.Equals(line, observation, StringComparison.Ordinal))
            {
                AddRemovalRange(lineStart, index + delimiterLength);
            }

            lineStart = index + delimiterLength;
            index += delimiterLength - 1;
        }

        var finalLine = text.Substring(lineStart);
        if (string.Equals(finalLine, observation, StringComparison.Ordinal))
        {
            AddRemovalRange(lineStart, text.Length);
        }

        for (var index = removalRanges.Count - 1; index >= 0; index--)
        {
            var range = removalRanges[index];
            text = text.Remove(range.Start, range.End - range.Start);
        }

        return text;

        void AddRemovalRange(int start, int end)
        {
            if (removalRanges.Count > 0 && removalRanges[^1].End >= start)
            {
                var previous = removalRanges[^1];
                removalRanges[^1] = (previous.Start, Math.Max(previous.End, end));
                return;
            }

            removalRanges.Add((start, end));
        }
    }

    private async Task FocusObservationInputAsync()
    {
        _observationChoiceMessage = null;
        if (_observationsField is not null)
        {
