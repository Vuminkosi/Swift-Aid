    private GeoPlaceOption? CurrentPlaceSelection
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Draft.CountryCode))
            {
                return null;
            }

            var hasPlace = Draft.RegionPresence == PresenceState.Known ||
                Draft.AreaPresence == PresenceState.Known ||
                Draft.LocalityPresence == PresenceState.Known;
            if (!hasPlace)
            {
                return null;
            }

            var name = Draft.LocalityPresence == PresenceState.Known && !string.IsNullOrWhiteSpace(Draft.Locality)
                ? Draft.Locality.Trim()
                : Draft.AreaPresence == PresenceState.Known && !string.IsNullOrWhiteSpace(Draft.Area)
                    ? Draft.Area.Trim()
                    : Draft.Region;
            if (string.IsNullOrWhiteSpace(name))
            {
                return null;
            }

            return new GeoPlaceOption(
                Draft.LocalityId ?? Draft.AreaId ?? Draft.RegionId ?? string.Empty,
                name.Trim(),
                Draft.LocalityPresence == PresenceState.Known ? "Settlement" : "Region",
                Draft.CountryCode,
                CountrySummary,
                LocationSummary,
                false,
                []);
        }
    }

