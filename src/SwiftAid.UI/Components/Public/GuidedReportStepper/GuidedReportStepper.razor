    private void GoBack()
    {
        if (_step > 0)
        {
            _step--;
            _stepError = null;
            _focusStepHeadingAfterRender = true;
            if (_step == 1 && ServerValidationRevision > 0 &&
                ServerValidationRevision != _dismissedServerValidationRevision)
            {
                // A server rejection may not identify its field. Re-run the trusted
                // client checks so Ellai can guide the reporter through known issues
                // in order instead of leaving the generic rejection on the review page.
                ValidateDetails();
            }
        }
    }

    private async Task SaveDraftAsync()
    {
        if (!CanSaveDraft || _saving)
        {
            return;
        }

        _saving = true;
        _saveValidationAttempted = false;
        _savingDraftId = CurrentDraftId;
        _pendingDraftRefresh = null;
        _confirmedDraftSave = null;
        _saveState = DraftSaveState.Saving;
        var sourceDraft = Draft;
        _savingSourceDraft = sourceDraft;
        var sourceSnapshot = Draft.Copy();
        _savingSourceSnapshot = sourceSnapshot;
        var savedStep = _step;
        try
        {
            IntakeSubmission submission;
            GuestDraftFormSnapshot? formSnapshot = null;
            try
            {
                submission = Draft.ToSubmission(
                    CountryCatalogueVersion,
                    ProcessingPolicyReference,
                    ProcessingPolicyVersion,
                    Countries,
                    CountryCatalogueIsCurrent,
                    allowUnverifiedCountryForDraft: true);
            }
            catch (InvalidOperationException)
            {
                _saveValidationAttempted = true;
                _showManualPlaces |= !PublicReportDraft.IsValidPlaceName(Draft.RegionPresence, Draft.Region) ||
                    !PublicReportDraft.IsValidPlaceName(Draft.AreaPresence, Draft.Area) ||
                    !PublicReportDraft.IsValidPlaceName(Draft.LocalityPresence, Draft.Locality);
                if (_step != 1)
                {
                    _step = 1;
                    _focusStepHeadingAfterRender = true;
                }
                if (!EditableDraftSnapshotsSupported)
                {
                    _saveState = DraftSaveState.Invalid;
                    return;
                }
                formSnapshot = Draft.ToFormSnapshot();
                // The protected snapshot is authoritative for editing. This empty,
                // unconfirmed carrier cannot be queued or mistaken for the entered values.
                var carrier = new PublicReportDraft { SubjectScope = Draft.SubjectScope };
                submission = carrier.ToSubmission(null, null, null, [], false);
            }
            if (formSnapshot is null && EditableDraftSnapshotsSupported &&
                !sourceSnapshot.IsLosslesslyRepresentedBy(submission))
                formSnapshot = sourceSnapshot.ToFormSnapshot();
            _savingSnapshot = formSnapshot is null ? PublicReportDraft.FromSubmission(submission) : sourceSnapshot.Copy();
            _activeSaveRequest = new PublicReportSaveRequest(CurrentDraftId, submission, formSnapshot);
            await OnSaveDraft.InvokeAsync(_activeSaveRequest);
            var savedId = _activeSaveRequest.PersistedDraftId ?? _savingDraftId;
            var sameReport = ReferenceEquals(Draft, sourceDraft) && (CurrentDraftId == _savingDraftId || CurrentDraftId == savedId)
                || IsSaveRefreshIdentity(savedId, CurrentDraftId) && DraftMatches(Draft, _savingSnapshot);
            var unchanged = ReferenceEquals(Draft, sourceDraft)
                ? DraftMatches(Draft, sourceSnapshot) : DraftMatches(Draft, _savingSnapshot);
            if (sameReport && _activeSaveRequest.PersistedDraftId is not null)
                _pendingDraftRefresh = new PendingDraftRefresh(savedId, _savingSnapshot, sourceSnapshot, sourceDraft, savedStep);
            if (sameReport && unchanged && _activeSaveRequest.PersistedDraftId is not null)
            {
                _saveState = DraftSaveState.Saved;
                _confirmedDraftSave = _pendingDraftRefresh;
            }
            else
            {
                _saveState = sameReport && unchanged ? DraftSaveState.Unconfirmed : DraftSaveState.Unsaved;
            }
        }
        catch
        {
            _saveState = ReferenceEquals(Draft, sourceDraft) ? DraftSaveState.Failed : DraftSaveState.Unsaved;
        }
        finally
        {
            _saving = false;
            _savingDraftId = null;
            _activeSaveRequest = null;
            _savingSnapshot = null;
            _savingSourceSnapshot = null;
            _savingSourceDraft = null;
        }
    }

    private static bool IsSaveRefreshIdentity(Guid? sourceDraftId, Guid? updatedDraftId) =>
        sourceDraftId == updatedDraftId;

    private static bool DraftMatches(PublicReportDraft actual, PublicReportDraft expected) =>
        actual.SubjectScope == expected.SubjectScope &&
        actual.AgeYearsText == expected.AgeYearsText &&
        actual.Gender == expected.Gender &&
        actual.Narrative == expected.Narrative &&
        actual.ObservationsText == expected.ObservationsText &&
        actual.OccurrencePrecision == expected.OccurrencePrecision &&
        actual.OccurrenceDate == expected.OccurrenceDate &&
        actual.OccurrenceDateText == expected.OccurrenceDateText &&
        actual.OccurrenceTime == expected.OccurrenceTime &&
        actual.OccurrenceOffset == expected.OccurrenceOffset &&
        actual.TimeNote == expected.TimeNote &&
        actual.OnsetPrecision == expected.OnsetPrecision &&
        actual.OnsetDate == expected.OnsetDate &&
        actual.OnsetDateText == expected.OnsetDateText &&
        actual.OnsetTime == expected.OnsetTime &&
        actual.OnsetOffset == expected.OnsetOffset &&
        actual.OnsetZoneId == expected.OnsetZoneId &&
        actual.OnsetDateInterpretedFromCaptureContext == expected.OnsetDateInterpretedFromCaptureContext &&
        actual.CapturedAt == expected.CapturedAt &&
        actual.LocationUnknown == expected.LocationUnknown &&
        actual.CountryCode == expected.CountryCode &&
        actual.CountryConfirmed == expected.CountryConfirmed &&
        actual.RegionPresence == expected.RegionPresence &&
        actual.Region == expected.Region &&
        actual.RegionId == expected.RegionId &&
        actual.AreaPresence == expected.AreaPresence &&
        actual.Area == expected.Area &&
        actual.AreaId == expected.AreaId &&
        actual.LocalityPresence == expected.LocalityPresence &&
        actual.Locality == expected.Locality &&
        actual.LocalityId == expected.LocalityId &&
        actual.ReportReviewConfirmed == expected.ReportReviewConfirmed &&
        actual.ProcessingConfirmed == expected.ProcessingConfirmed;

    private async Task HandleSubmitAsync(EditContext _)
    {
        if (_step == 0)
        {
            await ContinueFromTypeAsync();
        }
        else if (_step == 1)
        {
            await ContinueToReviewAsync();
        }
        else
        {
            await SubmitAsync();
        }
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit || _submitting)
        {
            return;
        }

        ClearStepValidation();
        if (!_editContext.Validate())
        {
            _stepError = "Review the highlighted information and confirm your report before submitting.";
            return;
        }

        _submitting = true;
        _submitError = null;
        try
        {
            var submission = Draft.ToSubmission(
                CountryCatalogueVersion,
                ProcessingPolicyReference,
                ProcessingPolicyVersion,
                Countries,
                CountryCatalogueIsCurrent);
            // Callback completion is not a submission receipt. The parent surface renders
            // the authoritative queued/failed/received outcome and any server receipt.
            await OnSubmit.InvokeAsync(submission);
        }
        catch
        {
            _submitError = "The submission action could not be completed. Your entries remain on this screen.";
        }
        finally
        {
            _submitting = false;
        }
    }

    public void Dispose()
    {
        EllaiDraftContext?.Remove(this);
        if (_editContext is not null)
        {
            _editContext.OnFieldChanged -= HandleFieldChanged;
        }
    }

    private enum DraftSaveState
    {
        Unsaved,
        Saving,
        Saved,
        Unconfirmed,
        Invalid,
        Failed
    }

    private enum ReportSubjectCategory
    {
        HumanHealth,
        AnimalHealth
    }
}
