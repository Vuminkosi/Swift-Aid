@using SwiftAid.Contracts.Ellai
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using SwiftAid.Contracts.Geography
@using SwiftAid.Contracts.Intake
@inject SwiftAid.UI.Ellai.Guidance.EllaiPublicReportDraftContext? EllaiDraftContext
@using SwiftAid.UI.Components.Geography
@using SwiftAid.UI.Components.Public
@implements IDisposable
@implements SwiftAid.Contracts.Ellai.IEllaiUiContextProvider
@inject IServiceProvider Services

<SwiftAid.UI.Ellai.Guidance.EllaiSemanticContext Provider="this" />

<section class="guided-report" aria-labelledby="guided-report-title">
    <MudText id="guided-report-title" data-ellai-control="report.entry" data-bonboarding-anchor='@EllaiReportUiManifest.AnchorFor("report.entry")' Typo="Typo.h5" HtmlTag="h1">Report a concern</MudText>
    @if (_step == 0)
    {
        <MudText Typo="Typo.body2" Class="guided-report__intro">
            Share what you observed about a person or animal. Unknown details can stay unknown. This form does not provide a diagnosis.
        </MudText>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="guided-report__intro">
            Leave uncertain details blank. SwiftAid does not provide a diagnosis.
        </MudText>
    }

    <ol class="guided-report__progress" aria-label="Report progress">
        @for (var index = 0; index < StepNames.Length; index++)
        {
            var stepIndex = index;
            <li class="@(stepIndex == _step ? "is-current" : stepIndex < _step ? "is-complete" : null)"
                aria-current="@(stepIndex == _step ? "step" : null)">
                <span class="guided-report__step-number" aria-hidden="true">
                    @if (stepIndex < _step)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check"
                                 Class="guided-report__step-complete-icon" />
                    }
                    else
                    {
                        @(stepIndex + 1)
                    }
                </span>
                <span>@StepNames[stepIndex]</span>
                @if (stepIndex < _step)
                {
                    <span class="guided-report__screen-reader-only">Complete</span>
                }
            </li>
        }
    </ol>

    <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />
        <div class="guided-report__validation" tabindex="-1" aria-label="Report validation errors" @ref="_validationSummary">
            <ValidationSummary />
        </div>

        @if (_step == 0)
        {
            <section class="guided-report__panel" aria-labelledby="report-type-title">
                <h2 id="report-type-title" class="mud-typography mud-typography-h6 guided-report__step-heading" tabindex="-1" @ref="_stepHeading">Who or what is the concern about?</h2>
                <div class="guided-report__subject-selector" data-ellai-control="report.subject" data-bonboarding-anchor='@EllaiReportUiManifest.AnchorFor("report.subject")'>
                    <div data-bonboarding-anchor="ellai-report-subject-kind">
                    <MudRadioGroup T="ReportSubjectCategory?" Value="_subjectCategory" ValueChanged="SubjectCategoryChangedAsync" Class="guided-report__subject-group" aria-label="Report subject">
                        <div class="guided-report__choices">
                            <div class="@GetSubjectChoiceClass(ReportSubjectCategory.HumanHealth)">
                                <MudRadio T="ReportSubjectCategory?" Value="@((ReportSubjectCategory?)ReportSubjectCategory.HumanHealth)" Color="Color.Primary" aria-label="Human health — a person or people">
                                    <span class="guided-report__choice-content"><MudIcon Icon="@Icons.Material.Filled.HealthAndSafety" aria-hidden="true" /><span><strong>Human health</strong><small>A person or people</small></span></span>
                                </MudRadio>
                            </div>
                            <div class="@GetSubjectChoiceClass(ReportSubjectCategory.AnimalHealth)">
                                <MudRadio T="ReportSubjectCategory?" Value="@((ReportSubjectCategory?)ReportSubjectCategory.AnimalHealth)" Color="Color.Primary" aria-label="Animal health — an animal or group of animals">
                                    <span class="guided-report__choice-content"><MudIcon Icon="@Icons.Material.Filled.Pets" aria-hidden="true" /><span><strong>Animal health</strong><small>An animal or group of animals</small></span></span>
                                </MudRadio>
                            </div>
                        </div>
                    </MudRadioGroup>
                    </div>
                </div>
                @if (_subjectCategory == ReportSubjectCategory.HumanHealth)
                {
                    <div class="guided-report__animal-scope-group" data-bonboarding-anchor="ellai-report-gender">
                        <MudText Typo="Typo.body2" id="reported-gender-label">Reported gender (optional)</MudText>
                        <MudRadioGroup T="ReportedGender?" Value="Draft.Gender" ValueChanged="ReportedGenderChangedAsync" aria-labelledby="reported-gender-label">
                            <div class="guided-report__animal-scope-options">
                                <MudRadio T="ReportedGender?" Value="@((ReportedGender?)ReportedGender.Female)" Color="Color.Primary">Female</MudRadio>
                                <MudRadio T="ReportedGender?" Value="@((ReportedGender?)ReportedGender.Male)" Color="Color.Primary">Male</MudRadio>
                                <MudRadio T="ReportedGender?" Value="@((ReportedGender?)ReportedGender.Other)" Color="Color.Primary">Other</MudRadio>
                                <MudRadio T="ReportedGender?" Value="@((ReportedGender?)null)" Color="Color.Primary">Unknown / not provided</MudRadio>
                            </div>
                        </MudRadioGroup>
                    </div>
                }
                @if (_subjectCategory == ReportSubjectCategory.AnimalHealth)
                {
                    <div class="guided-report__animal-scope-group" data-bonboarding-anchor="ellai-report-animal-scope">
                        <MudText Typo="Typo.body2" id="animal-scope-label">What is the concern about?</MudText>
                        <MudRadioGroup T="IntakeSubjectScope?" Value="Draft.SubjectScope" ValueChanged="AnimalScopeChangedAsync" aria-labelledby="animal-scope-label">
                            <div class="guided-report__animal-scope-options">
                                <MudRadio T="IntakeSubjectScope?" Value="@((IntakeSubjectScope?)IntakeSubjectScope.Individual)" Color="Color.Primary" aria-label="Individual animal">Individual</MudRadio>
                                <MudRadio T="IntakeSubjectScope?" Value="@((IntakeSubjectScope?)IntakeSubjectScope.Herd)" Color="Color.Primary" aria-label="Herd">Herd</MudRadio>
                                <MudRadio T="IntakeSubjectScope?" Value="@((IntakeSubjectScope?)IntakeSubjectScope.Flock)" Color="Color.Primary" aria-label="Flock">Flock</MudRadio>
                                <MudRadio T="IntakeSubjectScope?" Value="@((IntakeSubjectScope?)IntakeSubjectScope.OtherGroup)" Color="Color.Primary" aria-label="Other animal group">Other group</MudRadio>
                            </div>
                        </MudRadioGroup>
                    </div>
                }
                @if (!HasCompleteSubject)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" role="status">
                        @(_subjectCategory == ReportSubjectCategory.AnimalHealth
                            ? "Choose an animal type or group to continue."
                            : "Choose Human health or Animal health to continue.")
                    </MudText>
                }
                @if (_stepError is not null)
                {
                    <MudText Color="Color.Error" Typo="Typo.body2" role="alert">@_stepError</MudText>
                }
                <div class="guided-report__actions">
                    <MudButton ButtonType="ButtonType.Button" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!HasCompleteSubject)" OnClick="ContinueFromTypeAsync" StartIcon="@Icons.Material.Filled.ArrowForward">
                        Continue to details
                    </MudButton>
                    @if (OnSaveDraft.HasDelegate)
                    {
                        <MudButton ButtonType="ButtonType.Button" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Save" Disabled="@(!CanSaveDraft || _saving)" OnClick="SaveDraftAsync" data-ellai-control="report.save" data-bonboarding-anchor='@EllaiReportUiManifest.AnchorFor("report.save")'>
                            @(_saving ? DraftSavingLabel : DraftSaveButtonLabel)
                        </MudButton>
                    }
                </div>
            </section>
        }
        else if (_step == 1)
        {
            <section class="guided-report__panel" aria-labelledby="report-details-title">
                <h2 id="report-details-title" class="mud-typography mud-typography-h6 guided-report__step-heading" tabindex="-1" @ref="_stepHeading">What did you notice?</h2>
                @DetailsLeadContent
                <div data-ellai-control="report.narrative" data-bonboarding-anchor='@EllaiReportUiManifest.AnchorFor("report.narrative")'>
                    <div data-bonboarding-anchor="ellai-report-original-statement">
                    <MudTextField T="string" Label="Describe what happened" Variant="Variant.Outlined" Lines="4" MaxLength="@MaximumNarrativeCharacters"
                                  HelperText="@($"Up to {MaximumNarrativeCharacters:N0} characters.")"
                                  @bind-Value="Draft.Narrative" For="@(() => Draft.Narrative)" />
                    </div>
                </div>
                @if (Draft.SubjectScope == IntakeSubjectScope.Human)
                {
                    <div data-bonboarding-anchor="ellai-report-age-years">
                        <MudTextField T="string" Label="Age in years (optional)" Variant="Variant.Outlined"
                                      HelperText="Enter completed years, or leave blank if unknown."
                                      @bind-Value="Draft.AgeYearsText" For="@(() => Draft.AgeYearsText)" />
                    </div>
                }
                <div class="guided-report__observation-input">
                    <MudText Typo="Typo.subtitle2" id="reported-observations-heading">Reported observations (optional)</MudText>
                    <MudText Typo="Typo.body2" Class="guided-report__observation-guidance">
                        Select only what was reported. Unselected choices do not mean absent.
                    </MudText>
                    @if (Draft.SubjectScope == IntakeSubjectScope.Human)
                    {
                        <div class="guided-report__observation-groups" aria-labelledby="reported-observations-heading">
                            @foreach (var group in HumanObservationGroups)
                            {
                                <details class="guided-report__observation-group" open="@(group.Heading == "Core symptoms")">
                                    <summary>@group.Heading</summary>
                                    <div class="guided-report__observation-choices" role="group" aria-label="@group.Heading">
                                        @foreach (var observation in group.Choices)
                                        {
                                            var choice = observation;
                                            var isSelected = IsObservationSelected(choice);
                                            <MudButton ButtonType="ButtonType.Button"
                                                       Variant="Variant.Text"
                                                       StartIcon="@(isSelected ? Icons.Material.Filled.Check : Icons.Material.Filled.Add)"
                                                       Class="guided-report__observation-choice"
                                                       aria-pressed="@isSelected"
                                                       OnClick="@(() => ToggleObservationAsync(choice))">
                                                @choice
                                            </MudButton>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="guided-report__observation-groups" aria-labelledby="reported-observations-heading">
                            @foreach (var group in AnimalObservationGroups)
                            {
                                <details class="guided-report__observation-group" open="@(group.Heading == "Eating and activity")">
                                    <summary>@group.Heading</summary>
                                    <div class="guided-report__observation-choices" role="group" aria-label="@group.Heading">
                                        @foreach (var observation in group.Choices)
                                        {
                                            var choice = observation;
                                            var isSelected = IsObservationSelected(choice);
                                            <MudButton ButtonType="ButtonType.Button"
                                                       Variant="Variant.Text"
                                                       StartIcon="@(isSelected ? Icons.Material.Filled.Check : Icons.Material.Filled.Add)"
                                                       Class="guided-report__observation-choice"
                                                       aria-pressed="@isSelected"
                                                       OnClick="@(() => ToggleObservationAsync(choice))">
                                                @choice
                                            </MudButton>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    }
                    <MudButton ButtonType="ButtonType.Button"
                               Variant="Variant.Text"
                               StartIcon="@Icons.Material.Filled.Edit"
                               Class="guided-report__observation-choice guided-report__observation-choice--other"
                               OnClick="FocusObservationInputAsync">
                        Other
                    </MudButton>
                    @if (!string.IsNullOrWhiteSpace(_observationChoiceMessage))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error" role="alert">@_observationChoiceMessage</MudText>
                    }
                </div>
                <div data-bonboarding-anchor="ellai-report-other-observations">
                <MudTextField @ref="_observationsField" T="string" Label="Add other observations (optional)"
                              HelperText="@($"One per line; up to {MaximumObservations} observations and {MaximumObservationCharacters:N0} characters each.")"
                              Variant="Variant.Outlined" Lines="3" MaxLength="20000" @bind-Value="Draft.ObservationsText"
                              For="@(() => Draft.ObservationsText)" />
                </div>

                <MudSelect T="ReportedTimePrecision" Label="When did symptoms or signs start?" Variant="Variant.Outlined" @bind-Value="Draft.OnsetPrecision">
                    <MudSelectItem Value="ReportedTimePrecision.Unknown">Unknown</MudSelectItem>
                    <MudSelectItem Value="ReportedTimePrecision.Approximate">Approximate date</MudSelectItem>
                    <MudSelectItem Value="ReportedTimePrecision.DateOnly">Date only</MudSelectItem>
                    <MudSelectItem Value="ReportedTimePrecision.Exact">Exact time</MudSelectItem>
                </MudSelect>
                @if (Draft.OnsetPrecision != ReportedTimePrecision.Unknown)
                {
                    <div data-bonboarding-anchor="ellai-report-onset-date">
                    <MudTextField T="string" Label="Reported onset date" InputType="InputType.Text" Placeholder="YYYY-MM-DD"
                                  HelperText="Use the date the reporter says symptoms or signs began. Leave it unknown if not known."
                                  Variant="Variant.Outlined" Immediate="true"
                                  Value="@(Draft.OnsetDateText ?? Draft.OnsetDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))"
                                  ValueChanged="OnsetDateChangedAsync" For="@(() => Draft.OnsetDateText)" />
                    </div>
                }
                @if (Draft.OnsetPrecision == ReportedTimePrecision.Exact)
                {
                    <div class="guided-report__grid">
                        <div data-bonboarding-anchor="ellai-report-onset-time">
                        <MudTextField T="string" Label="Reported onset time" InputType="InputType.Text" Placeholder="HH:MM"
                                      HelperText="Enter the reported 24-hour local time."
                                      Variant="Variant.Outlined" Immediate="true"
                                      @bind-Value="Draft.OnsetTime" For="@(() => Draft.OnsetTime)" />
                        </div>
                        <div data-bonboarding-anchor="ellai-report-onset-utc-offset">
                        <MudTextField T="string" Label="Onset time difference from UTC" Placeholder="+02:00"
                                      HelperText="Enter the reported time difference; do not guess it."
                                      Variant="Variant.Outlined" @bind-Value="Draft.OnsetOffset" For="@(() => Draft.OnsetOffset)" />
                        </div>
                    </div>
                }

                <MudSelect T="ReportedTimePrecision" Label="When did this happen?" Variant="Variant.Outlined" @bind-Value="Draft.OccurrencePrecision" For="@(() => Draft.OccurrencePrecision)">
                    <MudSelectItem Value="ReportedTimePrecision.Unknown">Unknown</MudSelectItem>
                    <MudSelectItem Value="ReportedTimePrecision.Approximate">Approximate date</MudSelectItem>
                    <MudSelectItem Value="ReportedTimePrecision.DateOnly">Date only</MudSelectItem>
                    <MudSelectItem Value="ReportedTimePrecision.Exact">Exact time</MudSelectItem>
                </MudSelect>
                @if (Draft.OccurrencePrecision != ReportedTimePrecision.Unknown)
                {
                    <div data-bonboarding-anchor="ellai-report-occurrence-date">
                    <MudTextField T="string" Label="Reported date" InputType="InputType.Text" Placeholder="YYYY-MM-DD"
                                  HelperText="Enter the date as year-month-day, for example 2026-10-01."
                                  Variant="Variant.Outlined" Immediate="true"
                                  Value="@(Draft.OccurrenceDateText ?? Draft.OccurrenceDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))"
                                  ValueChanged="OccurrenceDateChangedAsync" For="@(() => Draft.OccurrenceDateText)" />
                    </div>
                }
                @if (Draft.OccurrencePrecision == ReportedTimePrecision.Exact)
                {
                    <div class="guided-report__grid">
                        <div data-bonboarding-anchor="ellai-report-occurrence-time">
                        <MudTextField T="string" Label="Reported time" InputType="InputType.Text" Placeholder="HH:MM"
                                      HelperText="Enter a 24-hour time, for example 08:30."
                                      Variant="Variant.Outlined" Immediate="true"
                                      @bind-Value="Draft.OccurrenceTime" For="@(() => Draft.OccurrenceTime)" />
                        </div>
                        <div data-bonboarding-anchor="ellai-report-utc-offset">
                        <MudTextField T="string" Label="Time difference from UTC" Placeholder="+02:00" HelperText="Enter the time difference that was reported."
                                      Variant="Variant.Outlined" @bind-Value="Draft.OccurrenceOffset" For="@(() => Draft.OccurrenceOffset)" />
                        </div>
                    </div>
                }

                <div data-ellai-control="report.time-location" data-bonboarding-anchor='@EllaiReportUiManifest.AnchorFor("report.time-location")'>
                    <div data-bonboarding-anchor="ellai-report-place">
                    <MudSelect T="string" id="guided-report-country" Label="Country where the event happened" Variant="Variant.Outlined"
                               Value="Draft.CountryCode" ValueChanged="CountryChangedAsync" Disabled="@(!HasCountryCatalogue)" Clearable="true">
                        @foreach (var country in Countries)
                        {
                            <MudSelectItem Value="@country.Code">@country.Name</MudSelectItem>
                        }
                    </MudSelect>
                    </div>
                </div>
                @if (!HasCountryCatalogue)
                {
                    <MudText Typo="Typo.body2">Current country choices are unavailable. This report cannot be sent until the list is available.</MudText>
                    @if (CanSaveDraft)
                    {
                        <MudText Typo="Typo.caption">You can save a draft and return when the list is available.</MudText>
                    }
                }
                else if (!string.IsNullOrWhiteSpace(Draft.CountryCode) && !IsCountrySupported(Draft.CountryCode))
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        This saved country is no longer on the list. Choose a listed country before sending.
                    </MudAlert>
                }
                @if (ShowRegistryPicker)
                {
                    <SwiftAidLocationPicker Label="Search for the place"
                                            HelperText="Type a town, village, or area. The region is filled in for you."
                                            SearchFunc="PlaceSearchFunc!"
                                            ChildrenFunc="PlaceChildrenFunc!"
                                            Countries="GeoCountries"
                                            CountryCode="@Draft.CountryCode"
                                            Selected="CurrentPlaceSelection"
                                            SelectedChanged="ApplyPlaceSelectionAsync"
                                            OnProvisionalRequested="ShowManualPlaceFields" />
                }
                @if (ShowManualPlaceFieldsGrid)
                {
                    <MudText Typo="Typo.subtitle2">Reported place names</MudText>
                    <div class="guided-report__grid">
                        <div data-bonboarding-anchor="ellai-report-region">
                        <MudTextField T="string" Label="Region" Variant="Variant.Outlined" HelperText="Leave blank when unknown."
                                      Value="Draft.Region" ValueChanged="RegionChangedAsync" For="@(() => Draft.Region)" />
                        </div>
                        <div data-bonboarding-anchor="ellai-report-area">
                        <MudTextField T="string" Label="Area or district" Variant="Variant.Outlined" HelperText="Leave blank when unknown."
                                      Value="Draft.Area" ValueChanged="AreaChangedAsync" For="@(() => Draft.Area)" />
                        </div>
                        <div data-bonboarding-anchor="ellai-report-locality">
                        <MudTextField T="string" Label="Locality" Variant="Variant.Outlined" HelperText="Leave blank when unknown."
                                      Value="Draft.Locality" ValueChanged="LocalityChangedAsync" For="@(() => Draft.Locality)" />
                        </div>
                    </div>
                }
                <MudText Typo="Typo.caption">Leave uncertain place names unknown. No device location is collected by this form.</MudText>

                @DetailsContent

                @if (_stepError is not null)
                {
                    <MudText Color="Color.Error" Typo="Typo.body2" role="alert">@_stepError</MudText>
                }
            </section>
            <div class="guided-report__actions">
                <MudButton ButtonType="ButtonType.Button" Variant="Variant.Text" OnClick="GoBack" StartIcon="@Icons.Material.Filled.ArrowBack">Back</MudButton>
                <MudButton ButtonType="ButtonType.Button" Color="Color.Primary" Variant="Variant.Text" OnClick="ContinueToReviewAsync" StartIcon="@Icons.Material.Filled.FactCheck">
                    Review report
                </MudButton>
                @if (OnSaveDraft.HasDelegate)
                {
                    <MudButton ButtonType="ButtonType.Button" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Save" Disabled="@(!CanSaveDraft || _saving)" OnClick="SaveDraftAsync" data-ellai-control="report.save" data-bonboarding-anchor='@EllaiReportUiManifest.AnchorFor("report.save")'>
                        @(_saving ? DraftSavingLabel : DraftSaveButtonLabel)
                    </MudButton>
                }
            </div>
        }
        else
        {
            <section class="guided-report__panel" aria-labelledby="report-review-title">
                <h2 id="report-review-title" data-ellai-control="report.review" data-bonboarding-anchor='@EllaiReportUiManifest.AnchorFor("report.review")' class="mud-typography mud-typography-h6 guided-report__step-heading" tabindex="-1" @ref="_stepHeading">Review your report</h2>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    Check the details you entered. Nothing has been added, rewritten, or diagnosed for you. Use Back to make changes; unknowns remain unknown.
                </MudAlert>
                <dl class="guided-report__summary">
                    <div><dt>Subject</dt><dd>@SubjectLabel</dd></div>
                    @if (Draft.SubjectScope == IntakeSubjectScope.Human)
                    {
                        <div><dt>Reported gender</dt><dd>@GenderSummary</dd></div>
                        <div><dt>Reported age in years</dt><dd>@UnknownIfEmpty(Draft.AgeYearsText)</dd></div>
                    }
                    <div><dt>Original statement</dt><dd>@UnknownIfEmpty(Draft.Narrative)</dd><dd class="guided-report__provenance">Your words, shown as entered</dd></div>
                    <div><dt>Separate observations</dt><dd>@ObservationSummary</dd><dd class="guided-report__provenance">You entered these details. No others were added.</dd></div>
                    <div><dt>Reported symptom or sign onset</dt><dd>@OnsetSummary</dd><dd class="guided-report__provenance">@OnsetProvenance</dd></div>
                    <div><dt>Event occurrence time</dt><dd>@TimeSummary</dd><dd class="guided-report__provenance">@(Draft.OccurrencePrecision == ReportedTimePrecision.Unknown ? "Not provided; remains unknown" : "From the time you entered")</dd></div>
                    <div><dt>Country</dt><dd>@CountrySummary</dd><dd class="guided-report__provenance">@(string.IsNullOrWhiteSpace(Draft.CountryCode) ? "Not provided; remains unknown" : "You selected this")</dd></div>
                    <div><dt>Location</dt><dd>@LocationSummary</dd><dd class="guided-report__provenance">@LocationProvenance</dd></div>
                    <div><dt>Animal type or group</dt><dd>Unknown</dd><dd class="guided-report__provenance">Not asked here; remains unknown.</dd></div>
                    <div><dt>Affected, deceased, and at-risk counts</dt><dd>Unknown</dd><dd class="guided-report__provenance">Not entered; remains unknown.</dd></div>
                </dl>
                <div data-bonboarding-anchor="ellai-report-review-confirmed">
                <MudCheckBox T="bool" Label="I reviewed the original statement and the known or unknown details above." @bind-Value="Draft.ReportReviewConfirmed" Color="Color.Primary" />
                </div>
                <div data-bonboarding-anchor="ellai-report-country-confirmed">
                <MudCheckBox T="bool" Label="I confirm the selected event country." @bind-Value="Draft.CountryConfirmed" Color="Color.Primary"
                             Disabled="@(!CanConfirmCountry)" />
                </div>
                @if (HasPrivacyNotice)
                {
                    <MudLink Href="@PrivacyNoticeReference" Target="_blank" rel="noopener noreferrer">Read SwiftAid’s privacy notice</MudLink>
                }
                else
                {
                    <div data-bonboarding-anchor="ellai-report-privacy-unavailable">
                    <MudText Typo="Typo.body2">SwiftAid’s privacy notice is unavailable right now. Sending is not available.</MudText>
                    </div>
                    @if (CanSaveDraft)
                    {
                        <MudText Typo="Typo.caption">You can still save a draft.</MudText>
                    }
                }
                @if (!string.IsNullOrWhiteSpace(ProcessingPolicyNoticeText))
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" role="note">
                        @ProcessingPolicyNoticeText
                    </MudAlert>
                }
                @if (!string.IsNullOrWhiteSpace(ProcessingPolicyNotice))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" role="note">
                        @ProcessingPolicyNotice
                    </MudText>
                }
                @if (HasProcessingPolicy)
                {
                    @if (IsSafePolicyLink)
                    {
                        <MudLink Href="@ProcessingPolicyReference" Target="_blank" rel="noopener noreferrer">Read how this report is handled</MudLink>
                    }
                    <div data-ellai-control="report.confirmations" data-bonboarding-anchor='@EllaiReportUiManifest.AnchorFor("report.confirmations")'>
                        <div data-bonboarding-anchor="ellai-report-processing-confirmed">
                        <MudCheckBox T="bool" Label="@ProcessingAcknowledgementLabel" @bind-Value="Draft.ProcessingConfirmed"
                                     Color="Color.Primary" />
                        </div>
                    </div>
                }
                else
                {
                    <div data-bonboarding-anchor="ellai-report-policy-unavailable">
                    <MudText Typo="Typo.body2">Details about how this report is handled are unavailable. Sending is not available.</MudText>
                    </div>
                    @if (CanSaveDraft)
                    {
                        <MudText Typo="Typo.caption">You can save a draft.</MudText>
                    }
                }
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    This report records observations. It does not provide a diagnosis or treatment, promise a service, or assign a worker.
                </MudAlert>
                @if (_stepError is not null)
                {
                    <MudText Color="Color.Error" Typo="Typo.body2" role="alert">@_stepError</MudText>
                }
                @if (_submitError is not null)
                {
                    <MudText Color="Color.Error" Typo="Typo.body2" role="alert">@_submitError</MudText>
                }
            </section>
            <div class="guided-report__actions">
                <div data-bonboarding-anchor="ellai-report-return-details">
                <MudButton ButtonType="ButtonType.Button" Variant="Variant.Text" OnClick="GoBack" StartIcon="@Icons.Material.Filled.ArrowBack">Back</MudButton>
                </div>
                @if (OnSaveDraft.HasDelegate)
                {
                    <MudButton ButtonType="ButtonType.Button" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Save" Disabled="@(!CanSaveDraft || _saving)" OnClick="SaveDraftAsync" data-ellai-control="report.save" data-bonboarding-anchor='@EllaiReportUiManifest.AnchorFor("report.save")'>
                        @(_saving ? DraftSavingLabel : DraftSaveButtonLabel)
                    </MudButton>
                }
                <MudButton id="report-submit" data-ellai-control="report.submit" data-bonboarding-anchor='@EllaiReportUiManifest.AnchorFor("report.submit")' ButtonType="ButtonType.Button" Color="Color.Primary" Variant="Variant.Text" Disabled="@(!CanSubmit || _submitting)" OnClick="SubmitAsync" StartIcon="@Icons.Material.Filled.Cancel">
                    @(_submitting ? SubmitProgressLabel : SubmitButtonLabel)
                </MudButton>
                @if (!CanSubmit)
                {
                    <MudText Typo="Typo.caption" Class="guided-report__submit-hint">
                        @if (!HasProcessingPolicy)
                        {
                            <span>Sending is unavailable until details about how reports are handled are available.</span>
                            @if (CanSaveDraft)
                            {
                                <span> You can save this report as a draft.</span>
                            }
                        }
                        else
                        {
                            <span>To send, current country choices and privacy information must be available. Choose and confirm the event country, then review the details.</span>
                            @if (CanSaveDraft)
                            {
                                <span> You can still save this draft.</span>
                            }
                        }
                    </MudText>
                }
            </div>
        }
        <div class="guided-report__save-state" role="status" aria-live="polite">
            @if (_saving)
            {
                <span>@DraftSavingLabel</span>
            }
            else if (_saveState == DraftSaveState.Saved)
            {
                <span>@DraftSavedMessage</span>
            }
            else if (_saveState == DraftSaveState.Failed)
            {
                <span>The save action failed. Your entries remain on this screen. Check saved reports before trying again.</span>
            }
            else if (_saveState == DraftSaveState.Invalid)
            {
                <span>The draft was not saved. @(GetValidationGuidance().FirstOrDefault()?.Message) Your entries remain on this screen.</span>
            }
            else if (_saveState == DraftSaveState.Unconfirmed)
            {
                <span>We could not confirm whether your draft was saved. Your entries remain on this screen. Check saved reports before trying again.</span>
            }
            else if (!DraftSavingAvailable)
            {
                <span>Draft saving is unavailable right now. Your entries remain on this screen, but could be lost if you leave or refresh.</span>
            }
            else if (_saveState == DraftSaveState.Unsaved)
            {
                <span>Changes are not saved yet.</span>
            }
        </div>
    </EditForm>
</section>

@code {
    private static readonly string[] StepNames = ["Type", "Details", "Review"];
    private EditContext _editContext = default!;
    private ValidationMessageStore _messageStore = default!;
    private PublicReportDraft? _observedDraft;
    private ElementReference _stepHeading;
    private ElementReference _validationSummary;
    private ElementReference _subjectValidationTarget;
    private ElementReference _animalScopeValidationTarget;
    private ElementReference _narrativeValidationTarget;
    private ElementReference _ageValidationTarget;
    private ElementReference _observationsValidationTarget;
    private ElementReference _dateValidationTarget;
    private ElementReference _timeValidationTarget;
    private ElementReference _offsetValidationTarget;
    private ElementReference _locationValidationTarget;
    private ElementReference _regionValidationTarget;
    private ElementReference _areaValidationTarget;
    private ElementReference _localityValidationTarget;
    private string? _validationField;
    private string? _validationMessage;
    private SwiftAid.UI.Ellai.Guidance.EllaiValidationGuidance? _validationGuidance;
    private bool _followValidation;
    private bool _focusValidationFieldAfterRender;
    private MudTextField<string>? _observationsField;
    private bool _focusStepHeadingAfterRender;
    private bool _focusValidationSummaryAfterRender;
    private int _step;
    private string? _stepError;
    private bool _detailsValidationAttempted;
    private bool _saveValidationAttempted;
    private bool _showManualPlaces;
    private string? _observationChoiceMessage;
    private string? _submitError;
    private long _dismissedServerValidationRevision;
    private bool _saving;
    private Guid? _savingDraftId;
    private Guid? _observedDraftId;
    private PublicReportSaveRequest? _activeSaveRequest;
    private PublicReportDraft? _savingSnapshot;
    private PublicReportDraft? _savingSourceSnapshot;
    private PublicReportDraft? _savingSourceDraft;
    private PendingDraftRefresh? _pendingDraftRefresh;
    private PendingDraftRefresh? _confirmedDraftSave;
    private bool _submitting;
    private DraftSaveState _saveState = DraftSaveState.Unsaved;
    private ReportSubjectCategory? _subjectCategory;
    private readonly List<int> _previousAges = [];

    private sealed record ObservationGroup(string Heading, IReadOnlyList<string> Choices);
    private sealed record PendingDraftRefresh(Guid? SourceDraftId, PublicReportDraft SavedDraft, PublicReportDraft SourceDraft,
        PublicReportDraft EditableDraft, int Step);

    private static readonly ObservationGroup[] HumanObservationGroups =
    [
        new("Core symptoms",
        [
            "Acute watery diarrhea (rice-water stools)",
            "Vomiting",
            "Leg/muscle cramps",
            "Restlessness or irritability (especially children)"
        ]),
        new("Signs of dehydration",
        [
            "Thirst, dry mouth",
            "Sunken eyes",
            "Little or no urine",
            "Dizziness or lightheadedness",
            "Weak/fast pulse",
            "Low blood pressure",
            "Cool/clammy skin",
            "Poor skin turgor"
        ]),
        new("Additional symptoms and signs",
        [
            "Profuse watery diarrhea",
            "Persistent vomiting",
            "Lethargy or confusion",
            "Very weak pulse or very low blood pressure (shock)",
            "In children: extreme drowsiness or convulsions",
            "Fever",
            "Rash",
            "Headache",
            "Muscle weakness",
            "Fatigue",
            "Cough",
            "Chills",
            "Joint pain",
            "Stomach pain",
            "Nausea",
            "Diarrhea",
            "Sweating",
            "Loss of appetite",
            "Sore throat",
            "Difficulty breathing"
        ])
    ];

    private static readonly ObservationGroup[] AnimalObservationGroups =
    [
        new("Eating and activity",
        [
            "Animal diarrhoea",
            "Reduced appetite or drinking",
            "Unusual weakness or reduced activity",
            "Animal died"
        ]),
        new("Movement and breathing",
        [
            "Difficulty walking or standing",
            "Coughing or sneezing",
            "Difficulty breathing"
        ]),
        new("Visible changes",
        [
            "Discharge from eyes, nose, or mouth",
            "Changes to skin, coat, or feathers",
            "Visible wounds or injuries",
            "Swelling or unusual lumps"
        ]),
        new("Other changes noticed",
        [
            "Unusual droppings",
            "Multiple animals affected"
        ])
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusValidationFieldAfterRender)
        {
            _focusValidationFieldAfterRender = false;
            var target = _validationField switch
            {
                nameof(PublicReportDraft.SubjectScope) => _subjectCategory == ReportSubjectCategory.AnimalHealth
                    ? _animalScopeValidationTarget : _subjectValidationTarget,
                nameof(PublicReportDraft.Narrative) => _narrativeValidationTarget,
                nameof(PublicReportDraft.AgeYearsText) => _ageValidationTarget,
                nameof(PublicReportDraft.ObservationsText) => _observationsValidationTarget,
                nameof(PublicReportDraft.OccurrenceDate) => _dateValidationTarget,
                nameof(PublicReportDraft.OccurrenceTime) => _timeValidationTarget,
                nameof(PublicReportDraft.OccurrenceOffset) => _offsetValidationTarget,
                nameof(PublicReportDraft.Region) => _regionValidationTarget,
                nameof(PublicReportDraft.Area) => _areaValidationTarget,
                nameof(PublicReportDraft.Locality) => _localityValidationTarget,
                _ => _locationValidationTarget
            };
            await target.FocusAsync();
        }
        else if (_focusStepHeadingAfterRender)
        {
            _focusStepHeadingAfterRender = false;
            await _stepHeading.FocusAsync();
        }
        else if (_focusValidationSummaryAfterRender)
        {
            _focusValidationSummaryAfterRender = false;
            await _validationSummary.FocusAsync();
        }
    }

    private string GetSubjectChoiceClass(ReportSubjectCategory category) =>
        _subjectCategory == category ? "guided-report__choice is-selected" : "guided-report__choice";

    private string? ValidationClass(string field) => _followValidation && _validationField == field
        ? "guided-report__current-validation" : null;

    [Parameter, EditorRequired]
    public PublicReportDraft Draft { get; set; } = default!;

    [Parameter]
    public EventCallback<PublicReportSaveRequest> OnSaveDraft { get; set; }

    [Parameter]
    public bool DraftSavingAvailable { get; set; } = true;

    [Parameter]
    public bool EditableDraftSnapshotsSupported { get; set; }

    [Parameter]
    public EventCallback<PublicReportDraft> OnContinue { get; set; }

    [Parameter]
    public EventCallback<PublicReportDraft> OnReview { get; set; }

    [Parameter]
    public EventCallback<IntakeSubmission> OnSubmit { get; set; }

    [Parameter]
    public long ServerValidationRevision { get; set; }

    [Parameter]
    public string SubmitButtonLabel { get; set; } = "Submit report";

    [Parameter]
    public string SubmitProgressLabel { get; set; } = "Sending…";

    [Parameter]
    public string DraftSaveButtonLabel { get; set; } = "Save draft";

    [Parameter]
    public string DraftSavingLabel { get; set; } = "Saving draft…";

    [Parameter]
    public string DraftSavedMessage { get; set; } = "Your draft save action completed. It has not been submitted.";

    [Parameter]
    public IReadOnlyList<PublicCountryOption> Countries { get; set; } = [];

    [Parameter]
    public PublicIntakeTextLimits? TextLimits { get; set; }

    [Parameter]
    public Func<string, string?, CancellationToken, Task<GeoPlaceQueryResult>>? PlaceSearchFunc { get; set; }

    [Parameter]
    public Func<string, CancellationToken, Task<GeoPlaceQueryResult>>? PlaceChildrenFunc { get; set; }

    [Parameter]
    public IReadOnlyList<GeoPlaceCountry> GeoCountries { get; set; } = [];

    [Parameter]
    public string? CountryCatalogueVersion { get; set; }

    [Parameter]
    public bool CountryCatalogueIsCurrent { get; set; }

    [Parameter]
    public string? PrivacyNoticeReference { get; set; }

    [Parameter]
    public string? ProcessingPolicyReference { get; set; }

    [Parameter]
    public string? ProcessingPolicyVersion { get; set; }

    [Parameter]
    public string? ProcessingPolicyNoticeText { get; set; }

    [Parameter]
    public string? ProcessingPolicyAcknowledgementLabel { get; set; }

    [Parameter]
    public string? ProcessingPolicyNotice { get; set; }

    [Parameter]
    public bool PrivacyNoticeIsCurrent { get; set; }

    [Parameter]
    public int AttachmentSelectionCount { get; set; }

    [Parameter]
    public Guid? CurrentDraftId { get; set; }

    [Parameter]
    public RenderFragment? DetailsLeadContent { get; set; }

    [Parameter]
    public RenderFragment? DetailsContent { get; set; }

    protected override void OnParametersSet()
    {
        ArgumentNullException.ThrowIfNull(Draft);
        if (ReferenceEquals(Draft, _observedDraft) && CurrentDraftId == _observedDraftId)
        {
            if (Draft.SubjectScope is not null)
            {
                _subjectCategory = GetSubjectCategory(Draft.SubjectScope);
            }

            RegisterEllaiDraftContext();
            return;
        }

        var preserveCurrentStepForSaveRefresh = _saving && _savingSnapshot is not null
            && (ReferenceEquals(Draft, _savingSourceDraft) || DraftMatches(Draft, _savingSnapshot)
                || _savingSourceSnapshot is not null && DraftMatches(Draft, _savingSourceSnapshot))
            && IsSaveRefreshIdentity(_activeSaveRequest?.PersistedDraftId ?? _savingDraftId, CurrentDraftId);
        if (_pendingDraftRefresh is { } pendingRefresh)
        {
            var matchesSavedDraft =
                IsSaveRefreshIdentity(pendingRefresh.SourceDraftId, CurrentDraftId) &&
                (ReferenceEquals(Draft, pendingRefresh.EditableDraft)
                    || DraftMatches(Draft, pendingRefresh.SavedDraft) || DraftMatches(Draft, pendingRefresh.SourceDraft));
            if (matchesSavedDraft)
            {
                _step = pendingRefresh.Step;
                preserveCurrentStepForSaveRefresh = true;
            }

            _pendingDraftRefresh = null;
        }

        if (!ReferenceEquals(Draft, _observedDraft) || CurrentDraftId != _observedDraftId)
        {
            if (_editContext is not null) _editContext.OnFieldChanged -= HandleFieldChanged;
            _observedDraft = Draft;
            _observedDraftId = CurrentDraftId;
            _previousAges.Clear();
            _editContext = new EditContext(Draft);
            _messageStore = new ValidationMessageStore(_editContext);
            _editContext.OnFieldChanged += HandleFieldChanged;
            if (!preserveCurrentStepForSaveRefresh)
            {
                _step = 0;
                _detailsValidationAttempted = false;
                _saveValidationAttempted = false;
                _saveState = DraftSaveState.Unsaved;
            }
            _subjectCategory = GetSubjectCategory(Draft.SubjectScope);
            _followValidation = false;
            _validationField = null;
            _validationMessage = null;
            _focusValidationFieldAfterRender = false;
            PublishValidation();
            _stepError = null;
            _submitError = null;
            RegisterEllaiReportDraftContext();
        }

        if (HasCountryCatalogue &&
            !IsCountrySupported(Draft.CountryCode) &&
            Draft.CountryConfirmed)
        {
            Draft.CountryConfirmed = false;
        }

        RegisterEllaiDraftContext();
    }

    private void RegisterEllaiDraftContext()
    {
        if (EllaiDraftContext is null) return;
        EllaiDraftContext.Register(this, age =>
        {
            if (Draft.SubjectScope is not (null or IntakeSubjectScope.Human)) return false;
            SetReportedAge(age);
            _editContext.NotifyFieldChanged(new FieldIdentifier(Draft, nameof(Draft.AgeYearsText)));
            return true;
        }, observation =>
        {
            var existing = Draft.GetObservations();
            if (existing.Contains(observation, StringComparer.Ordinal)) return true;
            var updated = existing.Append(observation).ToArray();
            if (!Draft.HasValidObservations(updated, MaximumObservations, MaximumObservationCharacters)) return false;
            Draft.ObservationsText = string.Join(Environment.NewLine, updated);
            _editContext.NotifyFieldChanged(new FieldIdentifier(Draft, nameof(Draft.ObservationsText)));
            return true;
        }, locality =>
        {
            if (!PublicReportDraft.IsValidPlaceName(PresenceState.Known, locality)) return false;
            Draft.Locality = locality;
            Draft.LocalityPresence = PresenceState.Known;
            Draft.LocalityId = null;
            Draft.LocationUnknown = false;
            NotifyPlaceFieldsChanged();
            return true;
        }, statement =>
        {
            var current = Draft.Narrative?.Trim();
            var lines = string.IsNullOrEmpty(current)
                ? Array.Empty<string>()
                : current.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (lines.Contains(statement, StringComparer.Ordinal)) return true;
            var updated = string.Join(Environment.NewLine, lines.Append(statement));
            if (updated.Length > MaximumNarrativeCharacters) return false;
            Draft.Narrative = updated;
            _editContext.NotifyFieldChanged(new FieldIdentifier(Draft, nameof(Draft.Narrative)));
            return true;
        }, gender =>
        {
            if (Draft.SubjectScope is not (null or IntakeSubjectScope.Human)) return false;
            Draft.SubjectScope = IntakeSubjectScope.Human;
            _subjectCategory = ReportSubjectCategory.HumanHealth;
            Draft.Gender = gender;
            _editContext.NotifyFieldChanged(new FieldIdentifier(Draft, nameof(Draft.SubjectScope)));
            _editContext.NotifyFieldChanged(new FieldIdentifier(Draft, nameof(Draft.Gender)));
            return true;
        }, () =>
        {
            if (_previousAges.Count == 0) return false;
            var previousAge = _previousAges[^1];
            _previousAges.RemoveAt(_previousAges.Count - 1);
            Draft.AgeYearsText = previousAge.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _editContext.NotifyFieldChanged(new FieldIdentifier(Draft, nameof(Draft.AgeYearsText)));
            return true;
        }, observation =>
        {
            var existing = Draft.GetObservations();
            var matches = existing.Where(value => string.Equals(value, observation, StringComparison.OrdinalIgnoreCase)).ToArray();
            if (matches.Length != 1) return false;
            Draft.ObservationsText = string.Join(Environment.NewLine,
                existing.Where(value => !string.Equals(value, matches[0], StringComparison.Ordinal)));
            _editContext.NotifyFieldChanged(new FieldIdentifier(Draft, nameof(Draft.ObservationsText)));
            return true;
        }, (onsetDate, relativeDay, statement) =>
        {
            if (onsetDate is null)
            {
                if (relativeDay is null || Draft.CapturedAt is not { } capturedAt) return false;
                var captureDate = DateOnly.FromDateTime(capturedAt.DateTime);
                onsetDate = relativeDay == SwiftAid.UI.Ellai.Guidance.EllaiRelativeOnsetDay.Today ? captureDate : captureDate.AddDays(-1);
            }

            var existingNarrative = Draft.Narrative?.Trim();
            var narrativeLines = string.IsNullOrEmpty(existingNarrative)
                ? Array.Empty<string>()
                : existingNarrative.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var updatedNarrative = narrativeLines.Contains(statement, StringComparer.Ordinal)
                ? existingNarrative
                : string.Join(Environment.NewLine, narrativeLines.Append(statement));
            if (updatedNarrative is not null && updatedNarrative.Length > MaximumNarrativeCharacters) return false;

            Draft.OnsetPrecision = ReportedTimePrecision.DateOnly;
            Draft.OnsetDate = onsetDate.Value.ToDateTime(TimeOnly.MinValue);
            Draft.OnsetDateText = onsetDate.Value.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
            Draft.OnsetTime = null;
            Draft.OnsetOffset = null;
            Draft.OnsetZoneId = null;
            Draft.OnsetDateInterpretedFromCaptureContext = relativeDay is not null;
            Draft.Narrative = updatedNarrative;
            _editContext.NotifyFieldChanged(new FieldIdentifier(Draft, nameof(Draft.OnsetPrecision)));
            _editContext.NotifyFieldChanged(new FieldIdentifier(Draft, nameof(Draft.OnsetDateText)));
            _editContext.NotifyFieldChanged(new FieldIdentifier(Draft, nameof(Draft.OnsetDateInterpretedFromCaptureContext)));
            _editContext.NotifyFieldChanged(new FieldIdentifier(Draft, nameof(Draft.Narrative)));
            return true;
        });
        if (!EllaiDraftContext.FlushPending(this))
            _stepError = "Some details from this Ellai report conversation could not fit the form. Review the report and add those details manually.";
    }

    private void RegisterEllaiReportDraftContext()
    {
        if (Services.GetService(typeof(SwiftAid.UI.Ellai.Guidance.EllaiPublicReportDraftContext)) is not
            SwiftAid.UI.Ellai.Guidance.EllaiPublicReportDraftContext context) return;
        context.Register(this, SetReportedAge, GetReportedAge, AddReportedObservation, SetReportedLocality,
            AppendReportedStatement, Draft, AutoFillVoiceSuggestion);
        if (!context.FlushPending(this))
            _stepError = "Ellai could not apply the report detail. Enter it in the report form to continue.";
    }

    private bool SetReportedAge(int? age)
    {
        if (age is < 0 || Draft.SubjectScope is not (null or IntakeSubjectScope.Human)) return false;
        if (Draft.SubjectScope is null)
        {
            Draft.SubjectScope = IntakeSubjectScope.Human;
            _subjectCategory = ReportSubjectCategory.HumanHealth;
            NotifyEllaiDraftEdit(nameof(Draft.SubjectScope));
        }
        Draft.AgeYearsText = age?.ToString(System.Globalization.CultureInfo.InvariantCulture);
        NotifyEllaiDraftEdit(nameof(Draft.AgeYearsText));
        return true;
    }

    private int? GetReportedAge() => int.TryParse(Draft.AgeYearsText,
        System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var age) ? age : null;

    private bool AutoFillVoiceSuggestion(SwiftAid.Contracts.Intake.ReportVoiceSuggestion suggestion, string transcript)
    {
        bool IsModified(string field) => _editContext?.IsModified(new FieldIdentifier(Draft, field)) == true;
        if (suggestion.Field == "country")
        {
            if (!HasCountryCatalogue || !ReportVoiceAutofill.TryGetCountryCode(
                    suggestion, transcript, Draft, IsModified, Countries, out var countryCode)) return false;
            Draft.CountryCode = countryCode;
            Draft.CountryConfirmed = false;
            Draft.LocationUnknown = false;
            NotifyEllaiDraftEdit(nameof(Draft.CountryCode));
            return true;
        }
        if (!ReportVoiceAutofill.CanApply(suggestion, transcript, Draft, IsModified)) return false;
        return suggestion.Field switch
        {
            "age" when ReportVoiceAutofill.TryGetAge(suggestion.Value, out var age) => SetReportedAge(age),
            "locality" => SetReportedLocality(suggestion.Value),
            "observation" => AddReportedObservation(suggestion.Evidence),
            _ => false
        };
    }

    private bool AddReportedObservation(string observation)
    {
        var value = observation.Trim();
        var existing = Draft.GetObservations();
        if (string.IsNullOrWhiteSpace(value) || value.Length > 1000 || value.Contains('\r') || value.Contains('\n')) return false;
        if (existing.Contains(value, StringComparer.Ordinal)) return true;
        if (existing.Count >= 20) return false;
        Draft.ObservationsText = string.Join(Environment.NewLine, existing.Append(value));
        NotifyEllaiDraftEdit(nameof(Draft.ObservationsText));
        return true;
    }

    private bool SetReportedLocality(string? locality)
    {
        if (locality is null)
        {
            Draft.Locality = null;
            Draft.LocalityPresence = PresenceState.Unknown;
            Draft.LocalityId = null;
            Draft.LocationUnknown = string.IsNullOrWhiteSpace(Draft.CountryCode) &&
                Draft.RegionPresence != PresenceState.Known && Draft.AreaPresence != PresenceState.Known;
            NotifyEllaiDraftEdit(nameof(Draft.Locality));
            return true;
        }
        var value = locality.Trim();
        if (string.IsNullOrWhiteSpace(value) || value.Length > 200) return false;
        Draft.Locality = value;
        Draft.LocalityPresence = PresenceState.Known;
        Draft.LocalityId = null;
        Draft.LocationUnknown = false;
        NotifyEllaiDraftEdit(nameof(Draft.Locality));
        return true;
    }

    private bool AppendReportedStatement(string statement)
    {
        var value = statement.Trim();
        if (string.IsNullOrWhiteSpace(value) || value.Length > 6000) return false;
        var narrative = string.IsNullOrWhiteSpace(Draft.Narrative)
            ? value : string.Join(Environment.NewLine, Draft.Narrative, value);
        if (narrative.Length > 6000) return false;
        Draft.Narrative = narrative;
        NotifyEllaiDraftEdit(nameof(Draft.Narrative));
        return true;
    }

    private void NotifyEllaiDraftEdit(string fieldName)
    {
        if (_editContext is not null)
            _editContext.NotifyFieldChanged(new FieldIdentifier(Draft, fieldName));
        _ = InvokeAsync(StateHasChanged);
    }

    private string SubjectLabel => Draft.SubjectScope switch
    {
        IntakeSubjectScope.Human => "Human health",
        IntakeSubjectScope.Individual => "Animal health — individual",
        IntakeSubjectScope.Herd => "Animal health — herd",
        IntakeSubjectScope.Flock => "Animal health — flock",
        IntakeSubjectScope.OtherGroup => "Animal health — other group",
        _ => "Unknown"
    };

    private string GenderSummary => Draft.Gender switch
    {
        ReportedGender.Female => "Female",
        ReportedGender.Male => "Male",
        ReportedGender.Other => "Other",
        _ => "Unknown"
    };

    private void SetReportedAge(int age)
    {
        if (int.TryParse(Draft.AgeYearsText, System.Globalization.NumberStyles.None,
                System.Globalization.CultureInfo.InvariantCulture, out var previousAge) && previousAge != age)
        {
            _previousAges.Add(previousAge);
            if (_previousAges.Count > 10) _previousAges.RemoveAt(0);
        }
        Draft.AgeYearsText = age.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    private string ObservationSummary
    {
        get
        {
            var observations = Draft.GetObservations();
            return observations.Count == 0 ? "Unknown" : string.Join("; ", observations);
        }
    }

    private string TimeSummary => Draft.OccurrencePrecision switch
    {
        ReportedTimePrecision.Unknown => "Unknown",
        ReportedTimePrecision.Exact => $"{Draft.OccurrenceDate?.ToString("d") ?? "Unknown date"} {Draft.OccurrenceTime ?? "Unknown time"} {Draft.OccurrenceOffset ?? "Unknown offset"}",
        ReportedTimePrecision.DateOnly => Draft.OccurrenceDate?.ToString("d") ?? "Date unknown",
        _ => Draft.OccurrenceDate is { } date ? $"Approximately {date:d}" : "Approximately; date unknown"
    };

    private string OnsetSummary => Draft.OnsetPrecision switch
    {
        ReportedTimePrecision.Unknown => "Unknown",
        ReportedTimePrecision.Exact => $"{Draft.OnsetDate?.ToString("d") ?? "Unknown date"} {Draft.OnsetTime ?? "Unknown time"} {Draft.OnsetOffset ?? "Unknown offset"}",
        ReportedTimePrecision.DateOnly => Draft.OnsetDate?.ToString("d") ?? "Date unknown",
        _ => Draft.OnsetDate is { } date ? $"Approximately {date:d}" : "Approximately; date unknown"
    };

    private string OnsetProvenance => Draft.OnsetPrecision == ReportedTimePrecision.Unknown
        ? "Not provided; remains unknown"
        : Draft.OnsetDateInterpretedFromCaptureContext
            ? "Interpreted from your words using the draft capture date and local time offset; review or correct before submitting."
            : "From the onset details you entered";

    private string CountrySummary => string.IsNullOrWhiteSpace(Draft.CountryCode)
        ? "Unknown"
        : Countries.FirstOrDefault(country => string.Equals(country.Code, Draft.CountryCode.Trim(), StringComparison.OrdinalIgnoreCase))?.Name
            ?? (HasCountryCatalogue ? "Country choice unavailable — choose again" : "Previously selected; country list unavailable");

    private int MaximumNarrativeCharacters => Math.Min(TextLimits is { } limits && limits.IsValid() ? limits.MaximumNarrativeCharacters : 6000, 6000);
    private int MaximumObservations => Math.Min(TextLimits is { } limits && limits.IsValid() ? limits.MaximumObservations : 20, 20);
    private int MaximumObservationCharacters => Math.Min(TextLimits is { } limits && limits.IsValid() ? limits.MaximumObservationCharacters : 300, 1000);

    private bool HasCountryCatalogue => CountryCatalogueIsCurrent &&
        Countries.Count > 0 && !string.IsNullOrWhiteSpace(CountryCatalogueVersion);

    private bool CanConfirmCountry => HasCountryCatalogue && IsCountrySupported(Draft.CountryCode);

    private bool HasPrivacyNotice => PrivacyNoticeIsCurrent &&
        !string.IsNullOrWhiteSpace(PrivacyNoticeReference);

    private bool HasProcessingPolicy =>
        !string.IsNullOrWhiteSpace(ProcessingPolicyReference) &&
        !string.IsNullOrWhiteSpace(ProcessingPolicyVersion);

    private string ProcessingAcknowledgementLabel =>
        string.IsNullOrWhiteSpace(ProcessingPolicyAcknowledgementLabel)
            ? "I have reviewed the report-handling information shown here."
            : ProcessingPolicyAcknowledgementLabel;

    private bool IsSafePolicyLink
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ProcessingPolicyReference) ||
                ProcessingPolicyReference.Any(char.IsControl) ||
                ProcessingPolicyReference.Contains('\\'))
            {
                return false;
            }

            if (ProcessingPolicyReference.StartsWith("/", StringComparison.Ordinal))
            {
                return !ProcessingPolicyReference.StartsWith("//", StringComparison.Ordinal) &&
                    !ProcessingPolicyReference.Contains("..", StringComparison.Ordinal);
            }

            return Uri.TryCreate(ProcessingPolicyReference, UriKind.Absolute, out var policyUri) &&
                string.Equals(policyUri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase) &&
                !string.IsNullOrWhiteSpace(policyUri.Host) &&
                string.IsNullOrEmpty(policyUri.UserInfo);
        }
    }

    private bool HasCompleteSubject => _subjectCategory switch
    {
        ReportSubjectCategory.HumanHealth => Draft.SubjectScope == IntakeSubjectScope.Human,
        ReportSubjectCategory.AnimalHealth => Draft.SubjectScope is IntakeSubjectScope.Individual or
            IntakeSubjectScope.Herd or IntakeSubjectScope.Flock or IntakeSubjectScope.OtherGroup,
        _ => false
    };

    private bool CanSaveDraft => DraftSavingAvailable && OnSaveDraft.HasDelegate &&
        AttachmentSelectionCount == 0 && HasCompleteSubject;

    private static ReportSubjectCategory? GetSubjectCategory(IntakeSubjectScope? scope) => scope switch
    {
        IntakeSubjectScope.Human => ReportSubjectCategory.HumanHealth,
        IntakeSubjectScope.Individual or IntakeSubjectScope.Herd or IntakeSubjectScope.Flock or IntakeSubjectScope.OtherGroup => ReportSubjectCategory.AnimalHealth,
        _ => null
    };

    private Task SubjectCategoryChangedAsync(ReportSubjectCategory? category)
    {
        var previousScope = Draft.SubjectScope;
        _subjectCategory = category;
        Draft.SubjectScope = category switch
        {
            ReportSubjectCategory.HumanHealth => IntakeSubjectScope.Human,
            ReportSubjectCategory.AnimalHealth when previousScope is IntakeSubjectScope.Individual or
                IntakeSubjectScope.Herd or IntakeSubjectScope.Flock or IntakeSubjectScope.OtherGroup => previousScope,
            _ => null
        };
        if (Draft.SubjectScope != IntakeSubjectScope.Human)
        {
            Draft.Gender = null;
            _previousAges.Clear();
        }
        NotifySubjectScopeChanged();
        return Task.CompletedTask;
    }

