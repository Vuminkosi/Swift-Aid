    private async Task ContinueFromTypeAsync()
    {
        ClearStepValidation();
        if (!HasCompleteSubject)
        {
            _stepError = _subjectCategory == ReportSubjectCategory.AnimalHealth
                ? "Choose an animal type or group before continuing."
                : "Choose whether this concern is about a person or an animal.";
            _followValidation = true;
            AddError(nameof(PublicReportDraft.SubjectScope), _stepError);
            _focusValidationFieldAfterRender = true;
            _editContext.NotifyValidationStateChanged();
            PublishValidation();
            return;
        }

        await RunStepCallbackAsync(OnContinue, 1);
    }

    private async Task ContinueToReviewAsync()
    {
        ClearStepValidation();
        if (!ValidateDetails())
        {
            _followValidation = true;
            _focusValidationFieldAfterRender = true;
            PublishValidation();
            return;
        }

        try
        {
            await OnReview.InvokeAsync(Draft);
            await OnContinue.InvokeAsync(Draft);
            _step = 2;
            _focusStepHeadingAfterRender = true;
        }
        catch
        {
            _stepError = "The review step could not be opened. Your entries remain on this screen.";
        }
    }

    private async Task RunStepCallbackAsync(EventCallback<PublicReportDraft> callback, int nextStep)
    {
        try
        {
            await callback.InvokeAsync(Draft);
            _step = nextStep;
            _focusStepHeadingAfterRender = true;
            _stepError = null;
        }
        catch
        {
            _stepError = "The next step could not be opened. Your entries remain on this screen.";
        }
    }

    private bool ValidateDetails()
    {
        _saveValidationAttempted = false;
        _detailsValidationAttempted = true;
        var hasNarrative = !string.IsNullOrWhiteSpace(Draft.Narrative);
        var observations = Draft.GetObservations();
        var isValid = true;

        if (Draft.SubjectScope == IntakeSubjectScope.Human && !Draft.HasValidAge())
        {
            AddError(nameof(Draft.AgeYearsText), "Enter age in whole years, or leave it blank if unknown.");
            isValid = false;
        }

        if (!hasNarrative && observations.Count == 0)
        {
            AddError(nameof(Draft.Narrative), "Describe what happened or add an observation.");
            isValid = false;
        }

        if ((Draft.Narrative?.Length ?? 0) > MaximumNarrativeCharacters)
        {
            AddError(nameof(Draft.Narrative), $"Keep the description within {MaximumNarrativeCharacters:N0} characters.");
            isValid = false;
        }

        if (!Draft.HasValidObservations(observations, MaximumObservations, MaximumObservationCharacters))
        {
            AddError(nameof(Draft.ObservationsText), $"Use at most {MaximumObservations} observations, {MaximumObservationCharacters:N0} characters each and 20,000 characters in total.");
            isValid = false;
        }

        if (Draft.OccurrencePrecision != ReportedTimePrecision.Unknown && !Draft.OccurrenceDate.HasValue)
        {
            AddError(nameof(Draft.OccurrenceDateText), "Enter the reported date as YYYY-MM-DD or choose that the time is unknown.");
            isValid = false;
        }

        if (Draft.OccurrencePrecision == ReportedTimePrecision.Exact && !HasValidExactTime())
        {
            var missingTime = !TimeOnly.TryParse(Draft.OccurrenceTime, out _);
            AddError(missingTime ? nameof(Draft.OccurrenceTime) : nameof(Draft.OccurrenceOffset),
                missingTime ? "Enter the reported local time." : "Enter a valid time difference from UTC, such as +02:00.");
            isValid = false;
        }
        if (Draft.OccurrencePrecision == ReportedTimePrecision.Exact && Draft.OccurrenceDate.HasValue &&
            HasValidExactTime() && !Draft.HasValidExactOccurrence())
        {
            AddError(nameof(Draft.OccurrenceDateText), "Check that the date, time and UTC offset can be combined.");
            isValid = false;
        }

        if (Draft.OnsetPrecision != ReportedTimePrecision.Unknown && !Draft.OnsetDate.HasValue)
        {
            AddError(nameof(Draft.OnsetDateText), "Enter the reported symptom or sign onset date, or choose that it is unknown.");
            isValid = false;
        }
        if (Draft.OnsetPrecision == ReportedTimePrecision.Exact && !HasValidExactOnsetTime())
        {
            AddError(nameof(Draft.OnsetTime), "For an exact onset time, enter the local time and its reported offset from UTC.");
            isValid = false;
        }
        if (Draft.OnsetPrecision == ReportedTimePrecision.Exact && Draft.OnsetDate.HasValue &&
            HasValidExactOnsetTime() && !Draft.HasValidExactOnset())
        {
            AddError(nameof(Draft.OnsetDateText), "Check that the onset date, time and UTC offset can be combined.");
            isValid = false;
        }

        if (!PublicReportDraft.IsValidPlaceName(Draft.RegionPresence, Draft.Region) ||
            !PublicReportDraft.IsValidPlaceName(Draft.AreaPresence, Draft.Area) ||
            !PublicReportDraft.IsValidPlaceName(Draft.LocalityPresence, Draft.Locality))
        {
            _showManualPlaces = true;
            AddError(string.Empty, "Enter each known place name using at most 200 characters, or leave it unknown.");
            isValid = false;
        }

        foreach (var (field, label, presence, value) in new[]
        {
            (nameof(Draft.Region), "region", Draft.RegionPresence, Draft.Region),
            (nameof(Draft.Area), "area or district", Draft.AreaPresence, Draft.Area),
            (nameof(Draft.Locality), "locality", Draft.LocalityPresence, Draft.Locality)
        })
        {
            if (presence == PresenceState.Known && value is { Length: > 200 })
            {
                _showManualPlaces = true;
                AddError(field, $"Use no more than 200 characters for the {label}, or mark it unknown.");
                isValid = false;
            }
        }

        if (!Draft.LocationUnknown &&
            string.IsNullOrWhiteSpace(Draft.CountryCode) &&
            Draft.RegionPresence != PresenceState.Known &&
            Draft.AreaPresence != PresenceState.Known &&
            Draft.LocalityPresence != PresenceState.Known)
        {
            AddError(string.Empty, "Add a reported place or mark the location unknown.");
            isValid = false;
        }

        if (!isValid)
        {
            _stepError = _validationMessage ?? "Review the highlighted information before continuing.";
        }

        _editContext.NotifyValidationStateChanged();
        return isValid;
    }

    private void AddError(string fieldName, string message)
    {
        if (_validationMessage is null)
        {
            _messageStore.Add(new FieldIdentifier(Draft, fieldName), message);
            _validationField = fieldName;
            _validationMessage = message;
        }
    }

