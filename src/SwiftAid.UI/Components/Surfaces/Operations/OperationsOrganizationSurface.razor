    {
        public OrganizationRole Role { get; set; }
        public OrganizationCountry Country { get; set; } = OrganizationCountry.Zimbabwe;
        public OrganizationRegion Region { get; set; } = OrganizationRegion.Harare;
        public string Reason { get; set; } = string.Empty;
        public string RegionReason { get; set; } = string.Empty;
    }
