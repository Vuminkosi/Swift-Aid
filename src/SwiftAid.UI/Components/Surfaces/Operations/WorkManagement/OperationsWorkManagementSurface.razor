    {
        _workerOptionIndex = null;
        _assistanceNeed = null;
        _details = null;
        _followUpDate = null;
        _followUpTime = null;
        _timeZoneId = null;
        _selectedUtcOffset = null;
        _followUpOutcome = null;
        _escalationReason = null;
        _escalationReasonText = null;
        _cancellationReason = null;
        _resolutionSummary = null;
        _resolutionReason = null;
        _escalationAction = null;
        _confirmedReceived = false;
        _reviewing = false;
        _validationMessage = null;
    }

    private DateTimeOffset? ConfirmedFollowUpDueAtUtc()
    {
        if (SelectedLocalDateTime is not { } localDateTime || SelectedTimeZone is not { } timeZone ||
            timeZone.IsInvalidTime(localDateTime) || GetSelectedOffset(timeZone, localDateTime) is not { } offset)
        {
            return null;
        }

        return new DateTimeOffset(localDateTime, offset).ToUniversalTime();
    }

    private TimeSpan? GetSelectedOffset(TimeZoneInfo timeZone, DateTime localDateTime)
    {
        if (!timeZone.IsAmbiguousTime(localDateTime))
        {
            return timeZone.GetUtcOffset(localDateTime);
        }

        if (!TimeSpan.TryParse(_selectedUtcOffset, CultureInfo.InvariantCulture, out var selectedOffset))
        {
            return null;
        }

        return timeZone.GetAmbiguousTimeOffsets(localDateTime).Contains(selectedOffset) ? selectedOffset : null;
    }

    private static bool NeedsDetails(OperationsWorkAction action) => action is
        OperationsWorkAction.RequestAssistance or
        OperationsWorkAction.RecordAssistanceProvided or
        OperationsWorkAction.RecordAssistanceUnmet or
        OperationsWorkAction.RecordFollowUpOutcome or
        OperationsWorkAction.RecordEscalationAction;

    private static string DetailsLabel(OperationsWorkAction action) => action switch
    {
        OperationsWorkAction.RequestAssistance => "Describe the requested assistance",
        OperationsWorkAction.RecordAssistanceProvided => "Describe the assistance provided",
        OperationsWorkAction.RecordAssistanceUnmet => "Describe what remains unmet",
        OperationsWorkAction.RecordFollowUpOutcome => "Follow-up details",
        OperationsWorkAction.RecordEscalationAction => "Administrative action details",
        _ => "Additional details"
    };

    private string ReviewMessage(OperationsWorkAction action, OperationsWorkItem item)
    {
        var message = $"Review {ActionLabel(action).ToLowerInvariant()} for {SafeDisplayReference(item.DisplayReference)}.";
        if (action is OperationsWorkAction.ScheduleFollowUp or OperationsWorkAction.RescheduleFollowUp)
        {
            var zone = SelectedTimeZone;
            var newLocal = SelectedLocalDateTime;
            if (zone is not null && newLocal.HasValue)
            {
                var localOffset = GetSelectedOffset(zone, newLocal.Value);
                var selectedOffsetText = localOffset is { } offset ? OffsetLabel(offset) : "offset pending";
                message += action == OperationsWorkAction.RescheduleFollowUp
                    ? $" Current due time: {FormatInTimeZone(item.DueAtUtc!.Value, zone)}. New due time: {newLocal.Value:g} {selectedOffsetText} ({zone.DisplayName})."
                    : $" Due time: {newLocal.Value:g} {selectedOffsetText} ({zone.DisplayName}).";
            }
        }
        else if (action == OperationsWorkAction.CancelFollowUp)
        {
            message += $" Cancellation reason: {_cancellationReason?.Trim()}";
        }
        else if (action == OperationsWorkAction.RequestEscalation)
        {
            message += $" Category: {(_escalationReason is { } reason ? EscalationReasonLabel(reason) : "Not selected")}. Reason: {_escalationReasonText?.Trim()}";
        }
        else if (action == OperationsWorkAction.ResolveEscalation)
        {
            message += $" Resolution summary: {_resolutionSummary?.Trim()}. Reason: {_resolutionReason?.Trim()}";
        }

        return $"{message} Confirm submits this request.";
    }

