    private static string HistoryLabel(WorkHistoryEntry entry)
    {
        var timeZone = entry.LocalTimeZoneId is null
            ? null
            : TimeZones.FirstOrDefault(zone => string.Equals(zone.Id, entry.LocalTimeZoneId, StringComparison.Ordinal));

        if (entry.Action == OperationsWorkAction.RequestAssistance && entry.AssistanceNeed is { } requestedNeed)
        {
            return $"Assistance requested: {AssistanceNeedLabel(requestedNeed)}";
        }

        if (entry.Action == OperationsWorkAction.RecordAssistanceProvided && entry.AssistanceNeed is { } providedNeed)
        {
            return $"Assistance provided: {AssistanceNeedLabel(providedNeed)}";
        }

        if (entry.Action == OperationsWorkAction.RecordAssistanceUnmet && entry.AssistanceNeed is { } unmetNeed)
        {
            return $"Assistance need remains unmet: {AssistanceNeedLabel(unmetNeed)}";
        }

        if (entry.Action == OperationsWorkAction.ConfirmAssistanceReceived && entry.AssistanceReceiptConfirmed)
        {
            return "Assistance receipt confirmed";
        }

        if (entry.Action == OperationsWorkAction.RecordFollowUpOutcome && entry.FollowUpOutcome is { } outcome)
        {
            return $"Follow-up outcome: {FollowUpOutcomeLabel(outcome)}";
        }

        if (entry.Action == OperationsWorkAction.ScheduleFollowUp && entry.DueAtUtc is { } scheduledDue)
        {
            return $"Follow-up scheduled for {HistoryDueLabel(scheduledDue, timeZone, entry.LocalOffset)}";
        }

        if (entry.Action == OperationsWorkAction.RescheduleFollowUp && entry.DueAtUtc is { } oldDue && entry.NewDueAtUtc is { } newDue)
        {
            return $"Follow-up changed from {HistoryDueLabel(oldDue, timeZone, null)} to {HistoryDueLabel(newDue, timeZone, entry.LocalOffset)}";
        }

        if (entry.Action == OperationsWorkAction.CancelFollowUp && !string.IsNullOrWhiteSpace(entry.CancellationReason))
        {
            var previousDue = entry.DueAtUtc is { } cancelledDue ? $" (was due {HistoryDueLabel(cancelledDue, timeZone, null)})" : string.Empty;
            return $"Follow-up cancelled{previousDue}: {entry.CancellationReason}";
        }

        if (entry.Action == OperationsWorkAction.RequestEscalation && !string.IsNullOrWhiteSpace(entry.Reason))
        {
            var category = entry.EscalationReason is { } reason ? $"{EscalationReasonLabel(reason)}. " : string.Empty;
            return $"Escalation requested: {category}{entry.Reason}";
        }

        if (entry.Action == OperationsWorkAction.RecordEscalationAction && entry.EscalationAction is { } escalationAction)
        {
            return EscalationActionLabel(escalationAction);
        }

        if (entry.Action == OperationsWorkAction.ResolveEscalation)
        {
            var details = new[] { entry.ResolutionSummary, entry.Reason }.Where(value => !string.IsNullOrWhiteSpace(value));
            if (details.Any())
            {
                return $"Escalation resolved: {string.Join(" · ", details)}";
            }
        }

        return ActionLabel(entry.Action);
    }

    private static string HistoryDueLabel(DateTimeOffset dueAtUtc, TimeZoneInfo? timeZone, TimeSpan? offset) =>
        timeZone is null
            ? dueAtUtc.ToUniversalTime().ToString("g") + " UTC"
            : $"{FormatInTimeZone(dueAtUtc, timeZone)} {OffsetLabel(offset ?? TimeZoneInfo.ConvertTime(dueAtUtc, timeZone).Offset)} ({timeZone.DisplayName})";

