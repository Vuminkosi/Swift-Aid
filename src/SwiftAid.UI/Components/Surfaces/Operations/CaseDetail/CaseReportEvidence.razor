@using SwiftAid.Contracts.Cases

<section class="case-report-evidence" aria-label="Original report and observations">
    <h2>Reported observations</h2>
    @if (Report is not null)
    {
        @if (!string.IsNullOrWhiteSpace(Report.Narrative))
        {
            <h3>Report narrative</h3>
            <p class="case-report-evidence__text">@Report.Narrative</p>
        }
        @if (Report.Observations.Count == 0)
        {
            <p>No separate observations were recorded.</p>
        }
        else
        {
            <ul>
                @foreach (var observation in Report.Observations)
                {
                    <li class="case-report-evidence__text">@observation</li>
                }
            </ul>
        }
        <small>Recorded evidence · report revision @Report.ReportRevision</small>
        <section aria-label="Nearby medical facilities">
            <h3>Nearest clinic and hospital</h3>
            @if (Report.NearbyFacilities is { } nearby)
            {
                <dl>
                    @foreach (var entry in new[] { (Label: "Clinic", Facility: nearby.Clinic), (Label: "Hospital", Facility: nearby.Hospital) })
                    {
                        <dt>@entry.Label</dt>
                        <dd>
                            @if (entry.Facility is { } facility)
                            {
                                <a href="@facility.MapUrl" target="_blank" rel="noopener noreferrer">@facility.Name ↗</a>
                                <span> · @facility.DistanceKilometres.ToString("N1") km away</span>
                            }
                            else { <span>No mapped @entry.Label.ToLowerInvariant() available in this country.</span> }
                        </dd>
                    }
                </dl>
                @if (nearby.LocalityCentre is { } locality)
                {
                    <small>Approximate straight-line distances from the mapped centre of @locality, not the exact report location or road distances.</small>
                }
                else
                {
                    <small>Straight-line distances from the @(nearby.ApproximateLocation ? "approximate " : "")reported location, not road distances.</small>
                }
                <small>Nearest among mapped facilities; services are not verified.</small>
                @if (nearby.LocationAccuracyMetres is { } accuracy)
                {
                    <small>Reported location accuracy: @accuracy.ToString("N0") m.</small>
                }
            }
            else
            {
                <p>Distances unavailable: no usable report coordinates or uniquely matched locality centre.</p>
            }
        </section>
    }
    else
    {
        <p role="status">@(Loading ? "Loading reported observations…" : "Reported observations could not be loaded.")</p>
        @if (!Loading) { <MudButton OnClick="OnRetry" Size="Size.Small">Try again</MudButton> }
    }
</section>

@code {
    [Parameter] public CaseReportDetails? Report { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
}
