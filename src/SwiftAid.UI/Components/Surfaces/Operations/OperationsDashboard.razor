    private bool IsPartial => Overview?.Completeness == DashboardCompletenessView.Partial;
    private DashboardFreshnessView EvaluateFreshness()
    {
        if (Overview is null || Overview.Freshness == DashboardFreshnessView.Unknown || !Overview.FreshnessExpiresAtUtc.HasValue)
            return DashboardFreshnessView.Unknown;

        return Overview.Freshness == DashboardFreshnessView.Stale ||
            Overview.FreshnessExpiresAtUtc.Value <= DateTimeOffset.UtcNow
            ? DashboardFreshnessView.Stale
            : DashboardFreshnessView.Current;
    }

