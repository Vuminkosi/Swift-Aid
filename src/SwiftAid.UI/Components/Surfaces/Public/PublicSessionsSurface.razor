        if (QuerySessionsAsync is not null && !_queryInitialized && !Loading && ErrorMessage is null)
        {
            _queryInitialized = true;
            if (InitialCalendarView)
                await ShowCalendarAsync();
            else
                await RefreshQueryAsync();
        }

        EnsureSelectedSession();
        if (InitialRemindersView && !_initialRemindersApplied && InitialSessionId is { } requestedId &&
            SelectedSession?.SessionId == requestedId)
        {
            _activeTabIndex = 1;
            _initialRemindersApplied = true;
        }
        await EnsureSubscriptionForSelectionAsync();
    }

