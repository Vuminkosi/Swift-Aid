<MudPaper Class="password-reset-requested pa-5" Elevation="0">
    <div class="password-reset-requested__icon" aria-hidden="true">
        <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Large" />
    </div>
    <SwiftAidPageHeading Eyebrow="Password recovery"
                         Title="Check your inbox"
                         Description="If an account matches the address, reset instructions will be sent."
                         HeadingId="password-reset-requested-heading" />

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert" aria-atomic="true">
            @ErrorMessage
        </MudAlert>
    }

    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true"
               OnClick="OnResend" Disabled="@IsBusy">
        @(IsBusy ? "Sending…" : "Resend instructions")
    </MudButton>
    <MudButton Href="/sign-in" Variant="Variant.Text" Color="Color.Primary" FullWidth="true">
        Return to sign in
    </MudButton>
</MudPaper>

@code {
    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback OnResend { get; set; }
}
