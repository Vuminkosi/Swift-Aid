@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<a class="swiftaid-app-shell__skip-link" href="@SkipLinkHref" data-enhance-nav="false">Skip to main content</a>

<div class="swiftaid-app-shell @(ShowAppChrome ? null : HiddenChromeClass)">
    @if (ShowAppChrome)
    {
        <aside class="swiftaid-app-shell__sidebar" aria-label="SwiftAid workspace">
            <a class="swiftaid-app-shell__brand" href="@HomeHref">
                @if (BrandMark is not null)
                {
                    @BrandMark
                }
                else
                {
                    <img class="swiftaid-app-shell__brand-mark" src="_content/SwiftAid.UI/assets/swiftaid-icon.png" alt="" />
                }
                <span>@BrandName</span>
            </a>
            @if (DesktopNavigation is not null)
            {
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <nav class="swiftaid-app-shell__desktop-nav" aria-label="Primary navigation">
                        @DesktopNavigation
                    </nav>
                </MudHidden>
            }
        </aside>
    }

    <div class="swiftaid-app-shell__workspace">
        @if (ShowAppChrome)
        {
            <header class="swiftaid-app-shell__header">
                <MudHidden Breakpoint="Breakpoint.MdAndDown" Invert="true">
                    <a class="swiftaid-app-shell__mobile-brand" href="@HomeHref" aria-label="@BrandName">
                        @if (BrandMark is not null)
                        {
                            @BrandMark
                        }
                        else
                        {
                            <img class="swiftaid-app-shell__brand-mark" src="_content/SwiftAid.UI/assets/swiftaid-icon.png" alt="" />
                        }
                        <span>@BrandName</span>
                    </a>
                </MudHidden>
                <div class="swiftaid-app-shell__header-actions">
                    @HeaderActions
                </div>
            </header>
        }

        <main @ref="_mainContent" class="swiftaid-app-shell__main @ContentClass" id="@MainContentId" tabindex="-1"
              aria-label="@(string.IsNullOrWhiteSpace(PageLabel) ? null : PageLabel)">
            @ChildContent
        </main>
    </div>

    @if (ShowAppChrome && MobileNavigation is not null)
    {
        <MudHidden Breakpoint="Breakpoint.MdAndDown" Invert="true">
            <nav class="swiftaid-app-shell__mobile-nav" aria-label="Primary navigation">
                @MobileNavigation
            </nav>
        </MudHidden>
    }
</div>

@code {
    [Parameter]
    public string BrandName { get; set; } = "SwiftAid";

    [Parameter]
    public string HomeHref { get; set; } = "/";

    [Parameter]
    public RenderFragment? BrandMark { get; set; }

    [Parameter]
    public string? PageLabel { get; set; }

    [Parameter]
    public string MainContentId { get; set; } = "main-content";

    [Parameter]
    public string? ContentClass { get; set; }

    [Parameter]
    public bool ShowAppChrome { get; set; } = true;

    [Parameter]
    public string HiddenChromeClass { get; set; } = "swiftaid-app-shell--focused";

    [Parameter]
    public RenderFragment? DesktopNavigation { get; set; }

    [Parameter]
    public RenderFragment? MobileNavigation { get; set; }

    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private ElementReference _mainContent;
    private IJSObjectReference? _module;

    private string SkipLinkHref
    {
        get
        {
            var current = new Uri(Navigation.Uri, UriKind.Absolute);
            return $"{current.AbsolutePath}{current.Query}#{Uri.EscapeDataString(MainContentId)}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var modulePath = Navigation.ToAbsoluteUri("_content/SwiftAid.UI/js/swiftaid-shell.js").ToString();
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", modulePath);
            await _module.InvokeVoidAsync("attachSkipLinkFocus", _mainContent);
        }
        catch (Exception)
        {
            // The same-page anchor remains usable when the optional helper cannot load.
            await DisposeModuleAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detachSkipLinkFocus");
            }
            catch (Exception)
            {
                // The optional focus helper may already be disconnected.
            }

            await DisposeModuleAsync();
        }
    }

    private async Task DisposeModuleAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (Exception)
        {
            // Disposing the optional focus helper must not disrupt navigation.
        }
        finally
        {
            _module = null;
        }
    }
}
