@using SwiftAid.UI.Components.Surfaces.Account

@if (Snapshot.ViewState == ChangePasswordViewState.Loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading security settings" />
}
else if (Snapshot.ViewState == ChangePasswordViewState.SignedOut)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">
        Sign in to change your password.
    </MudAlert>
    <MudButton Href="/sign-in" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Login">
        Sign in
    </MudButton>
}
else if (Snapshot.ViewState == ChangePasswordViewState.Unavailable)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert">
        @(Snapshot.StatusMessage ?? "Password changes are temporarily unavailable.")
    </MudAlert>
    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="OnRefresh"
               StartIcon="@Icons.Material.Filled.Refresh">
        Retry
    </MudButton>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Snapshot.StatusMessage))
    {
        <MudAlert Severity="@(Snapshot.StatusIsError ? Severity.Warning : Severity.Success)"
                  Variant="Variant.Outlined" role="@(Snapshot.StatusIsError ? "alert" : "status")">
            @Snapshot.StatusMessage
        </MudAlert>
    }
    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <MudText Typo="Typo.subtitle1">Change password</MudText>
        <MudTextField T="string" Label="Current password" @bind-Value="_currentPassword"
                      Variant="Variant.Outlined" Required="true" Disabled="@Snapshot.IsSaving"
                      InputType="@(_showCurrent ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End" AdornmentIcon="@(_showCurrent ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="() => _showCurrent = !_showCurrent"
                      Immediate="true" MaxLength="256" autocomplete="current-password"
                      aria-label="Current password" />
        <MudTextField T="string" Label="New password" @bind-Value="_newPassword"
                      Variant="Variant.Outlined" Required="true" Disabled="@Snapshot.IsSaving"
                      InputType="@(_showNew ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End" AdornmentIcon="@(_showNew ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="() => _showNew = !_showNew"
                      Immediate="true" MaxLength="256" autocomplete="new-password"
                      aria-label="New password" />
        <MudTextField T="string" Label="Confirm new password" @bind-Value="_confirmPassword"
                      Variant="Variant.Outlined" Required="true" Disabled="@Snapshot.IsSaving"
                      InputType="InputType.Password" Immediate="true" MaxLength="256"
                      autocomplete="new-password" aria-label="Confirm new password" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync"
                   Disabled="@(!CanSave)" StartIcon="@Icons.Material.Filled.Save"
                   Class="auth-cta">
            @(Snapshot.IsSaving ? "Saving…" : "Change password")
        </MudButton>
    </MudPaper>
}

@code {
    [Parameter] public ChangePasswordSnapshot Snapshot { get; set; } = ChangePasswordSnapshot.Loading;

    [Parameter] public EventCallback OnRefresh { get; set; }

    [Parameter] public EventCallback<ChangePasswordRequest> OnSave { get; set; }

    private string? _currentPassword;
    private string? _newPassword;
    private string? _confirmPassword;
    private bool _showCurrent;
    private bool _showNew;

    private bool CanSave =>
        Snapshot.ViewState == ChangePasswordViewState.Ready &&
        !Snapshot.IsSaving &&
        !string.IsNullOrWhiteSpace(_currentPassword) &&
        !string.IsNullOrWhiteSpace(_newPassword);

    private Task SaveAsync() => OnSave.InvokeAsync(new ChangePasswordRequest(
        _currentPassword,
        string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal) ? _newPassword : null));
}
