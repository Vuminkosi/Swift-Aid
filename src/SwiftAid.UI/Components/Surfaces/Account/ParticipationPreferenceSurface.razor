@using Microsoft.JSInterop
@using SwiftAid.UI.Components.Surfaces.Account
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Snapshot.ViewState == ParticipationPreferenceViewState.Loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading participation choices" />
}
else if (Snapshot.ViewState == ParticipationPreferenceViewState.SignedOut)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">
        @(Snapshot.StatusMessage ?? "Sign in to choose how you participate.")
    </MudAlert>
    <MudButton Href="/sign-in" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Login">
        Sign in
    </MudButton>
}
else if (Snapshot.ViewState == ParticipationPreferenceViewState.Unavailable)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert">
        @(Snapshot.StatusMessage ?? "Participation choices are temporarily unavailable.")
    </MudAlert>
    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="OnRefresh"
               StartIcon="@Icons.Material.Filled.Refresh">
        Retry
    </MudButton>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_savedMessage))
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" role="status">
            @_savedMessage
        </MudAlert>
    }
    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <MudText Typo="Typo.subtitle1">What best describes you?</MudText>
        <MudText Typo="Typo.body2">Personalize your experience.</MudText>
        <div role="group" aria-label="Choose how you participate">
            @foreach (var option in ParticipationPreferenceSnapshot.Options)
            {
                <MudButton Variant="@(_selectedKey == option.Key ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary" FullWidth="true" Class="mb-2"
                           aria-pressed="@(_selectedKey == option.Key)"
                           OnClick="() => SelectAsync(option.Key)">
                    <div class="d-flex flex-column align-start">
                        <MudText Typo="Typo.body1"><strong>@option.Title</strong></MudText>
                        <MudText Typo="Typo.caption">@option.Description</MudText>
                    </div>
                </MudButton>
            }
        </div>
        <MudText Typo="Typo.caption">
            Your choice only personalizes your experience. It never grants clinical,
            administrative, or case-access permissions. Those come only from an
            approved organization membership.
        </MudText>
        <MudText Typo="Typo.caption">Stored on this device only. It is not proof of membership and does not unlock staff tools.</MudText>
    </MudPaper>
    @if (Snapshot.HasActiveMembership)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" role="status">
            You have authorized access through an approved membership. Your choice above does not change it.
        </MudAlert>
        @if (!string.IsNullOrWhiteSpace(OrganizationsHref))
        {
            <MudButton Href="@OrganizationsHref" Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Groups">
                View your access
            </MudButton>
        }
    }
    else if (Snapshot.HasPendingRequest)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">
            Your membership request is still pending. You can continue with public and member features meanwhile.
        </MudAlert>
        @if (!string.IsNullOrWhiteSpace(OrganizationsHref))
        {
            <MudButton Href="@OrganizationsHref" Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Groups">
                View request status
            </MudButton>
        }
    }
    else if (!string.IsNullOrWhiteSpace(OrganizationsHref))
    {
        <MudButton Href="@OrganizationsHref" Variant="Variant.Text" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Groups">
            Join an organization
        </MudButton>
    }
}

@code {
    [Parameter] public ParticipationPreferenceSnapshot Snapshot { get; set; } = ParticipationPreferenceSnapshot.Loading;

    [Parameter] public EventCallback OnRefresh { get; set; }

    /// <summary>
    /// Optional deep link to organizations. When null or empty the membership
    /// call-to-action buttons are omitted so hosts without that route stay clean.
    /// </summary>
    [Parameter] public string? OrganizationsHref { get; set; }

    private IJSObjectReference? _module;
    private string? _selectedKey;
    private string? _savedMessage;
    private bool _loaded;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/SwiftAid.UI/js/participation-preference.js");
            var stored = await _module.InvokeAsync<string>("getParticipation");
            _selectedKey = ParticipationPreferenceSnapshot.IsKnownKey(stored) ? stored : Snapshot.SelectedKey;
            _loaded = true;
            StateHasChanged();
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task SelectAsync(string key)
    {
        _selectedKey = key;
        _savedMessage = null;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeAsync<string>("setParticipation", key);
                _savedMessage = "Saved on this device.";
                return;
            }
            catch (JSException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }

        _savedMessage = _loaded
            ? "Saved on this device."
            : "Your choice is selected for this session.";
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        GC.SuppressFinalize(this);
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }
    }
}
