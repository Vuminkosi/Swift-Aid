@using SwiftAid.Contracts.Ellai
@implements IEllaiUiContextProvider
<SwiftAid.UI.Ellai.Guidance.EllaiSemanticContext Provider="this" />
@using SwiftAid.UI.Components.Surfaces.Account
@using SwiftAid.UI.Components.Theme

<ErrorBoundary @ref="_boundary">
    <ChildContent>
        <div class="organizations-surface" data-ellai-control="organizations.overview" data-bonboarding-anchor="ellai-organizations-overview">
@if (Snapshot.ViewState == OrganizationsViewState.Loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading your workspaces" />
}
else if (Snapshot.ViewState == OrganizationsViewState.SignedOut)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">
        Sign in to view your workspaces.
    </MudAlert>
    <MudButton Href="/sign-in" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Login" Class="auth-cta">
        Sign in
    </MudButton>
}
else if (Snapshot.ViewState == OrganizationsViewState.Unavailable && Snapshot.Memberships.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert">
        @(Snapshot.StatusMessage ?? "Your workspaces are temporarily unavailable.")
    </MudAlert>
    <MudButton Variant="Variant.Text" Color="Color.Primary" data-ellai-control="organizations.refresh" data-bonboarding-anchor="ellai-organizations-refresh" OnClick="OnRefresh"
               StartIcon="@Icons.Material.Filled.Refresh" Class="auth-cta">
        Retry
    </MudButton>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Snapshot.StatusMessage))
    {
        <MudAlert Severity="@(Snapshot.StatusIsError ? Severity.Warning : Severity.Success)"
                  Variant="Variant.Outlined" role="@(Snapshot.StatusIsError ? "alert" : "status")">
            @Snapshot.StatusMessage
        </MudAlert>
    }
    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <MudText data-ellai-control="organizations.memberships" data-bonboarding-anchor="ellai-organizations-memberships" Typo="Typo.subtitle1">Your workspaces</MudText>
        @if (Snapshot.Memberships.Count == 0)
        {
            <MudText Typo="Typo.body2">No workspaces yet. If you join one, it will appear here.</MudText>
        }
        @foreach (var membership in Snapshot.Memberships)
        {
            <MudPaper Class="pa-3 mb-2" Elevation="0" Outlined="true">
                <MudText Typo="Typo.subtitle2">@membership.OrganizationId</MudText>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@membership.MembershipStatus</MudChip>
                    @foreach (var workspace in membership.WorkspaceIds)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@workspace</MudChip>
                    }
                </MudStack>
                <MudText Typo="Typo.caption">Workspace access comes from verified organizational grants.</MudText>
            </MudPaper>
        }
    </MudPaper>
    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <MudText Typo="Typo.subtitle1">Join an organization</MudText>
        <MudTextField T="string" Label="Search organizations" data-ellai-control="organizations.search" data-bonboarding-anchor="ellai-organizations-search" Value="@_search" ValueChanged="SearchChangedAsync"
                      Variant="Variant.Outlined" Immediate="true" DebounceInterval="400" Clearable="true"
                      Disabled="@Snapshot.IsSaving" aria-label="Search organizations" />
        @if (Snapshot.Directory.Count > 0)
        {
            <div data-ellai-control="organizations.directory" data-bonboarding-anchor="ellai-organizations-directory">
            @foreach (var option in Snapshot.Directory)
            {
                <SwiftAidSettingsRow @key="option.OrganizationId"
                                     Title="@option.OrganizationId"
                                     Description="@option.Status"
                                     Icon="@Icons.Material.Outlined.Groups">
                    <Trailing>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@Snapshot.IsSaving"
                                   OnClick="@(() => RequestAsync(option.OrganizationId))" Class="auth-cta">
                            Request access
                        </MudButton>
                    </Trailing>
                </SwiftAidSettingsRow>
            }
            </div>
        }
        @if (Snapshot.Requests.Count > 0)
        {
            <MudText data-ellai-control="organizations.requests" data-bonboarding-anchor="ellai-organizations-requests" Typo="Typo.subtitle2">Your requests</MudText>
            @foreach (var request in Snapshot.Requests)
            {
                <MudText Typo="Typo.body2">@request.OrganizationId — @request.Status</MudText>
            }
        }
    </MudPaper>
    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <MudText Typo="Typo.subtitle1">Create an organization</MudText>
        <MudText Typo="Typo.body2">Start a new workspace. You become its first member and can invite others.</MudText>
        <MudTextField T="string" Label="Organization id" data-ellai-control="organizations.create-name" data-bonboarding-anchor="ellai-organizations-create-name" Value="@_createOrganizationId" ValueChanged="CreateIdChanged"
                      Variant="Variant.Outlined" Disabled="@Snapshot.IsSaving" aria-label="New organization id" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@Snapshot.IsSaving"
                   data-ellai-control="organizations.create" data-bonboarding-anchor="ellai-organizations-create" OnClick="CreateAsync" StartIcon="@Icons.Material.Filled.Add" Class="auth-cta">
            Create organization
        </MudButton>
    </MudPaper>
    <MudPaper Class="pa-4 mb-4" Elevation="0">
        <MudText Typo="Typo.subtitle1">Enter invitation code</MudText>
        <MudText Typo="Typo.body2">If your organization gave you a code, enter it to request access.</MudText>
        <MudTextField T="string" Label="Invitation code" data-ellai-control="organizations.invitation-code" data-bonboarding-anchor="ellai-organizations-invitation-code" Value="@_code" ValueChanged="CodeChanged"
                      Variant="Variant.Outlined" Disabled="@Snapshot.IsSaving" aria-label="Invitation code" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@Snapshot.IsSaving"
                   data-ellai-control="organizations.redeem" data-bonboarding-anchor="ellai-organizations-redeem" OnClick="RedeemAsync" StartIcon="@Icons.Material.Filled.ConfirmationNumber" Class="auth-cta">
            Redeem code
        </MudButton>
    </MudPaper>
    @if (Snapshot.Memberships.Any(IsStaffMember))
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0">
            <MudText Typo="Typo.subtitle1">Issue invitation codes</MudText>
            <MudText Typo="Typo.body2">Workspace staff can create codes for their organization. A new code is shown once — save it before sharing.</MudText>
            <MudSelect T="string" Label="Organization" data-ellai-control="organizations.issue-organization" data-bonboarding-anchor="ellai-organizations-issue-organization" Value="@_issueOrganizationId" ValueChanged="IssueOrganizationChanged"
                       Variant="Variant.Outlined" Disabled="@Snapshot.IsSaving" aria-label="Organization to invite to">
                @foreach (var entry in Snapshot.Memberships.Where(IsStaffMember))
                {
                    <MudSelectItem Value="@entry.OrganizationId">@entry.OrganizationId</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField T="int" Label="Maximum uses" data-ellai-control="organizations.issue-uses" data-bonboarding-anchor="ellai-organizations-issue-uses" Value="@_issueMaxUses" ValueChanged="IssueMaxUsesChanged"
                             Min="1" Max="100" Variant="Variant.Outlined" Disabled="@Snapshot.IsSaving" />
            <MudNumericField T="int" Label="Valid for (days)" data-ellai-control="organizations.issue-days" data-bonboarding-anchor="ellai-organizations-issue-days" Value="@_issueValidDays" ValueChanged="IssueValidDaysChanged"
                             Min="1" Max="365" Variant="Variant.Outlined" Disabled="@Snapshot.IsSaving" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@Snapshot.IsSaving"
                       data-ellai-control="organizations.issue" data-bonboarding-anchor="ellai-organizations-issue" OnClick="IssueAsync" StartIcon="@Icons.Material.Filled.Add" Class="auth-cta">
                Create invitation code
            </MudButton>
            @if (Snapshot.IssuedInvitation is not null)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" role="status">
                    New code for @Snapshot.IssuedInvitation.OrganizationId:
                    <strong>@Snapshot.IssuedInvitation.Code</strong>.
                    Save it now — it is shown only once.
                </MudAlert>
            }
        </MudPaper>
    }
}
        </div>
    </ChildContent>
    <ErrorContent>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert">
            Workspaces failed to load. Your access is unchanged.
        </MudAlert>
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="RecoverAsync" Class="auth-cta"
                   StartIcon="@Icons.Material.Filled.Refresh">
            Retry
        </MudButton>
    </ErrorContent>
</ErrorBoundary>

@code {
    public string ComponentId => EllaiOrganizationUiManifest.Definition.ComponentId;
    public EllaiUiManifest Describe() => EllaiOrganizationUiManifest.Definition;
    public EllaiUiState GetState() => new(ComponentId, Snapshot.ViewState == OrganizationsViewState.Loading, Snapshot.StatusIsError,
        EllaiOrganizationUiManifest.Controls.Select(control => new UiControlState(control.ControlId, SemanticState(control.ControlId))).ToArray());
    private UiObservationState SemanticState(string id)
    {
        if (id == "organizations.overview") return UiObservationState.Ready;
        var unavailable = Snapshot.ViewState == OrganizationsViewState.Unavailable && Snapshot.Memberships.Count == 0;
        if (id == "organizations.refresh") return unavailable ? UiObservationState.Ready : UiObservationState.Unmounted;
        if (Snapshot.ViewState is OrganizationsViewState.Loading or OrganizationsViewState.SignedOut || unavailable)
            return UiObservationState.Unmounted;
        if (id == "organizations.directory") return Snapshot.Directory.Count == 0 ? UiObservationState.Unmounted :
            Snapshot.IsSaving ? UiObservationState.Disabled : UiObservationState.Ready;
        if (id == "organizations.requests") return Snapshot.Requests.Count > 0 ? UiObservationState.Ready : UiObservationState.Unmounted;
        if (id.StartsWith("organizations.issue", StringComparison.Ordinal) && !Snapshot.Memberships.Any(IsStaffMember))
            return UiObservationState.Unmounted;
        return id == "organizations.memberships" || !Snapshot.IsSaving ? UiObservationState.Ready : UiObservationState.Disabled;
    }


    [Parameter] public OrganizationsSnapshot Snapshot { get; set; } = OrganizationsSnapshot.Loading;

    [Parameter] public EventCallback OnRefresh { get; set; }

    [Parameter] public EventCallback<string?> OnSearch { get; set; }

    [Parameter] public EventCallback<MembershipJoinRequest> OnRequest { get; set; }

    [Parameter] public EventCallback<string> OnRedeem { get; set; }

    [Parameter] public EventCallback<InvitationIssueRequest> OnIssue { get; set; }

    [Parameter] public EventCallback<string> OnCreate { get; set; }

    private string? _search;

    private string? _code;

    private string? _createOrganizationId;

    private string? _issueOrganizationId;

    private int _issueMaxUses = 5;

    private int _issueValidDays = 30;

    private static bool IsStaffMember(MembershipSnapshot entry) =>
        string.Equals(entry.MembershipStatus, "Active", StringComparison.Ordinal) &&
        entry.WorkspaceIds.Count > 0;

    protected override void OnParametersSet()
    {
        if (Snapshot is null)
        {
            _issueOrganizationId = null;
            return;
        }

        if (string.IsNullOrWhiteSpace(_issueOrganizationId))
        {
            _issueOrganizationId = Snapshot.Memberships
                .Where(IsStaffMember)
                .Select(entry => entry.OrganizationId)
                .FirstOrDefault();
        }
    }

    private void CodeChanged(string value) => _code = value;

    private void CreateIdChanged(string value) => _createOrganizationId = value;

    private Task CreateAsync() => OnCreate.InvokeAsync(_createOrganizationId);

    private Task RedeemAsync() => OnRedeem.InvokeAsync(_code);

    private void IssueOrganizationChanged(string value) => _issueOrganizationId = value;

    private void IssueMaxUsesChanged(int value) => _issueMaxUses = Math.Clamp(value, 1, 100);

    private void IssueValidDaysChanged(int value) => _issueValidDays = Math.Clamp(value, 1, 365);

    private Task IssueAsync()
    {
        var expiresAtUtc = DateTimeOffset.UtcNow.AddDays(_issueValidDays);
        return OnIssue.InvokeAsync(new InvitationIssueRequest(_issueOrganizationId ?? string.Empty, _issueMaxUses, expiresAtUtc));
    }

    private Task SearchChangedAsync(string value)
    {
        _search = value;
        return OnSearch.InvokeAsync(value);
    }

    private Task RequestAsync(string organizationId) =>
        OnRequest.InvokeAsync(new MembershipJoinRequest(organizationId, null));

    private ErrorBoundary? _boundary;

    private async Task RecoverAsync()
    {
        _boundary?.Recover();
        await OnRefresh.InvokeAsync();
    }


}
