<div class="swiftaid-page-heading">
    @if (!string.IsNullOrWhiteSpace(Eyebrow))
    {
        <MudText Typo="Typo.overline" Class="swiftaid-page-heading__eyebrow">@Eyebrow</MudText>
    }

    <MudText Typo="Typo.h3" HtmlTag="h1" id="@HeadingId" Class="swiftaid-page-heading__title">
        @Title
    </MudText>

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <MudText Typo="Typo.body1" Class="swiftaid-page-heading__description">
            @Description
        </MudText>
    }

    @if (Actions is not null)
    {
        <div class="swiftaid-page-heading__actions">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? HeadingId { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
