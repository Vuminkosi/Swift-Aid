@using SwiftAid.Contracts.Cases

<section class="case-queue" aria-label="My assigned cases">
    @if (_loading)
    {
        <div class="case-queue__state" role="status" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" aria-label="Loading assigned cases" />
            <MudText Typo="Typo.body2">Loading your cases…</MudText>
        </div>
    }
    else if (_denied)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="status">
            Your account cannot show assigned cases right now.
        </MudAlert>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert">
            @_error
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh" Color="Color.Error" OnClick="RefreshAsync" aria-label="Retry loading assigned cases">Retry</MudButton>
        </MudAlert>
    }
    else if (_items.Count == 0)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" role="status">
            No assigned cases yet.
        </MudAlert>
    }
    else
    {
        <MudHidden Breakpoint="Breakpoint.MdAndDown" Invert="true">
            <div class="case-queue__list" role="list" aria-label="Assigned cases">
                @foreach (var item in _items)
                {
                    <MudPaper Outlined="true" Class="case-queue__item" role="listitem">
                        <MudLink Href="@($"/case/{item.CaseId:D}")" aria-label="@($"Open {DisplayWorkflow(item.Workflow)} case from {item.CountryCode}, updated {item.UpdatedAtUtc.ToLocalTime():g}")">Open case</MudLink>
                        <MudChip T="string" Size="Size.Small" Color="@WorkflowColor(item.Workflow)">@DisplayWorkflow(item.Workflow)</MudChip>
                        <MudText Typo="Typo.body2">Country: @item.CountryCode</MudText>
                        <MudText Typo="Typo.body2">Updated: @item.UpdatedAtUtc.ToLocalTime().ToString("g")</MudText>
                    </MudPaper>
                }
            </div>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.MdAndDown">
        <MudTable Items="_items" Hover="true" Dense="true" aria-label="Assigned cases">
            <HeaderContent>
                <MudTh>Case</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Country</MudTh>
                <MudTh>Updated</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Case">
                    <MudLink Href="@($"/case/{context.CaseId:D}")"
                             aria-label="@($"Open {DisplayWorkflow(context.Workflow)} case from {context.CountryCode}, updated {context.UpdatedAtUtc.ToLocalTime():g}")">
                        Open case
                    </MudLink>
                </MudTd>
                <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@WorkflowColor(context.Workflow)">@DisplayWorkflow(context.Workflow)</MudChip></MudTd>
                <MudTd DataLabel="Country">@context.CountryCode</MudTd>
                <MudTd DataLabel="Updated">@context.UpdatedAtUtc.ToLocalTime().ToString("g")</MudTd>
            </RowTemplate>
        </MudTable>
        </MudHidden>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="case-queue__notice">
            Newest activity first. Only cases assigned to you and available to view appear here.
        </MudText>
    }
</section>

@code {
    [Parameter, EditorRequired] public ICaseQueueClient Client { get; set; } = null!;

    [Parameter] public int? Limit { get; set; }

    private static string DisplayWorkflow(string? workflow) => workflow?.Trim() switch
    {
        "Open" => "Open",
        "Under review" or "UnderReview" => "Under review",
        "Resolved" => "Resolved",
        "Follow-up due" or "AwaitingFollowUp" => "Follow-up due",
        _ => "In progress"
    };

    private static Color WorkflowColor(string? workflow) => DisplayWorkflow(workflow) switch
    {
        "Resolved" => Color.Success,
        "Follow-up due" => Color.Warning,
        "Open" => Color.Primary,
        _ => Color.Default
    };

    private IReadOnlyList<CaseQueueItem> _items = Array.Empty<CaseQueueItem>();
    private bool _loading = true;
    private bool _denied;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (Client is null)
        {
            _error = "The case service is not available.";
            _loading = false;
            return;
        }

        await RefreshAsync();
    }

    /// <summary>Reloads the officer queue; called by hosting pages after commands change ownership.</summary>
    public async Task RefreshAsync()
    {
        if (Client is null)
        {
            return;
        }

        _loading = true;
        _denied = false;
        _error = null;
        _items = Array.Empty<CaseQueueItem>();
        StateHasChanged();

        try
        {
            var result = await Client.GetMineAsync(Limit);
            if (result.Access == CaseQueueAccess.Denied)
            {
                _denied = true;
            }
            else if (result.Access == CaseQueueAccess.Unavailable)
            {
                _error = "Your cases are temporarily unavailable. Check your connection and try again.";
            }
            else
            {
                _items = result.Items;
            }
        }
        catch (Exception)
        {
            _error = "Your cases are temporarily unavailable. Check your connection and try again.";
        }
        finally
        {
            _loading = false;
        }
    }

}
