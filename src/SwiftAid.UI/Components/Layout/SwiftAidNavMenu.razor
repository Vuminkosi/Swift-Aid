@using SwiftAid.Contracts.Ellai
@implements IEllaiUiContextProvider

<SwiftAid.UI.Ellai.Guidance.EllaiSemanticContext Provider="this" />
<MudNavMenu Class="swiftaid-nav-menu">
    @foreach (var destination in EllaiNavigationManifest.Destinations.Where(item => item.Group == "Main"))
    {
        <MudNavLink @key="destination.Id" Href="@destination.Route" Match="NavLinkMatch.Prefix" Icon="@NavigationIcon(destination.Id)"
                    data-ellai-control="@destination.ControlId" data-bonboarding-anchor="@destination.Anchor">@destination.Label</MudNavLink>
    }
    <MudNavGroup Title="Workspace" Icon="@Icons.Material.Filled.Work" Expanded="false">
        @foreach (var destination in EllaiNavigationManifest.Destinations.Where(item => item.Group == "Workspace"))
        {
            <MudNavLink @key="destination.Id" Href="@destination.Route" Match="NavLinkMatch.Prefix" Icon="@NavigationIcon(destination.Id)"
                        data-ellai-control="@destination.ControlId" data-bonboarding-anchor="@destination.Anchor">@destination.Label</MudNavLink>
        }
    </MudNavGroup>
    @foreach (var destination in EllaiNavigationManifest.Destinations.Where(item => item.Group == "Secondary"))
    {
        <MudNavLink @key="destination.Id" Href="@destination.Route" Match="NavLinkMatch.Prefix" Icon="@NavigationIcon(destination.Id)"
                    data-ellai-control="@destination.ControlId" data-bonboarding-anchor="@destination.Anchor">@destination.Label</MudNavLink>
    }
</MudNavMenu>

@code {
    public string ComponentId => EllaiNavigationManifest.Definition.ComponentId;
    public EllaiUiManifest Describe() => EllaiNavigationManifest.Definition;
    public EllaiUiState GetState() => new(ComponentId, false, false,
        EllaiNavigationManifest.Controls.Select(control => new UiControlState(control.ControlId, UiObservationState.Ready)).ToArray());

    private static string NavigationIcon(string id) => id switch
    {
        "dashboard" => Icons.Material.Filled.Dashboard,
        "cases" => Icons.Material.Filled.FolderOpen,
        "assignments" => Icons.Material.Filled.AssignmentInd,
        "surveillance" => Icons.Material.Filled.Map,
        "reports" => Icons.Material.Filled.Assessment,
        "monitoring" => Icons.Material.Filled.MonitorHeart,
        "organizations" => Icons.Material.Filled.Groups,
        "imports" => Icons.Material.Filled.UploadFile,
        "assistance" => Icons.Material.Filled.VolunteerActivism,
        "follow-ups" => Icons.Material.Filled.Schedule,
        "escalations" => Icons.Material.Filled.WarningAmber,
        "intake-coordination" => Icons.Material.Filled.Inbox,
        "investigations" => Icons.Material.Filled.Search,
        "sessions" => Icons.Material.Filled.Event,
        "account" => Icons.Material.Filled.Settings,
        _ => Icons.Material.Filled.Link,
    };
}
