@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using SwiftAid.UI.Ellai.Guidance
@using SwiftAid.UI.Theme

<SwiftAidThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Transparent" Dense="true" Class="swiftaid-public-appbar">
        <div class="swiftaid-public-header" @onkeydown="HandleMobileNavigationKeyDown">
            <MudButton Href="/" Variant="Variant.Text" Color="Color.Primary" Class="swiftaid-brand-link">
                <MudIcon Icon="@Icons.Material.Filled.VolunteerActivism" Class="mr-2" aria-hidden="true" />
                SwiftAid
            </MudButton>
            <nav class="swiftaid-public-desktop-navigation" aria-label="Public navigation">
                <MudButton Href="/education" Variant="Variant.Text" Color="Color.Default">Education</MudButton>
                <MudButton Href="/sessions" Variant="Variant.Text" Color="Color.Default">Community</MudButton>
            </nav>
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Class="swiftaid-public-menu-toggle"
                       @ref="_mobileMenuToggle"
                       OnClick="ToggleMobileNavigation"
                       aria-label="@(_mobileMenuOpen ? "Close public navigation" : "Open public navigation")"
                       aria-expanded="@(_mobileMenuOpen ? "true" : "false")"
                       aria-controls="swiftaid-public-mobile-navigation">
                <MudIcon Icon="@(_mobileMenuOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Menu)" aria-hidden="true" />
            </MudButton>
            <MudButton Href="/sign-in" Variant="Variant.Filled" Color="Color.Primary" Class="swiftaid-public-sign-in">Sign in</MudButton>
            <nav id="swiftaid-public-mobile-navigation"
                 class="swiftaid-public-mobile-navigation"
                 aria-label="Public navigation"
                 aria-hidden="@(_mobileMenuOpen ? "false" : "true")"
                 hidden="@(!_mobileMenuOpen)">
                <MudButton Href="/education" Variant="Variant.Text" Color="Color.Default"
                           Class="swiftaid-public-mobile-link" OnClick="CloseMobileNavigation">Education</MudButton>
                <MudButton Href="/sessions" Variant="Variant.Text" Color="Color.Default"
                           Class="swiftaid-public-mobile-link" OnClick="CloseMobileNavigation">Community</MudButton>
            </nav>
        </div>
    </MudAppBar>
    <MudMainContent Class="swiftaid-public-main">
        <MudContainer MaxWidth="MaxWidth.Large" Class="swiftaid-public-body">
            @(ChildContent ?? Body)
        </MudContainer>
    </MudMainContent>
</MudLayout>

<AuthorizeView>
    <Authorized>
        <EllaiGuidanceHost />
    </Authorized>
</AuthorizeView>

@code {
    private bool _mobileMenuOpen;
    private MudButton? _mobileMenuToggle;

    private void ToggleMobileNavigation() => _mobileMenuOpen = !_mobileMenuOpen;

    private void CloseMobileNavigation() => _mobileMenuOpen = false;

    private async Task HandleMobileNavigationKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _mobileMenuOpen = false;
            await InvokeAsync(StateHasChanged);
            if (_mobileMenuToggle is not null)
            {
                await _mobileMenuToggle.FocusAsync();
            }
        }
    }

    /// <summary>Body content. Set explicitly when this layout is composed
    /// inside <see cref="StartupLayout" />; otherwise the router fills
    /// <see cref="LayoutComponentBase.Body" />.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
