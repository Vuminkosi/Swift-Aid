@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to main content</a>

<SwiftAidThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Surface" Class="app-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer"
                       aria-label="Toggle navigation"
                       aria-controls="primary-navigation"
                       aria-expanded="@(_drawerOpen ? "true" : "false")" />
        <MudText Typo="Typo.h6" Class="brand-mark">SwiftAid</MudText>
        <MudSpacer />
        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
            Public information
        </MudChip>
    </MudAppBar>

    <MudDrawer id="primary-navigation" @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always" Elevation="0">
        <MudNavMenu Class="navigation-menu">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavLink Href="/report" Icon="@Icons.Material.Filled.EditNote">Report a concern</MudNavLink>
            <MudNavLink Href="/education" Icon="@Icons.Material.Filled.MenuBook">Education</MudNavLink>
            <MudNavLink Href="/sessions" Icon="@Icons.Material.Filled.Event">Community sessions</MudNavLink>
        </MudNavMenu>
        <MudDivider Class="drawer-divider" />
        <MudText Typo="Typo.caption" Class="drawer-note">
            A private report is not a promise of service or a confirmed case.
        </MudText>
    </MudDrawer>

    <MudMainContent Class="main-content">
        <main id="main-content" tabindex="-1">
            @Body
        </main>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
