@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using SwiftAid.UI.Components.Layout

<AuthorizeView>
    <Authorized>
        <AuthorizedLayout ChildContent="@Body">
            <HeaderActions>
                <NotificationMenu />
            </HeaderActions>
        </AuthorizedLayout>
    </Authorized>
    <NotAuthorized>
        <PublicLayout>@Body</PublicLayout>
    </NotAuthorized>
</AuthorizeView>
