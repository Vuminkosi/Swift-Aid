@page "/reset-password"
@using System.ComponentModel.DataAnnotations
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Set a new password | SwiftAid</PageTitle>

<AccountEntrySurface>
    <MudPaper Class="pa-4" Elevation="0">
        <SwiftAidPageHeading Eyebrow="Your SwiftAid account"
                             Title="Set a new password"
                             Description="Choose a new password for your account."
                             HeadingId="reset-password-heading" />

        @if (!HasLink)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert">
                <MudText>This reset link is invalid or has expired. Request a new one.</MudText>
            </MudAlert>
            <MudButton Href="/forgot-password" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Class="auth-cta">
                Request a new link
            </MudButton>
        }
        else
        {
            @if (_isLoadingPolicy)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading password requirements" />
                <MudText Typo="Typo.body2">Loading password requirements…</MudText>
            }
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div role="alert" aria-atomic="true">
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        <MudText>@_errorMessage</MudText>
                    </MudAlert>
                </div>
            }
            @if (_policyAvailable)
            {
            <EditForm Model="_resetForm" OnSubmit="ConfirmAsync">
            <DataAnnotationsValidator />
            <MudTextField T="string" Label="New password" @bind-Value="_resetForm.Password"
                          For="@(() => _resetForm.Password)"
                          Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="() => _showPassword = !_showPassword"
                          Immediate="true" MaxLength="256" autocomplete="new-password"
                          aria-label="New password" />
            <MudTextField T="string" Label="Confirm new password" @bind-Value="_resetForm.ConfirmPassword"
                          For="@(() => _resetForm.ConfirmPassword)"
                          Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting"
                          InputType="InputType.Password" Immediate="true" MaxLength="256"
                          autocomplete="new-password" aria-label="Confirm new password" />
            <MudText Typo="Typo.caption">@_policyHint</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       ButtonType="ButtonType.Submit" Disabled="@(_isSubmitting || _isLoadingPolicy)"
                       Class="auth-cta">
                @(_isSubmitting ? "Saving…" : "Set new password")
            </MudButton>
            </EditForm>
            }
        }
    </MudPaper>
</AccountEntrySurface>

@code {
    private IJSObjectReference? _module;
    private bool _isSubmitting;
    private bool _isLoadingPolicy = true;
    private bool _policyAvailable;
    private bool _showPassword;
    private readonly ResetPasswordForm _resetForm = new();
    private string? _errorMessage;
    private string _policyHint = string.Empty;

    [SupplyParameterFromQuery(Name = "userId")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    private bool HasLink =>
        !string.IsNullOrWhiteSpace(UserId) && !string.IsNullOrWhiteSpace(Code);

    private bool CanSubmit =>
        HasLink && _policyAvailable && !_isSubmitting &&
        !string.IsNullOrWhiteSpace(_resetForm.Password) &&
        string.Equals(_resetForm.Password, _resetForm.ConfirmPassword, StringComparison.Ordinal);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _module is not null)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Pages/ResetPassword.razor.js");
            var policy = await _module.InvokeAsync<PasswordPolicyResult>("loadPasswordPolicy");
            _policyHint = BuildPolicyHint(policy);
            _policyAvailable = true;
        }
        catch (JSException)
        {
            _errorMessage = "Password requirements could not be loaded. Try again later.";
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _isLoadingPolicy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConfirmAsync(EditContext editContext)
    {
        if (!CanSubmit || _module is null || !editContext.Validate())
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            var result = await _module.InvokeAsync<ResetConfirmResult>(
                "confirmPasswordReset", UserId, Code, _resetForm.Password);
            if (result.Ok)
            {
                Navigation.NavigateTo("/sign-in", forceLoad: true);
                return;
            }

            _errorMessage = result.Message ?? "The reset link is invalid or has expired.";
        }
        catch (JSException)
        {
            _errorMessage = "Password reset is temporarily unavailable. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private sealed record ResetConfirmResult(bool Ok, string? Message);

    private sealed record PasswordPolicyResult(
        int MinimumLength,
        bool RequireDigit,
        bool RequireLowercase,
        bool RequireUppercase,
        bool RequireSymbol);

    private static string BuildPolicyHint(PasswordPolicyResult policy)
    {
        var requirements = new List<string> { $"at least {Math.Max(1, policy.MinimumLength)} characters" };
        if (policy.RequireDigit) requirements.Add("a number");
        if (policy.RequireLowercase) requirements.Add("a lowercase letter");
        if (policy.RequireUppercase) requirements.Add("an uppercase letter");
        if (policy.RequireSymbol) requirements.Add("a symbol");
        return $"Use {string.Join(", ", requirements)}.";
    }

    private sealed class ResetPasswordForm : IValidatableObject
    {
        [Required(ErrorMessage = "Enter a new password.")]
        [StringLength(256)]
        public string? Password { get; set; }

        [Required(ErrorMessage = "Confirm your new password.")]
        [StringLength(256)]
        public string? ConfirmPassword { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!string.Equals(Password, ConfirmPassword, StringComparison.Ordinal))
                yield return new ValidationResult("The passwords do not match.", new[] { nameof(ConfirmPassword) });
        }
    }
}
