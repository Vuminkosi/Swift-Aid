@page "/reset-password"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Set a new password | SwiftAid</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small">
    <MudPaper Class="pa-4" Elevation="0">
        <SwiftAidPageHeading Eyebrow="Your SwiftAid account"
                             Title="Set a new password"
                             Description="Choose a new password for your account."
                             HeadingId="reset-password-heading" />

        @if (!HasLink)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="alert">
                <MudText>This reset link is invalid or has expired. Request a new one.</MudText>
            </MudAlert>
            <MudButton Href="/forgot-password" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Class="auth-cta">
                Request a new link
            </MudButton>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div role="alert" aria-atomic="true">
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        <MudText>@_errorMessage</MudText>
                    </MudAlert>
                </div>
            }
            <MudTextField T="string" Label="New password" @bind-Value="_password"
                          Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="() => _showPassword = !_showPassword"
                          Immediate="true" MaxLength="256" autocomplete="new-password"
                          aria-label="New password" />
            <MudTextField T="string" Label="Confirm new password" @bind-Value="_confirm"
                          Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting"
                          InputType="InputType.Password" Immediate="true" MaxLength="256"
                          autocomplete="new-password" aria-label="Confirm new password" />
            <MudText Typo="Typo.caption">Use at least 8 characters with a number and symbol.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="ConfirmAsync" Disabled="@(!CanSubmit)"
                       Class="auth-cta">
                @(_isSubmitting ? "Saving…" : "Set new password")
            </MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    private IJSObjectReference? _module;
    private bool _isSubmitting;
    private bool _showPassword;
    private string? _password;
    private string? _confirm;
    private string? _errorMessage;

    [SupplyParameterFromQuery(Name = "userId")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    private bool HasLink =>
        !string.IsNullOrWhiteSpace(UserId) && !string.IsNullOrWhiteSpace(Code);

    private bool CanSubmit =>
        HasLink && !_isSubmitting &&
        !string.IsNullOrWhiteSpace(_password) &&
        string.Equals(_password, _confirm, StringComparison.Ordinal);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _module is not null)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Pages/ResetPassword.razor.js");
        }
        catch (JSException)
        {
            _errorMessage = "Password reset is temporarily unavailable. Please try again.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConfirmAsync()
    {
        if (!CanSubmit || _module is null)
        {
            if (!string.Equals(_password, _confirm, StringComparison.Ordinal))
            {
                _errorMessage = "The passwords do not match.";
            }

            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            var result = await _module.InvokeAsync<ResetConfirmResult>(
                "confirmPasswordReset", UserId, Code, _password);
            if (result.Ok)
            {
                Navigation.NavigateTo("/sign-in", forceLoad: true);
                return;
            }

            _errorMessage = result.Message ?? "The reset link is invalid or has expired.";
        }
        catch (JSException)
        {
            _errorMessage = "Password reset is temporarily unavailable. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private sealed record ResetConfirmResult(bool Ok, string? Message);
}
