@page "/verify-email"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Verify account | SwiftAid</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small">
    <MudPaper Class="pa-4" Elevation="0">
        <SwiftAidPageHeading Eyebrow="Your SwiftAid account"
                             Title="Verify your account"
                             Description="Enter the code we sent to your email address."
                             HeadingId="verify-email-heading" />

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div role="alert" aria-atomic="true">
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    <MudText>@_errorMessage</MudText>
                </MudAlert>
            </div>
        }
        @if (!string.IsNullOrEmpty(_notice))
        {
            <div role="status" aria-atomic="true">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    <MudText>@_notice</MudText>
                </MudAlert>
            </div>
        }

        <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true"
                   OnClick="ResendAsync" Disabled="@(!CanResend)">
            @(_isBusy ? "Working…" : ResendLabel)
        </MudButton>
        <MudTextField T="string" Label="Verification code" @bind-Value="_code"
                      Variant="Variant.Outlined" Required="true" Disabled="@_isBusy"
                      Immediate="true" MaxLength="6" autocomplete="one-time-code" InputMode="InputMode.numeric"
                      aria-label="6-digit verification code" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   OnClick="ConfirmAsync" Disabled="@(!CanConfirm)"
                   Class="auth-cta">
            @(_isBusy ? "Verifying…" : "Verify")
        </MudButton>
        <p role="status" aria-live="polite">@_liveMessage</p>
    </MudPaper>
</MudContainer>

@code {
    private IJSObjectReference? _module;
    private bool _isBusy;
    private string? _code;
    private string? _errorMessage;
    private string? _notice;
    private string _liveMessage = string.Empty;
    private int _resendCountdown;
    private CancellationTokenSource? _countdownLifetime;
    private bool _disposed;

    private bool CanConfirm => !_isBusy && !string.IsNullOrWhiteSpace(_code);

    private bool CanResend => !_isBusy && _resendCountdown <= 0;

    private string ResendLabel => _resendCountdown > 0
        ? $"Resend code ({_resendCountdown / 60:00}:{_resendCountdown % 60:00})"
        : "Send me a code";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _module is not null)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Pages/VerifyEmail.razor.js");
        }
        catch (JSException)
        {
            _errorMessage = "Verification is temporarily unavailable. Please try again.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ResendAsync()
    {
        if (_module is null || _isBusy)
        {
            return;
        }

        _isBusy = true;
        _errorMessage = null;
        _notice = null;
        try
        {
            var result = await _module.InvokeAsync<EmailCodeResult>("requestEmailCode");
            if (result.Ok)
            {
                _notice = result.Message ?? "A verification code has been sent to your email address.";
                StartResendCountdown(result.RetryAfterSeconds);
            }
            else
            {
                _errorMessage = result.Message ?? "Requesting a code failed. Please try again.";
                StartResendCountdown(result.RetryAfterSeconds);
            }
        }
        catch (JSException)
        {
            _errorMessage = "Verification is temporarily unavailable. Please try again.";
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConfirmAsync()
    {
        if (!CanConfirm || _module is null)
        {
            return;
        }

        _isBusy = true;
        _errorMessage = null;
        _notice = null;
        try
        {
            var result = await _module.InvokeAsync<EmailCodeResult>("confirmEmailCode", _code?.Trim());
            if (result.Ok)
            {
                _liveMessage = "Verified. Taking you to your account.";
                Navigation.NavigateTo("/account", forceLoad: true);
                return;
            }

            _errorMessage = result.Message ?? "The code is invalid or has expired.";
        }
        catch (JSException)
        {
            _errorMessage = "Verification is temporarily unavailable. Please try again.";
        }
        finally
        {
            _isBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartResendCountdown(int seconds)
    {
        StopResendCountdown();
        if (seconds <= 0 || _disposed)
        {
            return;
        }

        _resendCountdown = seconds;
        var lifetime = new CancellationTokenSource();
        _countdownLifetime = lifetime;
        _ = RunResendCountdownAsync(lifetime.Token);
    }

    private async Task RunResendCountdownAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (_resendCountdown > 0 && await timer.WaitForNextTickAsync(cancellationToken).ConfigureAwait(false))
            {
                _resendCountdown--;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void StopResendCountdown()
    {
        try
        {
            _countdownLifetime?.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }
        finally
        {
            _countdownLifetime?.Dispose();
            _countdownLifetime = null;
            _resendCountdown = 0;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        StopResendCountdown();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private sealed record EmailCodeResult(bool Ok, string? Message, int RetryAfterSeconds = 0);
}
