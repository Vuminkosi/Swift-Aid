@page "/security"
@using SwiftAid.Client.Presentation
@using SwiftAid.Gateway.Presentation
@using SwiftAid.Infrastructure.Identity
@using SwiftAid.UI.Components.Surfaces.Account
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Security &amp; sign-in | SwiftAid</PageTitle>

<AccountSettingsLayout>

<SwiftAidPageHeading Eyebrow="Account" Title="Security &amp; sign-in"
                     Description="Change your password and review how you sign in."
                     HeadingId="security-heading" />

<ChangePasswordSurface Snapshot="_password" OnRefresh="RefreshAsync" OnSave="ChangePasswordAsync" />

<MudPaper Class="pa-4 mb-4" Elevation="0">
    <MudText Typo="Typo.subtitle1">Connected sign-in methods</MudText>
    <MudText Typo="Typo.body2">
        Review or disconnect Google, Facebook, or organization sign-in.
    </MudText>
    <MudButton Href="/sign-in-methods" Variant="Variant.Outlined" Color="Color.Primary">
        Manage sign-in methods
    </MudButton>
    <MudText Typo="Typo.caption">
        Only this device session is shown here. Remote session management is not supported.
    </MudText>
</MudPaper>

</AccountSettingsLayout>

@code {
    private ChangePasswordSnapshot _password = ChangePasswordSnapshot.Loading;
    private IJSObjectReference? _module;
    private bool _disposed;

    private IUserProfileClient ProfileClient =>
        (IUserProfileClient?)ServiceProvider.GetService(typeof(IUserProfileClient))
        ?? CreateProfileFallback()
        ?? new UnavailableUserProfileClient();

    private IUserProfileClient? CreateProfileFallback()
    {
        var auth = (AuthenticationStateProvider?)ServiceProvider.GetService(typeof(AuthenticationStateProvider));
        var users = (UserManager<SwiftAidUser>?)ServiceProvider.GetService(typeof(UserManager<SwiftAidUser>));
        var profiles = (IUserProfileService?)ServiceProvider.GetService(typeof(IUserProfileService));
        var verification = (IEmailVerificationService?)ServiceProvider.GetService(typeof(IEmailVerificationService));
        var avatars = (IProfileAvatarService?)ServiceProvider.GetService(typeof(IProfileAvatarService));
        var signIn = (SignInManager<SwiftAidUser>?)ServiceProvider.GetService(typeof(SignInManager<SwiftAidUser>));
        return auth is null || users is null || profiles is null || verification is null || avatars is null || signIn is null
            ? null
            : new GatewayUserProfileClient(auth, users, profiles, verification, avatars, signIn);
    }

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _module is not null)
        {
            return;
        }

        try
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./Components/Pages/Security.razor.js");
        }
        catch (JSException)
        {
            _password = ChangePasswordSnapshot.Unavailable;
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        var profile = await ProfileClient.GetAsync();
        if (profile.Value is null)
        {
            _password = profile.Code == UiCapabilityResultCode.Denied
                ? ChangePasswordSnapshot.SignedOut
                : ChangePasswordSnapshot.Unavailable with
                {
                    StatusMessage = profile.Message ?? ChangePasswordSnapshot.Unavailable.StatusMessage
                };
            return;
        }

        _password = profile.Value.IsSignedIn
            ? new ChangePasswordSnapshot(ChangePasswordViewState.Ready, false)
            : ChangePasswordSnapshot.SignedOut;
    }

    private async Task ChangePasswordAsync(ChangePasswordRequest request)
    {
        if (_module is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(request.NewPassword))
        {
            _password = new ChangePasswordSnapshot(
                ChangePasswordViewState.Ready, false, "The new passwords do not match.", true);
            return;
        }

        _password = new ChangePasswordSnapshot(ChangePasswordViewState.Ready, true);
        try
        {
            var result = await _module.InvokeAsync<ChangePasswordResult>(
                "changePassword", request.CurrentPassword ?? string.Empty, request.NewPassword);
            if (result.SignedOut)
            {
                _password = ChangePasswordSnapshot.SignedOut;
                return;
            }

            _password = new ChangePasswordSnapshot(
                ChangePasswordViewState.Ready, false,
                result.Message ?? "The password could not be changed.",
                !result.Ok);
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
        catch (Exception)
        {
            _password = new ChangePasswordSnapshot(
                ChangePasswordViewState.Ready, false,
                "Changing the password is temporarily unavailable.", true);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private sealed record ChangePasswordResult(bool Ok, string? Message, bool SignedOut = false);
}
