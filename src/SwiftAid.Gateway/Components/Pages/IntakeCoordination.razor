@page "/intake-coordination"
@using SwiftAid.Contracts.Intake
@using SwiftAid.UI.Components.Coordination
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IIntakeCoordinationClient CoordinationClient

<PageTitle>Intake coordination | SwiftAid</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="intake-coordination-page">
    <SwiftAidPageHeading Eyebrow="Platform intake coordination"
                         Title="Coordination queue"
                         Description="Restricted review for public reports that no organization queue could receive. Coordinators assess routing only; report content stays with organization reviewers."
                         HeadingId="intake-coordination-heading" />

    <IntakeCoordinationQueue Client="CoordinationClient" />
</MudContainer>
