@page "/sessions"
@page "/sessions/calendar"
@implements IDisposable
@using SwiftAid.Contracts.Sessions
@using SwiftAid.Client.Presentation
@using SwiftAid.Client.Presentation.PublicWorkflows
@using Microsoft.Extensions.DependencyInjection
@using SwiftAid.UI.Components.Sessions
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using SwiftAid.UI.Components.Surfaces.Public
@inject IPublicCommunitySessionClient PublicSessionClient
@inject ISubscriptionClient SubscriptionClient
@inject IStaffSessionEditorClient StaffSessionEditor
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>Community sessions | SwiftAid</PageTitle>
<NavigationLock OnBeforeInternalNavigation="ConfirmRetainedLeave" ConfirmExternalNavigation="@HasRetainedProposal" />

<div class="community-sessions-page">
    @if (_confirmingRetainedLeave)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0" role="alertdialog" aria-modal="true" aria-label="Unconfirmed session update">
            <MudText Typo="Typo.subtitle1">Leave without keeping your session changes?</MudText>
            <MudText Typo="Typo.body2">The temporary update copy and any unsaved session edits will be lost.</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="StayWithRetainedProposal">Stay on this page</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="LeaveWithRetainedProposal">Leave without saving</MudButton>
        </MudPaper>
    }
    @if (_deferredProposal is not null)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">
            @(_deferredNotSubmitted ? "An update was not submitted because access could not be confirmed." : "An update could not be confirmed.")
            Check access again to compare your changes. This temporary copy lasts only while this page remains open.
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="RetryDeferredProposalAsync" Disabled="_busy">Check access again</MudButton>
            @if (!_confirmingDeferredDiscard)
            {
                <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="() => _confirmingDeferredDiscard = true" Disabled="_busy">Discard temporary copy…</MudButton>
            }
            else
            {
                <MudText Typo="Typo.caption">Discard the unconfirmed update copy?</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ClearDeferredProposal" Disabled="_busy">Yes, discard copy</MudButton>
                <MudButton Variant="Variant.Text" OnClick="() => _confirmingDeferredDiscard = false" Disabled="_busy">Keep copy</MudButton>
            }
        </MudAlert>
    }
    @if (_conflictProposal is { } proposal && _staffView is { } current &&
         _managementCapabilities.CanEdit && CanRenderEditor(_managementCapabilities))
    {
        <SessionConflictReview Proposal="proposal" Current="current" OutcomeUnknown="_proposalOutcomeUnknown" NotSubmitted="_proposalNotSubmitted" OnDismiss="DismissConflictProposal" />
    }
    <PublicSessionsSurface @key="(RequestedSessionId, IsCalendarRoute, InitialRemindersView)" Sessions="_sessions"
                           Loading="_loadingList"
                           ErrorMessage="@ListError"
                           SubscriptionsHref="/notifications"
                           OnRetry="LoadListAsync"
                           QuerySessionsAsync="@(RequestedSessionId is null ? QuerySessionsAsync : null)"
                           InitialCalendarView="@(IsCalendarRoute && RequestedSessionId is null)"
                           LoadInvitationTextAsync="InvitationLoader"
                           LoadSubscriptionStateAsync="LoadSubscriptionStateAsync"
                           ExecuteSubscriptionActionAsync="ExecuteSubscriptionActionAsync"
                           OnRequestSignIn="RequestSubscriptionSignInAsync"
                           InitialSessionId="RequestedSessionId"
                           InitialRemindersView="InitialRemindersView"
                           LoadManagementCapabilitiesAsync="LoadManagementCapabilitiesAsync"
                           OnManageSession="ManageSessionAsync"
                           HasPendingEditorInput="HasPendingEditorInput"
                           StaffEditorCapabilities="_managementCapabilities">
        <StaffSessionEditorContent Context="capability">
            @if (CanRenderEditor(capability))
            {
                var editorGeneration = _editorGeneration;
                <SessionEditor @ref="_sessionEditor" @key="(_editorGeneration, _editingVersion)"
                           ManagementCapabilities="capability"
                           SessionId="_editingSessionId"
                           ExpectedVersion="_editingVersion"
                           Status="@_editingStatus"
                           CreatedByActorId="@_editingCreatedBy"
                           CurrentActorId="@_actorId"
                           InitialSession="_staffView"
                           Busy="_busy"
                           SuppressNavigationPrompt="HasRetainedProposal"
                           ServerError="@_serverError"
                           OnCreate="submission => HandleCreateAsync(submission, editorGeneration)"
                           OnUpdate="submission => HandleUpdateAsync(submission, editorGeneration)"
                           OnReview="submission => HandleReviewAsync(submission, editorGeneration)"
                           OnSchedule="reason => HandleScheduleAsync(reason, editorGeneration)"
                           OnCancel="submission => HandleCancelAsync(submission, editorGeneration)"
                           OnComplete="reason => HandleCompleteAsync(reason, editorGeneration)" />
            }
        </StaffSessionEditorContent>
    </PublicSessionsSurface>
</div>

@code {
    private IReadOnlyList<PublicSessionView> _sessions = Array.Empty<PublicSessionView>();
    private bool _loadingList = true;
    private string? ListError { get; set; }
    private bool _busy;
    private bool _canManageSessions;
    private long _staffLoadGeneration;
    private long _accessGeneration;
    private long _identityEpoch;
    private bool _disposed;
    private long _capabilityRequestGeneration;
    private long _editorGeneration;
    private string? _serverError;
    private string? _actorId;
    private SessionManagementPresentation _managementCapabilities = SessionManagementPresentation.Unavailable();
    private Guid? _editingSessionId;
    private long _editingVersion;
    private string? _editingStatus;
    private string? _editingCreatedBy;
    private CommunitySessionView? _staffView;
    private SessionUpdateSubmission? _conflictProposal;
    private bool _proposalOutcomeUnknown;
    private bool _proposalNotSubmitted;
    private SessionUpdateSubmission? _deferredProposal;
    private string? _deferredProposalActor;
    private bool _deferredNotSubmitted;
    private bool _confirmingDeferredDiscard;
    private bool _confirmingRetainedLeave;
    private string? _retainedLeaveTarget;
    private string? _approvedRetainedLeaveTarget;
    private bool HasRetainedProposal => _deferredProposal is not null || _conflictProposal is not null;
    private SessionEditor? _sessionEditor;
    private bool HasPendingEditorInput() => _sessionEditor?.HasPendingInput == true || _conflictProposal is not null;
    private Guid? _loadedRequestId;
    private bool _pageInitialized;
    private long _listGeneration;
    [SupplyParameterFromQuery(Name = "sessionId")] public Guid? RequestedSessionId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? RequestedTab { get; set; }
    private bool InitialRemindersView => RequestedSessionId is not null &&
        string.Equals(RequestedTab, "reminders", StringComparison.OrdinalIgnoreCase);
    private bool IsCalendarRoute => string.Equals(Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.TrimEnd('/'),
        "/sessions/calendar", StringComparison.OrdinalIgnoreCase);
    private Func<Guid, long, Task<string?>> InvitationLoader => LoadInvitationAsync;
    private async Task<PublicSessionPage?> QuerySessionsAsync(PublicSessionQuery query)
    {
        var result = await PublicSessionClient.QueryPublicAsync(query);
        return result.Succeeded ? result.Value : null;
    }
    protected override async Task OnInitializedAsync()
    {
        AuthenticationState.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await RefreshStaffAccessAsync();
        _loadedRequestId = RequestedSessionId;
        await LoadListAsync();
        _pageInitialized = true;
        if (RequestedSessionId is { } sessionId && sessionId != Guid.Empty && _canManageSessions)
        {
            await LoadStaffSessionAsync(sessionId);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_pageInitialized && _loadedRequestId != RequestedSessionId)
        {
            _loadedRequestId = RequestedSessionId;
            await LoadListAsync();
        }
    }

    private async Task<bool> RefreshStaffIdentityAsync(bool preserveCurrentStaffLoad = false)
    {
        var generation = Interlocked.Increment(ref _accessGeneration);
        var previousActorId = _actorId;
        try
        {
            var result = await StaffSessionEditor.GetCurrentActorIdAsync();
            if (generation != Volatile.Read(ref _accessGeneration))
            {
                return false;
            }

            if (result.Code == UiCapabilityResultCode.Success && result.Metadata.IsAvailable &&
                !string.IsNullOrWhiteSpace(result.Value))
            {
                _actorId = result.Value;
                if (_deferredProposalActor is not null && !string.Equals(_deferredProposalActor, _actorId, StringComparison.Ordinal))
                    ClearDeferredProposal();
                if (!string.Equals(previousActorId, _actorId, StringComparison.Ordinal))
                {
                    _managementCapabilities = SessionManagementPresentation.Unavailable();
                    _canManageSessions = false;
                    ClearEditorStateCore(invalidateStaffLoad: !preserveCurrentStaffLoad);
                }
                return true;
            }

            if (result.Code == UiCapabilityResultCode.Denied) ClearDeferredProposal();
            _actorId = null;
            _canManageSessions = false;
            _managementCapabilities = SessionManagementPresentation.Unavailable();
            ClearEditorState();
            if (result.Code is UiCapabilityResultCode.Denied or UiCapabilityResultCode.Unavailable)
                _serverError = result.Message ?? "Sign in with an authorized staff account to manage sessions.";
            return false;
        }
        catch (Exception)
        {
            if (generation != Volatile.Read(ref _accessGeneration))
            {
                return false;
            }

            _actorId = null;
            _canManageSessions = false;
            _managementCapabilities = SessionManagementPresentation.Unavailable();
            ClearEditorState();
            _serverError = "The session workspace is unavailable right now.";
            return false;
        }
    }

    private async Task<bool> RefreshStaffAccessAsync(Guid? sessionId = null, long? expectedVersion = null)
    {
        _managementCapabilities = SessionManagementPresentation.Unavailable();
        _canManageSessions = false;
        var generation = Interlocked.Increment(ref _capabilityRequestGeneration);
        try
        {
            var presentation = await LoadManagementCapabilitiesAsync(sessionId, expectedVersion);
            if (generation != Volatile.Read(ref _capabilityRequestGeneration)) return false;

            if (presentation.IsAvailable && presentation.IsCurrent &&
                presentation.SessionId == sessionId &&
                (expectedVersion is null || presentation.Version == expectedVersion))
            {
                _managementCapabilities = presentation;
                _canManageSessions = presentation.CanCreate || presentation.CanEdit || presentation.CanReview ||
                    presentation.CanSchedule || presentation.CanCancel || presentation.CanComplete;
                if (_canManageSessions)
                {
                    _serverError = null;
                    return true;
                }
            }

            _managementCapabilities = SessionManagementPresentation.Unavailable(presentation.Message);
            _canManageSessions = false;
            ClearEditorState();
            _serverError = presentation.Message ?? "Session management access is not available for this session.";
            return false;
        }
        catch (Exception)
        {
            if (generation == Volatile.Read(ref _capabilityRequestGeneration))
            {
                _managementCapabilities = SessionManagementPresentation.Unavailable("Session management access could not be refreshed.");
                _canManageSessions = false;
                ClearEditorState();
                _serverError = "Session management access could not be refreshed.";
            }
            return false;
        }
    }

    private async Task<SessionManagementPresentation> LoadManagementCapabilitiesAsync(
        Guid? sessionId,
        long? expectedVersion)
    {
        if (!await RefreshStaffIdentityAsync())
        {
            return SessionManagementPresentation.Unavailable(
                "Sign in to check session management access.");
        }

        try
        {
            var identityGeneration = Volatile.Read(ref _accessGeneration);
            var result = await StaffSessionEditor.GetManagementCapabilitiesAsync(sessionId, expectedVersion);
            if (identityGeneration != Volatile.Read(ref _accessGeneration))
            {
                return SessionManagementPresentation.Unavailable("Session management access changed. Refresh and try again.");
            }

            if (result.Value is not { } capability ||
                result.Code is not (UiCapabilityResultCode.Success or UiCapabilityResultCode.Conflict))
            {
                return SessionManagementPresentation.Unavailable(
                    result.Message ?? result.Metadata.Notice ?? "Session management access is unavailable.");
            }

            return ToPresentation(capability, result.Metadata.IsAvailable,
                result.Message ?? result.Metadata.Notice);
        }
        catch (Exception)
        {
            return SessionManagementPresentation.Unavailable(
                "Session management access could not be refreshed.");
        }
    }

    private static SessionManagementPresentation ToPresentation(
        StaffSessionManagementCapabilities capability,
        bool isAvailable,
        string? message) => new(
            isAvailable,
            capability.IsCurrent,
            capability.SessionId,
            capability.Version,
            capability.Status,
            capability.CanCreate,
            capability.CanEdit,
            capability.CanReview,
            capability.CanSchedule,
            capability.CanCancel,
            capability.CanComplete,
            message);

    private bool CanRenderEditor(SessionManagementPresentation presentation)
    {
        if (!presentation.IsAvailable || !presentation.IsCurrent)
        {
            return false;
        }

        if (_editingSessionId is null)
        {
            return presentation.SessionId is null && presentation.CanCreate;
        }

        return presentation.SessionId == _editingSessionId &&
            presentation.Version == _editingVersion &&
            string.Equals(presentation.Status, _editingStatus, StringComparison.OrdinalIgnoreCase) &&
            (presentation.CanEdit || presentation.CanReview || presentation.CanSchedule ||
             presentation.CanCancel || presentation.CanComplete);
    }

    private async Task ManageSessionAsync(Guid? sessionId)
    {
        _conflictProposal = null;
        if (sessionId is null)
        {
            if (!await RefreshStaffAccessAsync())
            {
                ClearEditorState();
                return;
            }

            if (!_managementCapabilities.CanCreate)
            {
                ClearEditorState();
                return;
            }

            _serverError = null;
            _editingSessionId = null;
            _editingVersion = 0;
            _editingStatus = null;
            _editingCreatedBy = _actorId;
            _staffView = null;
            Interlocked.Increment(ref _editorGeneration);
            return;
        }

        Interlocked.Increment(ref _editorGeneration);
        await LoadStaffSessionAsync(sessionId.Value);
    }

    private async Task LoadStaffSessionAsync(Guid sessionId)
    {
        var generation = Interlocked.Increment(ref _staffLoadGeneration);
        var identityEpoch = Volatile.Read(ref _identityEpoch);
        var identityAvailable = sessionId != Guid.Empty && await RefreshStaffIdentityAsync(preserveCurrentStaffLoad: true);
        if (!IsCurrentIdentityEpoch(identityEpoch)) return;
        if (!identityAvailable || string.IsNullOrWhiteSpace(_actorId))
        {
            ClearEditorState();
            return;
        }

        _busy = true;
        _serverError = null;
        var identityGeneration = Volatile.Read(ref _accessGeneration);
        try
        {
            var result = await StaffSessionEditor.GetStaffAsync(sessionId);
            if (!IsCurrentIdentityEpoch(identityEpoch) || generation != Volatile.Read(ref _staffLoadGeneration) ||
                identityGeneration != Volatile.Read(ref _accessGeneration))
            {
                return;
            }

            if (result.Code == UiCapabilityResultCode.Success && result.Metadata.IsAvailable &&
                result.Value is { Version: > 0 } session)
            {
                var capabilityResult = await StaffSessionEditor.GetManagementCapabilitiesAsync(session.SessionId, session.Version);
                if (!IsCurrentIdentityEpoch(identityEpoch) || generation != Volatile.Read(ref _staffLoadGeneration) ||
                    identityGeneration != Volatile.Read(ref _accessGeneration)) return;
                if (capabilityResult.Code != UiCapabilityResultCode.Success || !capabilityResult.Metadata.IsAvailable ||
                    capabilityResult.Value is not { IsCurrent: true } capabilities ||
                    capabilities.SessionId != session.SessionId || capabilities.Version != session.Version ||
                    !string.Equals(capabilities.Status, session.Status, StringComparison.OrdinalIgnoreCase))
                {
                    ClearEditorState();
                    _managementCapabilities = SessionManagementPresentation.Unavailable(
                        capabilityResult.Message ?? capabilityResult.Metadata.Notice);
                    _canManageSessions = false;
                    _serverError = capabilityResult.Message ?? "Session management access is not available for this session.";
                    return;
                }

                var presentation = ToPresentation(capabilities, capabilityResult.Metadata.IsAvailable,
                    capabilityResult.Message ?? capabilityResult.Metadata.Notice);
                var canManage = capabilities.CanEdit || capabilities.CanReview || capabilities.CanSchedule ||
                    capabilities.CanCancel || capabilities.CanComplete;
                if (!canManage)
                {
                    ClearEditorState();
                    _managementCapabilities = presentation;
                    _serverError = null;
                    return;
                }

                _editingSessionId = session.SessionId;
                _editingVersion = session.Version;
                _editingStatus = session.Status;
                _editingCreatedBy = session.CreatedByActorId;
                _staffView = session;
                _managementCapabilities = presentation;
                _canManageSessions = true;
                if (capabilities.CanEdit && _deferredProposal is { } deferred &&
                    deferred.SessionId == session.SessionId &&
                    string.Equals(_deferredProposalActor, _actorId, StringComparison.Ordinal))
                {
                    _conflictProposal = deferred;
                    _proposalNotSubmitted = _deferredNotSubmitted;
                    _proposalOutcomeUnknown = !_deferredNotSubmitted;
                    ClearDeferredProposal();
                    _serverError = _proposalNotSubmitted
                        ? "The update was not submitted. Compare your proposal with the current version below."
                        : "The update outcome could not be confirmed. Compare your proposal with the current version below.";
                }
                return;
            }

            ClearEditorState();
            _managementCapabilities = SessionManagementPresentation.Unavailable(
                result.Message ?? result.Metadata.Notice);
            _canManageSessions = false;
            _serverError = result.Message ?? "That session is unavailable to this account. You can start a new session below.";
        }
        catch (Exception)
        {
            if (IsCurrentIdentityEpoch(identityEpoch) && generation == Volatile.Read(ref _staffLoadGeneration))
            {
                ClearEditorState();
                _managementCapabilities = SessionManagementPresentation.Unavailable(
                    "The session could not be loaded. Refresh and try again.");
                _canManageSessions = false;
                _serverError = "That session could not be loaded. You can start a new session below.";
            }
        }
        finally
        {
            if (IsCurrentIdentityEpoch(identityEpoch) && generation == Volatile.Read(ref _staffLoadGeneration))
            {
                _busy = false;
            }
        }
    }

    private void ClearEditorState()
        => ClearEditorStateCore(invalidateStaffLoad: true);

    private void ClearEditorStateCore(bool invalidateStaffLoad)
    {
        _conflictProposal = null;
        _sessionEditor = null;
        if (invalidateStaffLoad) Interlocked.Increment(ref _staffLoadGeneration);
        _canManageSessions = false;
        _managementCapabilities = SessionManagementPresentation.Unavailable();
        _editingSessionId = null;
        _editingVersion = 0;
        _editingStatus = null;
        _editingCreatedBy = null;
        _staffView = null;
        Interlocked.Increment(ref _editorGeneration);
        _busy = false;
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        var authEpoch = Interlocked.Increment(ref _identityEpoch);
        Interlocked.Increment(ref _accessGeneration);
        Interlocked.Increment(ref _capabilityRequestGeneration);
        Interlocked.Increment(ref _staffLoadGeneration);
        _ = InvokeAsync(async () =>
        {
            if (!IsCurrentIdentityEpoch(authEpoch)) return;
            ClearDeferredProposal();
            ClearEditorState();
            _actorId = null;
            _ = await authenticationStateTask;
            if (!IsCurrentIdentityEpoch(authEpoch)) return;
            await RefreshStaffAccessAsync(_editingSessionId, _editingSessionId is null ? null : _editingVersion);
            if (!IsCurrentIdentityEpoch(authEpoch)) return;
            if (_canManageSessions && RequestedSessionId is { } id && id != Guid.Empty)
            {
                await LoadStaffSessionAsync(id);
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        Interlocked.Increment(ref _identityEpoch);
        Interlocked.Increment(ref _accessGeneration);
        Interlocked.Increment(ref _capabilityRequestGeneration);
        Interlocked.Increment(ref _staffLoadGeneration);
        ClearDeferredProposal();
        AuthenticationState.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private bool IsCurrentIdentityEpoch(long epoch) => !_disposed && epoch == Volatile.Read(ref _identityEpoch);

    private void ClearDeferredProposal()
    {
        _deferredProposal = null;
        _deferredProposalActor = null;
        _deferredNotSubmitted = false;
        _confirmingDeferredDiscard = false;
    }

    private void ConfirmRetainedLeave(LocationChangingContext context)
    {
        if (_approvedRetainedLeaveTarget is { } approved)
        {
            _approvedRetainedLeaveTarget = null;
            if (string.Equals(approved, context.TargetLocation, StringComparison.Ordinal)) return;
        }
        if (!HasRetainedProposal) return;
        context.PreventNavigation();
        _retainedLeaveTarget = context.TargetLocation;
        _confirmingRetainedLeave = true;
    }

    private void StayWithRetainedProposal()
    {
        _confirmingRetainedLeave = false;
        _retainedLeaveTarget = null;
    }

    private void LeaveWithRetainedProposal()
    {
        if (_retainedLeaveTarget is not { } target) return;
        StayWithRetainedProposal();
        _approvedRetainedLeaveTarget = target;
        Navigation.NavigateTo(target);
    }

    private async Task RetryDeferredProposalAsync()
    {
        if (_busy || _deferredProposal is not { } proposal) return;
        await LoadStaffSessionAsync(proposal.SessionId);
    }

    private async Task LoadListAsync()
    {
        var generation = ++_listGeneration;
        _loadingList = true;
        ListError = null;
        try
        {
            if (RequestedSessionId is { } sessionId)
            {
                var detail = await PublicSessionClient.GetPublicAsync(sessionId);
                if (generation != _listGeneration) return;
                _sessions = detail.Succeeded && detail.Value is { } session ? [session] : [];
                if (!detail.Succeeded)
                    ListError = "This session is temporarily unavailable. Try again.";
                else if (detail.Value is null)
                    ListError = "This session is not available.";
                return;
            }
            var result = await PublicSessionClient.ListPublicAsync(null);
            if (generation != _listGeneration) return;
            if (result.Code == UiCapabilityResultCode.Success && result.Value is not null)
            {
                _sessions = result.Value;
                return;
            }

            _sessions = Array.Empty<PublicSessionView>();
            ListError = result.Code switch
            {
                UiCapabilityResultCode.Denied => "Published sessions are not available for this request.",
                UiCapabilityResultCode.Cancelled => "Loading sessions was cancelled. Try again when ready.",
                UiCapabilityResultCode.Retryable => "Published sessions are temporarily unavailable. Check your connection and try again.",
                _ => "Published sessions are not connected in this environment."
            };
        }
        catch (Exception)
        {
            if (generation != _listGeneration) return;
            _sessions = Array.Empty<PublicSessionView>();
            ListError = "Published sessions are temporarily unavailable. Check your connection and try again.";
        }
        finally
        {
            if (generation == _listGeneration) _loadingList = false;
        }
    }

    private async Task<string?> LoadInvitationAsync(Guid sessionId, long expectedVersion)
    {
        try
        {
            var result = await PublicSessionClient.GetInvitationTextForVersionAsync(sessionId, expectedVersion);
            return result.Code == UiCapabilityResultCode.Success
                ? result.Value
                : null;
        }
        catch (Exception)
        {
            return null;
        }
    }

    private async Task<PublicSessionsSurface.SessionSubscriptionPanelState?> LoadSubscriptionStateAsync(Guid sessionId)
    {
        try
        {
            var result = await SubscriptionClient.GetAsync(sessionId);
            if (result.Code != UiCapabilityResultCode.Success || result.Value is null)
            {
                return UnavailableSubscriptionState(sessionId, result.Message ?? result.Metadata.Notice);
            }

            var status = result.Value.Status switch
            {
                SubscriptionStatus.Active => PublicSessionsSurface.SessionSubscriptionStatus.Active,
                SubscriptionStatus.Unsubscribed => PublicSessionsSurface.SessionSubscriptionStatus.Unsubscribed,
                SubscriptionStatus.RequiresAuthentication => PublicSessionsSurface.SessionSubscriptionStatus.RequiresAuthentication,
                _ => PublicSessionsSurface.SessionSubscriptionStatus.Unavailable
            };
            var options = (PublicSessionsSurface.SessionSubscriptionOptions?)null;
            var message = CombineMessages(result.Message, result.Metadata.Notice);
            if (status is PublicSessionsSurface.SessionSubscriptionStatus.Unsubscribed or PublicSessionsSurface.SessionSubscriptionStatus.Active)
            {
                var optionsResult = await SubscriptionClient.GetSubscriptionOptionsAsync(sessionId);
                if (optionsResult.Code == UiCapabilityResultCode.Success && optionsResult.Value is { } optionValue)
                {
                    options = new PublicSessionsSurface.SessionSubscriptionOptions(
                        optionValue.SessionId,
                        optionValue.ConsentReference,
                        optionValue.Version,
                        optionValue.ConsentText,
                        optionValue.Channels.Select(MapChannel).ToArray(),
                        optionValue.IsCurrent);
                    message = CombineMessages(message, CombineMessages(optionsResult.Message, optionsResult.Metadata.Notice));
                }
                else if (status == PublicSessionsSurface.SessionSubscriptionStatus.Unsubscribed)
                {
                    return UnavailableSubscriptionState(
                        sessionId,
                        CombineMessages(optionsResult.Message, optionsResult.Metadata.Notice));
                }
            }

            return new PublicSessionsSurface.SessionSubscriptionPanelState(
                sessionId, status, result.Value.Version, options, message,
                CurrentChannel: result.Value.Channel is { } channel ? MapChannel(channel) : null);
        }
        catch (Exception)
        {
            return UnavailableSubscriptionState(sessionId, "Reminder choices are temporarily unavailable. Try again later.", isError: true);
        }
    }

    private async Task<PublicSessionsSurface.SessionSubscriptionPanelState?> ExecuteSubscriptionActionAsync(
        PublicSessionsSurface.SessionSubscriptionAction action)
    {
        try
        {
            var result = action.Kind switch
            {
                PublicSessionsSurface.SessionSubscriptionActionKind.Subscribe
                    when !string.IsNullOrWhiteSpace(action.ConsentReference) && action.Channel is { } channel =>
                    await SubscriptionClient.SubscribeAsync(new SubscriptionRequest(
                        action.SessionId,
                        action.ConsentReference,
                        action.ExpectedVersion,
                        MapChannel(channel))),
                PublicSessionsSurface.SessionSubscriptionActionKind.Unsubscribe =>
                    await SubscriptionClient.UnsubscribeAsync(action.SessionId, action.ExpectedVersion),
                _ => null
            };

            if (result is null)
            {
                return UnavailableSubscriptionState(action.SessionId, "Review the reminder choices before continuing.", isError: true);
            }

            if (result.Code == UiCapabilityResultCode.Success && result.Value is { } value)
            {
                var status = value.Status switch
                {
                    SubscriptionStatus.Active => PublicSessionsSurface.SessionSubscriptionStatus.Active,
                    SubscriptionStatus.Unsubscribed => PublicSessionsSurface.SessionSubscriptionStatus.Unsubscribed,
                    SubscriptionStatus.RequiresAuthentication => PublicSessionsSurface.SessionSubscriptionStatus.RequiresAuthentication,
                    _ => PublicSessionsSurface.SessionSubscriptionStatus.Unavailable
                };
                if (status is PublicSessionsSurface.SessionSubscriptionStatus.Unsubscribed or PublicSessionsSurface.SessionSubscriptionStatus.Active)
                {
                    var refreshed = await LoadSubscriptionStateAsync(action.SessionId);
                    return refreshed is null
                        ? UnavailableSubscriptionState(action.SessionId, CombineMessages(result.Message, result.Metadata.Notice))
                        : refreshed with { Message = CombineMessages(CombineMessages(result.Message, result.Metadata.Notice), refreshed.Message) };
                }

                return new PublicSessionsSurface.SessionSubscriptionPanelState(
                    action.SessionId,
                    status,
                    value.Version,
                    null,
                    CombineMessages(result.Message, result.Metadata.Notice));
            }

            var current = await LoadSubscriptionStateAsync(action.SessionId);
            return current is null
                ? UnavailableSubscriptionState(action.SessionId, result.Message ?? result.Metadata.Notice, isError: true)
                : current with
                {
                    IsError = true,
                    Message = CombineMessages(result.Message, result.Metadata.Notice)
                };
        }
        catch (Exception)
        {
            var current = await LoadSubscriptionStateAsync(action.SessionId);
            return current is null
                ? UnavailableSubscriptionState(action.SessionId, "The reminder choice could not be updated. Try again.", isError: true)
                : current with { IsError = true, Message = "The reminder choice could not be updated. Try again." };
        }
    }

    private Task RequestSubscriptionSignInAsync(Guid sessionId)
    {
        var returnUrl = $"/sessions?sessionId={sessionId:D}&tab=reminders";
        Navigation.NavigateTo($"/sign-in?returnUrl={Uri.EscapeDataString(returnUrl)}");
        return Task.CompletedTask;
    }

    private static PublicSessionsSurface.SessionSubscriptionPanelState UnavailableSubscriptionState(
        Guid sessionId,
        string? message,
        bool isError = false) => new(
            sessionId,
            PublicSessionsSurface.SessionSubscriptionStatus.Unavailable,
            0,
            null,
            string.IsNullOrWhiteSpace(message) ? "Reminder choices are not available right now." : message,
            isError);

    private static string? CombineMessages(string? first, string? second)
    {
        var messages = new[] { first, second }
            .Where(message => !string.IsNullOrWhiteSpace(message))
            .Distinct(StringComparer.Ordinal)
            .ToArray();
        return messages.Length == 0 ? null : string.Join(" ", messages);
    }

    private static PublicSessionsSurface.SessionReminderChannel MapChannel(SubscriptionChannel channel) => channel switch
    {
        SubscriptionChannel.Email => PublicSessionsSurface.SessionReminderChannel.Email,
        SubscriptionChannel.MobilePush => PublicSessionsSurface.SessionReminderChannel.MobilePush,
        _ => throw new ArgumentOutOfRangeException(nameof(channel), channel, "Unsupported reminder channel.")
    };

    private static SubscriptionChannel MapChannel(PublicSessionsSurface.SessionReminderChannel channel) => channel switch
    {
        PublicSessionsSurface.SessionReminderChannel.Email => SubscriptionChannel.Email,
        PublicSessionsSurface.SessionReminderChannel.MobilePush => SubscriptionChannel.MobilePush,
        _ => throw new ArgumentOutOfRangeException(nameof(channel), channel, "Unsupported reminder channel.")
    };

    private async Task HandleCreateAsync(SessionCreateSubmission submission, long generation)
    {
        if (generation != Volatile.Read(ref _editorGeneration)) return;
        var command = submission.Input.ToCommand(
            Guid.NewGuid(), submission.Reason, DateTimeOffset.UtcNow);
        await RunCommandAsync(command);
    }

    private Task HandleUpdateAsync(SessionUpdateSubmission submission, long generation) =>
        generation != Volatile.Read(ref _editorGeneration) || _editingSessionId is null || submission.SessionId != _editingSessionId ||
        submission.ExpectedVersion <= 0 || submission.ExpectedVersion != _editingVersion
            ? Task.CompletedTask
            : RunCommandAsync(submission.Input.ToCommand(
                submission.SessionId, submission.ExpectedVersion, submission.Reason, DateTimeOffset.UtcNow), submission);

    private Task HandleReviewAsync(SessionReviewSubmission submission, long generation)
    {
        if (generation != Volatile.Read(ref _editorGeneration) || _editingSessionId is null || _editingVersion <= 0)
        {
            return Task.CompletedTask;
        }

        return RunCommandAsync(new ReviewSessionCommand(
            _editingSessionId.Value,
            _editingVersion,
            submission.AcknowledgeSelfReview,
            submission.Reason,
            DateTimeOffset.UtcNow));
    }

    private Task HandleScheduleAsync(string reason, long generation)
    {
        if (generation != Volatile.Read(ref _editorGeneration) || _editingSessionId is null || _editingVersion <= 0)
        {
