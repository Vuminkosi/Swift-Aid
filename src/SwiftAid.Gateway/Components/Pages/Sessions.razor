@page "/sessions"

<PageTitle>Community sessions | SwiftAid</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="status-page">
    <MudIcon Icon="@Icons.Material.Filled.Event" Color="Color.Primary" Size="Size.Large" />
    <MudText Typo="Typo.h4" HtmlTag="h1">Community sessions</MudText>
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        No public sessions are available yet.
    </MudAlert>
    <MudText Typo="Typo.body1">
        Public session listings will appear here when an organizer has published them.
        No subscription or social message is sent from this page.
    </MudText>
</MudContainer>
