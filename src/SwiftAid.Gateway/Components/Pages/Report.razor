@page "/report"
@using SwiftAid.Application.Intake
@using SwiftAid.Contracts.Intake
@using SwiftAid.Gateway.Intake
@using SwiftAid.UI.Components.Public
@inject IIntakePublicMetadataProvider IntakeMetadataProvider
@inject WebGuestIntakeService GuestIntake

<PageTitle>Report a concern | SwiftAid</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="status-page">
    <SwiftAidPageHeading Eyebrow="Private community reporting"
                         Title="Report a concern"
                         Description="Share a human or animal concern without creating an account. You can leave details unknown when you are unsure."
                         HeadingId="public-report-heading" />
    <PublicReportForm Countries="_countries"
                      CountryCatalogueVersion="_countryCatalogueVersion"
                      CountryCatalogueIsCurrent="_countryCatalogueIsCurrent"
                      PrivacyNoticeReference="_privacyNoticeReference"
                      ProcessingPolicyReference="_privacyNoticeReference"
                      ProcessingPolicyVersion="_privacyNoticeVersion"
                      SubmitAvailable="true"
                      OnSendReport="SendReportAsync" />
    @if (_sendError is not null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-3">
            @_sendError
        </MudAlert>
    }
    @if (_receipt is not null)
    {
        <PublicReportReceipt Receipt="_receipt" />
    }
</MudContainer>

@code {
    private IntakeReceipt? _receipt;
    private string? _sendError;
    private bool _sending;
    private IReadOnlyList<PublicCountryOption> _countries = [];
    private string? _countryCatalogueVersion;
    private bool _countryCatalogueIsCurrent;
    private string? _privacyNoticeReference;
    private string? _privacyNoticeVersion;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var metadata = IntakeMetadataProvider.GetMetadata();
            _privacyNoticeReference = metadata.PrivacyNoticeReference;
            _privacyNoticeVersion = metadata.PrivacyNoticeVersion;

            var catalogue = await IntakeMetadataProvider.GetCountriesAsync(CancellationToken.None);
            if (!string.Equals(metadata.CountryCatalogueVersion, catalogue.Version, StringComparison.Ordinal))
                return;

            _countryCatalogueVersion = catalogue.Version;
            _countries = catalogue.Countries
                .Select(country => new PublicCountryOption(country.Code, country.Label))
                .ToArray();
            _countryCatalogueIsCurrent = _countries.Count > 0;
        }
        catch
        {
            _countries = [];
            _countryCatalogueVersion = null;
            _countryCatalogueIsCurrent = false;
            _privacyNoticeReference = null;
            _privacyNoticeVersion = null;
        }
    }

    private async Task SendReportAsync(IntakeSubmission submission)
    {
        if (_sending)
        {
            return;
        }

        _sending = true;
        try
        {
            _receipt = await GuestIntake.SubmitAsync(submission);
            _sendError = null;
        }
        catch (IntakeSubmissionException exception) when (exception.Code == IntakeErrorCode.InvalidReport)
        {
            _receipt = null;
            _sendError = "Your report needs review before it can be sent. Check the highlighted entries and try again.";
        }
        catch (IntakeSubmissionException exception) when (exception.Code == IntakeErrorCode.PayloadTooLarge)
        {
            _receipt = null;
            _sendError = "Your report is too large to send. Shorten the narrative or remove recordings and try again.";
        }
        catch (IntakeSubmissionException exception) when (exception.Code == IntakeErrorCode.RateLimited)
        {
            _receipt = null;
            _sendError = "Too many reports have been sent recently. Wait a little while and try again.";
        }
        catch (IntakeSubmissionException exception) when (exception.Code is IntakeErrorCode.SubmissionConflict or IntakeErrorCode.AlreadyPromoted)
        {
            _receipt = null;
            _sendError = "This report has already been received. Your earlier receipt remains the record of it.";
        }
        catch (IntakeSubmissionException)
        {
            _receipt = null;
            _sendError = "Your report could not be sent right now. Your entries remain on this screen — try again shortly.";
        }
        catch
        {
            _receipt = null;
            _sendError = "Your report could not be sent. Your entries remain on this screen.";
        }
        finally
        {
            _sending = false;
        }
    }
}
