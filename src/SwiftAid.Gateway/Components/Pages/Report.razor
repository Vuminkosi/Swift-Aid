@page "/report"
@using SwiftAid.Application.Intake
@using SwiftAid.Contracts.Geography
@using SwiftAid.Contracts.Intake
@using SwiftAid.Client.Intake
@using SwiftAid.Client.Presentation
@using SwiftAid.Client.Presentation.PublicWorkflows
@using SwiftAid.Gateway.Presentation
@using SwiftAid.UI.Components.Geography
@using SwiftAid.UI.Components.Public
@using SwiftAid.UI.Components.Surfaces.Public
@inject IPublicIntakeMetadataClient IntakeMetadataClient
@inject IGuestSubmissionStore SubmissionStore
@inject IGuestSubmissionCoordinator SubmissionCoordinator
@inject IPublicIntakeProcessingPolicyClient ProcessingPolicyClient
@inject IGeographicRegistry GeographicRegistry
@inject IServiceProvider ServiceProvider

<PageTitle>Report a concern | SwiftAid</PageTitle>

@if (_storageReady && _savedDrafts.Count > 0)
{
    <MudPaper Class="pa-4 mb-4" Outlined="true" aria-label="Saved reports on this device">
        <MudText Typo="Typo.subtitle1">Saved reports on this device</MudText>
        <MudText Typo="Typo.body2">Choose a draft to resume. It will not replace the form until you select it.</MudText>
        <div class="d-flex flex-wrap gap-2 mt-2">
            @foreach (var saved in _savedDrafts)
            {
                <MudButton @key="saved.ClientSubmissionId" Variant="Variant.Outlined" Disabled="_sending || _savingDraft"
                           OnClick="() => RestoreDraftAsync(saved.ClientSubmissionId)">
                    @(saved.State == GuestSubmissionLocalState.NeedsAttention ? "Review saved report" : "Resume saved report")
                    <span class="ml-1">@saved.CreatedAtUtc.ToLocalTime().ToString("g")</span>
                </MudButton>
            }
        </div>
    </MudPaper>
}

<PublicReportSurface Countries="_countries"
                     TextLimits="_textLimits"
                     CountryCatalogueVersion="@_countryCatalogueVersion"
                     CountryCatalogueIsCurrent="_countryCatalogueIsCurrent"
                     PlaceSearchFunc="SearchPlacesAsync"
                     PlaceChildrenFunc="SearchPlaceChildrenAsync"
                     GeoCountries="_geoCountries"
                     PrivacyNoticeReference="@_privacyNoticeReference"
                     ProcessingPolicyReference="@_processingPolicyReference"
                     ProcessingPolicyVersion="@_processingPolicyVersion"
                     ProcessingPolicyNotice="@_processingPolicyNotice"
                     ProcessingPolicyNoticeText="@_processingPolicyNoticeText"
                     ProcessingPolicyAcknowledgementLabel="@_processingPolicyAcknowledgementLabel"
                     PrivacyNoticeIsCurrent="@(!string.IsNullOrWhiteSpace(_privacyNoticeReference) && !string.IsNullOrWhiteSpace(_privacyNoticeVersion))"
                     SubmitAvailable="@CanSubmitReport"
                     DraftSavingAvailable="@_storageAvailable"
                     EditableDraftSnapshotsSupported="true"
                     CurrentDraftId="_currentDraftId"
                     Draft="_mobileDraft"
                     ServerValidationRevision="_activeServerValidationRevision"
                     OnSaveDraft="SaveDraftAsync"
                     OnSendReport="SendReportAsync"
                     Feedback="@_sendError"
                     FeedbackIsError="@_sendErrorIsError"
                     Receipt="_receipt" />

@code {
    private IntakeReceipt? _receipt;
    private readonly WebReportSubmissionIdentity _submissionIdentity = new();
    private Guid? _currentDraftId;
    private long _serverValidationSequence;
    private long _activeServerValidationRevision;
    private string? _sendError { get; set; }
    private bool _sending;
    private bool _savingDraft;
    private bool _storageReady;
    private bool _storageAvailable;
    private IReadOnlyList<GuestSubmissionSummary> _savedDrafts = [];
    private IReadOnlyList<PublicCountryOption> _countries = [];
    private IReadOnlyList<GeoPlaceCountry> _geoCountries = [];
    private string? _countryCatalogueVersion;
    private PublicIntakeTextLimits? _textLimits;
    private bool _countryCatalogueIsCurrent;
    private bool _metadataAvailable;
    private string? _privacyNoticeReference;
    private string? _privacyNoticeVersion;
    private string? _processingPolicyReference;
    private string? _processingPolicyVersion;
    private string? _processingPolicyNotice;
    private string? _processingPolicyNoticeText;
    private string? _processingPolicyAcknowledgementLabel;
    private bool _processingPolicyIsLive;
    private PublicReportDraft _mobileDraft = new() { CapturedAt = DateTimeOffset.Now };
    private bool CanSubmitReport => _countryCatalogueIsCurrent &&
        !string.IsNullOrWhiteSpace(_privacyNoticeReference) &&
        !string.IsNullOrWhiteSpace(_privacyNoticeVersion) &&
        _metadataAvailable &&
        _processingPolicyIsLive &&
        !string.IsNullOrWhiteSpace(_processingPolicyReference) &&
        !string.IsNullOrWhiteSpace(_processingPolicyVersion) && _storageAvailable;

    protected override async Task OnInitializedAsync()
    {
        _textLimits = null;
        await LoadProcessingPolicyAsync();
        try
        {
            var metadataResult = await IntakeMetadataClient.GetMetadataAsync();
            var catalogueResult = await IntakeMetadataClient.GetCountriesAsync();
            if (metadataResult.Code != UiCapabilityResultCode.Success || metadataResult.Value is not { } metadata ||
                catalogueResult.Code != UiCapabilityResultCode.Success || catalogueResult.Value is not { } catalogue ||
                !string.Equals(metadata.CountryCatalogueVersion, catalogue.Version, StringComparison.Ordinal))
            {
                return;
            }

            _countryCatalogueVersion = catalogue.Version;
            _textLimits = metadata.TextLimits is { } limits && limits.IsValid() ? limits : null;
            _countries = catalogue.Countries
                .Select(country => new PublicCountryOption(country.Code, country.Label))
                .ToArray();
            _geoCountries = _countries
                .Where(country => GeoRegistryCoverage.CountryCodes.Contains(country.Code))
                .Select(country => new GeoPlaceCountry(country.Code, country.Name))
                .ToList();
            _metadataAvailable = metadataResult.Metadata.IsAvailable && catalogueResult.Metadata.IsAvailable;
            _countryCatalogueIsCurrent = _countries.Count > 0 && _metadataAvailable;
            if (!_metadataAvailable)
            {
                _countries = [];
                _geoCountries = [];
                _countryCatalogueVersion = null;
                _countryCatalogueIsCurrent = false;
                return;
            }

            _privacyNoticeReference = metadata.PrivacyNoticeReference;
            _privacyNoticeVersion = metadata.PrivacyNoticeVersion;
        }
        catch (Exception)
        {
            _countries = [];
            _geoCountries = [];
            _countryCatalogueVersion = null;
            _countryCatalogueIsCurrent = false;
            _metadataAvailable = false;
            _privacyNoticeReference = null;
            _privacyNoticeVersion = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await ReloadDraftsAsync();
            _storageAvailable = true;
        }
        catch (Exception)
        {
            _storageAvailable = false;
            _sendError = "Saved report storage is unavailable in this browser. You can keep working on this page, but save and send are disabled until storage is available.";
            _sendErrorIsError = true;
        }
        finally
        {
            _storageReady = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private IGeoLookupClient GeoLookup =>
        (IGeoLookupClient?)ServiceProvider.GetService(typeof(IGeoLookupClient))
        ?? new GatewayGeoLookupClient(GeographicRegistry);

    private async Task<GeoPlaceQueryResult> SearchPlacesAsync(
        string query,
        string? countryCode,
        CancellationToken cancellationToken) =>
        MapGeoLookupResult(await GeoLookup.SearchAsync(query, countryCode, cancellationToken).ConfigureAwait(false));

    private async Task<GeoPlaceQueryResult> SearchPlaceChildrenAsync(
        string parentId,
        CancellationToken cancellationToken) =>
        MapGeoLookupResult(await GeoLookup.GetChildrenAsync(parentId, cancellationToken).ConfigureAwait(false));

    private static GeoPlaceQueryResult MapGeoLookupResult(UiCapabilityResult<IReadOnlyList<GeoLookupOption>> result) =>
        result.Code == UiCapabilityResultCode.Success && result.Value is { } options
            ? new GeoPlaceQueryResult(true, options.Select(ToPlaceOption).ToList(), null)
            : new GeoPlaceQueryResult(false, [], result.Message ?? "Place search is temporarily unavailable.");

    private static GeoPlaceOption ToPlaceOption(GeoLookupOption option) => new(
        option.Id,
        option.Name,
        option.Kind.ToString(),
        option.CountryCode,
        option.CountryName,
        option.Ancestry,
        option.HasChildren,
        option.Ancestors.Select(ancestor => new GeoPlaceAncestor(ancestor.Id, ancestor.Name, ancestor.Kind.ToString())).ToList());

    private async Task LoadProcessingPolicyAsync()
    {
        try
        {
            var result = await ProcessingPolicyClient.GetPolicyAsync();
            if (result.Code != UiCapabilityResultCode.Success || result.Value is not { } policy)
            {
                return;
            }

            _processingPolicyReference = policy.Reference;
            _processingPolicyVersion = policy.Version;
            _processingPolicyNotice = result.Metadata.Notice;
            _processingPolicyNoticeText = policy.NoticeText;
            _processingPolicyAcknowledgementLabel = policy.AcknowledgementLabel;
            _processingPolicyIsLive = result.Metadata.IsAvailable &&
                result.Metadata.Provenance == UiCapabilityProvenance.LiveService;
        }
        catch (Exception)
        {
            _processingPolicyReference = null;
            _processingPolicyVersion = null;
            _processingPolicyNotice = null;
            _processingPolicyNoticeText = null;
            _processingPolicyAcknowledgementLabel = null;
            _processingPolicyIsLive = false;
        }
    }

    private async Task ReloadDraftsAsync()
    {
        _savedDrafts = (await SubmissionStore.GetAllAsync())
            .Where(item => item.State is GuestSubmissionLocalState.Draft or GuestSubmissionLocalState.NeedsAttention)
            .OrderByDescending(item => item.CreatedAtUtc)
            .ToArray();
    }

    private async Task RefreshDraftsSafelyAsync()
    {
        try { await ReloadDraftsAsync(); }
        catch (Exception) { _storageAvailable = false; }
    }

    private async Task RestoreDraftAsync(Guid draftId)
    {
        if (_sending || _savingDraft || draftId == Guid.Empty) return;
        try
        {
            var editable = await SubmissionStore.GetEditableDraftAsync(draftId);
            if (editable is { State: GuestSubmissionLocalState.Draft or GuestSubmissionLocalState.NeedsAttention })
            {
                _mobileDraft = PublicReportDraft.FromFormSnapshot(editable.FormSnapshot);
                _currentDraftId = editable.ClientSubmissionId;
            }
            else
            {
                var saved = await SubmissionStore.GetDraftAsync(draftId);
                if (saved is null || saved.State is not (GuestSubmissionLocalState.Draft or GuestSubmissionLocalState.NeedsAttention))
                {
                    _sendError = "That saved report is no longer available to resume.";
                    _sendErrorIsError = true;
                    await RefreshDraftsSafelyAsync();
                    return;
                }
                _mobileDraft = PublicReportDraft.FromSubmission(saved.Submission);
                _currentDraftId = saved.ClientSubmissionId;
            }
            _receipt = null;
            _activeServerValidationRevision = 0;
            _sendError = "Saved report restored on this device. Review it before sending.";
            _sendErrorIsError = false;
        }
        catch (Exception)
        {
            _sendError = "The saved report could not be restored. Your current entries remain on this screen.";
            _sendErrorIsError = true;
        }
    }

    private async Task SaveDraftAsync(PublicReportSaveRequest request)
    {
        if (_savingDraft || _sending || !_storageAvailable)
        {
            _sendError = "The draft could not be saved right now. Your entries remain on this screen.";
            _sendErrorIsError = true;
            throw new InvalidOperationException("The report draft cannot be saved right now.");
        }
        _savingDraft = true;
        try
        {
            var previousEditable = request.PreviousDraftId is { } previousId
                ? await SubmissionStore.GetEditableDraftAsync(previousId) : null;
            var previousDraft = request.PreviousDraftId is { } existingId && previousEditable is null
                ? await SubmissionStore.GetDraftAsync(existingId) : null;
            if (request.PreviousDraftId is not null && previousEditable is null && previousDraft is null)
                throw new InvalidOperationException("The saved draft is no longer available.");

            var summary = request.FormSnapshot is { } snapshot
                ? request.PreviousDraftId is { } editableId
                    ? await SubmissionStore.CreateEditableRevisionAsync(editableId, request.Submission, snapshot)
                    : await SubmissionStore.CreateEditableDraftAsync(request.Submission, snapshot)
                : request.PreviousDraftId is { } draftId
                    ? previousEditable is not null
                        ? await SubmissionStore.CompleteEditableDraftAsync(draftId, request.Submission)
                        : await SubmissionStore.CreateRevisionAsync(draftId, request.Submission)
                    : await SubmissionStore.CreateDraftAsync(request.Submission);

            request.ConfirmPersisted(summary.ClientSubmissionId, request.FormSnapshot is not null);
            _currentDraftId = summary.ClientSubmissionId;
            _sendError = "Your draft was saved on this device. It has not been sent.";
            _sendErrorIsError = false;
            await RefreshDraftsSafelyAsync();
        }
        catch (Exception)
        {
            _sendError = "This draft could not be saved safely. Your entries remain on this page.";
            _sendErrorIsError = true;
            throw;
        }
        finally { _savingDraft = false; }
    }

    private async Task SendReportAsync(IntakeSubmission submission)
    {
        submission = _submissionIdentity.Assign(submission);
        if (_sending || !_storageAvailable || !CanSubmitReport) return;
        _sending = true;
        _activeServerValidationRevision = 0;
        _receipt = null;
        var sourceDraft = _mobileDraft;
        var sourceSnapshot = System.Text.Json.JsonSerializer.Serialize(sourceDraft);
        try
        {
            var previousEditable = _currentDraftId is { } prior
                ? await SubmissionStore.GetEditableDraftAsync(prior) : null;
            var previous = _currentDraftId is { } existingId
                ? await SubmissionStore.GetAsync(existingId) : null;
            if (_currentDraftId is not null && previous is null)
                throw new InvalidOperationException("The saved report is no longer available.");

            var saved = _currentDraftId is { } draftId
                ? previousEditable is not null
                    ? await SubmissionStore.CompleteEditableDraftAsync(draftId, submission)
                    : await SubmissionStore.CreateRevisionAsync(draftId, submission)
                : await SubmissionStore.CreateDraftAsync(submission);
            _currentDraftId = saved.ClientSubmissionId;
            await SubmissionStore.QueueAsync(saved.ClientSubmissionId);
            await SubmissionCoordinator.SubmitPendingAsync();
            var result = await SubmissionStore.GetAsync(saved.ClientSubmissionId);
            if (result is { State: GuestSubmissionLocalState.Received, Receipt: not null } received &&
                received.Receipt.ReceiptId != Guid.Empty && received.Receipt.ClientSubmissionId == saved.ClientSubmissionId)
            {
                _receipt = received.Receipt;
                _currentDraftId = null;
                _mobileDraft = new PublicReportDraft { CapturedAt = DateTimeOffset.Now };
                _sendError = "SwiftAid confirmed receiving your report. Its receipt is shown below.";
                _sendErrorIsError = false;
                await RefreshDraftsSafelyAsync();
                return;
            }

            if (result?.State == GuestSubmissionLocalState.NeedsAttention)
            {
                if (ReferenceEquals(_mobileDraft, sourceDraft) &&
                    System.Text.Json.JsonSerializer.Serialize(_mobileDraft) == sourceSnapshot)
                    _activeServerValidationRevision = ++_serverValidationSequence;
                _sendError = "SwiftAid could not confirm this report and did not identify a specific field. Your saved entries remain on this device; return to Details to review the fields Ellai can validate.";
                _sendErrorIsError = true;
                await RefreshDraftsSafelyAsync();
                return;
            }

            _sendError = "Your report is saved on this device, but SwiftAid has not confirmed receiving it yet.";
            _sendErrorIsError = false;
        }
        catch (Exception)
        {
            _sendError = "We could not confirm whether the report was received. Your entries remain saved on this device.";
            _sendErrorIsError = true;
            await RefreshDraftsSafelyAsync();
        }
        finally { _sending = false; }
    }
    private bool _sendErrorIsError = true;

}
