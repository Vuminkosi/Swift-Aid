@page "/forgot-password"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Forgot password | SwiftAid</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small">
    <MudPaper Class="pa-4" Elevation="0">
        <SwiftAidPageHeading Eyebrow="Your SwiftAid account"
                             Title="Forgot your password?"
                             Description="Enter your registered email to request reset instructions."
                             HeadingId="forgot-password-heading" />

        @if (!string.IsNullOrEmpty(_notice))
        {
            <div role="status" aria-atomic="true">
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    <MudText>@_notice</MudText>
                </MudAlert>
            </div>
        }
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div role="alert" aria-atomic="true">
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    <MudText>@_errorMessage</MudText>
                </MudAlert>
            </div>
        }

        <MudTextField T="string" Label="Email address" @bind-Value="_email"
                      Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting"
                      InputType="InputType.Email" Immediate="true" autocomplete="email"
                      aria-label="Email address" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   OnClick="RequestAsync" Disabled="@(!CanSubmit)"
                   Class="auth-cta">
            @(_isSubmitting ? "Sending…" : "Send reset link")
        </MudButton>
        <MudButton Href="/sign-in" Variant="Variant.Text" Color="Color.Primary" FullWidth="true">
            Back to sign in
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private IJSObjectReference? _module;
    private bool _isSubmitting;
    private string? _email;
    private string? _notice;
    private string? _errorMessage;

    private bool CanSubmit =>
        !_isSubmitting && !string.IsNullOrWhiteSpace(_email);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _module is not null)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Pages/ForgotPassword.razor.js");
        }
        catch (JSException)
        {
            _errorMessage = "Password reset is temporarily unavailable. Please try again.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RequestAsync()
    {
        if (!CanSubmit || _module is null)
        {
            return;
        }

        _isSubmitting = true;
        _notice = null;
        _errorMessage = null;
        try
        {
            var result = await _module.InvokeAsync<ResetRequestResult>("requestPasswordReset", _email?.Trim());
            if (result.Ok)
            {
                _notice = result.Message ?? "If an account matches this address, reset instructions have been sent.";
            }
            else
            {
                _errorMessage = result.Message ?? "The reset request failed. Please try again.";
            }
        }
        catch (JSException)
        {
            _errorMessage = "Password reset is temporarily unavailable. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private sealed record ResetRequestResult(bool Ok, string? Message);
}
