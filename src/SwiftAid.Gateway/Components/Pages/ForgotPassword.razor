@page "/forgot-password"
@using System.ComponentModel.DataAnnotations
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Forgot password | SwiftAid</PageTitle>

<AccountEntrySurface>
    @if (_requestAccepted)
    {
        <PasswordResetRequestedSurface IsBusy="@_isSubmitting"
                                       ErrorMessage="@_errorMessage"
                                       OnResend="ResendAsync" />
    }
    else
    {
    <MudPaper Class="pa-4" Elevation="0">
        <SwiftAidPageHeading Eyebrow="Your SwiftAid account"
                             Title="Forgot your password?"
                             Description="Enter your registered email to request reset instructions."
                             HeadingId="forgot-password-heading" />

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div role="alert" aria-atomic="true">
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    <MudText>@_errorMessage</MudText>
                </MudAlert>
            </div>
        }

        <EditForm Model="_requestForm" OnSubmit="RequestAsync">
        <DataAnnotationsValidator />
        <MudTextField T="string" Label="Email address" @bind-Value="_requestForm.Email"
                      For="@(() => _requestForm.Email)"
                      Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting"
                      InputType="InputType.Email" Immediate="true" autocomplete="email"
                      aria-label="Email address" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   ButtonType="ButtonType.Submit" Disabled="@_isSubmitting"
                   Class="auth-cta">
            @(_isSubmitting ? "Sending…" : "Send reset link")
        </MudButton>
        </EditForm>
        <MudButton Href="/sign-in" Variant="Variant.Text" Color="Color.Primary" FullWidth="true">
            Back to sign in
        </MudButton>
    </MudPaper>
    }
</AccountEntrySurface>

@code {
    private IJSObjectReference? _module;
    private bool _isSubmitting;
    private bool _requestAccepted;
    private readonly ResetRequestForm _requestForm = new();
    private string? _errorMessage;

    private bool CanSubmit =>
        !_isSubmitting && !string.IsNullOrWhiteSpace(_requestForm.Email);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _module is not null)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Pages/ForgotPassword.razor.js");
        }
        catch (JSException)
        {
            _errorMessage = "Password reset is temporarily unavailable. Please try again.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RequestAsync(EditContext editContext)
    {
        if (!CanSubmit || _module is null || !editContext.Validate())
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            var result = await _module.InvokeAsync<ResetRequestResult>("requestPasswordReset", _requestForm.Email?.Trim());
            if (result.Ok)
            {
                _requestAccepted = true;
            }
            else
            {
                _errorMessage = result.Message ?? "The reset request failed. Please try again.";
            }
        }
        catch (JSException)
        {
            _errorMessage = "Password reset is temporarily unavailable. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task ResendAsync() => RequestAsync(new EditContext(_requestForm));

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private sealed record ResetRequestResult(bool Ok, string? Message);

    private sealed class ResetRequestForm
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [StringLength(256)]
        public string? Email { get; set; }
    }
}
