@page "/about"
@using SwiftAid.UI.Components.Surfaces.Public

<PageTitle>About | SwiftAid</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8 px-4">
    <AboutSurface AppVersion="@AppVersion"
                  PrivacyHref="/privacy"
                  TermsHref="/terms"
                  CommunityHref="/sessions" />
</MudContainer>

@code {
    private string AppVersion =>
        typeof(About).Assembly.GetName().Version?.ToString(3) ?? "unknown";
}
