@page "/sign-in-methods"
@using SwiftAid.UI.Components.Identity
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Sign-in methods | SwiftAid</PageTitle>

<LinkedSignInMethods ViewState="_viewState"
                     Linked="_linked"
                     AvailableToLink="_linkable"
                     RequestToken="@(_requestToken ?? string.Empty)"
                     UnlinkInProgress="_unlinkInProgress"
                     ReauthenticationRequired="_reauthRequired"
                     ReauthenticationProviderId="_reauthProviderId"
                     ReauthenticationDisplayName="_reauthDisplayName"
                     StatusMessage="_statusMessage"
                     StatusIsError="_statusIsError"
                     OnRefresh="ReloadAsync"
                     OnUnlink="UnlinkAsync" />

<MudMessageBox @ref="_unlinkBox" Title="Remove this sign-in method?">
    <MessageContent>
        You can still sign in with your other linked methods. At least one verified
        sign-in method must remain. Reports saved on this device stay here either way.
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary">Remove</MudButton>
    </YesButton>
    <NoButton>
        <MudButton Variant="Variant.Text" Color="Color.Primary">Keep it</MudButton>
    </NoButton>
</MudMessageBox>

@code {
    // Mirrors the server-authored messages in IdentityEndpoints so the page can
    // tell "prove it is you first" apart from "this is your last method".
    private const string ReauthenticationNeededMessage =
        "Reauthenticate with a linked provider before unlinking an account.";
    private const string LastLoginRouteMessage =
        "At least one verified sign-in method must remain linked.";

    [SupplyParameterFromQuery(Name = "linked")]
    private string? LinkedQuery { get; set; }

    [SupplyParameterFromQuery(Name = "reauthenticated")]
    private string? ReauthenticatedQuery { get; set; }

    private IJSObjectReference? _module;
    private LinkedIdentityViewState _viewState = LinkedIdentityViewState.Loading;
    private IReadOnlyList<LinkedIdentityRow> _linked = [];
    private IReadOnlyList<LinkableProviderRow> _linkable = [];
    private string? _requestToken;
    private bool _unlinkInProgress;
    private bool _reauthRequired;
    private string? _reauthProviderId;
    private string? _reauthDisplayName;
    private string? _statusMessage;
    private bool _statusIsError;
    private MudMessageBox? _unlinkBox;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Pages/SignInMethods.razor.js");
            await ReloadAsync();
        }
        catch (JSException)
        {
            _viewState = LinkedIdentityViewState.Unavailable;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReloadAsync()
    {
        if (_module is null || _unlinkInProgress)
        {
            return;
        }

        _viewState = LinkedIdentityViewState.Loading;
        _statusMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var snapshot = await _module.InvokeAsync<LinkedMethodsSnapshot>("loadLinkedMethods");
            ApplySnapshot(snapshot);
        }
        catch (JSException)
        {
            _viewState = LinkedIdentityViewState.Unavailable;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ApplySnapshot(LinkedMethodsSnapshot snapshot)
    {
        if (string.Equals(snapshot.State, "signedOut", StringComparison.OrdinalIgnoreCase))
        {
            _viewState = LinkedIdentityViewState.SignedOut;
            return;
        }

        if (!string.Equals(snapshot.State, "ready", StringComparison.OrdinalIgnoreCase) ||
            snapshot.Linked is null ||
            string.IsNullOrWhiteSpace(snapshot.RequestToken))
        {
            _viewState = LinkedIdentityViewState.Unavailable;
            return;
        }

        var names = (snapshot.Providers ?? [])
            .Where(provider => !string.IsNullOrWhiteSpace(provider.Id))
            .ToDictionary(provider => provider.Id, provider => provider, StringComparer.Ordinal);
        _requestToken = snapshot.RequestToken;
        _linked = snapshot.Linked
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .Distinct(StringComparer.Ordinal)
            .OrderBy(id => id, StringComparer.Ordinal)
            .Select(id => new LinkedIdentityRow(
                id,
                names.TryGetValue(id, out var known) &&
                    !string.IsNullOrWhiteSpace(known.DisplayName)
                    ? known.DisplayName
                    : id,
                names.TryGetValue(id, out var current) && current.Available))
            .ToArray();
        var linkedIds = new HashSet<string>(_linked.Select(row => row.Id), StringComparer.Ordinal);
        _linkable = names.Values
            .Where(provider => provider.Available && !linkedIds.Contains(provider.Id))
            .OrderBy(provider => provider.DisplayName, StringComparer.OrdinalIgnoreCase)
            .Select(provider => new LinkableProviderRow(provider.Id, provider.DisplayName))
            .ToArray();
        _viewState = LinkedIdentityViewState.Ready;

        if (!string.IsNullOrWhiteSpace(LinkedQuery) && linkedIds.Contains(LinkedQuery))
        {
            _statusMessage = $"{DisplayNameOf(LinkedQuery)} sign-in linked.";
            _statusIsError = false;
        }
        else if (!string.IsNullOrWhiteSpace(ReauthenticatedQuery))
        {
            _statusMessage = "Identity confirmed. You can now change sign-in methods.";
            _statusIsError = false;
        }
    }

    private string DisplayNameOf(string providerId) =>
        _linked.FirstOrDefault(row => string.Equals(row.Id, providerId, StringComparison.Ordinal))?.DisplayName
        ?? providerId;

    private async Task UnlinkAsync(string providerId)
    {
        if (_unlinkInProgress || _module is null || string.IsNullOrWhiteSpace(_requestToken))
        {
            return;
        }

        bool confirmed;
        try
        {
            confirmed = _unlinkBox is null || await _unlinkBox.ShowAsync() == true;
        }
        catch (JSException)
        {
            return;
        }

        if (!confirmed)
        {
            return;
        }

        _unlinkInProgress = true;
        _statusMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await _module.InvokeAsync<UnlinkResult>(
                "unlinkProvider", providerId, _requestToken);
            if (result.Ok)
            {
                _statusMessage = $"{DisplayNameOf(providerId)} sign-in removed.";
                _statusIsError = false;
                _reauthRequired = false;
                _unlinkInProgress = false;
                await ReloadAsync();
                return;
            }

            if (result.Status == 401)
            {
                _viewState = LinkedIdentityViewState.SignedOut;
                return;
            }

            if (result.Status == 409 &&
                string.Equals(result.Message, LastLoginRouteMessage, StringComparison.Ordinal))
            {
                _statusMessage = result.Message;
                _statusIsError = true;
                return;
            }

            if (result.Status == 409 &&
                string.Equals(result.Message, ReauthenticationNeededMessage, StringComparison.Ordinal))
            {
                _reauthRequired = true;
                _reauthProviderId = providerId;
                _reauthDisplayName = DisplayNameOf(providerId);
                _statusMessage = result.Message;
                _statusIsError = true;
                return;
            }

            _statusMessage = !string.IsNullOrWhiteSpace(result.Message)
                ? result.Message
                : "Removing this sign-in method is unavailable right now. Try again later.";
            _statusIsError = true;
        }
        catch (JSException)
        {
            _statusMessage = "Removing this sign-in method is unavailable right now. Try again later.";
            _statusIsError = true;
        }
        finally
        {
            _unlinkInProgress = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSException)
            {
            }
        }
    }

    private sealed class LinkedMethodsSnapshot
    {
        public string State { get; set; } = string.Empty;
        public string[]? Linked { get; set; }
        public ProviderChoice[]? Providers { get; set; }
        public string? RequestToken { get; set; }
    }

    private sealed class ProviderChoice
    {
        public string Id { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public bool Available { get; set; }
    }

    private sealed class UnlinkResult
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string? Message { get; set; }
    }
}
