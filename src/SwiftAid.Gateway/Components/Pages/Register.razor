@page "/register"
@using System.ComponentModel.DataAnnotations
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Create account | SwiftAid</PageTitle>

<div class="register-page">
<AccountEntrySurface>
    <MudPaper Class="pa-4" Elevation="0">
        <SwiftAidPageHeading Eyebrow="Your SwiftAid account"
                             Title="Create an account"
                             Description="Join SwiftAid to support healthier communities."
                             HeadingId="register-heading" />

        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-hidden="true" />
            <MudText Typo="Typo.body2">Checking registration requirements…</MudText>
        }

        @if (!string.IsNullOrEmpty(_errorMessage) || _isRetrying)
        {
            <div role="alert" aria-atomic="true">
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    <MudText>@_errorMessage</MudText>
                </MudAlert>
            </div>
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       OnClick="RetryOptionsAsync"
                       Disabled="@_isLoading"
                       aria-busy="@_isLoading"
                       StartIcon="@Icons.Material.Filled.Refresh">
                Try again
            </MudButton>
        }

        @if (!_isLoading && string.IsNullOrEmpty(_errorMessage) && !_passwordSignInAvailable)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                Account registration is currently unavailable. You can still continue without an account.
            </MudAlert>
            <MudButton Href="@SignInHref" Variant="Variant.Text" Color="Color.Primary" FullWidth="true">
                Return to sign in
            </MudButton>
            <MudButton Href="/report" Variant="Variant.Text" Color="Color.Primary" FullWidth="true">
                Continue without an account
            </MudButton>
        }

        @if (!_isLoading && string.IsNullOrEmpty(_errorMessage) && _passwordSignInAvailable)
        {
            <EditForm Model="_registrationForm" OnSubmit="RegisterAsync">
            <DataAnnotationsValidator />
            <MudTextField T="string" Label="Full name" @bind-Value="_registrationForm.DisplayName"
                          For="@(() => _registrationForm.DisplayName)"
                          Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting"
                          Immediate="true" MaxLength="128" autocomplete="name"
                          aria-label="Full name" />
            <MudTextField T="string" Label="Email address" @bind-Value="_registrationForm.Email"
                          For="@(() => _registrationForm.Email)"
                          Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting"
                          InputType="InputType.Email" Immediate="true" autocomplete="email"
                          aria-label="Email address" />
            <MudTextField T="string" Label="Password" @bind-Value="_registrationForm.Password"
                          For="@(() => _registrationForm.Password)"
                          Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="() => _showPassword = !_showPassword"
                          Immediate="true" MaxLength="256" autocomplete="new-password"
                          aria-label="Password" />
            <MudText Typo="Typo.caption">@_policyHint</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       ButtonType="ButtonType.Submit" Disabled="@(_isLoading || _isSubmitting)"
                       Class="auth-cta">
                @(_isSubmitting ? "Creating account…" : "Sign up")
            </MudButton>
            <MudStack Row="true" Spacing="2" Justify="Justify.Center" Class="register-legal-links">
                <MudLink Href="/privacy">Privacy</MudLink>
                <MudLink Href="/terms">Terms</MudLink>
            </MudStack>
            <MudDivider Class="my-2" />
            <MudButton Href="@SignInHref" Variant="Variant.Text" Color="Color.Primary" FullWidth="true">
                Already have an account? Sign in
            </MudButton>
            </EditForm>
        }

        <p class="register-live-status" role="status" aria-live="polite" aria-atomic="true" tabindex="-1">@_liveMessage</p>
    </MudPaper>
</AccountEntrySurface>
</div>

@code {
    private IJSObjectReference? _module;
    private bool _isLoading = true;
    private bool _passwordSignInAvailable;
    private bool _isRetrying;
    private bool _focusStatusAfterOptionsLoad;
    private bool _isSubmitting;
    private bool _showPassword;
    private readonly RegistrationForm _registrationForm = new();
    private string? _errorMessage;
    private string _liveMessage = string.Empty;
    private string _policyHint = string.Empty;
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? RequestedReturnUrl { get; set; }
    private string SafeReturnUrl => SwiftAid.Client.Navigation.LocalReturnUrlPolicy.Resolve(RequestedReturnUrl, "/");
    private string SignInHref => $"/sign-in?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";

    private bool CanSubmit =>
        !_isLoading && !_isSubmitting &&
        !string.IsNullOrWhiteSpace(_registrationForm.Email) &&
        !string.IsNullOrWhiteSpace(_registrationForm.Password);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusStatusAfterOptionsLoad && _module is not null)
        {
            _focusStatusAfterOptionsLoad = false;
            await _module.InvokeVoidAsync("focusRegistrationStatus");
        }

        if (firstRender)
        {
            await LoadRegistrationOptionsAsync(isRetry: false);
        }
    }

    private Task RetryOptionsAsync() => _isLoading ? Task.CompletedTask : LoadRegistrationOptionsAsync(isRetry: true);

    private async Task LoadRegistrationOptionsAsync(bool isRetry)
    {
        _isLoading = true;
        _isRetrying = isRetry;
        _liveMessage = isRetry ? "Checking registration availability." : string.Empty;
        if (!isRetry)
        {
            _errorMessage = null;
        }

        await InvokeAsync(StateHasChanged);
        try
        {
            if (_module is null)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./Components/Pages/Register.razor.js");
            }

            var options = await _module.InvokeAsync<RegistrationOptionsResult>("loadRegistrationOptions");
            _errorMessage = null;
            _passwordSignInAvailable = options.PasswordSignInAvailable;
            if (_passwordSignInAvailable)
            {
                _policyHint = BuildHint(options.Policy ?? throw new JSException("Password policy is missing."));
                _liveMessage = "Registration is available.";
            }
            else
            {
                _liveMessage = "Account registration is unavailable. You can return to sign in or continue without an account.";
            }
        }
        catch (JSException)
        {
            _passwordSignInAvailable = false;
            _errorMessage = "Registration options could not be loaded. Try again.";
            _liveMessage = "Registration options could not be loaded. Use Try again to retry.";
        }
        finally
        {
            _isLoading = false;
            _isRetrying = false;
            _focusStatusAfterOptionsLoad = isRetry;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RegisterAsync(EditContext editContext)
    {
        if (!CanSubmit || _module is null || !editContext.Validate())
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        _liveMessage = "Creating your account.";
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await _module.InvokeAsync<PasswordAuthResult>(
                "register",
                _registrationForm.DisplayName?.Trim(),
                _registrationForm.Email?.Trim(),
                _registrationForm.Password);
            if (result.Ok)
            {
                _liveMessage = "Account created. Taking you to SwiftAid.";
                Navigation.NavigateTo($"/welcome-complete?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}", forceLoad: true);
                return;
            }

            _errorMessage = string.IsNullOrWhiteSpace(result.Error)
                ? "Registration failed. Please try again."
                : result.Error;
            _liveMessage = string.Empty;
        }
        catch (JSException)
        {
            _errorMessage = "Registration is temporarily unavailable. Please try again.";
            _liveMessage = string.Empty;
        }
        finally
        {
            _isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string BuildHint(PasswordPolicyResult policy)
    {
        var parts = new List<string> { $"at least {Math.Max(1, policy.MinimumLength)} characters" };
        if (policy.RequireDigit)
        {
            parts.Add("a number");
        }

        if (policy.RequireLowercase)
        {
            parts.Add("a lowercase letter");
        }

        if (policy.RequireUppercase)
        {
            parts.Add("an uppercase letter");
        }

        if (policy.RequireSymbol)
        {
            parts.Add("a symbol");
        }

        return $"Use {string.Join(", ", parts)}. Signing up does not grant staff access.";
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private sealed record PasswordPolicyResult(
        int MinimumLength,
        bool RequireDigit,
        bool RequireLowercase,
        bool RequireUppercase,
        bool RequireSymbol);

    private sealed record RegistrationOptionsResult(
        bool PasswordSignInAvailable,
        PasswordPolicyResult? Policy);

    private sealed record PasswordAuthResult(bool Ok, string? Error);

    private sealed class RegistrationForm
    {
        [Required(ErrorMessage = "Enter your full name.")]
        [StringLength(128, ErrorMessage = "Your name must be 128 characters or fewer.")]
        public string? DisplayName { get; set; }

        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [StringLength(256)]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Enter a password.")]
        [StringLength(256)]
        public string? Password { get; set; }
    }
}
