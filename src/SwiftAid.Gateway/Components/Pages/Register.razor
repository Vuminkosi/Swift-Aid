@page "/register"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Create account | SwiftAid</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="register-page">
    <MudPaper Class="pa-4" Elevation="0">
        <SwiftAidPageHeading Eyebrow="Your SwiftAid account"
                             Title="Create an account"
                             Description="Join SwiftAid to support healthier communities."
                             HeadingId="register-heading" />

        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-hidden="true" />
            <MudText Typo="Typo.body2">Checking registration requirements…</MudText>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div role="alert" aria-atomic="true">
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    <MudText>@_errorMessage</MudText>
                </MudAlert>
            </div>
        }

        @if (!_isLoading)
        {
            <MudTextField T="string" Label="Email address" @bind-Value="_email"
                          Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting"
                          InputType="InputType.Email" Immediate="true" aria-label="Email address" />
            <MudTextField T="string" Label="Password" @bind-Value="_password"
                          Variant="Variant.Outlined" Required="true" Disabled="@_isSubmitting"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="() => _showPassword = !_showPassword"
                          Immediate="true" aria-label="Password" />
            <MudText Typo="Typo.caption">@_policyHint</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="RegisterAsync" Disabled="@(!CanSubmit)">
                @(_isSubmitting ? "Creating account…" : "Sign up")
            </MudButton>
            <MudDivider Class="my-2" />
            <MudButton Href="/sign-in" Variant="Variant.Text" Color="Color.Primary" FullWidth="true">
                Already have an account? Sign in
            </MudButton>
        }

        <p class="register-live-status" role="status" aria-live="polite">@_liveMessage</p>
    </MudPaper>
</MudContainer>

@code {
    private IJSObjectReference? _module;
    private bool _isLoading = true;
    private bool _isSubmitting;
    private bool _showPassword;
    private string? _email;
    private string? _password;
    private string? _errorMessage;
    private string _liveMessage = string.Empty;
    private string _policyHint = "Use at least 8 characters with a number and symbol.";
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? RequestedReturnUrl { get; set; }

    private bool CanSubmit =>
        !_isLoading && !_isSubmitting &&
        !string.IsNullOrWhiteSpace(_email) &&
        !string.IsNullOrWhiteSpace(_password);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Pages/Register.razor.js");
            var policy = await _module.InvokeAsync<PasswordPolicyResult>("loadPasswordPolicy");
            _policyHint = BuildHint(policy);
        }
        catch (JSException)
        {
            _errorMessage = "Registration is temporarily unavailable. Please try again.";
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RegisterAsync()
    {
        if (!CanSubmit || _module is null)
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        _liveMessage = "Creating your account.";
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await _module.InvokeAsync<PasswordAuthResult>(
                "register",
                _email?.Trim(),
                _password);
            if (result.Ok)
            {
                _liveMessage = "Account created. Taking you to SwiftAid.";
                Navigation.NavigateTo("/welcome-complete", forceLoad: true);
                return;
            }

            _errorMessage = string.IsNullOrWhiteSpace(result.Error)
                ? "Registration failed. Please try again."
                : result.Error;
            _liveMessage = string.Empty;
        }
        catch (JSException)
        {
            _errorMessage = "Registration is temporarily unavailable. Please try again.";
            _liveMessage = string.Empty;
        }
        finally
        {
            _isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string BuildHint(PasswordPolicyResult policy)
    {
        var parts = new List<string> { $"at least {Math.Max(1, policy.MinimumLength)} characters" };
        if (policy.RequireDigit)
        {
            parts.Add("a number");
        }

        if (policy.RequireSymbol)
        {
            parts.Add("a symbol");
        }

        return $"Use {string.Join(", ", parts)}. Signing up does not grant staff access.";
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private sealed record PasswordPolicyResult(
        int MinimumLength,
        bool RequireDigit,
        bool RequireLowercase,
        bool RequireUppercase,
        bool RequireSymbol);

    private sealed record PasswordAuthResult(bool Ok, string? Error);
}
