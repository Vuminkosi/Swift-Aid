@page "/managed-report"

<PageTitle>Managed report registration | SwiftAid</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="managed-report-page">
    <SwiftAidPageHeading Eyebrow="Managed case reporting"
                         Title="Registration unavailable"
                         Description="A trusted staff identity and registration service are not connected in this browser. This page does not accept report details."
                         HeadingId="managed-report-heading" />

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
        Managed report registration is unavailable here. No report details can be entered or registered from this page.
    </MudAlert>
</MudContainer>
