{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiftaid.online/contracts/intake/intake-session-request.v1.schema.json",
  "title": "SwiftAid guest intake session request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "receiptProof"],
  "properties": {
    "sessionId": { "type": "string", "format": "uuid" },
    "receiptProof": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
  }
}
