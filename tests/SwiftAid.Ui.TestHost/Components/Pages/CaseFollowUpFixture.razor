@page "/case-follow-up-fixture"
@using SwiftAid.Contracts.Cases
@using SwiftAid.UI.Components.Surfaces.Operations
@using SwiftAid.UI.Components.Surfaces.Operations.WorkManagement
@using static SwiftAid.UI.Components.Surfaces.Operations.WorkManagement.OperationsWorkManagementSurface

<SwiftAidThemeProvider />
<MudPopoverProvider />
<output id="fixture-ready">@_ready</output>
<output id="request-result">@_result</output>
    <output id="outcome-request">@_outcomeRequest</output>
<OperationsWorkManagementSurface Title="Follow-ups" Description="Synthetic follow-up acknowledgement scenario."
                                 State="OperationsSurfaceState.Populated" Items="Items" CandidatesClient="_candidateClient" OnAction="RecordAction" />

@code {
    private static readonly Guid CaseId = Guid.Parse("b2210000-2222-4222-8222-222222222222");
    private static readonly Guid FollowUpId = Guid.Parse("f4410000-4444-4444-8444-444444444444");
    [SupplyParameterFromQuery(Name = "Schedule")] public bool ScheduleMode { get; set; }
    [SupplyParameterFromQuery(Name = "Outcome")] public bool OutcomeMode { get; set; }
    private bool _ready;
    private string _result = "Scheduled";
    private string _outcomeRequest = "None";
    private readonly ICaseCollaboratorCandidatesClient _candidateClient = new SyntheticCandidateClient();
    private IReadOnlyList<OperationsWorkItem> Items => ScheduleMode
        ?
        [
            new OperationsWorkItem(CaseId, "new", 7, "SYNTHETIC-CASE", OperationsWorkKind.FollowUp,
                OperationsWorkStatus.Scheduled, OperationsAssignmentStatus.AssignedToYou, "Call reporting worker",
                DateTimeOffset.UtcNow, null, [OperationsWorkAction.ScheduleFollowUp], [], null)
        ]
        : OutcomeMode
            ? [new OperationsWorkItem(CaseId, $"fu:{FollowUpId:D}", 7, "SYNTHETIC-CASE", OperationsWorkKind.FollowUp,
                OperationsWorkStatus.Acknowledged, OperationsAssignmentStatus.AssignedToYou, "Call reporting worker",
                DateTimeOffset.UtcNow, DateTimeOffset.UtcNow.AddDays(1), [OperationsWorkAction.RecordFollowUpOutcome], [], null)]
            : _items;
    private IReadOnlyList<OperationsWorkItem> _items =
    [
        new OperationsWorkItem(CaseId, $"fu:{FollowUpId:D}", 7, "SYNTHETIC-CASE", OperationsWorkKind.FollowUp,
            OperationsWorkStatus.Scheduled, OperationsAssignmentStatus.AssignedToYou, "Call reporting worker",
            DateTimeOffset.UtcNow, DateTimeOffset.UtcNow.AddDays(1), [OperationsWorkAction.AcknowledgeFollowUp], [], null)
    ];

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { _ready = true; StateHasChanged(); }
    }

    private void RecordAction(OperationsWorkActionRequest request)
    {
        if (OutcomeMode)
        {
            if (request.CaseId != CaseId || request.WorkKey != $"fu:{FollowUpId:D}" || request.ExpectedVersion != 7 ||
                request.Action != OperationsWorkAction.RecordFollowUpOutcome)
                throw new InvalidOperationException("Unexpected synthetic follow-up outcome request.");

            _outcomeRequest = $"{request.FollowUpOutcome}:{request.NewDueAtUtc:O}:{request.LocalTimeZoneId}:{request.LocalOffset}";
            return;
        }

        if (request.CaseId != CaseId || request.WorkKey != $"fu:{FollowUpId:D}" || request.ExpectedVersion != 7 ||
            request.Action != OperationsWorkAction.AcknowledgeFollowUp)
            throw new InvalidOperationException("Unexpected synthetic follow-up acknowledgement.");

        _result = "Acknowledged";
        _items =
        [
            new OperationsWorkItem(CaseId, $"fu:{FollowUpId:D}", 8, "SYNTHETIC-CASE", OperationsWorkKind.FollowUp,
                OperationsWorkStatus.Acknowledged, OperationsAssignmentStatus.AssignedToYou, "Call reporting worker",
                DateTimeOffset.UtcNow, DateTimeOffset.UtcNow.AddDays(1),
                [OperationsWorkAction.RescheduleFollowUp, OperationsWorkAction.RecordFollowUpOutcome, OperationsWorkAction.CancelFollowUp], [], null)
        ];
    }

    private sealed class SyntheticCandidateClient : ICaseCollaboratorCandidatesClient
    {
        public Task<CaseCollaboratorCandidatePage?> GetAsync(Guid caseId, string? search, string? after,
            CancellationToken cancellationToken = default, bool followUpAssignees = false)
        {
            IReadOnlyList<CaseCollaboratorCandidate> candidates = followUpAssignees &&
                (string.IsNullOrWhiteSpace(search) || "Synthetic colleague".Contains(search, StringComparison.OrdinalIgnoreCase))
                ? [new("synthetic-grant", "synthetic-follow-up-worker", "Synthetic colleague", ["ReadCase", "ManageFollowUp"])]
                : [];
            return Task.FromResult<CaseCollaboratorCandidatePage?>(new(candidates, null));
        }
    }
}
