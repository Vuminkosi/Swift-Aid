@page "/shared-surfaces"
@using SwiftAid.Contracts.Cases
@using SwiftAid.Contracts.Geography
@using SwiftAid.Contracts.Intake
@using SwiftAid.Contracts.Sessions
@using SwiftAid.UI.Components.Public
@using SwiftAid.UI.Components.Surfaces.Public
@using SwiftAid.UI.Components.Surfaces.Shell
@using SwiftAid.UI.Components.Theme

<PageTitle>Shared SwiftAid surfaces fixture</PageTitle>

<SwiftAidThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<SwiftAidApplicationShell BrandName="SwiftAid"
                          HomeHref="/shared-surfaces"
                          PageLabel="Shared surfaces fixture"
                          MainContentId="shared-surfaces-main"
                          DesktopNavigation="@DesktopLinks"
                          MobileNavigation="@MobileLinks"
                          HeaderActions="@HeaderActions">
    <ChildContent>
        <div class="shared-surfaces-fixture">
            <header class="shared-surfaces-fixture__heading">
                <h1>Shared surfaces verification</h1>
                <p>Local test fixture only. Report edits stay in memory; no service, storage, receipt, or account is connected.</p>
            </header>

            <section id="shared-home" aria-label="Public home surface" data-testid="public-home-surface">
                <PublicHomeSurface IsSignedIn="false" CaseQueueClient="_unusedSignedInQueueClient" />
            </section>

            <section id="shared-report" aria-label="Public report surface" data-testid="public-report-surface">
                <PublicReportSurface Draft="_reportDraft"
                                     Countries="_countries"
                                     CountryCatalogueVersion="fixture-country-catalogue-v1"
                                     CountryCatalogueIsCurrent="true"
                                     ProcessingPolicyReference="testhost-synthetic-only"
                                     ProcessingPolicyVersion="fixture-v1"
                                     PrivacyNoticeIsCurrent="false"
                                     DraftSavingAvailable="false"
                                     SubmitAvailable="true"
                                     IsDevelopmentScenario="true"
                                     DevelopmentScenarioStatus="@_developmentScenarioStatus"
                                     DevelopmentReceiptReference="@_developmentReceiptReference"
                                     OnSendReport="CompleteDemoReportAsync" />
                <p data-testid="demo-report-memory-status" role="status" aria-live="polite">
                    @(_lastDemoSubmission is null ? "No fixture submission recorded." : "The typed submission is held in this page memory only.")
                </p>
            </section>

            <section id="shared-sessions" aria-label="Public sessions surface" data-testid="public-sessions-surface">
                <PublicSessionsSurface Sessions="_demoSessions"
                                       IsDevelopmentScenario="true"
                                       EnableDemoSubscriptionActions="true"
                                       DemoSubscriptionSessionId="_demoSubscriptionSessionId"
                                       DemoSubscriptionActive="_demoSubscriptionActive"
                                       DemoActionStatus="@_demoSessionStatus"
                                       OnDemoSubscribe="SubscribeDemoSessionAsync"
                                       OnDemoUnsubscribe="UnsubscribeDemoSessionAsync" />
                <p data-testid="demo-session-memory-status" role="status" aria-live="polite">
                    @(_demoSessionStatus ?? "No synthetic subscription action has been recorded in this page session.")
                </p>
            </section>

            <section id="shared-education" aria-label="Synthetic process education surface" data-testid="synthetic-education-surface">
                <p>TestHost-only, synthetic process and privacy materials. Search changes this in-memory fixture list; no health guidance or offline save is provided.</p>
                <EducationSurface Materials="@VisibleEducationResources"
                                  Query="_educationQuery"
                                  IsAvailable="true"
                                  IsSynthetic="true"
                                  TotalCount="@VisibleEducationResources.Count"
                                  OnQueryChanged="ChangeEducationQueryAsync"
                                  OnViewContent="ViewSyntheticEducationContentAsync" />
                <p data-testid="education-fixture-state" role="status" aria-live="polite">@_educationFixtureStatus</p>
            </section>

            <section id="shared-state-transitions" class="shared-surfaces-fixture__states" aria-label="State transition controls">
                <h2>Loading to empty or information</h2>
                <div class="shared-surfaces-fixture__controls">
                    <button type="button" data-testid="loading-to-empty" @onclick="ShowEmptyState">Show empty state</button>
                    <button type="button" data-testid="loading-to-information" @onclick="ShowInformationState">Show information state</button>
                    <button type="button" data-testid="reset-loading-state" @onclick="ResetLoadingState">Reset to loading</button>
                </div>
                <div data-testid="loading-transition-panel">
                    <SwiftAidStatePanel State="_loadingState"
                                        Title="Synthetic reports loading"
                                        Description="Waiting for this fixture state transition.">
                        <ChildContent>
                            <p data-testid="loading-transition-populated">The fixture data is ready.</p>
                        </ChildContent>
                    </SwiftAidStatePanel>
                </div>

                <h2>Populated to empty</h2>
                <button type="button" data-testid="populated-to-empty" @onclick="ShowEmptyQueue">Show empty state</button>
                <div data-testid="populated-transition-panel">
                    <SwiftAidStatePanel State="_populatedState"
                                        Title="Synthetic queue is empty"
                                        Description="No live queue was queried.">
                        <ChildContent>
                            <p data-testid="populated-transition-content">Synthetic fixture queue has one visible example.</p>
                        </ChildContent>
                    </SwiftAidStatePanel>
                </div>
            </section>

            <section id="shared-draft-probe" aria-label="Shared report draft probe" data-testid="shared-draft-probe">
                <h2>Shared report draft, in memory</h2>
                <p>The desktop form and mobile stepper receive the same draft object. This probe displays its current narrative without saving it.</p>
                <button type="button" data-testid="capture-shared-draft" @onclick="CaptureDraft">Read current draft</button>
                <output data-testid="shared-draft-value" aria-live="polite">@_observedDraftNarrative</output>
            </section>
        </div>
    </ChildContent>
</SwiftAidApplicationShell>

@code {
    // Signed-out PublicHomeSurface never requests the privileged case queue; null is deliberate here.
    private ICaseQueueClient _unusedSignedInQueueClient = null!;
    private readonly PublicReportDraft _reportDraft = new()
    {
        SubjectScope = IntakeSubjectScope.Human,
        Narrative = "Synthetic fixture narrative. No person or animal is represented.",
        ReportReviewConfirmed = true,
        CountryCode = "ZW",
        CountryConfirmed = true,
        LocationUnknown = false
    };
    private readonly IReadOnlyList<PublicCountryOption> _countries =
    [
        new("ZW", "Zimbabwe"),
        new("SZ", "Eswatini")
    ];
    private readonly IReadOnlyList<PublicSessionView> _demoSessions =
    [
        new(
            Guid.Parse("f7663b33-aee7-47a8-9b9d-5b1d3ab8fc01"),
            1,
            "Synthetic community session",
            "A fixture-only listing for testing the public sessions surface.",
            "Community members",
            ["fixture"],
            "ZW",
            "fixture-region",
            "community",
            "Demo presenter",
            "English",
            DateTimeOffset.UtcNow.AddDays(7),
            "Africa/Harare",
            45,
            null,
            [],
            SessionChannelType.None,
            null,
            "Published",
            null,
            1)
    ];
    private SwiftAidViewState _loadingState = SwiftAidViewState.Loading;
    private SwiftAidViewState _populatedState = SwiftAidViewState.Populated;
    private string _observedDraftNarrative = "No draft read yet.";
    private string _developmentScenarioStatus = "Synthetic test fixture only. Submitting records this draft in page memory; no request or persistence occurs.";
    private string? _developmentReceiptReference;
    private IntakeSubmission? _lastDemoSubmission;
    private Guid? _demoSubscriptionSessionId;
    private bool _demoSubscriptionActive;
    private string? _demoSessionStatus;
    private EducationBrowseRequest _educationQuery = new();
    private string _educationFixtureStatus = "Synthetic process material list; offline save and download are unavailable.";
    private IReadOnlyList<EducationMaterialPresentation> _educationResources =
    [
        new(
            "fixture-privacy-process",
            "Privacy notice review process",
            "A fixed, nonclinical checklist for reviewing privacy notice versions.",
            "Privacy process",
            "English",
            "Synthetic TestHost fixture",
            "fixture-v1",
            IsApproved: false,
            IsAvailableOffline: false,
            OfflineState: EducationOfflinePresentationState.Unavailable,
            ReviewStatus: "Synthetic only; not reviewed",
            ReuseRights: "No reuse-rights claim",
            IsSyntheticNonclinical: true),
        new(
            "fixture-evidence-process",
            "Evidence handling process",
            "A fixed, nonclinical checklist for labeling unknown evidence accurately.",
            "Evidence process",
            "English",
            "Synthetic TestHost fixture",
            "fixture-v1",
            IsApproved: false,
            IsAvailableOffline: false,
            OfflineState: EducationOfflinePresentationState.Unavailable,
            ReviewStatus: "Synthetic only; not reviewed",
            ReuseRights: "No reuse-rights claim",
            IsSyntheticNonclinical: true)
    ];

    private RenderFragment DesktopLinks => @<div class="shared-surfaces-fixture__desktop-links">
        <a href="#shared-home">Home</a>
        <a href="#shared-report">Report</a>
        <a href="#shared-sessions">Sessions</a>
        <a href="#shared-education">Education</a>
        <a href="#shared-state-transitions">State transitions</a>
        <a href="#shared-draft-probe">Draft probe</a>
        <a href="#populated-transition-content">Queue example</a>
    </div>;

    private RenderFragment MobileLinks => @<div class="shared-surfaces-fixture__mobile-links">
        <a href="#shared-home">Home</a>
        <a href="#shared-report">Report</a>
        <a href="#shared-sessions">Sessions</a>
        <a href="#shared-education">Education</a>
        <a href="#shared-state-transitions">States</a>
        <a href="#shared-draft-probe">Draft</a>
    </div>;

    private IReadOnlyList<EducationMaterialPresentation> VisibleEducationResources => _educationResources
        .Where(material => string.IsNullOrWhiteSpace(_educationQuery.Search) ||
            material.Title.Contains(_educationQuery.Search, StringComparison.OrdinalIgnoreCase) ||
            material.Summary.Contains(_educationQuery.Search, StringComparison.OrdinalIgnoreCase))
        .Where(material => string.IsNullOrWhiteSpace(_educationQuery.Category) ||
            string.Equals(material.Category, _educationQuery.Category, StringComparison.OrdinalIgnoreCase))
        .Where(material => !_educationQuery.OfflineOnly || material.IsAvailableOffline)
        .ToArray();

    private RenderFragment HeaderActions => @<span data-testid="shared-shell-status">Synthetic test fixture</span>;

    private void ShowEmptyState() => _loadingState = SwiftAidViewState.Empty;

    private void ShowInformationState() => _loadingState = SwiftAidViewState.Information;

    private void ResetLoadingState() => _loadingState = SwiftAidViewState.Loading;

    private void ShowEmptyQueue() => _populatedState = SwiftAidViewState.Empty;

    private void CaptureDraft()
    {
        _observedDraftNarrative = _reportDraft.Narrative ?? "Unknown";
    }

    private Task CompleteDemoReportAsync(IntakeSubmission submission)
    {
        _lastDemoSubmission = submission;
        _developmentReceiptReference = "DEMO-TESTHOST-001";
        _developmentScenarioStatus = "Synthetic demo completion in this page session. No service request, server record, or persistence occurred.";
        return Task.CompletedTask;
    }

    private Task SubscribeDemoSessionAsync(Guid sessionId)
    {
        _demoSubscriptionSessionId = sessionId;
        _demoSubscriptionActive = true;
        _demoSessionStatus = "Synthetic demo subscription active in this page session only. No service request, account, reminder, or attendance record was created.";
        return Task.CompletedTask;
    }

    private Task UnsubscribeDemoSessionAsync(Guid sessionId)
    {
        _demoSubscriptionSessionId = sessionId;
        _demoSubscriptionActive = false;
        _demoSessionStatus = "Synthetic demo subscription removed in this page session only. No real subscription changed.";
        return Task.CompletedTask;
    }

    private Task ChangeEducationQueryAsync(EducationBrowseRequest request)
    {
        _educationQuery = request;
        _educationFixtureStatus = "Search and filters updated the synthetic fixture list in page memory only.";
        return Task.CompletedTask;
    }

    private Task ViewSyntheticEducationContentAsync(EducationMaterialVersionPresentation request)
    {
        _educationResources = _educationResources
            .Select(material => material.Id == request.MaterialId
                ? material with
                {
                    Content = "Synthetic process text only: record the source version and keep unknown facts marked as unknown.",
                    ContentHash = "synthetic-fixture-no-source-hash"
                }
                : material)
            .ToArray();
        _educationFixtureStatus = "A fixed synthetic process text was displayed in page memory only; nothing was downloaded or saved.";
        return Task.CompletedTask;
    }
}
