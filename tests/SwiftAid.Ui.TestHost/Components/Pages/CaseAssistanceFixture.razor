@page "/case-assistance-fixture"
@page "/case-assistance-receipt-fixture"
@using SwiftAid.UI.Components.Surfaces.Operations
@using SwiftAid.UI.Components.Surfaces.Operations.CaseDetail
@using SwiftAid.UI.Components.Surfaces.Operations.WorkManagement
@using SwiftAid.UI.Components.Theme
@using static SwiftAid.UI.Components.Surfaces.Operations.WorkManagement.OperationsWorkManagementSurface

<SwiftAidThemeProvider />
<MudPopoverProvider />
<output id="fixture-ready">@_ready</output>
<output id="request-result">@_requestResult</output>
<OperationsCaseDetailSurface CaseId="CaseId" WorkVersion="7" WorkState="OperationsSurfaceState.Populated"
                             WorkItems="_items" OnWorkAction="RecordRequest" />

@code {
    private static readonly Guid CaseId = Guid.Parse("b2210000-2222-4222-8222-222222222222");
    private static readonly Guid ReceiptAssistanceId = Guid.Parse("a3310000-3333-4333-8333-333333333333");
    private static readonly Guid FollowUpId = Guid.Parse("f4410000-4444-4444-8444-444444444444");
    [SupplyParameterFromQuery(Name = "Receipt")] public bool ReceiptMode { get; set; }
    [SupplyParameterFromQuery(Name = "Unfulfilled")] public bool UnfulfilledMode { get; set; }
    [SupplyParameterFromQuery(Name = "FollowUp")] public bool FollowUpMode { get; set; }
    private bool _ready;
    private string _requestResult = "Pending";
    private IReadOnlyList<OperationsWorkItem> _items = Array.Empty<OperationsWorkItem>();

    protected override void OnParametersSet()
    {
        if (FollowUpMode && _items.Count == 0)
        {
            _requestResult = "Scheduled";
            _items = [new OperationsWorkItem(CaseId, $"fu:{FollowUpId:D}", 7, "SYNTHETIC-CASE",
                OperationsWorkKind.FollowUp, OperationsWorkStatus.Scheduled, OperationsAssignmentStatus.AssignedToYou,
                "Call reporting worker", DateTimeOffset.UtcNow, DateTimeOffset.UtcNow.AddDays(1),
                [OperationsWorkAction.AcknowledgeFollowUp], [], null)];
        }
        else if (ReceiptMode && _items.Count == 0)
        {
            _requestResult = "Provided";
            _items = [new OperationsWorkItem(CaseId, $"ast:{ReceiptAssistanceId:D}", 9, "SYNTHETIC-CASE",
                OperationsWorkKind.Assistance, OperationsWorkStatus.Provided, OperationsAssignmentStatus.AssignedToYou,
                "Transport: Synthetic transport arranged", DateTimeOffset.UtcNow, null,
                [OperationsWorkAction.ConfirmAssistanceReceived], [], null)];
        }
        else if (UnfulfilledMode && _items.Count == 0)
        {
            _requestResult = "Unfulfilled";
            _items = [new OperationsWorkItem(CaseId, $"ast:{ReceiptAssistanceId:D}", 9, "SYNTHETIC-CASE",
                OperationsWorkKind.Assistance, OperationsWorkStatus.Unfulfilled, OperationsAssignmentStatus.AssignedToYou,
                "Transport support - Unfulfilled: No eligible provider was available", DateTimeOffset.UtcNow, null,
                [], [], null)];
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { _ready = true; StateHasChanged(); }
    }

    private void RecordRequest(OperationsWorkActionRequest request)
    {
        if (FollowUpMode)
        {
            if (request.CaseId != CaseId || request.WorkKey != $"fu:{FollowUpId:D}" || request.ExpectedVersion != 7 ||
                request.Action != OperationsWorkAction.AcknowledgeFollowUp)
            {
                throw new InvalidOperationException("Unexpected synthetic follow-up acknowledgement.");
            }

            _requestResult = "Acknowledged";
            _items = [new OperationsWorkItem(CaseId, $"fu:{FollowUpId:D}", 8, "SYNTHETIC-CASE",
                OperationsWorkKind.FollowUp, OperationsWorkStatus.Acknowledged, OperationsAssignmentStatus.AssignedToYou,
                "Call reporting worker", DateTimeOffset.UtcNow, DateTimeOffset.UtcNow.AddDays(1),
                [OperationsWorkAction.RescheduleFollowUp, OperationsWorkAction.RecordFollowUpOutcome, OperationsWorkAction.CancelFollowUp], [], null)];
            return;
        }

        if (ReceiptMode)
        {
            if (request.CaseId != CaseId || request.WorkKey != $"ast:{ReceiptAssistanceId:D}" ||
                request.ExpectedVersion != 9 || request.Action != OperationsWorkAction.ConfirmAssistanceReceived ||
                !request.AssistanceReceiptConfirmed || string.IsNullOrWhiteSpace(request.AssistanceReceiptMethod) ||
                string.IsNullOrWhiteSpace(request.AssistanceReceiptContext) || string.IsNullOrWhiteSpace(request.Details))
            {
                throw new InvalidOperationException("Receipt confirmation requires explicit proof and provenance.");
            }

            _requestResult = "ReceiptConfirmed";
            _items = [new OperationsWorkItem(CaseId, $"ast:{ReceiptAssistanceId:D}", 10, "SYNTHETIC-CASE",
                OperationsWorkKind.Assistance, OperationsWorkStatus.ReceiptConfirmed, OperationsAssignmentStatus.AssignedToYou,
                "Transport: Synthetic transport arranged", DateTimeOffset.UtcNow, null, [], [], null)];
            return;
        }

        if (request.CaseId != CaseId || request.ExpectedVersion != 7 ||
            request.Action != OperationsWorkAction.RequestAssistance || request.AssistanceNeed is null ||
            string.IsNullOrWhiteSpace(request.Details) || request.CommandId is null ||
            request.WorkKey != $"assistance:new:{request.CommandId:D}")
        {
            throw new InvalidOperationException("Unexpected synthetic assistance request.");
        }

        _requestResult = "Accepted";
        _items = [new OperationsWorkItem(CaseId, $"ast:{request.CommandId:D}", 8, "SYNTHETIC-CASE",
            OperationsWorkKind.Assistance, OperationsWorkStatus.Requested, OperationsAssignmentStatus.AssignedToYou,
            $"{request.AssistanceNeed}: {request.Details}", DateTimeOffset.UtcNow, null,
            [OperationsWorkAction.AcceptAssistance], [], null)];
    }
}
