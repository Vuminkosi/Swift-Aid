<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>online.swiftaid.voiceprobe</ApplicationId>
    <ApplicationTitle>SwiftAid synthetic audio probe</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/SwiftAid.Mobile/Services/Audio/AndroidSavedReportVoiceDecoder.cs" Link="AndroidSavedReportVoiceDecoder.cs" />
    <Compile Include="../../src/SwiftAid.Client/Intake/ReportVoicePcmWaveEncoder.cs" Link="ReportVoicePcmWaveEncoder.cs" />
  </ItemGroup>
</Project>
